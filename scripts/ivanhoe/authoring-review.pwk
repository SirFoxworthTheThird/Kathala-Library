      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-12-p51",
      "chapterId": "ivanhoe-section-12",
      "timelineId": "ivanhoe-reading-order",
      "title": "Evening at the lists",
      "description": "Rides away with his glittering train, receiving the crowd’s acclaim as the spectators disperse toward Ashby and other quarters. Withdraws from public notice into a pavilion offered by the marshals.",
      "locationMarkerId": "ivanhoe-place-ashby-victor-pavilion",
