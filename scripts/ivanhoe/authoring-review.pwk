    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-12-p38",
      "chapterId": "ivanhoe-section-12",
      "timelineId": "ivanhoe-reading-order",
      "title": "The invitations declined",
      "description": "Is with the Saxon company when Cedric declines the banquet on behalf of himself, Rowena and Athelstane. Invites Rowena’s company and then the knight to his banquet. Declines in Saxon and crowns Rowena to accept her temporary authority. Receives the coronet on her head while Cedric answers for the household. Declines John’s banquet, pleading fatigue and preparation for tomorrow.",
      "locationMarkerId": "ivanhoe-place-ashby-saxon-gallery",
      "involvedCharacterIds": [
        "ivanhoe-character-athelstane",
        "ivanhoe-character-john",
        "ivanhoe-character-cedric",
