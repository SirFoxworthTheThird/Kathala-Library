    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-25-p21",
      "chapterId": "ivanhoe-section-25",
      "timelineId": "ivanhoe-reading-order",
      "title": "The heated bars",
      "description": "Orders charcoal lit and explains the torture he intends. Refuses to believe such cruelty can be carried out and insists he lacks the means. With Abdalla produces charcoal, bellows and oil and prepares the fire; the text does not identify which man lights it and which works the bellows. With Hamet produces charcoal, bellows and oil and prepares the fire; the text does not identify which man lights it and which works the bellows.",
      "locationMarkerId": "ivanhoe-place-torquilstone-dungeon",
      "involvedCharacterIds": [
        "ivanhoe-character-frontdeboeuf",
        "ivanhoe-character-isaac",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
      "mentionedCharacterIds": [],
