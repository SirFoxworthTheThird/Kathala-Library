    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p52",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "Sunken Cross",
      "description": "Arrives at the dark crossroads and insists that Wamba indicated a left turn. Argues for the right turning, notices a figure at the cross and orders Hugo to rouse him. Is ordered to touch the figure with his lance butt. Reaches Sunken Cross with the retinue; neither attendant was close enough to hear the servants’ earlier directions. Arrives with the company at Sunken Cross, unable to supply directions he had been too far behind to hear.",
      "locationMarkerId": "ivanhoe-place-sunken-cross",
      "involvedCharacterIds": [
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hugo",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
      "mentionedCharacterIds": [],
