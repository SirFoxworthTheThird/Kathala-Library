    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-4-p12",
      "chapterId": "ivanhoe-section-4",
      "timelineId": "ivanhoe-reading-order",
      "title": "Swine and pork",
      "description": "Blows his horn and calls Fangs to gather the pigs, then listens to Wamba’s account of Saxon and Norman food names. Declines to muddy his clothes and uses the names of meat to mock the division between Saxon labour and Norman consumption. Limpingly scatters the pigs while trying to answer Gurth’s signals.",
      "locationMarkerId": "ivanhoe-place-forest-glade",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
        "ivanhoe-character-fangs"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [
        "ivanhoe-thread-service"
      ],
      "motifIds": [
        "ivanhoe-motif-language"
      ],
      "sortOrder": 5,
      "travelDays": 0.003472222222228538,
      "inWorldTime": 151.87152777777777,
      "tension": 2,
      "tags": [],
      "structureBeat": null,
      "status": "draft",
      "povCharacterId": null,
      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-4-p22",
      "chapterId": "ivanhoe-section-4",
      "timelineId": "ivanhoe-reading-order",
      "title": "Dangerous words",
      "description": "Praises Cedric’s resistance, complains of Front-de-Bœuf and fears Wamba might betray his words. Warns that reporting Gurth’s speech to a Norman lord could cost him his life. Has brought the herd together before Gurth.",
      "locationMarkerId": "ivanhoe-place-forest-glade",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
        "ivanhoe-character-fangs"
      ],
      "mentionedCharacterIds": [],
