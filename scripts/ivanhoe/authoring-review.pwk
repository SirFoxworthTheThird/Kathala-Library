    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-8-p20",
      "chapterId": "ivanhoe-section-8",
      "timelineId": "ivanhoe-reading-order",
      "title": "Languages of the chase",
      "description": "Praises Norman hunting vocabulary and later proposes the Hospitallers as foremost crusading knights. Rejects foreign hunting terms, recalls Northallerton and drinks to prowess in Palestine. Claims French as the language of love and war, then speaks for his own order. Questions the wisdom of Richard’s expedition. Remains at the upper table as the discussion moves from hunting language to the English knights’ reputation. Stands on the other side of the hall, within hearing of the discussion that compares the crusading knights. Occupies the place at the hearth provided by the Palmer while the upper-table conversation turns to hunting and war.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-aymer",
        "ivanhoe-character-cedric",
        "ivanhoe-character-brian",
        "ivanhoe-character-wamba",
        "ivanhoe-character-rowena",
        "ivanhoe-character-palmer",
        "ivanhoe-character-isaac"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [],
