      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-12-p34",
      "chapterId": "ivanhoe-section-12",
      "timelineId": "ivanhoe-reading-order",
      "title": "A slight ill judged",
      "description": "Leaves his throne, remounts and pauses beneath Alicia’s gallery to disparage the victor’s choice. Rejects John’s implication that his daughter needs the knight’s preference. Is seated above the mounted prince as he pays his pointed compliment.",
      "locationMarkerId": "ivanhoe-place-ashby-alicia-gallery-frontage",
      "involvedCharacterIds": [
