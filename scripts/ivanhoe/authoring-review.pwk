      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-29-p28",
      "chapterId": "ivanhoe-section-29",
      "timelineId": "ivanhoe-reading-order",
      "title": "The cowl thrown back",
      "description": "Reveals his identity and offers to exchange clothes and remain as Cedric’s substitute. Recognises Wamba and is alarmed by the danger the substitution would bring.",
      "locationMarkerId": "ivanhoe-place-torquilstone-old-hall",
      "involvedCharacterIds": [
