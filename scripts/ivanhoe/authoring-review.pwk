    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-9-p0",
      "chapterId": "ivanhoe-section-9",
      "timelineId": "ivanhoe-reading-order",
      "title": "An invitation declined",
      "description": "Declines the household’s request to discuss Ivanhoe over mead. Resents the refusal and tells Anwold to lodge the Palmer beside Isaac. Urges the late-night cup, then jokes that the Palmer’s vow would ill suit a servant. Carries the torch and is directed to the southern cell.",
      "locationMarkerId": "ivanhoe-place-rotherwood-guest-passage",
