    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-10-p38",
      "chapterId": "ivanhoe-section-10",
      "timelineId": "ivanhoe-reading-order",
      "title": "Brawn and wooden sword",
      "description": "Remains below the gallery while her father is forced toward its steps and falls back down them. Remains in the Saxon gallery when John repeats the order to make room for Isaac. Forces Isaac toward the gallery, then laughs at his fall and grants him a place below. Reluctantly climbs the steps and recoils from Wamba’s pork, losing his footing. Blocks Isaac with brawn and his wooden sword, then claims a comic victory. Is poised to stop Isaac before Wamba interposes.",
      "locationMarkerId": "ivanhoe-place-ashby-gallery-steps",
      "involvedCharacterIds": [
        "ivanhoe-character-rebecca",
        "ivanhoe-character-athelstane",
