    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-8-p50",
      "chapterId": "ivanhoe-section-8",
      "timelineId": "ivanhoe-reading-order",
      "title": "Safekeeping",
      "description": "His offered reliquary passes into Brother Ambrose’s custody as security for the challenge. Adds her own assurance that Ivanhoe will answer an honourable challenge. Rebukes Rowena’s intervention but offers his honour for Ivanhoe’s honour. Entrusts the reliquary to Ambrose, puts Brian’s chain in his own pouch and urges retirement. Receives the reliquary from the Prior for safekeeping. His challenge and gold-chain pledge stand before the company while Rowena and Cedric vouch for Ivanhoe. Remains in the hall while the pledges are assigned to safekeeping and Aymer presses to retire.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
