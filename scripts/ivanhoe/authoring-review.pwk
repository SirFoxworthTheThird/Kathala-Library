    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-8-p36",
      "chapterId": "ivanhoe-section-8",
      "timelineId": "ivanhoe-reading-order",
      "title": "The sixth knight",
      "description": "Names Richard and four companions but professes not to recall the sixth. Celebrates the names and Saxon descent of the knights, pressing to hear the last name. Is at the upper table as the Palmer enumerates the successful knights and leaves the sixth unnamed. Remains before the company after his angry response to the Palmer’s account, while the successful knights are enumerated and the sixth left unnamed. Is at the principal table while the names of Richard and four companions are recited; the sixth is withheld. Remains at the hearth during the enumeration of the knights; he has not joined the upper table.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-palmer",
        "ivanhoe-character-cedric",
        "ivanhoe-character-rowena",
