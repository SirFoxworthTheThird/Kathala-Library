      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-30-p27",
      "chapterId": "ivanhoe-section-30",
      "timelineId": "ivanhoe-reading-order",
      "title": "A red flag promised",
      "description": "Threatens exposure, then asks Cedric to press the attack when a red flag flies from the donjon’s eastern-angle turret. Rejects coercion, softens toward her distress and seeks to know her purpose.",
      "locationMarkerId": "ivanhoe-place-torquilstone-urfried-room",
