      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-21-p32",
      "chapterId": "ivanhoe-section-21",
      "timelineId": "ivanhoe-reading-order",
      "title": "A crown imagined",
      "description": "Urges Athelstane toward a national Saxon restoration and a marriage to Rowena. Enjoys his ancestry’s honours but resists the effort required by Cedric’s political plans.",
