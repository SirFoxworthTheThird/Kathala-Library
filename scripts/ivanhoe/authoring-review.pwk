    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-9-p12",
      "chapterId": "ivanhoe-section-9",
      "timelineId": "ivanhoe-reading-order",
      "title": "Questions about Ivanhoe",
      "description": "Is among the maidens remaining inside the room at its further end while Rowena questions the Palmer; no individual reply from her is recorded. Asks about Ivanhoe’s health, expected return and danger on the journey, and calls him the companion of her childhood. Claims limited acquaintance, describes Ivanhoe as recovering and discusses a possible route through Italy and France. Is kept near Rowena while she questions the visitor.",
      "locationMarkerId": "ivanhoe-place-rotherwood-rowena-chamber",
      "involvedCharacterIds": [
