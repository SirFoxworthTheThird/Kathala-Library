    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-7-p12",
      "chapterId": "ivanhoe-section-7",
      "timelineId": "ivanhoe-reading-order",
      "title": "The servants return",
      "description": "Calls the late servants before the dais and threatens punishment before learning how Fangs was maimed. Reports that the herd is safe and submits without defending his late arrival. Defends Gurth by tracing the delay to Fangs’s injured feet and the forest keeper’s action. Is seated near Cedric during the servants’ accounting. Hears Cedric’s dispute with the newly arrived servants. Remains in the hall beside the chimney during the household dispute.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-cedric",
        "ivanhoe-character-gurth",
