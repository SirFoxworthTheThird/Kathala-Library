      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-30-p19",
      "chapterId": "ivanhoe-section-30",
      "timelineId": "ivanhoe-reading-order",
      "title": "The father’s murder",
      "description": "Recounts provoking the elder Front-de-Bœuf’s death at Reginald’s hand and describes her later degradation. Refuses to act as confessor and urges repentance.",
      "locationMarkerId": "ivanhoe-place-torquilstone-urfried-room",
