    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-25-p44",
      "chapterId": "ivanhoe-section-25",
      "timelineId": "ivanhoe-reading-order",
      "title": "A father’s plea",
      "description": "Says he has assigned Rebecca to Brian, briefly showing discomfort on learning she is Isaac’s daughter. Cries out, is released from the attendants’ grasp and clasps the Baron’s knees, offering everything for Rebecca’s safety. Lets go of Isaac with Abdalla, startled by his cry on learning what has happened to Rebecca. Lets go of Isaac with Hamet, startled by his cry on learning what has happened to Rebecca.",
      "locationMarkerId": "ivanhoe-place-torquilstone-dungeon",
      "involvedCharacterIds": [
        "ivanhoe-character-frontdeboeuf",
        "ivanhoe-character-isaac",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
