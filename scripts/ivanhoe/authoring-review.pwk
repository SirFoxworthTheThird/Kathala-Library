      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-32-p29",
      "chapterId": "ivanhoe-section-32",
      "timelineId": "ivanhoe-reading-order",
      "title": "The cloud of arrows",
      "description": "Withdraws briefly amid the missile exchange and returns to shelter at the lattice. Presses for news of the advance and of the Black Knight.",
      "locationMarkerId": "ivanhoe-place-torquilstone-ivanhoe-window",
