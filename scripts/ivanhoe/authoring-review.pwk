    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-25-p55",
      "chapterId": "ivanhoe-section-25",
      "timelineId": "ivanhoe-reading-order",
      "title": "The interrupted cruelty",
      "description": "Orders Isaac stripped for the bars, then stops on hearing the horn and calls for him from outside. Has his outer garment removed and restored before the Baron leaves with both attendants. With Abdalla tears off Isaac’s upper garment, restores it at the interrupted Baron’s signal, and leaves the dungeon; no burning occurs. With Hamet tears off Isaac’s upper garment, restores it at the interrupted Baron’s signal, and leaves the dungeon; no burning occurs.",
      "locationMarkerId": "ivanhoe-place-torquilstone-dungeon",
      "involvedCharacterIds": [
        "ivanhoe-character-frontdeboeuf",
