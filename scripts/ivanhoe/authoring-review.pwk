      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-29-p35",
      "chapterId": "ivanhoe-section-29",
      "timelineId": "ivanhoe-reading-order",
      "title": "For his own master",
      "description": "Offers to remain if Athelstane takes the escape instead. Refuses to risk his neck for anyone but his own master. Rejects escape bought by the jester’s sacrifice and urges Cedric to go.",
      "locationMarkerId": "ivanhoe-place-torquilstone-old-hall",
