    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-7-p48",
      "chapterId": "ivanhoe-section-7",
      "timelineId": "ivanhoe-reading-order",
      "title": "Another stranger",
      "description": "Orders that the new traveller at the gate be admitted and cared for in the storm. Receives Cedric’s order and leaves the hall to arrange the stranger’s welcome. Is at the upper table when the page’s message interrupts conversation. Is dining in the hall when another guest is announced. Is among the diners when the request from the gate arrives. Hears the page interrupt the hall’s conversation. Is in the household hall at the interruption. Waits at his separate seat as a new request for shelter is reported.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-cedric",
        "ivanhoe-character-oswald",
        "ivanhoe-character-rowena",
        "ivanhoe-character-brian",
