    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-9-p21",
      "chapterId": "ivanhoe-section-9",
      "timelineId": "ivanhoe-reading-order",
      "title": "The southern cells",
      "description": "Returns the torch to Anwold in the anteroom; he conducts the Palmer onward, and her next whereabouts are not stated. Asks which cells hold Isaac and Gurth before entering his allotted lodging. Resumes carrying the torch and identifies Isaac’s and Gurth’s cells on either side of the Palmer’s.",
      "locationMarkerId": "ivanhoe-place-rotherwood-guest-passage",
      "involvedCharacterIds": [
        "ivanhoe-character-edwina",
