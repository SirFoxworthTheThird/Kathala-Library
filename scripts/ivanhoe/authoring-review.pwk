      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-24-p29",
      "chapterId": "ivanhoe-section-24",
      "timelineId": "ivanhoe-reading-order",
      "title": "The prisoners divided",
      "description": "Is separated from her attendants and taken to a distant room. Is taken away separately despite Isaac’s pleas. Offers money to remain beside Rebecca, then is dragged in another direction. Is denied access to Rowena and confined with other disarmed domestics.",
      "locationMarkerId": null,
