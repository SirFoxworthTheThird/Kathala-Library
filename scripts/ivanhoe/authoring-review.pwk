  "lorePages": [
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-lore-colophon",
      "categoryId": "ivanhoe-lore-category-edition",
      "title": "Text, maps, and illustrations",
      "body": "This reading edition presents Walter Scott’s English original, Ivanhoe: A Romance (first published 1819, with an 1820 title date). No translation is used. The text follows Project Gutenberg eBook 82, updated 4 June 2021, credited to John P. Roberts, Jr. and David Widger.\n\nSource: https://www.gutenberg.org/cache/epub/82/pg82.txt\n\nThe original work is in the public domain in the United States. Project Gutenberg’s distribution notice and licence are reproduced on the accompanying source-notice page. Readers elsewhere should check their local law.\n\nThe original Roman-numbered chapter headings, introductory material and notes are retained. Scene captions and these reading notes are editorial additions.\n\nThe illustrations were generated for this edition. Unspecified faces, colours, furnishings and minor visual details are artistic interpretations. Maps of fictional sites are reconstructions from Scott’s descriptions, not measured archaeological plans. The regional relief uses public-domain NOAA ETOPO1 and Natural Earth data. A place whose position is not established by the text may remain unplaced.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "ivanhoe-source-1-p0"
    },
