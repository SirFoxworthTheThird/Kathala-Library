      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-25-p12",
      "chapterId": "ivanhoe-section-25",
      "timelineId": "ivanhoe-reading-order",
      "title": "A thousand pounds",
      "description": "Demands a thousand pounds of silver or a corresponding weight of gold and threatens a lingering death. Protests inability to supply the demanded sum and begs mercy. Stands with Abdalla during Front-de-Bœuf’s demand for a thousand pounds; no silver is delivered. Stands with Hamet during Front-de-Bœuf’s demand for a thousand pounds; no silver is delivered.",
      "locationMarkerId": "ivanhoe-place-torquilstone-dungeon",
      "involvedCharacterIds": [
        "ivanhoe-character-frontdeboeuf",
