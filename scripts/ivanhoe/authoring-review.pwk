    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-29-p19",
      "chapterId": "ivanhoe-section-29",
      "timelineId": "ivanhoe-reading-order",
      "title": "Prepare for death",
      "description": "Greets the prisoners and announces his apparent mission as confessor. Paces impatiently and is startled by the announced execution. Receives the news with outward composure after the meal.",
      "locationMarkerId": "ivanhoe-place-torquilstone-old-hall",
      "involvedCharacterIds": [
