      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-14-p0",
      "chapterId": "ivanhoe-section-14",
      "timelineId": "ivanhoe-reading-order",
      "title": "The dark lane",
      "description": "Hurries through the shadowed lane carrying his master’s gold and his own earnings, uneasy at the revelry behind him.",
