    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-6-p11",
      "chapterId": "ivanhoe-section-6",
      "timelineId": "ivanhoe-reading-order",
      "title": "A delayed supper",
      "description": "Complains that Rowena is still dressing and imagines that his missing servants and swine have been seized. Offers wine and cites the recent curfew, provoking Cedric’s anger. Explains that Rowena is changing her wet clothing after returning from mass.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
