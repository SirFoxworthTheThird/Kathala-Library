      "eventId": "ivanhoe-source-34-p80",
      "sortKey": 34.000365,
      "status": "active",
      "notes": "Brian’s mounted party forces its way over the principal drawbridge. This is distinct from the raft at the postern moat crossing."
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-location-state-torquilstone-ruins-ivanhoe-source-34-p92",
