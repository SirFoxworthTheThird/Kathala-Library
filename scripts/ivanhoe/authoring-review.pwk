    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p23",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "The raised riding rod",
      "description": "Refuses to guide men who demand shelter as a right and reaches for his knife when threatened. Remains beside Gurth as the soldier interrupts his exchange with the Prior. Names Cedric as their intended host, then interposes his mule to prevent violence. Spurs his horse across Gurth’s path and raises his riding rod to strike. Is with the rear retinue while the armed rider confronts the swineherd; no intervention by either attendant is described. Stays back with the travelling attendants during the armed rider’s confrontation with Gurth.",
      "locationMarkerId": "ivanhoe-place-forest-path",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [],
      "motifIds": [],
      "sortOrder": 11,
      "travelDays": 0.001388888888868678,
      "inWorldTime": 151.88541666666666,
      "tension": 4,
      "tags": [],
