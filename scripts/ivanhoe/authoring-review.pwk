    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-8-p14",
      "chapterId": "ivanhoe-section-8",
      "timelineId": "ivanhoe-reading-order",
      "title": "No seat offered",
      "description": "Lays a hand on his dagger as Isaac approaches the lower table, deterring him from sitting nearby. Joins the hostile response to Isaac at the lower table, putting a hand on his dagger without attacking him. Enters wet and hungry, bows to the company and finds no one at the lower table willing to make room. Acknowledges Isaac coldly and indicates the lower end of the table. Has brought servants whose hostile gestures deter Isaac from sitting beside them. Is at the upper table during Isaac’s arrival and the refusal of room at the lower board. Occupies the separate settle by the chimney when Isaac finds no room at the lower table. Is among the principal guests while his attendants cross themselves at Isaac’s approach to the lower table.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla",
        "ivanhoe-character-isaac",
