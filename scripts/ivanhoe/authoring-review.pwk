      "id": "ivanhoe-source-47-p5",
      "chapterId": "ivanhoe-section-47",
      "timelineId": "ivanhoe-reading-order",
      "title": "The king’s arrest",
      "description": "Arrives with armed followers and orders Albert’s arrest. Arrests Albert for high treason and names his office. Is arrested for high treason when Henry Bohun lays a hand on his shoulder. Challenges the authority for the arrest. Explains the result to Richard.",
      "locationMarkerId": "ivanhoe-place-templestowe-lists",
      "involvedCharacterIds": [
        "ivanhoe-character-blackknight",
        "ivanhoe-character-bohun",
        "ivanhoe-character-albert",
