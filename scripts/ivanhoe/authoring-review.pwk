    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-7-p39",
      "chapterId": "ivanhoe-section-7",
      "timelineId": "ivanhoe-reading-order",
      "title": "News and old directions",
      "description": "Asks for news from Palestine rather than further compliments. Reports a truce with Saladin and recognises Wamba as the guide who misdirected them. Jests about successive fifty-year truces and excuses his misleading directions as a fool’s mistake. Laughs at Wamba’s jest, then threatens discipline for misleading travellers. Hears the discussion after the toast at Cedric’s table. Is in the household hall during Wamba’s exchange with the guests. Remains apart in the hall as Palestine is discussed. Is among Cedric’s favourite dogs attending him while he shares food from his trencher with Wamba and the dogs.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-rowena",
        "ivanhoe-character-brian",
        "ivanhoe-character-wamba",
        "ivanhoe-character-cedric",
        "ivanhoe-character-aymer",
        "ivanhoe-character-gurth",
        "ivanhoe-character-palmer",
        "ivanhoe-character-balder"
