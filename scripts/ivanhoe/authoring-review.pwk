    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p14",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "A request for lodging",
      "description": "Stands with Wamba while the Prior asks the way to hospitality. Suggests the priory and hermitage, then challenges the Prior’s claim upon lay hospitality. Asks for a local host, rejects lodging with fellow churchmen and admonishes Wamba. Waits alongside the Prior during the exchange about hospitality. Waits with the travelling retinue while the churchman seeks lodging; remains behind the leading riders. Remains among the attendants behind the riders while the churchman asks where the company can lodge.",
      "locationMarkerId": "ivanhoe-place-forest-path",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [],
      "motifIds": [
        "ivanhoe-motif-hospitality"
      ],
      "sortOrder": 10,
      "travelDays": 0.0013888888888970996,
      "inWorldTime": 151.8840277777778,
      "tension": 2,
