    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p0",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "Riders on the path",
      "description": "Pauses with Wamba as a ten-man cavalcade overtakes them. Lingering over nuts and passers-by, allows the approaching horsemen to catch them. Rides at the head of the party on an ornamented mule. Travels beside the churchman wearing mail under his scarlet cross-marked mantle. Rides behind the two squires among the pair of turbaned attendants as the cavalcade overtakes the servants. Follows the two squires beside the other turbaned attendant when the company comes up with Gurth and Wamba.",
      "locationMarkerId": "ivanhoe-place-forest-path",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [],
      "motifIds": [],
      "sortOrder": 8,
      "travelDays": 0.0020833333333314386,
      "inWorldTime": 151.88125,
      "tension": 2,
      "tags": [],
      "structureBeat": null,
      "status": "draft",
      "povCharacterId": null,
      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p12",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "The familiar churchman",
      "description": "Recognises the Prior of Jorvaulx and makes an obeisance. Pays the Prior a rough greeting while studying his companion. Returns the servants’ greeting with a blessing. Attracts the servants’ curiosity by his unfamiliar dress and retinue. Continues behind the squires while the two leading riders meet the servants; the party has not yet resumed its journey. Is halted in the rear of the company during the leading riders’ encounter with the two servants.",
      "locationMarkerId": "ivanhoe-place-forest-path",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [],
      "motifIds": [],
      "sortOrder": 9,
      "travelDays": 0.0013888888888970996,
