    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-8-p28",
      "chapterId": "ivanhoe-section-8",
      "timelineId": "ivanhoe-reading-order",
      "title": "The Palmer’s testimony",
      "description": "Asks whether English knights deserve comparison with the military orders. Concedes English valour only second place and reacts angrily to the Palmer’s contradiction. Interrupts to assert the English knights were second to none and cites the Acre tournament. Offers a gold bracelet for the names of the successful English knights. Offers to wear the bracelet when the Palmer refuses gold. Turns with the company toward the Palmer’s unexpected assertion about the English knights. Turns with the company toward the Palmer when his claim for the English knights interrupts the exchange. Turns with the company toward the Palmer’s unexpected declaration from the place near the hearth. Turns with the company toward the Palmer when he publicly contradicts the claim about the English knights. Turns with the company toward the Palmer’s unexpected defence of the English chivalry.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-rowena",
        "ivanhoe-character-brian",
        "ivanhoe-character-palmer",
        "ivanhoe-character-cedric",
        "ivanhoe-character-wamba",
        "ivanhoe-character-hugo",
        "ivanhoe-character-aymer",
        "ivanhoe-character-isaac",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
