    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-8-p57",
      "chapterId": "ivanhoe-section-8",
      "timelineId": "ivanhoe-reading-order",
      "title": "A question in the throng",
      "description": "Questions Isaac about going to the tournament, accuses him of lying and addresses his own servants in another language. Says he is travelling for assistance with a tax fine and is left frightened by Brian’s accusation. Receives the guests’ final salutation and retires from the hall by a separate door with his attendants. Receives the parting obeisance and retires with her attendants through a door separate from Cedric’s. Is addressed with the other attendant by Brian in a language unknown to the bystanders; the order’s contents are not yet translated. Receives Brian’s words with the other attendant after the encounter with Isaac; the bystanders are not told what is said.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-brian",
