    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p57",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "A willing guide",
      "description": "Rises at the cross, objects to the disturbance and offers to guide the party to Rotherwood if given a horse. Asks for the road and arranges a horse for the stranger. Remains with the travellers while the stranger agrees to guide them. Is with the company at the crossroads as the stranger agrees to guide it; the horse supplied to the guide comes from the Prior’s attendant. Waits among the company at Sunken Cross while the stranger accepts a horse and undertakes to lead the travellers. Remains with the retinue at Sunken Cross after using his lance to rouse the stranger, who now agrees to guide the party.",
      "locationMarkerId": "ivanhoe-place-sunken-cross",
      "involvedCharacterIds": [
        "ivanhoe-character-palmer",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla",
        "ivanhoe-character-hugo"
      ],
