    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p68",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "Before Rotherwood",
      "description": "Says he was born nearby as the party reaches Cedric’s defended dwelling. Arrives with the travelling party at Rotherwood before the heavy rain. Sounds his horn before the western entrance as rain begins to fall. Reaches Rotherwood’s western entrance with the company as the Templar sounds his horn and heavy rain begins. Arrives among the attendants at Rotherwood’s western entrance as the horn is sounded in the rain. Arrives with the travelling company before Rotherwood’s western entrance as rain begins.",
      "locationMarkerId": "ivanhoe-place-rotherwood-entrance",
      "involvedCharacterIds": [
