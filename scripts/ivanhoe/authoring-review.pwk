    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-12-p37",
      "chapterId": "ivanhoe-section-12",
      "timelineId": "ivanhoe-reading-order",
      "title": "The prince rides to Rowena",
      "description": "Is seated in her gallery with the coronet still at her feet as John rides over from Alicia’s stand. Gives Fitzurse no answer and spurs his mount forward to Rowena’s gallery.",
      "locationMarkerId": "ivanhoe-place-ashby-saxon-gallery-frontage",
