      "id": "ivanhoe-source-33-p42",
      "chapterId": "ivanhoe-section-33",
      "timelineId": "ivanhoe-reading-order",
      "title": "The locked deathbed",
      "description": "Leaves and double-locks the door behind her. Calls unheard for aid as smoke thickens and flames rise, his voice lost in battle.",
      "locationMarkerId": "ivanhoe-place-torquilstone-frontdeboeuf-room",
