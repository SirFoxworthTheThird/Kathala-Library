      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p51",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "Confidence in the retinue",
      "description": "Continues with the travelling retinue as Brian names him among the companions on whom he relies for support. Is named with Hamet among the armed attendants accompanying Brian on the road. Promises restraint for the night but names Hamet and Abdalla with his squires as protection against expulsion. Hears Brian claim that force will secure their quarters if needed.",
      "locationMarkerId": "ivanhoe-place-road-to-sunken-cross",
      "involvedCharacterIds": [
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla",
        "ivanhoe-character-brian",
        "ivanhoe-character-aymer"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [],
      "motifIds": [],
      "sortOrder": 16,
      "travelDays": 0.001388888888868678,
      "inWorldTime": 151.89305555555555,
