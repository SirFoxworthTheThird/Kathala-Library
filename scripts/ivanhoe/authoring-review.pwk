    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-7-p7",
      "chapterId": "ivanhoe-section-7",
      "timelineId": "ivanhoe-reading-order",
      "title": "Three steps from the dais",
      "description": "Advances the three steps allowed by his vow, requests Saxon speech and seats the guests while suppressing resentment. Answers Cedric in the local language and invokes his grandmother in a conciliatory speech. Insists on speaking French while saying he understands the local language. Waits apart by the chimney while the principal guests exchange greetings.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
