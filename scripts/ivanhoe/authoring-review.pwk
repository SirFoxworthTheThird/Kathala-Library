    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-8-p0",
      "chapterId": "ivanhoe-section-8",
      "timelineId": "ivanhoe-reading-order",
      "title": "Hospitality disputed",
      "description": "Returns from the gate to ask whether Isaac of York should be admitted. Orders hospitality despite his guests’ objections and directs that the newcomer be fed. Uses the swineherd and a piece of bacon to make hostile jokes about the expected guest. Objects to admitting a Jewish guest into the company. Rejects sharing company with Isaac and claims that his servants will also refuse him. Is seated at Cedric’s right while the household disputes whether the stranger at the gate should be admitted. Remains at the separate chimney settle while the newcomer’s admission is debated; he has not yet given up that place.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-oswald",
        "ivanhoe-character-cedric",
        "ivanhoe-character-wamba",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-rowena",
        "ivanhoe-character-palmer"
      ],
      "mentionedCharacterIds": [],
