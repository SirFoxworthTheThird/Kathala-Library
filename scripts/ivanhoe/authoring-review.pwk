    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-7-p26",
      "chapterId": "ivanhoe-section-7",
      "timelineId": "ivanhoe-reading-order",
      "title": "Rowena enters",
      "description": "Enters with four attendants and is escorted to the elevated seat at Cedric’s right. Meets Rowena ceremonially and leads her to the lady’s seat. Concedes the wine wager to Aymer and fixes his gaze on Rowena. Accepts the wager’s result and warns Brian that Cedric is watching. Rises with the household to receive Rowena. Is among the household at the meal when Rowena is received. Is in the hall as the company rises for Rowena. Stands with the company when Rowena enters and receives its salutation. Raises his white wand and commands the company to make room for Rowena.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-rowena",
        "ivanhoe-character-cedric",
        "ivanhoe-character-brian",
