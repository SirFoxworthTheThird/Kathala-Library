      "threadIds": [],
      "motifIds": [],
      "sortOrder": 250,
      "travelDays": 0.0027777777777657775,
      "inWorldTime": 156.5048611111111,
      "tension": 5,
      "tags": [],
      "structureBeat": null,
      "status": "draft",
      "povCharacterId": null,
      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-25-p27",
      "chapterId": "ivanhoe-section-25",
      "timelineId": "ivanhoe-reading-order",
      "title": "The coerced promise",
      "description": "Is raised and held by the attendants, then promises payment with help from his community and asks for security. Insists silver must be weighed on the dungeon floor before any release. With Abdalla lifts Isaac from the floor and holds him while the Baron demands security for the promised ransom. With Hamet lifts Isaac from the floor and holds him while the Baron demands security for the promised ransom.",
      "locationMarkerId": "ivanhoe-place-torquilstone-dungeon",
      "involvedCharacterIds": [
        "ivanhoe-character-isaac",
