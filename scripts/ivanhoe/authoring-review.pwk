      "povCharacterId": null,
      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p30",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "Directions at a price",
      "description": "Sees the Prior intervene before the request for a route is settled. Jests about the armed traveller and bargains over giving directions. Rebukes brother Brian, offers Wamba silver and again asks the way to Cedric. Is rebuked by the Prior as Wamba answers their request with jests. Remains with the retinue during the halted riders’ exchange; the later crossroads account establishes that the attendants were too far away to hear the directions. Is still in the rear company during the roadside dispute, beyond hearing of the directions later discussed at the crossroads.",
      "locationMarkerId": "ivanhoe-place-forest-path",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [],
      "motifIds": [],
      "sortOrder": 12,
      "travelDays": 0.0013888888888970996,
      "inWorldTime": 151.88680555555555,
      "tension": 3,
      "tags": [],
      "structureBeat": null,
      "status": "draft",
      "povCharacterId": null,
      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p35",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "The wrong turning",
      "description": "Tells the travellers to take the left path at Sunken Cross, deliberately directing them away from Rotherwood. Hears Wamba give the route which he will question after the travellers leave. Receives Wamba’s directions to the crossroads. Is among the riders receiving the instructions to turn left at Sunken Cross. Waits behind the leading riders while Wamba gives his misleading directions; is not close enough to hear the route. Has not come within hearing of Wamba’s directions; waits farther back with the attendants.",
      "locationMarkerId": "ivanhoe-place-forest-path",
      "involvedCharacterIds": [
        "ivanhoe-character-wamba",
        "ivanhoe-character-gurth",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "threadIds": [
        "ivanhoe-thread-service"
      ],
      "motifIds": [],
