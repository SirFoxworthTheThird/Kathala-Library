      "eventId": "ivanhoe-source-13-p70",
      "sortKey": 13.000119,
      "condition": "intact",
      "notes": "Rebecca gives the silk purse containing a hundred gold pieces: eighty for the master and the remainder for his attendant. The amounts are allocations within the purse, not duplicated piles of coins."
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-item-masters-gold-state-ivanhoe-source-14-p17",
