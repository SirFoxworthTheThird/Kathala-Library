    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-10-p30",
      "chapterId": "ivanhoe-section-10",
      "timelineId": "ivanhoe-reading-order",
      "title": "The severed lance",
      "description": "Extends his lance toward Athelstane on John’s order. Draws his short sword and cuts off the lance point before it can strike. Is too slow to withdraw from the threatened weapon. Is enraged by Cedric’s blow and challenges an applauding archer. Applauds Cedric and accepts John’s challenge to test his archery.",
      "locationMarkerId": "ivanhoe-place-ashby-saxon-gallery",
      "involvedCharacterIds": [
