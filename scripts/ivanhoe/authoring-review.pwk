    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-4-p8",
      "chapterId": "ivanhoe-section-4",
      "timelineId": "ivanhoe-reading-order",
      "title": "The forest glade",
      "description": "Looks down dejectedly in his brass thrall collar beside the grazing herd. Rests on a fallen stone in his belled cap and contrasting red and yellow gaiters.",
      "locationMarkerId": "ivanhoe-place-forest-glade",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba"
      ],
      "mentionedCharacterIds": [],
