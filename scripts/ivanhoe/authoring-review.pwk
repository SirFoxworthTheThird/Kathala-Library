      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p40",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "A wager on the road",
      "description": "Explains Cedric’s temperament and Rowena’s wardship, confirms his gold-collar wager and urges Brian to behave courteously. Boasts of coercing captives and questions the promised beauty of Rowena. Travels onward with the cavalcade after it leaves the two servants behind; the leading riders discuss Cedric and their wager. Leaves the servants behind in the company’s onward movement while the two principal riders converse.",
      "locationMarkerId": "ivanhoe-place-road-to-sunken-cross",
      "involvedCharacterIds": [
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
        "ivanhoe-character-hamet",
        "ivanhoe-character-abdalla"
      ],
