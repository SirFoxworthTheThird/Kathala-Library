      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-4-p25",
      "chapterId": "ivanhoe-section-4",
      "timelineId": "ivanhoe-reading-order",
      "title": "Thunder in the wood",
      "description": "Takes up his quarterstaff and urges Wamba home while driving the gathered herd ahead of the storm. Hears approaching horses and wants to see the riders, but follows Gurth’s appeal to return home. Helps drive the pigs down the forest glade.",
      "locationMarkerId": "ivanhoe-place-forest-path",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
        "ivanhoe-character-fangs"
      ],
      "mentionedCharacterIds": [],
