    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-25-p35",
      "chapterId": "ivanhoe-section-25",
      "timelineId": "ivanhoe-reading-order",
      "title": "Who may be freed",
      "description": "Asks for the companions’ liberty and proposes Rebecca go to York for the ransom. Refuses to link the other captives to Isaac’s terms and presses for a payment date. Continues holding Isaac with Abdalla while the Baron refuses to release the other captives on Isaac’s terms. Continues holding Isaac with Hamet while the Baron refuses to release the other captives on Isaac’s terms.",
      "locationMarkerId": "ivanhoe-place-torquilstone-dungeon",
      "involvedCharacterIds": [
        "ivanhoe-character-isaac",
