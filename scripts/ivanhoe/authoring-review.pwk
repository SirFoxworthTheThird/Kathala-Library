      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-9-p20",
      "chapterId": "ivanhoe-section-9",
      "timelineId": "ivanhoe-reading-order",
      "title": "Edwina leads the visitor out",
      "description": "Receives Rowena’s gold with a low reverence and follows Edwina out of the apartment. Leads the Palmer out of Rowena’s apartment after the interview.",
      "locationMarkerId": "ivanhoe-place-rotherwood-rowena-chamber",
