    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-26-p4",
      "chapterId": "ivanhoe-section-26",
      "timelineId": "ivanhoe-reading-order",
      "title": "A suitor uninvited",
      "description": "Enters in rich courtly dress, names himself and attempts to turn the abduction into a gallant address. Refuses his offered seat and rejects the language which disguises her imprisonment.",
      "locationMarkerId": "ivanhoe-place-torquilstone-rowena-room",
      "involvedCharacterIds": [
        "ivanhoe-character-debracy",
        "ivanhoe-character-rowena"
      ],
