    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-7-p31",
      "chapterId": "ivanhoe-section-7",
      "timelineId": "ivanhoe-reading-order",
      "title": "A veil and an invitation",
      "description": "Draws her veil over her face to rebuke the Templar’s stare and declines to unveil for his toast. Challenges Brian’s stare and refuses the implication that he needs Norman protection to travel. Offers Rowena an apology and then drinks a lavishly flattering toast to her. Invites the household to the tournament and responds to Cedric’s wine pledge. Occupies his accustomed place behind Cedric during the feast. Has been sent back to his household place at supper. Sits apart from the principal table during their exchange.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-rowena",
        "ivanhoe-character-cedric",
        "ivanhoe-character-brian",
