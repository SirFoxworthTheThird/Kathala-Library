    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-7-p0",
      "chapterId": "ivanhoe-section-7",
      "timelineId": "ivanhoe-reading-order",
      "title": "The guests’ attire",
      "description": "Follows his master into the hall with the visiting attendants while the Palmer seeks a place apart. Enters with the company attending the Templar as the dignitaries return in changed clothing. Enters in an embroidered cope and jewelled rings after changing his travelling robe. Wears purple silk under a white mantle marked by the black cross instead of his travelling mail. Takes a settle by the chimney to dry his garments because the lower table is crowded. Receives the guests in his hall. Is among the visiting attendants whose company crowds the lower table as the Palmer finds a separate settle.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
