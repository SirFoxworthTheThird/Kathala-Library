      "sortOrder": 18,
      "travelDays": 0.0013888888888970996,
      "inWorldTime": 151.89583333333334,
      "tension": 2,
      "tags": [],
      "structureBeat": null,
      "status": "draft",
      "povCharacterId": null,
      "isFlashback": false
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p62",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "Through the marshes",
      "description": "Guides the riders by the soundest ground over marshy brooks and points out Rotherwood. Suffers alarm at the crossings and asks his guide’s identity when the house is near. Accompanies the party over the route chosen by the guide. Travels with the guided cavalcade across the marshy woodland brooks toward Rotherwood. Follows the new guide with the mounted company through marshy ground and woodland brooks. Accompanies the guided party through the woodland brooks after the disagreement at the cross.",
      "locationMarkerId": "ivanhoe-place-woodland-brooks",
      "involvedCharacterIds": [
        "ivanhoe-character-palmer",
        "ivanhoe-character-aymer",
        "ivanhoe-character-brian",
