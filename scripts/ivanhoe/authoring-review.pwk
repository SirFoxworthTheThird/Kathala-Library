    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-5-p37",
      "chapterId": "ivanhoe-section-5",
      "timelineId": "ivanhoe-reading-order",
      "title": "After the horses pass",
      "description": "Recognises that Wamba’s directions will keep the visitors from Rotherwood and fears trouble if they meet Cedric. Admits he has sent the visitors toward Sheffield to protect the household from them.",
      "locationMarkerId": "ivanhoe-place-forest-path",
      "involvedCharacterIds": [
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba"
      ],
      "mentionedCharacterIds": [],
