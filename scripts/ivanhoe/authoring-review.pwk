    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-8-p17",
      "chapterId": "ivanhoe-section-8",
      "timelineId": "ivanhoe-reading-order",
      "title": "A place by the fire",
      "description": "Gives Isaac his seat, stirs the fire and brings him pottage and kid before moving across the hall. Warms his chilled hands and eats the meal provided by the Palmer. Is absorbed with Aymer in discussing his hounds while Isaac seeks a seat. Keeps Cedric engaged in the conversation about hunting. Converses with an attendant while the company settles. Looks between Isaac and Rowena during the meal.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
