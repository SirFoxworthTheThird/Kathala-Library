    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-location-state-torquilstone-postern-crossing-ivanhoe-source-30-p55",
      "locationMarkerId": "ivanhoe-place-torquilstone-postern-crossing",
      "eventId": "ivanhoe-source-30-p55",
      "sortKey": 30.000307,
      "status": "active",
      "notes": "Front-de-Bœuf and the disguised Cedric cross the moat on a single plank to the small outer defence."
    },
    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-location-state-torquilstone-postern-crossing-ivanhoe-source-32-p17",
