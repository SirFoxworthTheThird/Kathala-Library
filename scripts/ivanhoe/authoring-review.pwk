    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-25-p49",
      "chapterId": "ivanhoe-section-25",
      "timelineId": "ivanhoe-reading-order",
      "title": "Payment refused",
      "description": "Refuses to break his agreement with Brian and renews the torture threat. Defies the Baron and refuses any silver unless Rebecca is restored safely. Remains beside Abdalla as Isaac withdraws his agreement to pay unless his daughter is restored safely. Remains beside Hamet as Isaac withdraws his agreement to pay unless his daughter is restored safely.",
      "locationMarkerId": "ivanhoe-place-torquilstone-dungeon",
      "involvedCharacterIds": [
        "ivanhoe-character-frontdeboeuf",
