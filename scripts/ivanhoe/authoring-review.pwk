    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-7-p24",
      "chapterId": "ivanhoe-section-7",
      "timelineId": "ivanhoe-reading-order",
      "title": "The supper board",
      "description": "Ends the dispute, tells Gurth to get another dog and invites the guests to eat. Is dismissed from before the dais after being told to replace Fangs. Returns to his place when Cedric ends the dispute. Is offered the substantial supper prepared in the hall. Receives Cedric’s apology and invitation to the meal. Waits separately from the crowded lower table.",
      "locationMarkerId": "ivanhoe-place-rotherwood-hall",
      "involvedCharacterIds": [
        "ivanhoe-character-cedric",
        "ivanhoe-character-gurth",
        "ivanhoe-character-wamba",
