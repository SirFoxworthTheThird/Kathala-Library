      "id": "ivanhoe-source-32-p17",
      "chapterId": "ivanhoe-section-32",
      "timelineId": "ivanhoe-reading-order",
      "title": "A shield at the window",
      "description": "Props an ancient shield before the lower lattice and describes the approaching archers and black-armoured leader. Questions the banner and interprets the blue fetterlock device without identifying its bearer.",
      "locationMarkerId": "ivanhoe-place-torquilstone-ivanhoe-window",
