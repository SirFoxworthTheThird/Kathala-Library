    {
      "worldId": "ivanhoe-world",
      "createdAt": 1793232000000,
      "updatedAt": 1793232000000,
      "id": "ivanhoe-source-30-p32",
      "chapterId": "ivanhoe-section-30",
      "timelineId": "ivanhoe-reading-order",
      "title": "A voice outside",
      "description": "Hears the Baron calling outside and urges Cedric to rejoin his people. Is prevented from asking more by the Baron’s approaching voice.",
