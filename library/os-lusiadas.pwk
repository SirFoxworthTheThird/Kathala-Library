  "characterGoals": [
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-goal-1",
      "characterId": "os-lusiadas-char-g",
      "startEventId": "os-lusiadas-event-01-057",
      "endEventId": "os-lusiadas-event-09-013",
      "type": "want",
      "text": "Reach India by sea and secure an audience and trade."
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-goal-2",
      "characterId": "os-lusiadas-char-b",
      "startEventId": "os-lusiadas-event-01-073",
      "endEventId": "os-lusiadas-event-06-035",
      "type": "want",
      "text": "Prevent the fleet from establishing its fame in the East."
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-goal-3",
      "characterId": "os-lusiadas-char-v",
      "startEventId": "os-lusiadas-event-01-030",
      "endEventId": "os-lusiadas-event-09-053",
      "type": "want",
      "text": "Guide the sailors through opposition and grant them a welcome."
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-goal-4",
      "characterId": "os-lusiadas-char-mo",
      "startEventId": "os-lusiadas-event-09-005",
      "endEventId": "os-lusiadas-event-09-015",
      "type": "want",
      "text": "Warn the Portuguese of the plan forming against their ships."
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-goal-5",
      "characterId": "os-lusiadas-char-sam",
      "startEventId": "os-lusiadas-event-07-057",
      "endEventId": "os-lusiadas-event-09-012",
      "type": "need",
      "text": "Judge the foreign embassy while preserving order in his port."
    }
  ],
  "mapRoutes": [],
  "loreCategories": [
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-lore-reading",
      "name": "Reading the poem",
      "description": "The edition and its narrative frames.",
      "sortOrder": 0
    }
  ],
  "lorePages": [
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-lore-edition",
      "categoryId": "os-lusiadas-lore-reading",
      "title": "Translation and spelling",
      "body": "The reading text is Richard Francis Burton’s complete English verse translation, edited by Isabel Burton and published in London in 1880. Project Gutenberg eBooks 77660 and 77661 transcribe the two volumes. Stanza numbering, numeric note calls, one ornamental divider in Canto I, and one in Canto X are excluded. An unnumbered interpolation after X.40 is omitted so the 1,102 numbered stanzas align with Camões’s 1572 poem. Burton’s historical English spelling and punctuation remain. The original Portuguese is available in the companion entry. See the source audit for exact boundaries and normalization. Both poem and translation are public domain.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-event-01-001"
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-lore-frames",
      "categoryId": "os-lusiadas-lore-reading",
      "title": "Voyage, memory, and gods",
      "body": "The cantos follow the order of Camões’s telling. Gama begins already at sea, then recounts earlier Portuguese history and the voyage outward. The gods act in a parallel epic plane; the poet also speaks directly to his king.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-event-01-019"
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-lore-calendar",
      "categoryId": "os-lusiadas-lore-reading",
      "title": "Editorial dates",
      "body": "Dates on the calendar are reading aids. Named voyage milestones follow a surviving voyage journal; events between them are interpolated. Older history uses approximate years, the Twelve of England an undated tale position, and divine action its own clock. The poem does not supply a day for every scene.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-event-03-001"
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-lore-maps",
      "categoryId": "os-lusiadas-lore-reading",
      "title": "Charts and places",
      "body": "The ocean and coastal charts use geographic coastlines. The gold sea road follows the voyage in broad strokes; exact open-sea positions are editorial.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-event-01-019"
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-lore-allegory-map",
      "categoryId": "os-lusiadas-lore-reading",
      "title": "The island and the divine charts",
      "body": "The island and divine diagrams are schematic because the poem gives no survey coordinates for those settings.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-event-09-021"
    },
    {
      "worldId": "os-lusiadas-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-lore-artwork",
      "categoryId": "os-lusiadas-lore-reading",
      "title": "Illustrations and chart sources",
      "body": "The cover, portraits, object studies, place views, and faction illustrations were generated for this edition with OpenAI imagegen in October 2026. They are interpretive images, not historical portraits or photographs. The five geographic charts use public-domain Natural Earth 1:10m land geometry and shaded relief; their voyage routes and three allegorical plans are editorial.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-event-01-001"
    }
  ],
