Notes":"Statius walks as the third traveller along the narrow edge."},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-snapshot-26-1-lustful","characterId":"purgatorio-char-lustful","eventId":"purgatorio-event-26-1","isAlive":false,"currentLocationMarkerId":"purgatorio-loc-lustTerrace","currentMapLayerId":"purgatorio-map-terraces","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":26.000098,"statusNotes":"The fiery companies exchange brief kisses, cry their opposed examples, and separate."},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-snapshot-26-1-guinicelli","characterId":"purgatorio-char-guinicelli","eventId":"purgatorio-event-26-1","isAlive":false,"currentLocationMarkerId":"purgatorio-loc-lustTerrace","currentMapLayerId":"purgatorio-map-terraces","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":26.000098,"statusNotes":"An unnamed penitent questions Dante and then waits while the two companies exchange greetings."},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-snapshot-26-2-dante","characterId":"purgatorio-char-dante","eventId":"purgatorio-event-26-2","isAlive":true,"currentLocationMarkerId":"purgatorio-loc-lustTerrace","currentMapLayerId":"purgatorio-map-terraces","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":26.000099,"statusNotes":"Dante explains that his living body has come here to overcome blindness and asks who is speaking."},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-snapshot-26-2-virgil","characterId":"purgatorio-char-virgil","eventId":"purgatorio-event-26-2","isAlive":false,"currentLocationMarkerId":"purgatorio-loc-lustTerrace","currentMapLayerId":"purgatorio-map-terraces","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":26.000099,"statusNotes":"Virgil 