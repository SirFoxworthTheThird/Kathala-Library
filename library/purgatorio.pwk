t":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-image-item-veil","mimeType":"image/png","url":"library/purgatorio/art/items/veil.png"},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-image-world-cover","mimeType":"image/png","url":"library/purgatorio/art/world.png"}],"relationships":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-relationship-dante-virgil","characterAId":"purgatorio-char-dante","characterBId":"purgatorio-char-virgil","label":"Traveller and guide","sentiment":"positive","description":"Virgil leads Dante through every law of the mountain within his reach.","strength":9,"isBidirectional":true,"startEventId":"purgatorio-event-1-1"},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-relationship-dante-statius","characterAId":"purgatorio-char-dante","characterBId":"purgatorio-char-statius","label":"Fellow pilgrims","sentiment":"positive","description":"Statius joins Dante on the upper ascent after completing his purification.","strength":7,"isBidirectional":true,"startEventId":"purgatorio-event-21-1"},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-relationship-dante-beatrice","characterAId":"purgatorio-char-dante","characterBId":"purgatorio-char-beatrice","label":"Penitent and beloved judge","sentiment":"neutral","description":"Dante meets Beatrice under the discipline of truthful confession.","strength":6,"isBidirectional":true,"startEventId":"purgatorio-event-30-1"},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-relationship-dante-matelda","characterAId":"purgatorio-char-dante","characterBId":"purgatorio-char-matelda","label":"Pilgrim and guide of Eden","sentiment":"positive","description":"Matelda receives Dante at the summit and teaches him the nature of the garden.","strength":8,"isBidirectional":true,"startEventId":"purgatorio-event-28-2"}],"relationshipSnapshots":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-relationship-state-1","relationshipId":"purgatorio-relationship-dante-virgil","eventId":"purgatorio-event-1-1","label":"Traveller and guide","sentiment":"positive","strength":9,"description":"Virgil leads Dante through every law of the mountain within his reach.","isActive":true,"sortKey":0},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-relationship-state-2","relationshipId":"purgatorio-relationship-dante-statius","eventId":"purgatorio-event-21-1","label":"Fellow pilgrims","sentiment":"positive","strength":7,"description":"Statius joins Dante on the upper ascent after completing his purification.","isActive":true,"sortKey":1},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-relationship-state-3","relationshipId":"purgatorio-relationship-dante-beatrice","eventId":"purgatorio-event-30-1","label":"Penitent and beloved judge","sentiment":"neutral","strength":6,"description":"Dante meets Beatrice under the discipline of truthful confession.","isActive":true,"sortKey":2},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-relationship-state-4","relationshipId":"purgatorio-relationship-dante-matelda","eventId":"purgatorio-event-28-2","label":"Pilgrim and guide of Eden","sentiment":"positive","strength":8,"description":"Matelda receives Dante at the summit and teaches him the nature of the garden.","isActive":true,"sortKey":3}],"plotThreads":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-thread-ascent","name":"The Ascent","description":"The travellers climb from the shore through successive disciplines toward restored freedom.","color":"#718a70","status":"complete","tags":[]}],"motifs":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-motif-ascent","name":"Stairs, Gates, and Height","description":"Every new height requires a threshold, an angelic permission, or a changed capacity in the climber.","color":"#78816a","tags":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-motif-speech","name":"Prayer, Song, and Testimony","description":"Souls teach through prayer, song, confession, history, and poetic recognition.","color":"#78816a","tags":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-motif-purification","name":"Burden and Release","description":"Stones, blindness, smoke, running, hunger, and fire turn moral disorder into bodily discipline.","color":"#78816a","tags":[]}],"loreCategories":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-category-edition","name":"Edition","description":"Reader-facing context grounded in Dante’s poem and the Longfellow edition.","color":"#71806c","sortOrder":0},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-category-journey","name":"Journey","description":"Reader-facing context grounded in Dante’s poem and the Longfellow edition.","color":"#71806c","sortOrder":1},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-category-form","name":"Poetic form","description":"Reader-facing context grounded in Dante’s poem and the Longfellow edition.","color":"#71806c","sortOrder":2}],"lorePages":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-source","categoryId":"purgatorio-lore-category-edition","title":"Text, translation, and rights","body":"This reading edition preserves all 33 cantos, 4,763 verse lines, and 37,410 words from Project Gutenberg eBook #1002, Henry Wadsworth Longfellow’s English translation of Purgatorio. Dante died in 1321 and Longfellow in 1882; Project Gutenberg marks the edition public domain in the United States. Downloaded source SHA-256: a84c5036f67ad127f1f39d144215bf116afb842c6b5a6d9a9dcd6f6d94cfdb60.","visibleFromEventId":"purgatorio-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-structure","categoryId":"purgatorio-lore-category-form","title":"Thirty-three cantos","body":"Purgatorio is the second canticle of the Divine Comedy and contains thirty-three cantos. Canto headings preserve Dante’s numbered structure; scene titles are reading aids paired with their passages.","visibleFromEventId":"purgatorio-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-terza","categoryId":"purgatorio-lore-category-form","title":"Terza rima in translation","body":"Dante’s poem is built from interlocking tercets. Longfellow preserves the three-line grouping and much of its syntax in unrhymed English verse; every retained source line remains separately displayed.","visibleFromEventId":"purgatorio-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-geography","categoryId":"purgatorio-lore-category-journey","title":"The mountain and its terraces","body":"The maps interpret an island mountain opposite Jerusalem: Ante-Purgatory below the gate, seven terraces ascending around it, and the earthly paradise at the summit. Their scale is editorial and serves the poem’s ordered movement.","visibleFromEventId":"purgatorio-event-3-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-chronology","categoryId":"purgatorio-lore-category-journey","title":"The Easter ascent","body":"The ascent continues directly from Inferno during Easter 1300. Fractional positions preserve scene order within the poem without claiming measured travel duration. Histories told by penitents remain speeches within the ascent rather than false simultaneous timelines.","visibleFromEventId":"purgatorio-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-lore-art","categoryId":"purgatorio-lore-category-edition","title":"Illustration provenance","body":"The world, portraits, objects, places, and topographic maps are original OpenAI ImageGen illustrations made for this edition in a mature late-medieval illuminated and engraved relief-map language.","visibleFromEventId":"purgatorio-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]}],"knowledgeFacts":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-fact-mountain","title":"The mountain permits ascent only by day","description":"Sordello explains that desire and movement upward fail after sunset.","readerLearnsAtEventId":"purgatorio-event-7-1","originEventId":"purgatorio-event-7-1","tags":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-fact-prayer","title":"Prayer can shorten the waiting of the penitent","description":"Virgil distinguishes a changed divine judgment from love fulfilling what justice requires.","readerLearnsAtEventId":"purgatorio-event-6-1","originEventId":"purgatorio-event-6-1","tags":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-fact-letters","title":"Seven marks measure the ascent","description":"The porter cuts seven letters upon Dante’s brow before opening the gate.","readerLearnsAtEventId":"purgatorio-event-9-3","originEventId":"purgatorio-event-9-3","tags":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-fact-earthquake","title":"The mountain trembles when a soul is free","description":"Statius explains that the mountain’s joyful shaking marks a completed purification.","readerLearnsAtEventId":"purgatorio-event-21-1","originEventId":"purgatorio-event-21-1","tags":[]},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-fact-matelda","title":"The lady of the forest is Matelda","description":"Beatrice names the woman who guides Dante through Lethe and Eunoe.","readerLearnsAtEventId":"purgatorio-event-31-2","originEventId":"purgatorio-event-31-2","tags":[]}],"knowledgeReveals":[],"factions":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-faction-pilgrims","name":"The Pilgrims","description":"Living and completed travellers climbing toward freedom.","color":"#74806b","tags":[],"coverImageId":null},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-faction-penitents","name":"The Penitent Souls","description":"Souls undergoing the mountain’s ordered disciplines.","color":"#74806b","tags":[],"coverImageId":null},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-faction-guardians","name":"Angelic Guardians","description":"Messengers who keep gates, remove marks, and direct each passage.","color":"#74806b","tags":[],"coverImageId":null},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-faction-pageant","name":"The Summit Procession","description":"Symbolic figures moving beside Lethe in the earthly paradise.","color":"#74806b","tags":[],"coverImageId":null}],"factionMemberships":[{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-membership-1","factionId":"purgatorio-faction-pilgrims","characterId":"purgatorio-char-dante","role":"Traveller","startEventId":"purgatorio-event-1-1","endEventId":null,"notes":""},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-membership-2","factionId":"purgatorio-faction-pilgrims","characterId":"purgatorio-char-virgil","role":"Traveller","startEventId":"purgatorio-event-1-1","endEventId":null,"notes":""},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-membership-3","factionId":"purgatorio-faction-pilgrims","characterId":"purgatorio-char-statius","role":"Traveller","startEventId":"purgatorio-event-21-1","endEventId":null,"notes":""},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-membership-4","factionId":"purgatorio-faction-penitents","characterId":"purgatorio-char-proud","role":"Penitent","startEventId":"purgatorio-event-10-3","endEventId":null,"notes":""},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-membership-5","factionId":"purgatorio-faction-penitents","characterId":"purgatorio-char-envious","role":"Penitent","startEventId":"purgatorio-event-13-1","endEventId":null,"notes":""},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-membership-6","factionId":"purgatorio-faction-penitents","characterId":"purgatorio-char-wrathful","role":"Penitent","startEventId":"purgatorio-event-15-3","endEventId":null,"notes":""},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-membership-7","factionId":"purgatorio-faction-penitents","characterId":"purgatorio-char-slothful","role":"Penitent","startEventId":"purgatorio-event-18-2","endEventId":null,"notes":""},{"worldId":"purgatorio-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"purgatorio-membership-8","factionId":"purgatorio-faction-penitents","c