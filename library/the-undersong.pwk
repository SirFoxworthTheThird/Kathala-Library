ough the bell and fabric of the church carry the note.","locationMarkerId":"undersong-loc-church","involvedCharacterIds":["undersong-char-silas"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["undersong-thread-withdrawal"],"motifIds":["undersong-motif-sound"],"sortOrder":20,"travelDays":18,"inWorldTime":58,"tension":3,"tags":["Source section: Congregation"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-silas","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-5-2-2","chapterId":"undersong-chapter-5","timelineId":"the-undersong-timeline","title":"A Congregation of One","description":"Agnes finds Silas preaching above an empty church while the village sits behind the Listener.","locationMarkerId":"undersong-loc-church","involvedCharacterIds":["undersong-char-silas","undersong-char-agnes"],"mentionedCharacterIds":["undersong-char-tom","undersong-char-harker"],"involvedItemIds":[],"threadIds":["undersong-thread-withdrawal"],"motifIds":["undersong-motif-sound"],"sortOrder":21,"travelDays":3,"inWorldTime":61,"tension":4,"tags":["Source section: Congregation"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-silas","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-5-3-1","chapterId":"undersong-chapter-5","timelineId":"the-undersong-timeline","title":"The Watch Kept Dry","description":"Wren asks for Elias’s stopped watch, and its hands begin moving inside his grasp.","locationMarkerId":"undersong-loc-surgery","involvedCharacterIds":["undersong-char-ezra","undersong-char-wren"],"mentionedCharacterIds":["undersong-char-agnes","undersong-char-tom","undersong-char-pell"],"involvedItemIds":["undersong-item-watch"],"threadIds":["undersong-thread-withdrawal","undersong-thread-records"],"motifIds":["undersong-motif-objects"],"sortOrder":22,"travelDays":4,"inWorldTime":