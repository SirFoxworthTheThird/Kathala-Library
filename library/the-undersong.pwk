pter-6","timelineId":"the-undersong-timeline","title":"The Handwriting in the Ledger","description":"Agnes watches an unfamiliar hand use her own body to write the coming low tide.","locationMarkerId":"undersong-loc-school","involvedCharacterIds":["undersong-char-agnes"],"mentionedCharacterIds":[],"involvedItemIds":["undersong-item-dream-ledger"],"threadIds":["undersong-thread-withdrawal","undersong-thread-records","undersong-thread-return"],"motifIds":["undersong-motif-tides","undersong-motif-objects","undersong-motif-writing"],"sortOrder":25,"travelDays":1.5,"inWorldTime":68,"tension":5,"tags":["Source section: Agnes Alone"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-agnes","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-6-3-2","chapterId":"undersong-chapter-6","timelineId":"the-undersong-timeline","title":"The Parcel for Ezra","description":"Agnes entrusts the wrapped Ledger to Ezra and makes a promise that leaves neither of them certain of return.","locationMarkerId":"undersong-loc-school","involvedCharacterIds":["undersong-char-agnes","undersong-char-ezra"],"mentionedCharacterIds":["undersong-char-tom"],"involvedItemIds":["undersong-item-dream-ledger"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-objects","undersong-motif-writing"],"sortOrder":26,"travelDays":0.5,"inWorldTime":68.5,"tension":4,"tags":["Source section: Agnes Alone"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-agnes","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-7-1-1","chapterId":"undersong-chapter-7","timelineId":"the-undersong-timeline","title":"The Road Will Not Let Them Pass","description":"The sea withdraws, the road fills with returning villagers, and Ezra’s horse refuses the boundary.","locationMarkerId":"undersong-loc-whitby-road","involvedCharacterIds":["undersong-char-ezra","undersong-char-ruth"],"mentionedCharacterIds":["undersong-char-agnes","undersong-char-tom"],"involvedItemIds":["undersong-item-dream-ledger"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-tides","undersong-motif-objects"],"sortOrder":27,"travelDays":0.6670000000000016,"inWorldTime":69.167,"tension":5,"tags":["Source section: The Sea Withdraws"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-7-2-1","chapterId":"undersong-chapter-7","timelineId":"the-undersong-timeline","title":"The Children Go Down","description":"Thirty-eight pupils walk in school order toward the exposed seabed with Agnes beside them.","locationMarkerId":"undersong-loc-staithe","involvedCharacterIds":["undersong-char-ezra","undersong-char-agnes","undersong-char-annie","undersong-char-joseph"],"mentionedCharacterIds":["undersong-char-tom"],"involvedItemIds":["undersong-item-dream-ledger"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-tides","undersong-motif-objects"],"sortOrder":28,"travelDays":0.3329999999999984,"inWorldTime":69.5,"tension":5,"tags":["Source section: Agnes Walks Out"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-7-2-2","chapterId":"undersong-chapter-7","timelineId":"the-undersong-timeline","title":"The School Command","description":"Agnes turns the children home with a practiced command, then walks alone toward the standing sea.","locationMarkerId":"undersong-loc-long-scar","involvedCharacterIds":["undersong-char-ezra","undersong-char-agnes","undersong-char-tom","undersong-char-annie","undersong-char-joseph"],"mentionedCharacterIds":["undersong-char-pell"],"involvedItemIds":["undersong-item-dream-ledger"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-tides","undersong-motif-objects"],"sortOrder":29,"travelDays":0.125,"inWorldTime":69.625,"tension":5,"tags":["Source section: Agnes Walks Out"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-7-3-1","chapterId":"undersong-chapter-7","timelineId":"the-undersong-timeline","title":"Silas Speaks Without the Pulpit","description":"Silas tells a full church that the world may be unwatched before surrendering the stone to the Listener.","locationMarkerId":"undersong-loc-church","involvedCharacterIds":["undersong-char-silas","undersong-char-ezra","undersong-char-ruth","undersong-char-tom"],"mentionedCharacterIds":[],"involvedItemIds":["undersong-item-dark-stone","undersong-item-dream-ledger"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-sound","undersong-motif-objects"],"sortOrder":30,"travelDays":0.125,"inWorldTime":69.75,"tension":5,"tags":["Source section: The Last Sermon"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-silas","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-7-4-1","chapterId":"undersong-chapter-7","timelineId":"the-undersong-timeline","title":"Hollin Staithe Empties","description":"The road opens and the surviving village departs by cart, foot and company lorry.","locationMarkerId":"undersong-loc-village-square","involvedCharacterIds":["undersong-char-ezra","undersong-char-harker","undersong-char-annie"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":[],"sortOrder":31,"travelDays":0.5,"inWorldTime":70.25,"tension":4,"tags":["Source section: Evacuation"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-7-4-2","chapterId":"undersong-chapter-7","timelineId":"the-undersong-timeline","title":"The Empty Schoolhouse","description":"Ezra finds Agnes’s register open and cannot cross the schoolroom threshold.","locationMarkerId":"undersong-loc-school","involvedCharacterIds":["undersong-char-ezra"],"mentionedCharacterIds":["undersong-char-agnes","undersong-char-silas"],"involvedItemIds":[],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":[],"sortOrder":32,"travelDays":0.125,"inWorldTime":70.375,"tension":4,"tags":["Source section: Evacuation"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-7-4-3","chapterId":"undersong-chapter-7","timelineId":"the-undersong-timeline","title":"Ruth Keeps Her Place","description":"Ruth refuses the final lorry and waits where she can still see her son on the scar.","locationMarkerId":"undersong-loc-hesketh-house","involvedCharacterIds":["undersong-char-ezra","undersong-char-ruth"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-tides"],"sortOrder":33,"travelDays":0.125,"inWorldTime":70.5,"tension":4,"tags":["Source section: Evacuation"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-8-1-1","chapterId":"undersong-chapter-8","timelineId":"the-undersong-timeline","title":"Silas Leaves Footprints","description":"Ezra reads the tracks leading from the empty church past the scar toward the water, then returns to lock the church.","locationMarkerId":"undersong-loc-churchyard","involvedCharacterIds":["undersong-char-ezra"],"mentionedCharacterIds":["undersong-char-tom","undersong-char-ruth","undersong-char-silas"],"involvedItemIds":[],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-tides"],"sortOrder":34,"travelDays":0.75,"inWorldTime":71.25,"tension":5,"tags":["Source section: The Empty Village"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-8-1-2","chapterId":"undersong-chapter-8","timelineId":"the-undersong-timeline","title":"Three People Left","description":"Ezra tends Ruth and the abandoned houses while the unopened Ledger waits on his desk.","locationMarkerId":"undersong-loc-hesketh-house","involvedCharacterIds":["undersong-char-ezra","undersong-char-ruth"],"mentionedCharacterIds":["undersong-char-agnes","undersong-char-annie"],"involvedItemIds":["undersong-item-dream-ledger","undersong-item-drawings"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-objects","undersong-motif-writing"],"sortOrder":35,"travelDays":0.25,"inWorldTime":71.5,"tension":4,"tags":["Source section: The Empty Village"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-8-1-3","chapterId":"undersong-chapter-8","timelineId":"the-undersong-timeline","title":"Ezra Goes to the Listener","description":"At the scar, the Listener speaks once for the mother he can barely hear.","locationMarkerId":"undersong-loc-long-scar","involvedCharacterIds":["undersong-char-ezra","undersong-char-tom"],"mentionedCharacterIds":[],"involvedItemIds":["undersong-item-dark-stone"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-sound","undersong-motif-tides","undersong-motif-objects"],"sortOrder":36,"travelDays":1.75,"inWorldTime":73.25,"tension":4,"tags":["Source section: The Empty Village"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-8-2-1","chapterId":"undersong-chapter-8","timelineId":"the-undersong-timeline","title":"The Great Low Tide","description":"Elias approaches across the seabed and leads the Listener north along the cliff.","locationMarkerId":"undersong-loc-long-scar","involvedCharacterIds":["undersong-char-ezra","undersong-char-tom","undersong-char-wren"],"mentionedCharacterIds":["undersong-char-agnes"],"involvedItemIds":["undersong-item-dark-stone","undersong-item-watch"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-sound","undersong-motif-tides","undersong-motif-objects"],"sortOrder":37,"travelDays":0.5,"inWorldTime":73.75,"tension":5,"tags":["Source section: Into the Hollow"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-8-2-2","chapterId":"undersong-chapter-8","timelineId":"the-undersong-timeline","title":"The Door in the Cliff","description":"At the reopened threshold, the Listener returns the stone and walks into the hollow with Elias.","locationMarkerId":"undersong-loc-hollow","involvedCharacterIds":["undersong-char-ezra","undersong-char-tom","undersong-char-wren"],"mentionedCharacterIds":[],"involvedItemIds":["undersong-item-dark-stone","undersong-item-watch"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-sound","undersong-motif-objects"],"sortOrder":38,"travelDays":0.125,"inWorldTime":73.875,"tension":5,"tags":["Source section: Into the Hollow"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-8-3-1","chapterId":"undersong-chapter-8","timelineId":"the-undersong-timeline","title":"The Sea Returns","description":"The bay fills in a breath and Ezra finds the ordinary black water restored.","locationMarkerId":"undersong-loc-surgery","involvedCharacterIds":["undersong-char-ezra"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-tides"],"sortOrder":39,"travelDays":0.26200000000000045,"inWorldTime":74.137,"tension":4,"tags":["Source section: What Ezra Wrote"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-8-3-2","chapterId":"undersong-chapter-8","timelineId":"the-undersong-timeline","title":"Ruth’s Open Door","description":"Ruth’s empty kitchen and wet footprints tell Ezra what happened without giving him a body to follow.","locationMarkerId":"undersong-loc-hesketh-house","involvedCharacterIds":["undersong-char-ezra"],"mentionedCharacterIds":["undersong-char-ruth"],"involvedItemIds":[],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":[],"sortOrder":40,"travelDays":0.23799999999999955,"inWorldTime":74.375,"tension":4,"tags":["Source section: What Ezra Wrote"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-event-8-3-3","chapterId":"undersong-chapter-8","timelineId":"the-undersong-timeline","title":"A Case History for Whoever Comes Next","description":"Ezra completes Agnes’s record, preserves the watch, and hears her command reduced to a fault in the continuing note.","locationMarkerId":"undersong-loc-surgery","involvedCharacterIds":["undersong-char-ezra"],"mentionedCharacterIds":["undersong-char-agnes","undersong-char-tom","undersong-char-ruth","undersong-char-pell","undersong-char-wren","undersong-char-silas","undersong-char-annie","undersong-char-joseph"],"involvedItemIds":["undersong-item-dream-ledger","undersong-item-watch","undersong-item-drawings"],"threadIds":["undersong-thread-withdrawal","undersong-thread-return"],"motifIds":["undersong-motif-sound","undersong-motif-objects","undersong-motif-writing"],"sortOrder":41,"travelDays":10.375,"inWorldTime":84.75,"tension":5,"tags":["Source section: What Ezra Wrote"],"structureBeat":null,"status":"final","povCharacterId":"undersong-char-ezra","isFlashback":false}],"sceneTexts":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-1-1-1","eventId":"undersong-event-1-1-1","text":"The sea had gone out further than it ought to have done, and Ezra Coyle stood at the window of the surgery on Cliff Row and watched it go. He had lived above the scaur at Hollin Staithe for fifty-one years and he knew the tables as well as any coble-man; he knew that the ebb on the fourteenth of September should have left the Long Scar bare to the second marker post and no further. It was past the third now. The weed lay flat and black on rock that had not seen the air since he was a boy, and the gulls would not go down to it.\n\nHe made a note of it in the margin of his daybook, under the line for Mrs Ainsley's chest, because he had been taught to write down anything that did not agree with what he expected. Then he crossed it out, because it was not a medical observation, and a man who kept a medical daybook ought to keep to medicine.\n\nBelow it, before he shut the book, he found himself writing that the school bell had rung four minutes late that afternoon. Agnes Merriman kept it to the minute, even in weather, and Ezra had noticed this without ever deciding to notice it. He crossed that out too.","wordCount":221},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-1-1-2","eventId":"undersong-event-1-1-2","text":"The knock came a little after four. Ruth Hesketh stood on the step with her shawl crossed over her chest and her hands knotted into it, and she did not come in when he opened the door.\n\n\"It's our Tom,\" she said. \"He's bleeding from his ears, Doctor. Both of them. He come up from the drift at dinner and he's been sat at the table since, and it'll not stop.\"\n\n\"Has he had a blow? A fall of stone?\"\n\n\"He says not. He says it were the noise.\"\n\nEzra fetched his bag. He did not ask what noise, because the drift at Saltwick was a noisy place, all hammers and the pump engine and the trams, and he had dressed a hundred ears for it. But Ruth Hesketh had buried a husband out of that drift, and she was not a woman who came for the doctor over a little blood, and she had said *the noise* the way the old women at chapel said *the Lord*.\n\nThey walked down Cliff Row together into the wind. The fishing cobles were drawn up high on the slipway, further up than he had seen them in years, and the men who should have been mending nets were standing at the top of the slip in a loose line, looking out at the bare scar and not talking.\n\n\"They say it's a neap,\" Ruth said, though it was not a neap and she knew it was not.\n\n\"It's a big ebb,\" Ezra said. \"It will come back.\"\n\nHe thought of his brother then, as he always did when the sea did anything at all. Twenty years since the *Grace Ainsley* went out through the surf to the collier aground on the Scar, and came back without Elias Coyle in her, as the inquest put it; twenty years of the sea doing ordinary things and Ezra flinching from each of them as if it were a hand raised. He had stopped expecting the sea to give his brother back. He had not stopped expecting it to say something.\n\nAt the Heskeths' door Ruth stopped with her hand on the latch.\n\n\"He keeps saying it's not finished,\" she said. \"The noise. He says it's still going on, only lower than he can hear it now. He says it's like standing on a bell.\"\n\nEzra said that he would look at the ears, and she let him in.","wordCount":403},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-1-2-1","eventId":"undersong-event-1-2-1","text":"The fourth heading of the Saltwick drift ran out under the sea at a slope of one in nine, and at the face of it, eleven hundred yards from daylight, Tom Hesketh put his ear to the rock and heard it breathing.\n\nHe did not say so. He was nineteen and had been underground since he was twelve, and he knew what the men said about lads who heard things in the stone. He said instead, \"Mr Pell, there's water behind this,\" because water was a thing a man was allowed to hear.\n\nJonah Pell came up the heading with the lamp held low. He was the manager and he did not need to be at the face, but he had been at the face every shift for a fortnight, since the seam had turned and the stone had begun to come away clean and dark and faintly warm, like the side of a sleeping beast. He put his own ear to the rock and stayed there a long time.\n\n\"That's not water,\" he said at last.\n\n\"No, sir.\"\n\n\"Get the bar.\"\n\nThey worked it between them, Tom with the bar and Pell with the pick, and the stone did not fracture the way ironstone fractures. It came away in plates, very thin, each with a sheen on it like oil on a puddle, and behind each plate was another. After the ninth or tenth Tom stopped counting. The lamp flame had begun to lean. It leaned towards the face, steadily, as if the air of the whole drift were being drawn through the hole they were making, and yet there was no draught on his face, and his sweat did not cool.\n\nThe last plate fell inward. It did not land. Tom listened for it to strike and it did not strike, and the sound of it not striking went on and on, longer than any fall could be, until it was not a silence but a kind of note.\n\nPell held the lamp to the hole. The light went into it and did not come back. That was the thing Tom would remember, when he could not remember his mother's face: that the light went in and there was nothing for it to fall on, no wall, no floor, no water, and yet there was a sense of distance, of a great extent, as when you stand on the cliff at night and know without seeing that the sea goes on for ever.\n\n\"It's bigger than the cliff,\" Tom said. He did not know why he said it. The hole was no wider than his hand. \"Mr Pell, it's bigger than the whole cliff.\"\n\nPell did not answer. He had taken a piece of the dark stone from the floor of the heading, a fragment the size of a hen's egg, and he turned it over in his fingers and then, without seeming to know he did it, gave it to Tom.\n\n\"Take that up,\" he said. \"Show nobody.\"\n\nTom put it in the breast of his shirt. It was warm, and it hummed against his ribs very faintly, and the hum was the same note as the falling plate that had not landed. Behind them, in the dark of the heading, the pump engine stopped, and in the new quiet both men heard it plainly: something far below them, below the sea, below the bottom of the sea, turning over in its sleep.\n\nThen his ears began to bleed, and Pell took him up.","wordCount":587},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-1-3-1","eventId":"undersong-event-1-3-1","text":"On the Friday Agnes Merriman set the infants to draw what they had done in the holidays, which was a thing she did every September and which produced, every September, forty pictures of cobles, cows, the Whitby train and grandmothers. She sat at the high desk while they worked and wrote up the register, and listened to the sea through the open window, and did not look at the drawings until the bell.\n\nThe first was by Annie Ward, who was six. It was a shore. Agnes knew it at once for a shore because of the line across the page, sand below and sea above, but the sea was drawn in black crayon pressed so hard the paper had torn, and above the sea, where the sky ought to have been, Annie had drawn the sea again.\n\nThe second was by Joseph Ainsley, who was seven and drew only engines. It was a shore with the sea above it.\n\nShe went through them standing up. She went through them twice. Of the thirty-eight children present that Friday, thirty-one had drawn a shore with the sea above it. Some had drawn a figure on the sand, very small, with its face turned up. Some had drawn, low on the page, something that might have been a church tower or might have been a finger. None of them had drawn the Whitby train.\n\nShe kept them behind, which she never did on a Friday, and asked them, one at a time, gently, where they had seen it.\n\n\"In bed, Miss.\"\n\n\"When you were asleep?\"\n\n\"When I were asleep, Miss. Everybody goes.\"\n\n\"Goes where, Annie?\"\n\nAnnie Ward looked at her with a patience that was not a child's patience, and said, \"Down the shore, Miss. Where it's the right way up.\"","wordCount":301},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-1-3-2","eventId":"undersong-event-1-3-2","text":"Agnes let them go. She stood in the empty schoolroom with the thirty-one drawings fanned across the desk and the light going brown on the whitewash, and for the first time since she had come to Hollin Staithe from Leeds, eleven years ago, she was afraid of the village and not merely lonely in it.\n\nShe did the only thing she knew how to do with a thing she did not understand. She took the new exercise book from the cupboard, the one with the marbled cover that she had been keeping for the Standard Four compositions, and she wrote on the first page in her best copperplate *Dreams of the Infant Class, from 15th September 1911*, and under it she began to write down, child by child, exactly what each of them had told her. She wrote until it was too dark to see the lines. She did not light the lamp. Sitting there, she found she did not want to see the window, or what the window might show of the shore.","wordCount":175},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-1-3-3","eventId":"undersong-event-1-3-3","text":"On Monday, during arithmetic, the room filled with the ordinary noise of children: slates tapping, boots scraping, thirty-eight voices speaking over one another while Agnes wrote sums on the board.\n\nShe turned from the blackboard and clapped twice.\n\nIt was not a loud sound, but they heard it. The room stopped. Slates came down. Feet went still. Even Joseph Ainsley, who had been whispering behind his slate, brought his eyes round to her.\n\n\"Hands flat,\" Agnes said. \"Eyes here.\"\n\nThey obeyed without fear or hurry. She had taught them the signal in their first week at school, and by now they answered it before they had time to think. It saved her throat. After a moment she turned back to the sums, and the noise took up again where it had left off.","wordCount":134},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-1-3-4","eventId":"undersong-event-1-3-4","text":"When she walked home along the top road the sea was in again, quite ordinary, slapping at the foot of the scaur. But the tide was an hour and ten minutes early by the almanac, and she wrote that down too, at her kitchen table, in the back of the book.\n\nThen she sat a long time with the pen in her hand, and did not go to bed, because she did not want to go down the shore.","wordCount":79},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-2-1-1","eventId":"undersong-event-2-1-1","text":"The man was standing at the lifeboat memorial when Ezra came up through the lychgate on the Sunday, and he was reading the names. Strangers did that; the memorial was the only thing in Hollin Staithe a stranger would walk up the hill for. But strangers read the names the way you read a list in a newspaper, and this man was reading them the way you read a letter, slowly, his lips moving, one hand flat against the cold granite as if to feel for a pulse in it.\n\nHe was tall and very thin and his coat was too good for the coast. His hair was white, though his face did not seem old so much as worn smooth, like a step. When he heard Ezra on the path he took his hand away from the stone, and Ezra saw which name it had been resting on, because there was a clean mark in the salt bloom where the palm had been, and the name under the clean mark was his brother's.\n\n\"You knew one of them,\" Ezra said.\n\n\"No.\" The stranger turned. His eyes were very pale, the grey of water in a bucket. \"No, I'm afraid not. I make a habit of it. Wherever the work takes me I read the drowned. Somebody ought to.\" He held out his hand. \"Wren. Abel Wren. I'm here for the Admiralty, on a matter of soundings.\"\n\nHis hand was cold and dry and his grip was oddly careful, as if he had been told how hard to hold a hand and was following the instruction. Ezra gave his name and his trade, and Wren said, \"Coyle,\" and looked once more at the stone, and said nothing else about it.\n\nSilas Tunstall came out of the vestry then in his surplice, with the look he always had on a Sunday of a man going in to a difficult interview, and Ezra introduced them. The vicar was pleased; the vicar was always pleased by anyone from outside, because outside meant the Church of England was still a going concern somewhere. He asked about the Admiralty and Wren answered him pleasantly and said nothing at all.\n\n\"Soundings,\" Silas said. \"Of the bay? We've had the strangest tides.\"\n\n\"So I'm told,\" said Wren. \"That's rather why I'm here.\"\n\nThey went in to the service. Wren sat at the back, under the board with the bell-ringers' names, and did not kneel and did not sing, and when Ezra looked round during the second lesson the stranger was not watching the vicar or the window or the congregation but the floor, the flags of the nave, with his head a little on one side. Listening. As Tom Hesketh had sat at his mother's table and listened, with the blood running down into his collar.\n\nAfter the blessing Ezra went back to the memorial alone. The mark of the man's palm was still there in the salt on the granite, though the wind off the sea should have dried it in a minute. It was over Elias's name exactly. It had five fingers, as a hand should, and Ezra stood a long while in the cold trying to persuade himself that the fingers were not too long.","wordCount":542},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-2-2-1","eventId":"undersong-event-2-2-1","text":"Wren came out to the drift on the Tuesday with a wooden case on a handcart and two Admiralty men to push it, and Jonah Pell met him at the adit mouth with his arms folded. He had not wanted the Admiralty. He had not wanted anyone. For nine days he had kept the fourth heading boarded off and told the men it was firedamp, and every night he had gone down alone with a lamp and sat at the boards and listened.\n\n\"You'll have heard it, then,\" Wren said, before Pell had said a word. \"Since the breaking-in. Lower than you can hear, but you've been hearing it.\"\n\nPell unfolded his arms.\n\nThe case held an instrument of brass and gutta-percha, a squat bell-mouthed thing on a tripod with a pair of earpieces on long tubes and a dial behind glass whose needle did not sit at zero but trembled somewhere just above it. Wren said it was a hydrophone, of the sort the Navy was trying for listening to submarines, and that this one had been made for a different purpose, and he did not say what the purpose was. He set it up at the boards himself. He asked for Tom Hesketh by name.\n\nThe boy had been back at work four days, against the doctor's advice, his ears packed with lint. He came up the heading with his lamp and stopped well short of the boards, the way a dog stops short of a grave.\n\n\"You were the first to hear it,\" Wren said. \"You'll be the best at it. Put these on.\"\n\nTom put on the earpieces. For a while his face showed nothing, and then it showed something Pell had seen once before, on a man pinned under a fall of stone who had stopped feeling his legs: a kind of terrible relief.\n\n\"It's singing,\" Tom said. \"It's not words. It's like the chapel, Mr Pell, when they all hold the last note. Only it doesn't stop to breathe.\"\n\nWren took the earpieces from him gently and handed them to Pell.\n\nJonah Pell listened for a long time. When he took them off he was grey under the dirt, and he sat down on an upturned tub and wiped his mouth.\n\n\"How long,\" he said, \"has the Admiralty known?\"\n\n\"The *Grace Ainsley* went down in eighteen ninety-one,\" Wren said. \"The night of the great storm, you'll remember. The coastguard at Ravenscar logged a sound under the water that night, lasting four hours, that they could not account for. It was written up and sent to London and London put it in a drawer. I have been reading that drawer for some years.\" He laid a hand on the brass bell of the instrument. \"It's yours, Mr Pell. I'm leaving it with you. Listen at the boards every hour and write down what the needle does. Don't let the men break through any further.\"\n\n\"And if it gets louder?\"\n\nWren looked at the boarded heading for a while.\n\n\"Then you'll be the first man in England to know something,\" he said. \"I'd make a note of that, too.\"","wordCount":527},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-2-3-1","eventId":"undersong-event-2-3-1","text":"On the night of the equinox the whole village went down to the staithe to see the spring tide come in, because the almanac said it would be the highest in thirty years, and it did not come.\n\nEzra stood with Agnes Merriman at the top of the slipway with the lanterns of the fishermen strung out along the shore below them. The moon was full and very bright and stood almost overhead, and under it the sea was flat as slate and a mile away. A mile. The Long Scar was dry to its tip. Beyond it lay rock that no one living had seen, ridged and pale in the moonlight like the roof of a mouth, and beyond that a black line that was the water, and the water was not moving.\n\n\"It should be on the slip,\" Agnes said. \"It should be over our feet. Look at the moon, Ezra.\"\n\n\"I'm looking at it.\"\n\n\"It's pulling. It has to be pulling. That's what it is for.\"\n\nChildren were running out across the wet sand towards the scar in twos and threes, shrieking, as children will at anything enormous, and their mothers were calling them back without much conviction. Old Harker the coble-man had walked out further than anyone, to where the sand gave way to the pale ridged rock, and was standing there with his lantern held up and his back to the village, quite still.\n\nAgnes had the marbled exercise book under her arm. She had shown it to Ezra in the schoolroom that afternoon, page after page in her careful copperplate, and he had read it as he read a fever chart, looking for the line that would tell him what kind of thing he was dealing with. He had not found it. He had found Annie Ward, six, saying *it's the right way up down there*, and Joseph Ainsley, seven, saying *the big one is asleep but it's turning over*, and a dozen children saying in a dozen ways that they were not frightened when they went, only when they came back.\n\n\"Last night the tide was in at the wrong time and tonight it isn't in at all,\" she said. \"I've written down every tide since the fifteenth. They don't agree with the almanac and they don't agree with each other. It isn't the moon any more, Ezra. Something else has hold of it.\"\n\nHe wanted to tell her that tides were complicated, that there were winds and surges and the shape of the seabed to consider. He had said such things to Ruth Hesketh. He found he could not say them to Agnes, who had been in the village eleven years and whom he had spoken to perhaps forty times, and whom he had liked, he realised now, every one of those forty times, without once doing anything about it.\n\n\"Yes,\" he said. \"I think so too.\"\n\nOut on the rock Harker lowered his lantern. Then, slowly, as if he had been called, he knelt and put his ear to the stone.\n\nThey walked back up the hill together without speaking. At her gate she touched his sleeve. It was the first time either had touched the other.\n\n\"I'm frightened to sleep,\" she said. \"Is that a medical condition?\"\n\n\"It's the commonest one there is,\" Ezra said, and stood at the gate until her lamp was lit.","wordCount":566},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-3-1-1","eventId":"undersong-event-3-1-1","text":"Silas Tunstall said Evensong to an empty church most weeknights and had long ago stopped minding. He said it for the dead on the memorial, he told himself, and for the bell-ringers on the board, and for God, who was presumably obliged to attend. On the Thursday after the equinox he had got as far as the Magnificat when the door at the west end opened and Tom Hesketh came in with his mother behind him.\n\nRuth stopped in the last pew. The boy came on up the nave alone, walking carefully, with one hand pressed flat to his chest as if he had a pain there, and he did not take his cap off.\n\n\"You'll want to take your cap off in church, Tom,\" Silas said, gently, because the boy was ill; you could see that from the pulpit.\n\nTom took out what he had been holding against his chest and laid it on the step of the chancel. It was a piece of stone about the size of an egg, very dark, with a sheen on it like a beetle's back. In the quiet of the church Silas heard it at once. It was not loud. It was not, he would think afterwards, a sound at all, so much as a pressure at the back of the ears, the feeling of a held note that has been going on so long you have stopped knowing you hear it.\n\n\"Make it stop, Vicar,\" Tom said. \"Mr Pell said show nobody, but you're not nobody. You're the church. Make it stop.\"\n\nSilas came down from the stall. He was fifty-eight and had been ordained thirty-four years and had never been asked to do anything by a parishioner that he could not at least pretend to. He picked the stone up. It was warm. Its note went up his arm into his teeth.\n\n\"Where did you get this?\"\n\n\"Down the fourth heading. It's off the wall of it. The inside wall.\" The boy's eyes were not on the stone or on the vicar but on the floor of the chancel, as Wren's had been on the Sunday. \"It's a bit of the inside, Vicar. It's still joined on, only not by anything. It goes back down.\"\n\nSilas said a prayer over it, because that was what there was to do. He said the Lord's Prayer and the collect for aid against all perils and part of the Commination, which he had never said aloud in his life, and the note did not change. Ruth Hesketh in the back pew had begun to cry, very quietly, the way women cried in that village, with her mouth shut.\n\nAt last he carried the stone to the font at the west end, and lifted the oak cover, and laid it in the bowl, under the water that had christened every child in Hollin Staithe for six hundred years.\n\nThe note went on. If anything it was clearer, as a bell is clearer under water.\n\n\"There,\" he said. \"It's in God's keeping now, Tom. Leave it with Him.\"\n\nThe boy looked at the font for a long moment and then, for the first time since he had come in, at Silas.\n\n\"He's not listening, Vicar,\" he said. \"He's not the one that's listening.\"\n\nThey went out. Silas finished Evensong alone, and when he came to the Nunc Dimittis he found he could not remember the words of it, though he had said them every night for thirty-four years.","wordCount":587},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-3-2-1","eventId":"undersong-event-3-2-1","text":"Pell would not have let him down, Ezra thought, if Pell had still been entirely himself. But the manager had not slept in a bed for a week, and the eyes he turned on the doctor at the adit mouth had the glaze of a man listening to two conversations at once, and when Wren said, \"Let him come; he should see it,\" Pell only nodded and handed Ezra a lamp.\n\nThe fourth heading was boarded off forty yards back from the face, rough planks spiked into the timbering, with a gap at the top a man could climb through. The hydrophone sat on its tripod before the boards like a priest before a rood screen. Beyond the boards the air was warm and smelled of nothing, which was the first wrong thing; a mine smells of everything.\n\nThey went over the boards one at a time. The face was as Pell had described it: the dark stone come away in plates, and in the middle of it a hole. It was no longer the width of a hand. It was the width of a door, and its edges were smooth, as if it had not been broken open but had opened.\n\nWren went through first. Then Pell. Then Ezra, with the lamp held out in front of him, through the door in the rock and into the Hollow.\n\nHe had been told the light would not come back, and it did not; he had been told there would be no floor, and there was a floor, but it was not stone and not sand and his boots made no sound on it. Those were things he could have borne. What he could not bear, what he would wake from for the rest of his life, was the sense of the size of the place. He could see nothing. The lamp lit his own hand and his own boots and a yard of featureless dark. And yet he knew, as surely as he had ever known anything, that the space around him was larger than the cliff it was inside; larger than the bay; larger than the North Sea above it. Larger, in some direction he had no word for, than the sky.\n\n\"Don't go further than the lamp,\" Wren said softly, close at his ear. \"It's not that it's dangerous. It's that you'll stop wanting to come back.\"\n\nThere was no sound. That was the second wrong thing. He had expected the note Tom had described, the held chord, and it was not there; and then he understood that it was there, that he was inside it, that the silence in the Hollow was the note heard from within, as a man inside a bell would hear nothing but feel his bones hum.\n\nFar off, unmeasurably far, something shifted. Not towards them. It was not interested in them. It was turning over, very slowly, as Tom had said, the way a sleeper turns in a bed, and the turning took the whole of the dark with it, and Ezra felt his inner ear tilt and his stomach rise as if the floor of the world had become, for one second, the wall of it.\n\nPell made a sound like a laugh.\n\nWren took them both by the arm and walked them backwards out of the door in the rock, and over the boards, and down the heading, and he did not let go until they could see daylight.","wordCount":579},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-3-3-1","eventId":"undersong-event-3-3-1","text":"They brought Tom Hesketh to the surgery on the Saturday because he had stopped eating and Ruth could not hold him in the house. He had walked out three nights running in his nightshirt, down Cliff Row and onto the scar, and on the third night they had found him lying flat on the exposed seabed a quarter of a mile out, with his ear to the rock and his eyes open, and the tide nowhere.\n\nEzra put him in the back room where he kept the patients he wanted to watch, and gave him bromide, and sat with him. Ruth sat on the other side of the bed with her hands in her lap.\n\nThe fever was real. His temperature stood at a hundred and three and would not come down, and the pulse in his wrist was very fast and very even, so even that Ezra counted it three times against his watch, because it did not vary by one beat in the minute, and a living pulse always varies. He did not tell Ruth that.\n\nTowards midnight the boy began to talk.\n\nHe talked for a long time, in a low, reasonable voice, as if dictating. Ruth kept saying \"Hush, Tommy, hush now,\" and Ezra let him go on, because he had sat at enough bedsides to know that the things people say in fever are sometimes the only true things they ever say.\n\n\"It doesn't know we're here,\" Tom said. \"That's what nobody understands. They think it's coming up for us. It's not coming up for anything. It's turning over. When you turn over in your sleep you don't know about the ants under the mattress. We're the ants under the mattress, Mam. We're not even that. We're the shape the mattress makes.\"\n\n\"Hush, love.\"\n\n\"Mr Wren knows. He's been down before. He's been down a long time.\" The boy's eyes opened and rested on Ezra without seeing him. \"He's wet all the way through, Doctor. Have you noticed? He's been wet for twenty years.\"\n\nEzra felt the skin on his arms tighten.\n\n\"Who told you that, Tom?\"\n\n\"Nobody tells you. You just hear it. Everybody's in it. All the drowned. That's what the singing is, partly. It's not them singing. It's them being sung.\" He frowned. \"Your brother's not in it, though. I looked. That's funny. All the rest of the *Grace Ainsley* are, but not him.\"\n\nRuth Hesketh stood up so suddenly that her chair went over.\n\n\"Don't you talk like that,\" she said. \"Don't you talk like that to the doctor, about his own brother, Thomas Hesketh. You stop it. You stop listening to it.\" She was shaking. \"I lost your father to that drift and I'll not lose you to it as well. You come back up out of it. You hear me? You come back up.\"\n\nThe boy looked at her with a polite, enormous patience, as Annie Ward had looked at Agnes in the schoolroom.\n\n\"I can't hear you very well, Mam,\" he said. \"It's very loud.\"\n\nRuth went out into the passage and Ezra heard her being sick. When she came back she did not sit down again on that side of the bed. She stood in the door, and stayed there until morning, and did not touch her son.","wordCount":551},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-3-4-1","eventId":"undersong-event-3-4-1","text":"Agnes had moved the book from the schoolroom to her own house, and then, after the night she woke to find she had written three pages in it in her sleep, back to the schoolroom again, where it lived in the cupboard with the chalk and the canes. She brought it out for Ezra on the Monday after the children had gone, and laid it on the high desk between them like an exhibit.\n\n\"I want you to read the last fortnight,\" she said. \"Not my summaries. What they said.\"\n\nHe read. The handwriting changed as the pages went on. It began as her teaching hand, careful and round; by the end of September it was smaller and faster and sloped to the right, the hand of someone taking dictation and falling behind.\n\nThe shore with the sea above it was still there, in almost every entry. But other things had come into it. A figure on the shore, very tall, that the children called *the reading man* or *the man who reads the names*. He walked along the shore with one hand out, touching things. He was always wet. He was kind. He was looking for one particular name and could not find it.\n\n\"Twenty-two children,\" Agnes said. \"Independently. I've had them apart. I've asked them in different words.\"\n\nThere was chalk dust along the side of her right forefinger, though school had been empty for three days. Ezra looked at it longer than he looked at the entries. She had rubbed the mark thin, almost to the skin, while she wrote. He noticed it, and then noticed it again. It had no place in a report.\n\n\"Wren,\" Ezra said.\n\n\"I'd never seen him when the first of them said it. I hadn't seen him till Sunday.\" She put a finger on an entry from Joseph Ainsley, seven. \"Read that one.\"\n\nJoseph had said: *The reading man said he went in the water on purpose. He said he heard it under the boat and he wanted to see. He said it's the right way up down there and he's been trying to get back the right way ever since but the stairs go the wrong way.*\n\nEzra closed the book.\n\n\"Agnes,\" he said, \"you understand I can't put any of this in a report.\"\n\n\"I'm not asking you to. I'm asking you whether you believe it.\"\n\nHe looked at her across the desk, at her face in the brown light from the window, and he thought of the floor of the Hollow that was not a floor, and the turning of something that did not know he was alive, and he understood that whatever he said now would be the thing he had said, for good, to this particular woman.\n\n\"Yes,\" he said.\n\nShe let out her breath. Her shoulders dropped a little, and she looked down at the book.\n\n\"Then I want you to take it,\" she said. \"Not yet. But if anything happens to me. I want it out of the village. I want somebody to have written it down who isn't here.\"\n\n\"Nothing is going to happen to you.\"\n\n\"Ezra.\" She almost smiled. \"Every child in my class goes down to that shore every night. I've started going with them. I don't remember it in the morning, but my feet are wet.\"\n\nHe took her hand across the desk. It was the second time either of them had touched the other, and this time neither of them pretended it was for any reason but the one it was.\n\nOutside, the sea came in at four in the afternoon, which was not a time it had ever come in, and stayed.","wordCount":615},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-4-1-1","eventId":"undersong-event-4-1-1","text":"For three days Jonah Pell did not come up.\n\nHe had the hydrophone moved to the boards and a camp bed put beside it, and he sat with the earpieces on and the brass bell turned to the gap at the top of the planking, and every hour on the hour he wrote down what the needle did in a pocketbook with a pencil tied to it by a string. Tom Hesketh brought him his food, because Tom was the only man in the drift who would go up the fourth heading now, and because since the fever Tom did not seem to need much sleep himself.\n\nThe pocketbook was very orderly at first. *Four a.m. Needle at 3. Steady. Slight beat at intervals of approx. 11 sec.* By the second day the entries were longer. *Noon. The beat is not a beat. It is the interval between two notes so close in pitch they quarrel. Compare tuning of a fiddle. Needle at 5.* By the third day they were not about the needle.\n\n*It is not below us. I had that wrong. Below is a direction and it has no directions. We are inside the condition of it, as a fish is inside the sea. Wren's drawer is full of men who found this out. The coastguard at Ravenscar 1891. A collier's mate at Skinningrove 1863. A Carmelite at Whitby in 1340 whose account was burned. Every few lifetimes it turns in its sleep, and where it turns it comes near, and where it comes near the sea forgets the moon.*\n\nTom read that one over his shoulder when he brought the bread at four, and Pell did not stop him.\n\n\"You can hear it better without the machine,\" Tom said. \"Can't you, Mr Pell?\"\n\n\"Yes.\"\n\n\"Then what's the machine for?\"\n\nPell thought about it. He took the earpieces off and laid them on the camp bed, and Tom saw that the inside of each was dark with dried blood.\n\n\"It's for writing down,\" Pell said. \"So that it's written down. So that when they come asking there's a record that a man sat here and listened properly and made notes like a man of science and did not just go mad like the rest of them.\" He laughed. \"It's a dial to look at, Tom. It's a thing to hold. That's all instruments ever were.\"\n\nThe note changed while he was saying it. Both of them felt it. It did not get louder. It got closer, the way a voice gets closer when someone in the next room comes and stands in the doorway, and the needle behind its glass went over to the stop and stayed there, trembling, and a fine dust began to come down from the timbering all along the heading in a curtain, very soft, like flour.\n\nPell put his hand flat on the boards.\n\n\"It's turning,\" he said. \"Over this way. Tom. It's turning over this way.\"\n\nThe boy said nothing. He was standing with his head on one side, the way he stood now most of the time, the way Wren stood in church.\n\n\"Go and get Wren,\" Pell said. \"No. Go and get the doctor. No.\" He pressed both hands against the planks. \"Don't get anybody. Stay here. Stay and listen with me. I don't want to be the only one.\"\n\nTom sat down on the floor of the heading beside the camp bed, and they listened together until the end of the shift.","wordCount":584},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-4-2-1","eventId":"undersong-event-4-2-1","text":"The fourth heading came down at seven minutes past two in the morning of the second of October, and it came down from the inside.\n\nTom would try to tell it afterwards and find there was no order to it. He had been asleep on the floor by the camp bed; he was sure of that. He had woken because the note had stopped. That was the thing: the silence. For three weeks the held chord had been under everything, under his mother's voice and the gulls and his own heart, and now it was gone, and the absence of it was so huge that he sat up gasping as a man gasps who has been underwater.\n\nPell was at the boards. He had the bar from the face, the same bar Tom had worked on the day of the breaking-in, and he was levering the planks off one by one and laying them aside with great care, the way you would lay aside the boards of a coffin you had promised to open.\n\n\"Mr Pell.\"\n\n\"It's stopped,\" Pell said reasonably. \"Do you understand, Tom? It's stopped to listen. It's never stopped before. It's listening to us.\"\n\n\"Mr Pell, Mr Wren said not.\"\n\n\"Wren's been down. Wren's had his turn.\" The last plank came away. Beyond it the door in the rock was not the width of a door any longer. It was the width of the heading, and there was no face, no rock, no end; the heading simply went on, into the dark that the lamp did not touch. \"I only want to hear what it hears. I only want to stand where it's listening from.\"\n\nHe stepped through.\n\nTom saw the lamp go with him for three yards, and then for thirty, though Pell was walking slowly, and then it was a long way off and very small, as a lamp is small at the far end of a pier, and then it was not a lamp but a star, and then it was not there at all. And then the note came back.\n\nIt came back all at once and from every direction and it was not a note. The timbers of the heading went like matchwood, all along its length, one after another, *crack crack crack*, coming towards him. The hydrophone went over and Tom heard its glass go and saw the brass bell crumple as if a hand had closed on it. Stone came down. The floor heaved up and then fell away, and a wind he could not feel took the air out of his lungs, and he was running, on his hands and on his feet, down a heading that was folding shut behind him like a book.","wordCount":457},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-4-2-2","eventId":"undersong-event-4-2-2","text":"He came out of the adit mouth at a quarter to three with his clothes torn off his back and the skin of both hands gone and his ears full of blood. Behind him the whole hill gave a long sigh and settled two feet, and the adit was a crack in the bracken that a child could not have got through.\n\nFor the first hour nobody believed the drift was closed. Three men from the night shift fetched picks and went down on their knees in the bracken, scraping at the crack with the frantic care of men clearing a trapped horse. One of them, Jack Bower, struck the hill until the head of his pick split. He listened between blows, his face pressed to the dirt.\n\n\"It's in there,\" he said. \"Can't you hear it? It's stopped. We've got to open it before it starts again.\"\n\nThey dragged him back when he began to claw at the earth with his hands. He fought them without anger, which frightened Ezra more than if he had shouted. When they got him to the road he turned at once and began walking downhill, still carrying the broken haft.","wordCount":197},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-4-2-3","eventId":"undersong-event-4-2-3","text":"At the slipway the coble-men were shouting over one another about the water. Old Harker swore that no tide could withdraw beyond the Scar and come back without a wind; Ned Ward, whose boy had drawn the sea above the shore in every schoolroom drawing for three weeks, said the sea had gone because the moon had failed; a third man ran to the harbour bell and rang it, though there was no boat to warn. They argued over the depth of the exposed channel as if figures might restore it. Then Harker stopped in the middle of a sentence, his mouth still open, and put his head on one side. The others followed him one by one. The bell swung on its rope and gave a final, small note.\n\nSilas Tunstall came out of the church and tried to gather the village in the square. He shouted until his voice broke, ordered the women indoors, and sent boys to fetch the families from the shore. For a little while people obeyed him. Then Mrs Ainsley walked past with her hands folded and her eyes fixed on the pale horizon. Silas caught her sleeve. She turned to him with such gentle surprise that he let go. By dawn the square was empty, and the people who remained were facing the sea.\n\nThey never found Jonah Pell. They never looked very hard. The Saltwick drift was not reopened, and the company wrote it off in the spring, and the sea came in over the shore that week at noon and at midnight both, in two great slow tides that met in the middle of the bay and stood there, piled, like a wall.","wordCount":283},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-4-3-1","eventId":"undersong-event-4-3-1","text":"There was nothing to bury, but Silas Tunstall buried it.\n\nThe company paid for a coffin and the men filled it with stones from the spoil heap so that the bearers would have a weight to carry, and the whole village came up the hill behind it in the rain. Ezra walked with Agnes. Ruth Hesketh walked alone. Tom walked at the back with his bandaged hands held out in front of him like a sleepwalker and a space around him on every side that nobody stepped into. Wren did not walk with anyone. He was already at the lychgate when they arrived, bareheaded, the rain running off his white hair, and he took his place at the graveside beside the vicar as if he had been asked.\n\nSilas began well. He had a good voice and he had buried perhaps four hundred people in this churchyard, a third of them out of the sea, and the words of the service carried themselves. *I am the resurrection and the life.* The rain beat on the umbrellas. Somewhere down the hill the sea was doing whatever it was doing now.\n\nIt was at the committal that it happened. He had got to *we therefore commit his body to the ground*, and the bearers had paid out the ropes and the coffin full of stones had gone down into the clay, and he stooped for the earth.\n\nInside the church, behind them, through the closed west door, the font began to ring.\n\nIt was not loud. It was the note, the held chord, the one the whole village had stopped hearing because it never stopped, and it was coming from the stone in the font, and it had changed. It was answering. Down the hill, under the sea, under the bottom of the sea, the other note rose to meet it, and for a moment the two stood together in the air over the churchyard in an interval so wrong that a woman behind Ezra dropped to her knees and a child began to scream.\n\nSilas Tunstall stood with the wet clay in his hand.\n\n\"Earth to earth,\" Ezra said quietly, beside him. \"Silas. Earth to earth.\"\n\nThe vicar looked at him. Ezra had known him thirty years; they had played chess every Wednesday for twenty of them. He did not know the face that looked at him now.\n\n\"Whose earth?\" said Silas. \"Tell me that, Ezra. You've been down there. Whose earth? Whose ground is it we're committing him to?\"\n\nHe let the clay fall from his hand onto the coffin. He did not finish the sentence. He walked away from the grave through the stones, past the memorial, past the lychgate, still in his surplice, and the village stood in the rain and watched him go, and nobody followed, and the ringing in the font went on.\n\nWren stooped, took up a handful of earth, and finished the committal himself, in a low, accurate voice, without the book. He knew every word.\n\nEzra stood beside the empty grave and thought, *He has heard this service before. He has heard it said over him.*","wordCount":523},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-5-1-1","eventId":"undersong-event-5-1-1","text":"After the drift fell Tom Hesketh went out onto the scar and did not come back.\n\nHe did not go far. He went to the end of the Long Scar, where the black rock runs out into the bay like a pointing finger, and he sat down on the last dry ledge of it with his bandaged hands in his lap and his head on one side, and he stayed there. He stayed there through the October gales and the two tides a day that now came at any hour they pleased. When the sea came in it came up to the ledge and stopped, and stood round him like a wall of green glass, a foot from his knees, and did not wet him. When it went out it went out for miles.\n\nRuth took him food the first week. She would walk out along the scar with a can of tea and a pasty wrapped in a cloth and set them down beside him, and he would thank her politely, and she would stand a while and then go back. He did not eat the food. The gulls would not touch it either. By the second week she was leaving it at the landward end of the scar and not going further, and by the third she did not go out at all.\n\nIt was Harker the coble-man who first called him what the village called him after. Harker had sat down on the scar beside the boy one evening, just to sit, an old man who had put his ear to the seabed on the night of the equinox and had never been easy since, and he had come back up the slipway at dark with his face wet and said to the men at the top: \"He's listening. That's all. He's listening for all of us, so we don't have to.\"\n\nSo he was the Listener. Within a fortnight nobody in Hollin Staithe called him Tom any more, not to his face and not behind his back, and the strange thing was how naturally it came, how the name fitted him, as if it had been waiting under the other one all his life.\n\nRuth heard them say it in the shop. *The Listener's had nothing again. The Listener says it's nearer.* She put down her basket and walked out without her change.\n\nAt home she sat at the kitchen table where he had sat, the first day, with the blood running into his collar, and she tried to say his name aloud and found that it had gone strange in her mouth, like a word in a language she had once known. *Tom.* It sounded like the name of somebody she had read about. *Thomas Hesketh, aged nineteen, miner.* She thought of his father, buried out of the same drift, and found she could remember his father's face perfectly and could not remember her son's.\n\nShe did not go down to the scar again. When women stopped her in the street to tell her what the Listener had said, she turned and walked away from them.\n\nFrom the end of the Long Scar the Listener could see his mother's window. He did not look at it. He was turned the other way, towards the place far out in the bay where the water stood piled and motionless, and his lips were moving, very slightly, in time with something nobody else could quite hear.","wordCount":579},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-5-2-1","eventId":"undersong-event-5-2-1","text":"For the days after the burial Silas tried to keep the hours. He unlocked the church at seven, rang the bell at eight, and said the offices aloud to the pews. Nobody came. At night he slept in the vestry with the door open, so that he could hear if the font began to ring again.\n\nIt did not ring. The note was in the flagstones instead, and in the iron hinges, and once in the brass clasp of his prayer book. He put his hands over his ears and continued the collect from memory. When he reached the end, the sound remained. He began again, not because he thought the words would help, but because he could not bear the silence that followed them.","wordCount":125},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-5-2-2","eventId":"undersong-event-5-2-2","text":"On All Saints' Day the Reverend Silas Tunstall preached to a congregation of one, and the one was Agnes Merriman, and she had come to tell him to stop.\n\nHe had preached anyway, to the flags and the pews and the bell-ringers' board, on the text *I will lift up mine eyes unto the hills*, because the sea was not to be thought of. His voice had gone up into the roof timbers and come back to him, and he had not liked what it sounded like.\n\nThe village was on the scar. All of it, or near enough, in Sunday clothes and silent rows behind the Listener. Agnes had walked down to see it. She had come back up the hill white to the lips.\n\n\"They don't do anything,\" she said. \"That's what's so terrible, Mr Tunstall. They just sit there with their heads on one side. The Wards. The Ainsleys. Old Harker. My children. All my children. School's empty. I rang the bell this morning and not one came.\"\n\nSilas came down from the pulpit and sat in the front pew beside her, which he had never done in his own church.\n\n\"It's stopped, you know,\" he said. \"The font. Since the funeral. I lifted the lid on Tuesday and the stone was lying there quite quiet.\" He laughed, a dry sound. \"I thought God had done it. I knelt down on the flags and gave thanks, Miss Merriman. I did.\"\n\n\"And?\"\n\n\"And then I went outside, and I heard it. It's in the ground. It's in the churchyard wall. It's in the slates. You can hear it in the pump on the green if you put your ear to the iron.\" He turned his hands over and looked at them. \"It isn't louder. It's only that there's nowhere now that it isn't.\"\n\nAgnes looked at him and saw that he had stopped shaving, and that there was a smell of drink on him that had not been there a month ago, and that he was holding the edge of the pew as if the pew might move.\n\n\"You should go down to them,\" she said. \"They're your people. They're sitting there without anyone to tell them anything.\"\n\n\"They have the Listener. He tells them it's turning over. He tells them we are beneath its notice and always were. Do you know, I think that's the worst of it. Not that it's coming. That it isn't.\" He was quiet a long time. \"What should I tell them, Miss Merriman? That God is listening? I've been listening to God for thirty-four years. I know what he sounds like. And it's not as loud as this.\"\n\nShe left him there. At the lychgate she looked back. He had not moved; he was sitting alone in the front pew with his head a little on one side.","wordCount":478},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-5-3-1","eventId":"undersong-event-5-3-1","text":"Wren came to the surgery after dark on the fifth of November, while the village burned no bonfire and set off no squibs, and sat in the patient's chair with his long hands folded and asked the doctor, very courteously, whether he still had his brother's watch.\n\nEzra had not told him there was a watch. He had told nobody, in twenty years, about the watch.\n\nHe took it out of the drawer of the desk where it had lain all that time in a twist of oiled silk. It was a plain silver half-hunter, cheap, a lad's watch, bought out of Elias's first year's wages from the lifeboat station. Elias had given it to him on the jetty the night of the storm, the night the *Grace Ainsley* went out to the collier on the Scar. *Keep it dry for me, Ez,* he had said, laughing, with the rain going sideways, *I'll want it back.* And Ezra had kept it dry for twenty years. It had stopped that same night, at seventeen minutes past three, and he had never had it wound.\n\n\"May I?\" said Wren.\n\nEzra did not mean to give it to him. He would think about that for the rest of his life: that he did not mean to, and that he held it out across the desk anyway, as Jonah Pell had held out the stone to Tom in the fourth heading, without seeming to know he did it.\n\nWren took the watch in his palm. He did not open it. He closed his long fingers round it and sat quite still with his eyes shut, and in the silence of the surgery Ezra heard the watch begin to tick.\n\nIt was very faint. Wren opened his hand and pressed the catch and the lid came up, and the hands were moving. The second hand went round the small dial steadily, smoothly, a good silver tick. It was going backwards.\n\n\"There,\" Wren said softly. \"There. That's better.\"\n\nEzra found he had stood up.\n\n\"Who are you?\"\n\n\"I told you. I read the drowned.\" Wren watched the hands go round. \"Somebody ought to. They're all down there, you know, Doctor, everybody the sea ever took off this coast. Not dead. Not alive. Being sung. Your Agnes's children have seen them. The Listener sits with them all day long.\" He smiled, without looking up. \"All of them but one.\"\n\n\"Give me that watch.\"\n\nWren looked up then, and his pale eyes were wet, or seemed wet; there was a brightness in them like water under ice.\n\n\"Let me keep it a little while,\" he said. \"Please. I've been so long without the time.\"\n\nAnd Ezra, who had kept that watch dry for twenty years against the night his brother came back to the jetty for it, let him keep it. He sat down again. He watched the stranger turn the silver case over and over in his long cold fingers, and listened to it ticking backwards, and did not ask the question that was in his mouth, because he knew, if he asked it, he would be answered.\n\nWhen Wren had gone he went to the window. There was no moon. The sea was a long way out, and on the bared rock below Cliff Row a line of wet footprints ran down from the surgery step towards the water, each one longer than a man's foot should be, and none coming back.","wordCount":577},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-6-1-1","eventId":"undersong-event-6-1-1","text":"At first light Ezra went down to fetch Agnes, and together they followed the footprints out.\n\nThe sea had gone further than he had ever seen it, further than the equinox, further than any chart. They walked down the slipway and across the sand and out along the Long Scar past the place where the Listener sat with his back to them and did not turn, and then off the end of the scar onto the seabed itself, onto the pale ridged rock that had been under forty feet of water since the ice went. It was dry. It was not wet as a beach is wet, shining and pooled; it was dry as a floor, and there was nothing on it, no weed, no shell, no crab, nothing that had ever lived.\n\nThe footprints went across it in a straight line, unhurried, towards the place where the water stood piled in the middle of the bay.\n\n\"They're not going anywhere,\" Agnes said, after a mile. \"Have you noticed? They don't stop. They don't turn. A man walking somewhere looks about him. These just go.\"\n\n\"He's going back.\"\n\n\"Back where?\"\n\nEzra did not answer. They had come to something in the rock: a long dark shape, half sunk, ribbed like a carcass. It was the collier. The *Mary Vane*, of Sunderland, that had gone aground on the Scar on the night of the great storm in ninety-one, the ship the lifeboat had gone out to. He had never seen her. Nobody had seen her since she broke up. She lay on the dry seabed with her plates rusted to lace and her boiler sitting up out of her like a heart, and the footprints went straight past her without a pause.\n\nAgnes put her hand on his arm.\n\n\"Ezra. Look at the sand by the bow.\"\n\nThere were other footprints there. Very many. Bare feet, and boots, and the small feet of children, going round and round the wreck in a great slow circle, worn into the rock as if they had been walking there for years. They were dry. They were not fresh. They were the prints the children had told her about in the Ledger: *everybody goes down the shore, Miss.*\n\nHe took her back. He took her back fast, with his hand round her wrist, and she let him, and it was not until they were on the scar again and could see the roofs of the village that she pulled free and stopped.\n\n\"Come away with me,\" he said. He had not known he was going to say it. \"Today. There's a cart to Whitby at noon. There's my sister's at Pickering. Come away and marry me, Agnes, for God's sake. There's nothing here now but this.\"\n\nShe looked at him a long time with the wind in her hair.\n\n\"There are thirty-eight children here,\" she said. \"Who go down to that shore every night. I can't take them to Pickering, Ezra.\" Then she put her hand flat on his chest, over his heart, very gently, the way Wren had put his hand on the memorial. \"But yes. Yes. When it's over. If there's an over. Ask me again then.\"\n\nHe said that he would. Behind them, at the end of the scar, the Listener had turned his head at last, and was watching them, with no expression at all.","wordCount":566},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-6-2-1","eventId":"undersong-event-6-2-1","text":"He found Wren at midnight where he had first found him, at the lifeboat memorial, with his palm on the granite.\n\nThe churchyard was full of the note. It came up out of the ground through the soles of Ezra's boots and through the gravestones and the yews; the whole hill hummed with it like a struck glass. Wren did not turn when he came up the path. He was reading the names again, slowly, his lips moving, and the watch was in his other hand, open, ticking its backward tick.\n\n\"There's no body,\" Ezra said. \"That's what I have never been able to get past. The *Grace Ainsley* came back with five aboard of the seven she went out with, and they found Dick Ward on the sand at Saltwick two days later, and they never found Elias. Twenty years I've been waiting for the sea to give him back.\"\n\n\"I know.\"\n\n\"Take your hand off his name.\"\n\nWren took his hand off the stone. The palm print stayed there in the salt bloom, the long fingers, as it had on the first Sunday.\n\n\"I heard it under the boat,\" he said. \"That night. We'd got the collier's crew off, all of them, and we were coming back through the surf, and I heard it under the keel. Singing. The others didn't. And I thought — I was twenty, Ez — I thought, I'll just see. I'll just go down and see what's singing, and come back up. So I went over the side.\" He turned round. \"And it's the right way up down there. The children are right. And I couldn't find the way back. The stairs go the wrong way. Twenty years I've been walking round that collier trying to get back to the jetty for my watch.\"\n\nThe moon came out from behind the church tower and showed his face clearly, and it was the face Ezra had been looking at for six weeks and had not let himself see, worn smooth and white and aged by no age that had happened on land: his brother's face. His brother's grey eyes. The small scar through the left eyebrow that Elias had got falling off the harbour wall at nine.\n\n\"Elias,\" he said.\n\n\"Hello, Ez.\"\n\nEzra reached for the watch. He did not know why. He wanted it back; he wanted something of his brother's in his hand that was not this. And his brother's fingers closed on it, hard, cold, and for a moment they held it between them, both pulling, and there was a small clear sound like ice breaking, and when Ezra looked down the glass of the watch was cracked straight across, and the hands had stopped again.\n\nAt seventeen minutes past three.\n\nElias looked at it for a long time. Then he closed the lid and put it in his pocket.\n\n\"I'm not coming back, Ez,\" he said gently. \"I'm sorry. That's not what I came for. I came because it's turning this way, and when it turns, the ones it has will go back down with it, and I wanted to read the names once more. And see you.\" He touched Ezra's face, once, with fingers like the sea in March. \"You got old. I'm glad. Somebody ought to.\"\n\nHe walked away down the hill towards the shore. Ezra did not follow him. He stood at the memorial until dawn with his own hand flat on his brother's name, feeling the granite hum.","wordCount":580},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-6-3-1","eventId":"undersong-event-6-3-1","text":"Agnes wrote the last entry in the Dream Ledger on the morning of the eighth of November, at the high desk in the empty schoolroom, in a hand that was no longer her own.\n\nIt was neat enough. It was legible. It was simply not the hand she had been taught at the board school in Leeds, nor the hand she had taught thirty-eight infants in eleven years; it was taller, more upright, and it ran across the page without a single blot or hesitation, as if it were being copied out from something she could see. She watched it do so. That was the strange part: she was not frightened. She sat and watched her own pen go across the paper the way one watches rain on a window.\n\n*They will all go down at the low tide,* the pen wrote. *The big low tide, the one that is coming. It is turning over and when it turns it will draw the water off the whole bay and everyone it has will go down the shore to meet it. The children know the way. They have been practising every night. Miss will walk with them as far as the collier. Miss will not be frightened.*\n\nShe put the pen down. She read the entry through twice. Then she took the pen up again, in her own fist, clumsy as a child's, and wrote underneath it, pressing so hard the nib split: *I will NOT let them.*\n\nThe schoolroom was very cold. The stove had not been lit for a week. Outside the window the playground was empty and the sea was far out and the light lay on the bared bay like the light on a plate. She could hear the note quite plainly now, in the window glass and in the iron of the desk and in the bones of her own wrists, and she found that if she let herself she could almost make out words in it: not words, but the shape words would have if the thing that was singing had ever needed to tell anything to anyone.","wordCount":354},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-6-3-2","eventId":"undersong-event-6-3-2","text":"When Ezra came at noon she had the Ledger wrapped in brown paper and tied with string, as if for the post.\n\n\"I said you were to have it if anything happened to me,\" she said. \"I'm giving it you now, because I don't think I'll be told beforehand. Read the last page. Not now. When you're somewhere else.\"\n\nHe took it. He held it against his chest with both arms, the way Tom had held the stone.\n\n\"Agnes, you're coming with me tomorrow. I've arranged the cart.\"\n\n\"I know.\" She smiled at him. It was her own smile; she checked, before she let it out, that it was hers. \"Ezra, if I go down the shore — if you see me go — you're not to follow. Promise me. You're to stay at the top of the slip and write it down. Somebody has to write it down who isn't there.\"\n\n\"I won't promise that.\"\n\n\"Then I'll ask you again when it's over,\" she said, as he had said, \"if there's an over,\" and kissed him once, very lightly, at the corner of the mouth, and sent him away with the book under his arm.\n\nWhen he had gone she sat at the high desk until it was dark, holding her right wrist hard in her left hand, so that it would not write.","wordCount":223},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-7-1-1","eventId":"undersong-event-7-1-1","text":"On the ninth of November the sea went out and kept going.\n\nIt began at four in the morning, which was not a time it had any business beginning, and by first light the bay was empty to the horizon. Not to the Long Scar; not to the wreck of the *Mary Vane*; to the horizon. Where the North Sea had been there was a plain of pale ridged rock running out east under a white sky until it met the sky, and in the middle of it, very far off, so far that it was only a dark smudge on the rim of the world, the water stood piled up like a cliff. It did not fall. It did not move at all. And from it, and from the rock, and from the ground under every house in Hollin Staithe, the note came up, and it was no longer a held chord but a sound like a breath drawn in.\n\nEzra had the cart ready at the top of Cliff Row by seven. The Whitby road was the only road. He had the Ledger in his bag and his instruments and nothing else, and he meant to go down the hill to the schoolhouse and put Agnes in the cart by force if he had to.\n\nThe road was full of people coming the other way.\n\nThey came up from the shore in their Sunday clothes, walking slowly, in families, with their heads on one side; and when they reached the top of the hill they turned round, every one, as if at a wall, and walked down again. Ezra watched old Mrs Ainsley do it three times. She came up to the last cottage on the top road and turned and went back down, and at the bottom she turned again and came up. She did not seem distressed. She was humming.\n\nHe led the horse out onto the Whitby road himself. It went a hundred yards and stopped and would not go on, and when he went to its head he found it trembling from neck to fetlock, and in front of it the road ran on quite ordinary between its hedges, and he could not make himself walk down it either. It was not fear. It was the plain bodily certainty a man has, at the top of a stair in the dark, that there is one more step than there is.\n\nNobody was leaving Hollin Staithe. Nobody could.\n\nRuth Hesketh found him there with the horse. She had her shawl crossed over her chest and her hands knotted in it as on the first day, and she stood beside him and looked down the road that could not be walked.\n\n\"You've been down there,\" she said. \"Into it. The only one that came back up with his wits. So you tell me, Doctor. Is my son in there? Is Tom in there, under the Listener, or has it got all of him?\"\n\nHe thought of the fever, the pulse that did not vary by a beat.\n\n\"I don't know, Ruth.\"\n\n\"Then go and ask him.\" Her face did not move. \"I can't. I've tried. I get to the end of the scar and I can't say his name. It won't come. Go and say it to him, and see if anybody answers.\"\n\nHe said he would. He said it the way he had said, on the first day, that the tide would come back.","wordCount":579},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-7-2-1","eventId":"undersong-event-7-2-1","text":"The children went down at noon.\n\nEzra was at the top of the slipway, as he had promised her and had not promised her, with the Ledger under his coat. He had gone out along the scar at eleven to say the boy's name, and had stood behind the Listener in the cold and said *Tom, Tom Hesketh, your mother is asking for you*, and the Listener had not turned his head; and on the way back Ezra had found that he too could not quite remember what the name had been for.\n\nThey came down Cliff Row two by two, in their school pinafores and their boots, holding hands the way they held hands to cross the road on the way to chapel. Thirty-eight of them. They were not hurried and they were not frightened. Annie Ward was at the front. Their parents walked down behind them, not to stop them but as people walk behind a band.\n\nAgnes was with them. She walked at the side of the column with her hat on and her coat buttoned, as she walked them every Whitsun to the treat at the Hall, and as she passed the slipway she looked up at him, once, and he saw that her right hand was holding her left wrist so hard the knuckles were white.\n\nHe went down the slip after her. He had not promised.","wordCount":233},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-7-2-2","eventId":"undersong-event-7-2-2","text":"He caught them up at the end of the Long Scar, where the Listener sat. The children were going past him in their pairs and stepping down off the last ledge onto the seabed, and the Listener did not look at them, and they did not look at him; they went past him the way water goes past a post. Out across the pale rock in front of them, very far, the piled water stood on the horizon. It had come nearer. Or the horizon had.\n\n\"Agnes.\"\n\nShe turned. Her face was entirely her own.\n\n\"I said you weren't to follow.\"\n\n\"I didn't promise.\"\n\n\"No.\" She almost laughed. \"No, you didn't.\" Then she let go of her wrist, and turned to the column, and raised her hand and clapped it twice against her other palm, sharp.\n\n\"Standard One! *Stand still.*\"\n\nThey stopped. All of them. Thirty-eight children stopped in their pairs on the seabed and turned round and looked at her, puzzled, blinking, like children woken up.\n\n\"Go home,\" said Agnes Merriman. \"All of you. Back up the scar and home to your mothers, and walk, don't run. Annie Ward, you're in charge. Go on. *Now.*\"\n\nAnd they went. It held them for as long as it took. They turned and went back past the Listener and up the scar in their pairs, and the parents behind them stopped and stood aside, and Ezra stood on the ledge and watched them go by him, and when he turned back Agnes was already a long way out on the rock.\n\nShe was walking quite steadily towards the water, alone, with her hat on. She did not look back. He called her name until there was no voice left in him to call it with, and she did not turn, and she got smaller, and smaller, as Jonah Pell's lamp had got smaller in the fourth heading, and became a speck at the foot of the standing wall of the sea, and then she was not there.\n\nThe Listener, beside him on the ledge, said quietly, without turning his head: \"She's in it now. She's very loud.\"","wordCount":356},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-7-3-1","eventId":"undersong-event-7-3-1","text":"Silas Tunstall took the stone out of the font on the evening of the ninth, after the children had come back up the hill without their teacher, and carried it down the nave in both hands like the elements.\n\nThe church was full. It was the first time in thirty-four years he had seen it full on a weekday; they had come up from the shore in the dusk, not knowing why, and sat in the pews in their damp Sunday clothes with their heads on one side, and they watched him. Ezra stood at the back under the bell-ringers' board. He had not slept. He had sat on the top of the slipway until dark with the Ledger on his knees and had not been able to open it.\n\nSilas stood in the chancel with the stone. It hummed in his hands. Its hum was the hum of everything now, and so it was hard to hear; it was like listening for one wave in a storm.\n\n\"I have something to tell you,\" he said, \"and then I am going to give this away, and then I am going to stop.\"\n\nHe did not go up into the pulpit. He stood on the chancel step where Tom Hesketh had laid the stone down two months before.\n\n\"I have been your priest for thirty-four years,\" he said, \"and I have told you every Sunday that we are watched. That the hairs of our heads are numbered and no sparrow falls. That there is an eye upon us, and that eye is love. And I believed it. I want you to know that. I was not lying to you. I believed it because I could not bear the alternative, which is that we are not watched at all. That there is something under us so large that our whole history is a crease in its bedclothes. That it is not cruel. It would be easier if it were cruel. It does not know that we are here.\" He turned the stone over. \"Miss Merriman walked into it this afternoon, to save your children. It does not know that either. That's all. That's my sermon.\"\n\nThe Listener came in at the west door. Nobody had seen him leave the scar in seven weeks, and the people in the back pews drew their feet in as he passed, and he walked up the nave in the candlelight with his bandaged hands held out in front of him and stopped at the chancel step.\n\n\"It wants that back now, Vicar,\" he said. \"It's going home. It wants all of its bits.\"\n\nSilas gave him the stone. He held it out and the Listener took it, gently, and held it against his chest, and Silas Tunstall took off his stole and folded it and laid it on the altar rail and sat down on the chancel step with his hands hanging between his knees, and did not get up again that night.\n\nEzra watched the Listener walk back down the nave with the stone, past his mother in the third pew, who did not look up. He wanted to say the boy's name. He opened his mouth for it. There was nothing in his mouth at all.","wordCount":545},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-7-4-1","eventId":"undersong-event-7-4-1","text":"In the morning the Whitby road could be walked again.\n\nBy morning the note had changed; not gone, but drawn away, like weather passing. Harker tried the road at dawn, as he tried it every dawn, and found he could walk past the last cottage, and past the milestone, and on down between the hedges. He came back running with the news, and within the hour Hollin Staithe was emptying like a bath with the plug pulled.\n\nThey went on carts, on foot, on the two motor lorries the ironstone company sent from Loftus when the telephone at the post office worked for eleven minutes at half past eight. They went with what they could carry. Ezra stood at the top of Cliff Row and watched them go and did not try to count. Mothers with children. Old men with clocks. The Wards, with Annie, who would not let go of the gatepost of the schoolhouse until her father carried her, and who screamed for Miss all the way up the hill.","wordCount":172},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-7-4-2","eventId":"undersong-event-7-4-2","text":"The schoolhouse was the first building in the village to stand empty. He went down to it at nine, after the last of the children had gone. The door was open. The register lay open on the high desk at the date of the eighth, every name in it marked absent in Agnes's hand, and her coat was not on its peg, and the stove was cold. He stood a long while in the doorway. He did not go in. He thought that if he went in he would sit down at her desk and not get up, as Silas had sat on the chancel step, and someone had to stay up.","wordCount":112},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-7-4-3","eventId":"undersong-event-7-4-3","text":"Ruth Hesketh would not go.\n\nHe found her in her kitchen with her hands flat on the table, and her bags not packed, and the door to the street standing open so that she could see, between the cottages, the end of the Long Scar and the little dark shape on its last ledge.\n\n\"There's a place on the second lorry,\" he said. \"I've kept it for you.\"\n\n\"Give it to somebody else.\"\n\n\"Ruth, there's nobody here to give it to. They've gone. The road could close again at any moment. Nobody knows why it opened.\"\n\n\"I know why.\" She did not look away from the scar. \"It opened because it doesn't need them. It's got what it wanted out of Hollin Staithe. It's got its bits back, and it's got the teacher, and it's got my lad. The rest of us are just — \" she searched for it — \"spoil. Off the heap.\"\n\n\"Then come away.\"\n\n\"I'm his mother,\" Ruth said. \"I couldn't say his name to him. I couldn't touch him, the night of the fever. You saw. I stood in that doorway and let him go down into it on his own.\" Her voice did not shake. \"I'll not do it twice. When he goes I'll be on the scar. I'll not be on a lorry at Loftus wondering.\"\n\nHe stayed with her until noon. Then the second lorry went without her place filled, and the road was empty, and there was no sound in Hollin Staithe but the note and the gulls, who had begun at last to come back down onto the bared rock, and to walk about on it, and to stand, facing the far water, with their heads on one side.","wordCount":286},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-8-1-1","eventId":"undersong-event-8-1-1","text":"For three days there were four people left in Hollin Staithe, and then there were three.\n\nThe vicar went on the first night. Ezra found the church door open in the morning and the chancel step empty and the stole still folded on the altar rail, and a line of footprints, ordinary ones, a man's in clerical boots, going down the churchyard path, through the lychgate, down the hill, and out along the Long Scar. They stopped at the last ledge, beside the Listener, as if Silas Tunstall had stood there a while to say something. Then they went on, out onto the rock, towards the water. Ezra did not follow them. He went back up to the church and closed the west door, and after a moment's thought he turned the great iron key in it and put the key in his pocket, though there was no one now to keep out.\n\nThen there were Ezra, and Ruth, and the Listener, and whatever was walking up and down on the seabed round the *Mary Vane* in the nights.","wordCount":179},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-8-1-2","eventId":"undersong-event-8-1-2","text":"He did what a doctor does. He kept himself fed. He kept Ruth fed, mostly by sitting in her kitchen until she ate something to make him go. He went round the empty houses with a lamp in the evenings and closed the doors that were open and banked the fires that were still smouldering, and in the house of the Wards he found that Annie had left all her drawings pinned up over her bed, thirty-one of them, the shore with the sea above it, and he took them down and put them in his bag with the Ledger.\n\nThe note did not change. He had stopped hearing it as a sound weeks ago. It was the condition of things now, like weather or gravity; it was the floor he stood on.\n\nHe had still not opened the Ledger. It lay on his desk in its brown paper and string where Agnes had tied it. Each night he sat down in front of it and put his hands on it and did not untie the string.","wordCount":178},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-8-1-3","eventId":"undersong-event-8-1-3","text":"On the third morning he went out along the scar.\n\nThe Listener was where he always was. He had not eaten in seven weeks and he was not thin. His bandages had come off at some point, and the skin of his palms underneath had healed smooth and white and without lines, like the skin of a drowned man's hand. He had the stone in his lap. He was humming with it, very softly, the same note.\n\nEzra sat down beside him on the ledge.\n\n\"Your mother's waiting for you,\" he said. \"In the kitchen. She's kept your chair.\"\n\nFor a long time nothing happened. Then the Listener turned his head, for the first time in seven weeks, and looked at the doctor, and something moved far down in his face, the way something moves far down in deep water: a shape, a pale shape, coming up and then going back.\n\n\"Tell her I can't hear her very well,\" he said. \"Tell her it's very loud.\"\n\nEzra walked back up the scar. Behind him, very far out on the rock, a white-haired figure was walking towards the shore in a straight line, unhurried, with its hand held out in front of it as if it were reading something written on the air.","wordCount":213},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-8-2-1","eventId":"undersong-event-8-2-1","text":"Elias came for the Listener at the turn of the night, and Ezra followed them because there was nothing left in the world to do but follow.\n\nThe great low tide had come. That was what Agnes's hand had written and that was what it was: not a tide at all but the whole sea drawn off the shelf of the coast and stood up on its edge on the horizon like a page about to be turned. The bared seabed shone in the dark with a faint light of its own. The air was perfectly still. And the note had stopped.\n\nElias walked out along the scar to the last ledge, and the Listener stood up to meet him, holding the stone. They did not speak. Elias put out his long white hand and the Listener put his into it, as a child does, and they stepped down off the ledge onto the rock together and walked, not out towards the standing water, but along the foot of the cliff, northward, to where the slip of the Saltwick drift lay buried under its two feet of settled hill.","wordCount":189},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-8-2-2","eventId":"undersong-event-8-2-2","text":"There was no adit there any more. There was a door.\n\nIt stood in the face of the cliff where the drift mouth had been, the width of the heading, smooth-edged, as if it had not been broken open but had opened; and through it Ezra saw the dark that the lamp had not touched, the dark that was larger than the sky.\n\nElias stopped on the threshold. He took the watch from his pocket, with its cracked glass and its hands at seventeen minutes past three, and turned, and held it out to his brother.\n\n\"Keep it dry for me, Ez,\" he said.\n\nEzra took it. He could not see for a moment. When he could, the Listener had stepped past them both and was standing just inside the door, and he bent and laid the dark stone down on the floor that was not a floor, very carefully, the way you put a thing back in the place it was taken from, and the stone went down into the dark and did not land, and the sound of it not landing was the note, beginning again.\n\nThe Listener looked back once, at the village. At a window on Cliff Row where a lamp was burning. His lips moved. Ezra would never know what they said; would lie awake for the rest of his life deciding it had been *Mam*, and then deciding it had not.\n\nThen the two of them went in, the drowned man and the boy, and walked away into the dark until they were a long way off and very small, two stars, one star, none.\n\nEzra stood in the door. He felt it at last, the thing Wren had warned him of on the first descent: not danger, but the end of wanting to come back. It would be easy. It would be the easiest thing he had ever done. The dark was not cruel. It was only very large and entirely indifferent and it was the right way up, and everyone was in it, everyone he had ever lost, being sung.\n\nHe had a watch in his hand to keep dry. He had a book in a brown paper parcel on his desk that he had promised to write in. He stepped back.\n\nThe door closed, smoothly, like an eye. The cliff was a cliff. Out on the horizon the standing sea began, very slowly, to lean.","wordCount":405},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-8-3-1","eventId":"undersong-event-8-3-1","text":"The sea came back to Hollin Staithe at three seventeen in the morning, and it came back all at once.\n\nEzra was at his desk in the surgery on Cliff Row when he heard it: not a roar but a long slow exhalation, the sound a house makes when a door is opened somewhere in it and the pressure goes out. He went to the window. The bay was full. It had filled in the time it took him to stand up. It was quite calm, black and glossy under no moon, slapping at the foot of the scaur as it had slapped on every ordinary night of his childhood, and there was nothing on it at all.","wordCount":118},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-8-3-2","eventId":"undersong-event-8-3-2","text":"Ruth Hesketh's lamp was out. He went down to her in the morning and her kitchen was empty and her door was open and her shawl was folded on the chair her son had sat in, and there was a line of wet footprints going down the street towards the slip. He did not follow them. There was no longer anywhere for them to go but the water.","wordCount":68},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-scene-8-3-3","eventId":"undersong-event-8-3-3","text":"He went back up to the surgery. He untied the string.\n\nHe read the Dream Ledger from the beginning: Annie Ward, six, *where it's the right way up*; Joseph Ainsley, seven; the reading man; the stairs that go the wrong way. He read Agnes's last page, the upright hand that was not hers and the clumsy fist that was, *I will NOT let them*, with the nib split through the paper. Then he turned to the blank pages at the back of the book, where she had written down the tides, and uncapped his pen, and began.\n\nHe wrote it as a case history, because that was the only form he had. *Hollin Staithe, North Riding. Population at onset, four hundred and twelve. Presenting complaint: a sound.* He wrote down the names, all of them, Jonah Pell and Silas Tunstall and Agnes Merriman and Ruth Hesketh and Thomas Hesketh, called the Listener, and Elias Coyle, called Abel Wren, drowned eighteen ninety-one, drowned again nineteen eleven; and under each name, where he would have written the cause of death, he left a space, because there was no word for it, and he would not invent one.\n\nIt took him nine days. When it was done he wrapped the book in the same brown paper and tied it with the same string and left it on the desk in the surgery, addressed in his clearest hand to *Whoever comes next*, with the watch on top of it in its twist of oiled silk, kept dry.\n\nHe did not leave. He had meant to. But on the tenth night, sitting at the window with the lamp out, watching the ordinary sea, he found that he was sitting with his head a little on one side.\n\nIt was very faint. It was lower than he could hear. It was far below him, below the sea, below the bottom of the sea, and it did not know that he was there, and it never would; and it had not finished turning over. It had only paused.\n\nWithin the held note was a small interruption: two dry impacts, close together, then a long interval, then two more. Ezra knew the pattern because Agnes had used it every day in the schoolyard. But it was not her calling the children now. It had no hand behind it, no will, no ear waiting for obedience. The rhythm returned at intervals too exact for a living wrist, each pair slightly altered, as if the great sound were trying and failing to reproduce a command it had swallowed.\n\nHe understood that her discipline had not survived in the song. Only its shape had. A life spent making order had become a tiny mechanical fault in something too vast to notice the damage it did.\n\nHe sat and listened. He had always been the one who wrote things down. The two impacts came again, and again, and each time he recognized them less as Agnes and more as the place where Agnes had been.","wordCount":504}],"blobs":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-maps-coast","mimeType":"image/png","url":"library/the-undersong/maps/coast.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-maps-village","mimeType":"image/png","url":"library/the-undersong/maps/village.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-maps-drift","mimeType":"image/png","url":"library/the-undersong/maps/drift.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-hollin","mimeType":"image/png","url":"library/the-undersong/art/locations/hollin.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-whitby","mimeType":"image/png","url":"library/the-undersong/art/locations/whitby.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-loftus","mimeType":"image/png","url":"library/the-undersong/art/locations/loftus.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-surgery","mimeType":"image/png","url":"library/the-undersong/art/locations/surgery.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-cliff-row","mimeType":"image/png","url":"library/the-undersong/art/locations/cliff-row.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-hesketh-house","mimeType":"image/png","url":"library/the-undersong/art/locations/hesketh-house.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-school","mimeType":"image/png","url":"library/the-undersong/art/locations/school.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-agnes-house","mimeType":"image/png","url":"library/the-undersong/art/locations/agnes-house.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-church","mimeType":"image/png","url":"library/the-undersong/art/locations/church.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-churchyard","mimeType":"image/png","url":"library/the-undersong/art/locations/churchyard.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-memorial","mimeType":"image/png","url":"library/the-undersong/art/locations/memorial.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-staithe","mimeType":"image/png","url":"library/the-undersong/art/locations/staithe.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-long-scar","mimeType":"image/png","url":"library/the-undersong/art/locations/long-scar.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-seabed","mimeType":"image/png","url":"library/the-undersong/art/locations/seabed.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-village-square","mimeType":"image/png","url":"library/the-undersong/art/locations/village-square.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-whitby-road","mimeType":"image/png","url":"library/the-undersong/art/locations/whitby-road.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-drift-mouth","mimeType":"image/png","url":"library/the-undersong/art/locations/drift-mouth.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-adit","mimeType":"image/png","url":"library/the-undersong/art/locations/adit.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-fourth-heading","mimeType":"image/png","url":"library/the-undersong/art/locations/fourth-heading.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-locations-hollow","mimeType":"image/png","url":"library/the-undersong/art/locations/hollow.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-bower","mimeType":"image/png","url":"library/the-undersong/art/characters/bower.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-ezra","mimeType":"image/png","url":"library/the-undersong/art/characters/ezra.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-agnes","mimeType":"image/png","url":"library/the-undersong/art/characters/agnes.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-tom","mimeType":"image/png","url":"library/the-undersong/art/characters/tom.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-ruth","mimeType":"image/png","url":"library/the-undersong/art/characters/ruth.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-pell","mimeType":"image/png","url":"library/the-undersong/art/characters/pell.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-wren","mimeType":"image/png","url":"library/the-undersong/art/characters/wren.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-silas","mimeType":"image/png","url":"library/the-undersong/art/characters/silas.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-harker","mimeType":"image/png","url":"library/the-undersong/art/characters/harker.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-annie","mimeType":"image/png","url":"library/the-undersong/art/characters/annie.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-characters-joseph","mimeType":"image/png","url":"library/the-undersong/art/characters/joseph.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-items-daybook","mimeType":"image/png","url":"library/the-undersong/art/items/daybook.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-items-dark-stone","mimeType":"image/png","url":"library/the-undersong/art/items/dark-stone.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-items-hydrophone","mimeType":"image/png","url":"library/the-undersong/art/items/hydrophone.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-items-dream-ledger","mimeType":"image/png","url":"library/the-undersong/art/items/dream-ledger.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-items-pell-book","mimeType":"image/png","url":"library/the-undersong/art/items/pell-book.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-items-watch","mimeType":"image/png","url":"library/the-undersong/art/items/watch.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-items-drawings","mimeType":"image/png","url":"library/the-undersong/art/items/drawings.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-factions-village","mimeType":"image/png","url":"library/the-undersong/art/factions/village.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-factions-mine","mimeType":"image/png","url":"library/the-undersong/art/factions/mine.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-factions-parish","mimeType":"image/png","url":"library/the-undersong/art/factions/parish.png"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-image-world-cover","mimeType":"image/png","url":"library/the-undersong/art/world.png"}],"relationships":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-1","characterAId":"undersong-char-ezra","characterBId":"undersong-char-agnes","label":"Doctor and schoolmistress","sentiment":"positive","description":"Two careful observers trust one another with facts the village cannot explain.","strength":6,"isBidirectional":true,"startEventId":"undersong-event-2-3-1"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-2","characterAId":"undersong-char-ezra","characterBId":"undersong-char-ruth","label":"Doctor and patient’s mother","sentiment":"positive","description":"Ruth calls on Ezra for Tom and expects an honest answer even when medicine has none.","strength":6,"isBidirectional":true,"startEventId":"undersong-event-1-1-2"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-3","characterAId":"undersong-char-ruth","characterBId":"undersong-char-tom","label":"Mother and son","sentiment":"positive","description":"Ruth’s care remains fixed on Tom as his attention moves beyond ordinary speech.","strength":6,"isBidirectional":true,"startEventId":"undersong-event-1-1-2"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-4","characterAId":"undersong-char-tom","characterBId":"undersong-char-pell","label":"Miner and manager","sentiment":"mixed","description":"They share the first opening and listen together at the boarded heading.","strength":6,"isBidirectional":true,"startEventId":"undersong-event-1-2-1"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-5","characterAId":"undersong-char-ezra","characterBId":"undersong-char-wren","label":"Doctor and surveyor","sentiment":"mixed","description":"Ezra distrusts a visitor who knows too much about the drowned.","strength":6,"isBidirectional":true,"startEventId":"undersong-event-2-1-1"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-6","characterAId":"undersong-char-ezra","characterBId":"undersong-char-silas","label":"Old friends","sentiment":"positive","description":"The doctor and vicar have shared a village and a weekly chessboard for decades.","strength":6,"isBidirectional":true,"startEventId":"undersong-event-2-1-1"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-7","characterAId":"undersong-char-agnes","characterBId":"undersong-char-annie","label":"Teacher and pupil","sentiment":"positive","description":"Agnes listens closely when Annie describes the shared shore.","strength":6,"isBidirectional":true,"startEventId":"undersong-event-1-3-1"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-8","characterAId":"undersong-char-agnes","characterBId":"undersong-char-joseph","label":"Teacher and pupil","sentiment":"positive","description":"Joseph’s changed drawings become part of Agnes’s evidence.","strength":6,"isBidirectional":true,"startEventId":"undersong-event-1-3-1"}],"relationshipSnapshots":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-snapshot-1","relationshipId":"undersong-relationship-1","eventId":"undersong-event-6-1-1","label":"Love acknowledged","sentiment":"positive","strength":9,"description":"Ezra asks Agnes to marry him; she accepts if they can get through the crisis.","isActive":true,"sortKey":0},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-relationship-snapshot-2","relationshipId":"undersong-relationship-5","eventId":"undersong-event-6-2-1","label":"Brothers reunited","sentiment":"positive","strength":9,"description":"Ezra recognizes Elias and hears why he cannot remain on land.","isActive":true,"sortKey":1}],"timelines":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"the-undersong-timeline","name":"Hollin Staithe, 1911","description":"One continuous autumn chronology; the 1891 loss is recounted memory rather than a second active timeline.","color":"#485b5f","dayOffset":0}],"plotThreads":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-thread-signs","name":"Things That Do Not Agree","description":"Tides, bells, wounds, dreams and instruments accumulate as observations that ordinary explanation cannot reconcile.","color":"#5f6a67","status":"complete","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-thread-withdrawal","name":"The Withdrawing Sea","description":"The coast ceases to obey the expected rhythm and exposes ground beyond living memory.","color":"#5f6a67","status":"complete","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-thread-records","name":"Written Evidence","description":"Medical notes, school records, mine readings and a stopped watch preserve facts that memory alone cannot hold.","color":"#5f6a67","status":"complete","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-thread-return","name":"What Comes Back","description":"Footprints, a familiar face and an old watch raise the question of what the sea can return.","color":"#5f6a67","status":"complete","tags":[]}],"motifs":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-motif-sound","name":"The Held Note","description":"A sound below hearing appears through stone, bodies, instruments and the fabric of the village.","color":"#68706a","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-motif-tides","name":"Wrong Tides","description":"The changing boundary between sea and land measures a disturbance no almanac predicts.","color":"#68706a","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-motif-objects","name":"Objects That Carry the Note","description":"Stone, brass, paper and silver hold traces of events their keepers cannot fully explain.","color":"#68706a","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-motif-writing","name":"Writing Things Down","description":"Characters answer uncertainty by making records precise enough for whoever reads next.","color":"#68706a","tags":[]}],"loreCategories":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-lore-category-edition","name":"Edition and Reading","color":"#756a5d","sortOrder":0},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-lore-category-place","name":"Coast and Mine","color":"#4f6468","sortOrder":1}],"lorePages":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-lore-source","categoryId":"undersong-lore-category-edition","title":"Text and Rights","body":"This complete English manuscript is reproduced with the direct permission of its creator and credited to Solomon Darko. Copyright © 2026 Solomon Darko. All rights reserved.","visibleFromEventId":"undersong-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-lore-structure","categoryId":"undersong-lore-category-edition","title":"Eight Chapters and Twenty-Six Sections","body":"The chapter and section titles are authorial. Scene divisions within a section follow paragraph boundaries where place, cast, knowledge or dramatic state changes.","visibleFromEventId":"undersong-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-lore-calendar","categoryId":"undersong-lore-category-edition","title":"The Autumn of 1911","body":"The manuscript fixes the opening on 14 September 1911 and supplies several later dates. Intermediate positions follow the stated sequence and are editorial approximations rather than invented historical claims.","visibleFromEventId":"undersong-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-lore-art","categoryId":"undersong-lore-category-edition","title":"Maps and Illustrations","body":"The cover, portraits, objects, places and interpretive maps are original artwork generated with OpenAI ImageGen in a mature Edwardian coastal-gothic style. The coast chart places Whitby southeast of Loftus. The village and mine are local plans with the shore and entrance identified, rather than surveyed north-up sheets; all three maps are interpretive reading aids.","visibleFromEventId":"undersong-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-lore-ironstone","categoryId":"undersong-lore-category-place","title":"Ironstone Beneath the Sea","body":"Saltwick drift follows the North Riding practice of mining ironstone seams from coastal workings, while Hollin Staithe itself remains fictional.","visibleFromEventId":"undersong-event-1-2-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-lore-lifeboat","categoryId":"undersong-lore-category-place","title":"The Lifeboat Memorial","body":"The churchyard stone records the village’s drowned, including the crewman lost from the Grace Ainsley in 1891.","visibleFromEventId":"undersong-event-2-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]}],"knowledgeFacts":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-stone","title":"The fragment carries the note","description":"Tom brings a warm humming piece of the opened face to the surface.","readerLearnsAtEventId":"undersong-event-1-2-1","originEventId":"undersong-event-1-2-1","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-dreams","title":"The children share the inverted shore","description":"Separate pupils describe the same shore with the sea above it.","readerLearnsAtEventId":"undersong-event-1-3-1","originEventId":"undersong-event-1-3-1","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-wren","title":"Wren has investigated an earlier underwater sound","description":"The surveyor connects the present note to a coastguard record from the 1891 storm.","readerLearnsAtEventId":"undersong-event-2-2-1","originEventId":"undersong-event-2-2-1","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-hollow","title":"The opening exceeds the mine","description":"Ezra experiences distance and direction that cannot fit behind the rock face.","readerLearnsAtEventId":"undersong-event-3-2-1","originEventId":"undersong-event-3-2-1","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-identity","title":"Abel Wren is Elias Coyle","description":"The man at the memorial is the brother Ezra lost from the Grace Ainsley.","readerLearnsAtEventId":"undersong-event-6-2-1","originEventId":"undersong-event-6-2-1","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-low-tide","title":"A great low tide is coming","description":"An altered hand writes that the children will go down when the sea withdraws.","readerLearnsAtEventId":"undersong-event-6-3-1","originEventId":"undersong-event-6-3-1","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-agnes-gone","title":"Agnes walks beyond the children","description":"After turning her pupils home, Agnes continues alone toward the standing sea.","readerLearnsAtEventId":"undersong-event-7-2-2","originEventId":"undersong-event-7-2-2","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-pell-gone","title":"Jonah Pell does not return from the hollow","description":"The manager walks beyond the lamp before the drift collapses.","readerLearnsAtEventId":"undersong-event-4-2-1","originEventId":"undersong-event-4-2-1","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-silas-gone","title":"Silas follows the seabed tracks","description":"His boots leave the church and stop beside the Listener before continuing toward the water.","readerLearnsAtEventId":"undersong-event-8-1-1","originEventId":"undersong-event-8-1-1","tags":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-fact-ruth-gone","title":"Ruth leaves toward the restored sea","description":"Her folded shawl and wet footprints remain after the bay returns.","readerLearnsAtEventId":"undersong-event-8-3-2","originEventId":"undersong-event-8-3-2","tags":[]}],"knowledgeReveals":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-reveal-stone-tom","factId":"undersong-fact-stone","characterId":"undersong-char-tom","eventId":"undersong-event-1-2-1","note":"Learned by direct observation, testimony, or surviving record."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-reveal-stone-pell","factId":"undersong-fact-stone","characterId":"undersong-char-pell","eventId"