","eventId":"undersong-event-5-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-surgery","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-watch"],"inventoryNotes":"","travelModeId":null,"sortKey":23.01,"statusNotes":"Asks for the undisclosed watch, restarts it in reverse, and pleads to keep it a little longer."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-6-1-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-6-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-seabed","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":24,"statusNotes":"Follows the prints to the wreck, brings Agnes back quickly, and asks her to leave and marry him."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-6-1-1-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-6-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-seabed","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":24.01,"statusNotes":"Finds the circling prints and accepts a future with Ezra while refusing to abandon her pupils."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-6-2-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-6-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-memorial","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":25,"statusNotes":"Recognizes his brother, cracks the watch glass in their struggle, and remains at the memorial until dawn."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-6-2-1-wren","characterId":"undersong-char-wren","eve