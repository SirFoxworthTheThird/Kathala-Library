ndersong-snapshot-7-1-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-7-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-whitby-road","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-dream-ledger"],"inventoryNotes":"","travelModeId":null,"sortKey":28,"statusNotes":"Finds neither horse nor his own body will pass the road boundary and agrees to speak to Tom."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-1-1-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-7-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-whitby-road","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":28.01,"statusNotes":"Asks whether her son remains beneath the Listener and sends the doctor to call him by name."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-2-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-7-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-staithe","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-dream-ledger"],"inventoryNotes":"","travelModeId":null,"sortKey":29,"statusNotes":"Waits above the slipway with the Ledger under his coat, then follows Agnes despite her request."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-2-1-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-7-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-staithe","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":29.01,"statusNotes":"Walks beside the ordered column while gripping one wrist with the other hand."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-2-1-annie","characterId":"undersong-char-annie","eventId":"undersong-event-7-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-staithe","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":29.02,"statusNotes":"Leads the paired pupils down Cliff Row toward the scar."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-2-1-joseph","characterId":"undersong-char-joseph","eventId":"undersong-event-7-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-staithe","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":29.03,"statusNotes":"Walks with the infant class in the procession down to the exposed shore."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-2-2-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-7-2-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-long-scar","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-dream-ledger"],"inventoryNotes":"","travelModeId":null,"sortKey":30,"statusNotes":"Watches the children return safely and calls after Agnes as she walks beyond his reach."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-2-2-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-7-2-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-long-scar","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":30.01,"statusNotes":"Uses the practiced classroom command to turn the pupils home before continuing alone toward the standing sea."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-2-2-tom","characterId":"un