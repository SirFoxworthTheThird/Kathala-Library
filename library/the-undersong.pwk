loc-church","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-dream-ledger"],"inventoryNotes":"","travelModeId":null,"sortKey":31.01,"statusNotes":"Stands at the back with the unopened Ledger and cannot speak the boy’s name."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-3-1-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-7-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-church","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":31.02,"statusNotes":"Sits in the third pew without looking up as her son passes."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-3-1-tom","characterId":"undersong-char-tom","eventId":"undersong-event-7-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-church","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-dark-stone"],"inventoryNotes":"","travelModeId":null,"sortKey":31.03,"statusNotes":"Asks for the stone, receives it gently, and carries it against his chest out of the church."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-4-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-7-4-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-village-square","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":32,"statusNotes":"Watches families leave from the top of Cliff Row without trying to count them."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-4-1-harker","characterId":"undersong-char-harker","eventId":"undersong-event-7-4-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-village-square","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":32.01,"statusNotes":"Finds the road passable at dawn and runs back to bring the news."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-4-1-annie","characterId":"undersong-char-annie","eventId":"undersong-event-7-4-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-village-square","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":32.02,"statusNotes":"Clings to the school gatepost until her father carries her away calling for her teacher."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-4-2-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-7-4-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":33,"statusNotes":"Stops in the doorway before the open register and refuses to sit at Agnes’s desk."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-4-3-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-7-4-3","isAlive":true,"currentLocationMarkerId":"undersong-loc-hesketh-house","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":34,"statusNotes":"Offers Ruth the reserved lorry place and stays with her until noon."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-7-4-3-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-7-4-3","isAlive":true,"currentLocationMarkerId":"undersong-loc-hesketh-house","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":34.01,"statusNotes":"Refuses evacuation and waits where she can see her son at the end of the scar."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-8-1-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-8-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-churchyard","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":35,"statusNotes":"Finds the vicar absent, reads the tracks leading past the scar toward the water, and locks the church without following them onward."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-8-1-2-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-8-1-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-hesketh-house","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-drawings"],"inventoryNotes":"","travelModeId":null,"sortKey":36,"statusNotes":"Keeps Ruth fed, closes the abandoned houses, and retrieves Annie’s drawings for his bag."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-8-1-2-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-8-1-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-hesketh-house","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":36.01,"statusNotes":"Eats when Ezra sits with her in the kitchen, remaining in the emptied village."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-8-1-3-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-8-1-3","isAlive":true,"currentLocationMarkerId":"undersong-loc-long-scar","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":37,"statusN