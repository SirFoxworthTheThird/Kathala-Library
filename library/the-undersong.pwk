-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-reveal-agnes-gone-tom","factId":"undersong-fact-agnes-gone","characterId":"undersong-char-tom","eventId":"undersong-event-7-2-2","note":"Learned by direct observation, testimony, or surviving record."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-reveal-pell-gone-tom","factId":"undersong-fact-pell-gone","characterId":"undersong-char-tom","eventId":"undersong-event-4-2-1","note":"Learned by direct observation, testimony, or surviving record."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-reveal-silas-gone-ezra","factId":"undersong-fact-silas-gone","characterId":"undersong-char-ezra","eventId":"undersong-event-8-1-1","note":"Learned by direct observation, testimony, or surviving record."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-reveal-ruth-gone-ezra","factId":"undersong-fact-ruth-gone","characterId":"undersong-char-ezra","eventId":"undersong-event-8-3-2","note":"Learned by direct observation, testimony, or surviving record."}],"factions":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-faction-village","name":"Hollin Staithe","description":"Fishing families, miners, children and tradespeople bound to one exposed coastal settlement.","color":"#5b6661","tags":[],"coverImageId":"undersong-image-factions-village"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-faction-mine","name":"Saltwick Ironstone Company","description":"The industrial concern operating the seaward drift and employing Pell and Tom.","color":"#5c5650","tags":[],"coverImageId":"undersong-image-factions-mine"},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-faction-parish","name":"St Oswald’s parish","de