Alive":true,"currentLocationMarkerId":"undersong-loc-church","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":11,"statusNotes":"Prays over the warm fragment and places it in the font when the note will not stop."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-1-1-tom","characterId":"undersong-char-tom","eventId":"undersong-event-3-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-church","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":11.01,"statusNotes":"Brings the fragment to the chancel and asks the vicar to silence it."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-1-1-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-3-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-church","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":11.02,"statusNotes":"Waits in the last pew and cries quietly while the prayers fail."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-2-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-3-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-hollow","currentMapLayerId":"undersong-map-drift","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":12,"statusNotes":"Enters the Hollow with a lamp and loses his ordinary sense of size and direction."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-2-1-wren","characterId":"undersong-char-wren","eventId":"undersong-event-3-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-hollow","currentMapLayerId":"undersong-map-drift","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":12.01,"statusNotes":"Warns the doctor against passing the lamp’s reach and leads both visitors back to daylight."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-2-1-pell","characterId":"undersong-char-pell","eventId":"undersong-event-3-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-hollow","currentMapLayerId":"undersong-map-drift","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":12.02,"statusNotes":"Admits the doctor to the drift and laughs when the vast darkness shifts."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-3-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-3-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-surgery","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":13,"statusNotes":"Measures an unvarying pulse, administers bromide, and questions Tom’s knowledge of the drowned."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-3-1-tom","characterId":"undersong-char-tom","eventId":"undersong-event-3-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-surgery","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":13.01,"statusNotes":"Lies feverish and describes the villagers as part of an indifferent song."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-3-1-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-3-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-surgery","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":13.02,"statusNotes":"Demands that her son stop listening, becomes sick in the passage, and keeps her vigil in the doorway."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-4-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-3-4-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":14,"statusNotes":"Reads the children’s exact testimony at the high desk, believes Agnes, and takes her hand."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-3-4-1-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-3-4-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":14.01,"statusNotes":"Shows the changed dream accounts and asks Ezra to preserve her book if anything happens to her."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-1-1-pell","characterId":"undersong-char-pell","eventId":"undersong-event-4-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-fourth-heading","currentMapLayerId":"undersong-map-drift","inventoryItemIds":["undersong-item-pell-book"],"inventoryNotes":"","travelModeId":null,"sortKey":15,"statusNotes":"Records hourly dial readings, admits that the instrument gives him something to hold, and asks Tom to stay."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-1-1-tom","characterId":"undersong-char-tom","eventId":"undersong-event-4-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-fourth-heading","currentMapLayerId":"undersong-map-drift","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":15.01,"statusNotes":"Brings food, reads the pocketbook over Pell’s shoulder, and sits beside the camp bed to listen."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-2-1-pell","characterId":"undersong-char-pell","eventId":"undersong-event-4-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-fourth-heading","currentMapLayerId":"undersong-map-drift","inventoryItemIds":["undersong-item-pell-book"],"inventoryNotes":"","travelModeId":null,"sortKey":16,"statusNotes":"Pries off the boards and walks beyond the lamp’s apparent distance until his light disappears."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-2-1-tom","characterId":"undersong-char-tom","eventId":"undersong-event-4-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-fourth-heading","currentMapLayerId":"undersong-map-drift","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":16.01,"statusNotes":"Wakes at the silence, tries to warn Pell, and escapes as the gallery folds shut behind him."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-2-2-tom","characterId":"undersong-char-tom","eventId":"undersong-event-4-2-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-drift-mouth","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":17,"statusNotes":"Emerges at a quarter to three with torn clothes, bleeding ears, and the skin stripped from his hands."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-2-2-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-4-2-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-drift-mouth","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":17.01,"statusNotes":"Witnesses the miners’ desperate digging and is frightened by Bower’s unresisting struggle."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-2-2-bower","characterId":"undersong-char-bower","eventId":"undersong-event-4-2-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-drift-mouth","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":17.02,"statusNotes":"Breaks his pick against the settled hill, claws at the earth, and is dragged back to the road."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-2-3-harker","characterId":"undersong-char-harker","eventId":"undersong-event-4-2-3","isAlive":true,"currentLocationMarkerId":"undersong-loc-staithe","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":18,"statusNotes":"Argues about the impossible withdrawal before falling silent with his head tilted."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-2-3-silas","characterId":"undersong-char-silas","eventId":"undersong-event-4-2-3","isAlive":true,"currentLocationMarkerId":"undersong-loc-staithe","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":18.01,"statusNotes":"Tries to gather the village and catches Mrs Ainsley’s sleeve, then lets her continue toward the shore."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-3-1-silas","characterId":"undersong-char-silas","eventId":"undersong-event-4-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-churchyard","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":19,"statusNotes":"Begins the burial service but abandons the committal after asking whose ground receives the coffin."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-3-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-4-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-churchyard","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":19.01,"statusNotes":"Walks with Agnes, prompts the stalled vicar, and watches Wren finish the service."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-3-1-wren","characterId":"undersong-char-wren","eventId":"undersong-event-4-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-churchyard","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":19.02,"statusNotes":"Waits at the lychgate and completes the committal from memory after the vicar leaves."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-3-1-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-4-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-churchyard","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":19.03,"statusNotes":"Walks beside Ezra in the rain with the funeral procession."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-3-1-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-4-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-churchyard","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":19.04,"statusNotes":"Walks alone behind the coffin filled with spoil."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-4-3-1-tom","characterId":"undersong-char-tom","eventId":"undersong-event-4-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-churchyard","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":19.05,"statusNotes":"Follows at the back with bandaged hands extended and a space around him."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-5-1-1-tom","characterId":"undersong-char-tom","eventId":"undersong-event-5-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-long-scar","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":20,"statusNotes":"Remains on the last ledge without eating while the tides stop short of his knees."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-5-1-1-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-5-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-long-scar","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":20.01,"statusNotes":"Brings food, withdraws from the ledge, and struggles to say the name of the son she remembers."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-5-1-1-harker","characterId":"undersong-char-harker","eventId":"undersong-event-5-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-long-scar","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":20.02,"statusNotes":"Sits beside Tom and tells the village that the boy listens on their behalf."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-5-2-1-silas","characterId":"undersong-char-