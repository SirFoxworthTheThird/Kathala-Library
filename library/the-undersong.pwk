{"version":18,"type":"world","exportedAt":1792195200000,"world":{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"the-undersong-world","name":"The Undersong","description":"In an Edwardian North Riding village, a wrong tide, a sound below hearing and records kept by doctor, teacher and mine manager draw the coast toward an impossible low water.","coverImageId":"undersong-image-world-cover","theme":"theme-horror","readingMode":true,"continuityStaleThreshold":5,"wordTarget":15530,"calendar":{"startYear":1911,"yearSuffix":"","months":[{"name":"September","days":30},{"name":"October","days":31},{"name":"November","days":30},{"name":"December","days":31}]}},"mapLayers":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-map-coast","name":"The North Riding Coast","description":"A topographic coastal chart of the Whitby and ironstone country, with Hollin Staithe placed as a fictional village between cliff, railway, road and sea.","parentMapId":null,"imageId":"undersong-image-maps-coast","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-map-village","name":"Hollin Staithe","description":"An interpretive village plan following the manuscript’s cliff road, church hill, school, staithe, scar and drift.","parentMapId":"undersong-map-coast","imageId":"undersong-image-maps-village","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":1,"levelLabel":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-map-drift","name":"Saltwick Drift","description":"An interpretive sectional mine plan from adit to fourth heading and the opening beyond it.","parentMapId":"undersong-map-village","imageId":"undersong-image-maps-drift","imageWidth":1600,"imageHeight":1000,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":2,"levelLabel":null}],"locationMarkers":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-hollin","name":"Hollin Staithe","description":"A small ironstone and fishing village held between the North Riding cliffs and the sea.","mapLayerId":"undersong-map-coast","linkedMapLayerId":"undersong-map-village","x":800,"y":550,"iconType":"building","imageId":"undersong-image-locations-hollin","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-whitby","name":"Whitby","description":"The larger coastal town reached by the only road out of Hollin Staithe.","mapLayerId":"undersong-map-coast","linkedMapLayerId":null,"x":1420,"y":210,"iconType":"landmark","imageId":"undersong-image-locations-whitby","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-loftus","name":"Loftus","description":"The inland ironstone town from which the company sends lorries.","mapLayerId":"undersong-map-coast","linkedMapLayerId":null,"x":100,"y":870,"iconType":"landmark","imageId":"undersong-image-locations-loftus","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-surgery","name":"Coyle’s surgery","description":"Ezra’s rooms above Cliff Row, with a surgery window facing the bay.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":560,"y":760,"iconType":"landmark","imageId":"undersong-image-locations-surgery","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-cliff-row","name":"Cliff Row","description":"The steep row of cottages above the scaur and the road between doctor, school and shore.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":730,"y":700,"iconType":"landmark","imageId":"undersong-image-locations-cliff-row","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-hesketh-house","name":"The Hesketh house","description":"Ruth and Tom’s cottage, its kitchen looking between other houses toward the Long Scar.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":815,"y":685,"iconType":"landmark","imageId":"undersong-image-locations-hesketh-house","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-school","name":"Hollin Staithe school","description":"A village classroom with a high desk, blackboard, stove and windows toward the shore.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":1080,"y":790,"iconType":"landmark","imageId":"undersong-image-locations-school","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-agnes-house","name":"Agnes Merriman’s house","description":"The schoolmistress’s small house where the Dream Ledger is kept after the dreams deepen.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":850,"y":660,"iconType":"landmark","imageId":"undersong-image-locations-agnes-house","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-church","name":"St Oswald’s church","description":"The parish church above the shore, built over old flags with a stone font near the west door.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":835,"y":810,"iconType":"landmark","imageId":"undersong-image-locations-church","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-churchyard","name":"Churchyard","description":"A salt-blown burial ground around St Oswald’s, overlooking the sea.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":760,"y":825,"iconType":"landmark","imageId":"undersong-image-locations-churchyard","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-memorial","name":"Lifeboat memorial","description":"A granite memorial inside the churchyard bearing the names of Hollin Staithe’s drowned.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":805,"y":750,"iconType":"landmark","imageId":"undersong-image-locations-memorial","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-staithe","name":"The staithe and slipway","description":"The working shore where cobles are drawn up beneath Cliff Row.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":950,"y":500,"iconType":"landmark","imageId":"undersong-image-locations-staithe","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-long-scar","name":"Long Scar","description":"A black rock reef running from the bay toward deep water, exposed farther as the tides fail.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":1150,"y":200,"iconType":"landmark","imageId":"undersong-image-locations-long-scar","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-seabed","name":"The bared seabed","description":"Normally drowned ground beyond the scar, revealed as the sea withdraws past every chart.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":1380,"y":100,"iconType":"landmark","imageId":"undersong-image-locations-seabed","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-village-square","name":"Village square","description":"The open ground between church, cottages and roads where Hollin Staithe gathers.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":905,"y":670,"iconType":"landmark","imageId":"undersong-image-locations-village-square","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-whitby-road","name":"Whitby road","description":"The village’s one road inland, climbing between hedges beyond the last cottage.","mapLayerId":"undersong-map-village","linkedMapLayerId":null,"x":340,"y":825,"iconType":"landmark","imageId":"undersong-image-locations-whitby-road","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-drift-mouth","name":"Saltwick drift mouth","description":"The timbered adit entrance below the cliff, leading down beneath the sea.","mapLayerId":"undersong-map-village","linkedMapLayerId":"undersong-map-drift","x":365,"y":555,"iconType":"building","imageId":"undersong-image-locations-drift-mouth","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-adit","name":"Main adit","description":"The sloping underground road carrying men, trams and pump lines into Saltwick drift.","mapLayerId":"undersong-map-drift","linkedMapLayerId":null,"x":140,"y":290,"iconType":"landmark","imageId":"undersong-image-locations-adit","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-fourth-heading","name":"Fourth heading","description":"The seaward heading eleven hundred yards from daylight where dark warm stone appears.","mapLayerId":"undersong-map-drift","linkedMapLayerId":null,"x":1160,"y":625,"iconType":"landmark","imageId":"undersong-image-locations-fourth-heading","tags":[],"factionId":null},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-loc-hollow","name":"The hollow beyond the face","description":"An opening in the rock whose apparent distance exceeds the dimensions of the mine.","mapLayerId":"undersong-map-drift","linkedMapLayerId":null,"x":1400,"y":760,"iconType":"landmark","imageId":"undersong-image-locations-hollow","tags":[],"factionId":null}],"characters":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-bower","name":"Jack Bower","aliases":[],"description":"A Saltwick night-shift miner who sets to work at the blocked entrance with his pick.","color":"#716356","portraitImageId":"undersong-image-characters-bower","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-ezra","name":"Ezra Coyle","aliases":[],"description":"A village doctor who records whatever refuses to agree with expectation.","color":"#687477","portraitImageId":"undersong-image-characters-ezra","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-agnes","name":"Agnes Merriman","aliases":[],"description":"The Hollin Staithe schoolmistress, exact in observation and practiced in commanding a room.","color":"#7a665d","portraitImageId":"undersong-image-characters-agnes","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-tom","name":"Tom Hesketh","aliases":[],"description":"A nineteen-year-old ironstone miner who hears something beneath the fourth heading.","color":"#555f61","portraitImageId":"undersong-image-characters-tom","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[{"eventId":"undersong-event-5-1-1","name":"The Listener"}]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-ruth","name":"Ruth Hesketh","aliases":[],"description":"Tom's mother, direct in speech and unwilling to abandon him.","color":"#755d52","portraitImageId":"undersong-image-characters-ruth","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-pell","name":"Jonah Pell","aliases":[],"description":"The Saltwick drift manager, methodical and accustomed to inspecting the face himself.","color":"#4e5651","portraitImageId":"undersong-image-characters-pell","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-wren","name":"Abel Wren","aliases":[],"description":"A pale Admiralty surveyor who says that he reads the drowned.","color":"#657078","portraitImageId":"undersong-image-characters-wren","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[{"eventId":"undersong-event-6-2-1","name":"Elias Coyle"}]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-silas","name":"Silas Tunstall","aliases":[],"description":"The village vicar, long practiced in the parish rituals of a coastal village.","color":"#6b6254","portraitImageId":"undersong-image-characters-silas","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-harker","name":"Old Harker","aliases":[],"description":"An elderly coble-man who knows the bay and watches its impossible tides.","color":"#59676a","portraitImageId":"undersong-image-characters-harker","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-annie","name":"Annie Ward","aliases":[],"description":"A six-year-old pupil whose drawing shows the sea above the shore.","color":"#856f62","portraitImageId":"undersong-image-characters-annie","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-char-joseph","name":"Joseph Ainsley","aliases":[],"description":"A seven-year-old pupil who usually draws engines and now dreams of the shore.","color":"#6f7567","portraitImageId":"undersong-image-characters-joseph","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]}],"items":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-item-daybook","name":"Ezra’s daybook","description":"The medical daybook in which Ezra first records and crosses out the wrong tide and late bell.","iconType":"book","imageId":"undersong-image-items-daybook","tags":[],"isCollective":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-item-dark-stone","name":"Dark stone","description":"A warm dark fragment taken from the opened face, faintly humming with the same held note.","iconType":"gem","imageId":"undersong-image-items-dark-stone","tags":[],"isCollective":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-item-hydrophone","name":"Admiralty hydrophone","description":"A brass and gutta-percha listening instrument with earpieces and a trembling dial.","iconType":"tool","imageId":"undersong-image-items-hydrophone","tags":[],"isCollective":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-item-dream-ledger","name":"Dream Ledger","description":"Agnes’s marbled exercise book recording the children’s dreams and the altered tides.","iconType":"book","imageId":"undersong-image-items-dream-ledger","tags":[],"isCollective":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-item-pell-book","name":"Pell’s pocketbook","description":"The manager’s increasingly altered hourly record beside the fourth heading.","iconType":"book","imageId":"undersong-image-items-pell-book","tags":[],"isCollective":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-item-watch","name":"Elias’s watch","description":"A plain silver watch recovered without its owner, stopped at seventeen minutes past three.","iconType":"clock","imageId":"undersong-image-items-watch","tags":[],"isCollective":false},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-item-drawings","name":"Children’s drawings","description":"Thirty-one pictures of a shore with the sea drawn above it.","iconType":"document","imageId":"undersong-image-items-drawings","tags":[],"isCollective":true}],"characterSnapshots":[{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-1-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-1-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-surgery","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-daybook"],"inventoryNotes":"","travelModeId":null,"sortKey":1,"statusNotes":"Watches the ebb pass the third marker, then writes and crosses out two observations in his medical daybook."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-1-2-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-1-1-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-cliff-row","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":2,"statusNotes":"Fetches his medical bag and accompanies Ruth to examine Tom’s bleeding ears."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-1-2-ruth","characterId":"undersong-char-ruth","eventId":"undersong-event-1-1-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-cliff-row","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":2.01,"statusNotes":"Calls for the doctor and describes the continuing noise her son hears."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-2-1-tom","characterId":"undersong-char-tom","eventId":"undersong-event-1-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-fourth-heading","currentMapLayerId":"undersong-map-drift","inventoryItemIds":["undersong-item-dark-stone"],"inventoryNotes":"","travelModeId":null,"sortKey":3,"statusNotes":"Levers the plated face open, pockets Pell’s fragment, and begins bleeding from both ears."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-2-1-pell","characterId":"undersong-char-pell","eventId":"undersong-event-1-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-fourth-heading","currentMapLayerId":"undersong-map-drift","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3.01,"statusNotes":"Works the pick beside Tom, holds the lamp to the opening, and sends the fragment up with the boy."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-3-1-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-1-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-drawings"],"inventoryNotes":"","travelModeId":null,"sortKey":4,"statusNotes":"Compares thirty-one inverted shores and questions the pupils separately about their dreams."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-3-1-annie","characterId":"undersong-char-annie","eventId":"undersong-event-1-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":4.01,"statusNotes":"Explains that the shore in her drawing is the right way up when she goes there in sleep."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-3-1-joseph","characterId":"undersong-char-joseph","eventId":"undersong-event-1-3-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":4.02,"statusNotes":"Submits an inverted-shore drawing instead of his customary engines."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-3-2-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-1-3-2","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-dream-ledger"],"inventoryNotes":"","travelModeId":null,"sortKey":5,"statusNotes":"Releases the pupils, opens the marbled exercise book, and records each child’s account until the light fails."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-3-3-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-1-3-3","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6,"statusNotes":"Claps twice and restores classroom attention with a familiar command."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-3-3-annie","characterId":"undersong-char-annie","eventId":"undersong-event-1-3-3","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6.01,"statusNotes":"Stops with the class and answers the teacher’s practiced signal."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-3-3-joseph","characterId":"undersong-char-joseph","eventId":"undersong-event-1-3-3","isAlive":true,"currentLocationMarkerId":"undersong-loc-school","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6.02,"statusNotes":"Stops whispering behind his slate and turns his eyes to the teacher."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-1-3-4-agnes","characterId":"undersong-char-agnes","eventId":"undersong-event-1-3-4","isAlive":true,"currentLocationMarkerId":"undersong-loc-agnes-house","currentMapLayerId":"undersong-map-village","inventoryItemIds":["undersong-item-dream-ledger"],"inventoryNotes":"","travelModeId":null,"sortKey":7,"statusNotes":"Records the early tide at her kitchen table and stays awake to avoid the dream shore."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-2-1-1-ezra","characterId":"undersong-char-ezra","eventId":"undersong-event-2-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-memorial","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":8,"statusNotes":"Introduces himself to the surveyor and notices the strange palm print left over his brother’s name."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-2-1-1-wren","characterId":"undersong-char-wren","eventId":"undersong-event-2-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-memorial","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":8.01,"statusNotes":"Reads the drowned names, introduces himself as an Admiralty surveyor, and listens to the church floor."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-2-1-1-silas","characterId":"undersong-char-silas","eventId":"undersong-event-2-1-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-memorial","currentMapLayerId":"undersong-map-village","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":8.02,"statusNotes":"Welcomes the visitor and asks whether his soundings concern the strange tides."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-2-2-1-wren","characterId":"undersong-char-wren","eventId":"undersong-event-2-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-fourth-heading","currentMapLayerId":"undersong-map-drift","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":9,"statusNotes":"Sets up the tripod instrument and orders hourly readings without further excavation."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-2-2-1-pell","characterId":"undersong-char-pell","eventId":"undersong-event-2-2-1","isAlive":true,"currentLocationMarkerId":"undersong-loc-fourth-heading","currentMapLayerId":"undersong-map-drift","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":9.01,"statusNotes":"Listens through the earpieces, sits down shaken, and asks how long the Admiralty has known."},{"worldId":"the-undersong-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"undersong-snapshot-2-2-1-tom","characterId":"undersong-char-tom","eventId":"und