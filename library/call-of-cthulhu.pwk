ary/call-of-cthulhu/art/items/telescope.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-items-wheel","mimeType":"image/png","url":"library/call-of-cthulhu/art/items/wheel.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-world-cover","mimeType":"image/png","url":"library/call-of-cthulhu/art/world.png"}],"relationships":[{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-relationship-1","characterAId":"coc-char-thurston","characterBId":"coc-char-angell","label":"Grand-nephew and grand-uncle","sentiment":"positive","description":"Thurston inherits the scholar’s papers and intellectual burden.","strength":6,"isBidirectional":true,"startEventId":"coc-event-1-1"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-relationship-2","characterAId":"coc-char-angell","characterBId":"coc-char-wilcox","label":"Scholar and witness","sentiment":"mixed","description":"Angell questions a sculptor whose dreams resist ordinary explanation.","strength":6,"isBidirectional":true,"startEventId":"coc-event-1-2"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-relationship-3","characterAId":"coc-char-angell","characterBId":"coc-char-legrasse","label":"Consulted scholar and investigator","sentiment":"positive","description":"Legrasse brings an object Angell helps compare with other evidence.","strength":6,"isBidirectional":true,"startEventId":"coc-event-2-1"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-relationship-4","characterAId":"coc-char-legrasse","characterBId":"coc-char-webb","label":"Investigators comparing evidence","sentiment":"positive","description":"The policeman’s idol matches the anthropologist’s northern memory.","strength":6,"isBidirectional":true,"startEventId":"coc-event-2-1"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-relationship-5","characterAId":"coc-char-legrasse","characterBId":"coc-char-castro","label":"Interrogator and prisoner","sentiment":"negative","description":"Legrasse questions a captive who speaks more freely than the others.","strength":6,"isBidirectional":true,"startEventId":"coc-event-2-4"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-relationship-6","characterAId":"coc-char-johansen","characterBId":"coc-char-briden","label":"Shipmates","sentiment":"positive","description":"The last two sailors return to the Alert together.","strength":6,"isBidirectional":true,"startEventId":"coc-event-3-2"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-relationship-7","characterAId":"coc-char-thurston","characterBId":"coc-char-emma","label":"Visitor and widow","sentiment":"positive","description":"A shared concern for Johansen’s record gives Thurston access to the manuscript.","strength":6,"isBidirectional":true,"startEventId":"coc-event-3-2"}],"relationshipSnapshots":[],"timelines":[{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"call-of-cthulhu-timeline","name":"Thurston’s Assembled Record","description":"The three authorial sections in reading order; embedded events from 1907, 1908, and 1925 are marked as retrospective testimony.","color":"#50645d","dayOffset":0}],"plotThreads":[{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-thread-papers","name":"Angell’s Papers","description":"An inherited box makes a private scholarly puzzle available to a skeptical reader.","color":"#536b63","status":"complete","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-thread-cult","name":"The Hidden Cult","description":"Matching words and images connect distant rites without making their full meaning safe.","color":"#536b63","status":"complete","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-thread-sea","name":"The Emma and the Alert","description":"A newspaper report leads from two ships to an uncharted Pacific place.","color":"#536b63","status":"complete","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-thread-correlation","name":"Dissociated Knowledge","description":"Separate observations become dangerous when a mind begins to join them.","color":"#536b63","status":"complete","tags":[]}],"motifs":[{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-motif-dreams","name":"Dreams and Fever","description":"Sleep, delirium, and creative vision carry impressions ordinary inquiry cannot explain.","color":"#64746b","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-motif-images","name":"Repeated Images","description":"Clay, stone, sketches, and carvings preserve the same unsettling outline.","color":"#64746b","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-motif-documents","name":"Documents and Testimony","description":"The tale reaches its narrator through boxes, reports, clippings, interviews, and a sailor’s manuscript.","color":"#64746b","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-motif-sea","name":"Black Seas","description":"Oceans divide the evidence while concealing the place to which it points.","color":"#64746b","tags":[]}],"loreCategories":[{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-category-edition","name":"Edition and Reading","color":"#796d5d","sortOrder":0},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-category-world","name":"The Recorded World","color":"#52675e","sortOrder":1}],"lorePages":[{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-source","categoryId":"coc-lore-category-edition","title":"Source Edition","body":"Scene drafts reproduce The Call of Cthulhu by H. P. Lovecraft, Project Gutenberg eBook #68283, based on Weird Tales (February 1928), updated 18 October 2024. Source: https://www.gutenberg.org/ebooks/68283. SHA-256: db20dc8b4b2a58af9462c2f66d3deefa843c3bce4390b825f74d31ca231eedca. Project Gutenberg framing and licence text are excluded; the story title, byline, transcriber’s note, epigraph, original illustration caption, footnote, three headings, and complete prose are retained. Original English; no translator. First published in the United States in 1928 and now public domain there.","visibleFromEventId":"coc-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-structure","categoryId":"coc-lore-category-edition","title":"A Tale in Three Records","body":"The story’s three headings are Lovecraft’s own. Each section nests older testimony inside Thurston’s account, so the reading chronology moves backward and forward as documents are opened.","visibleFromEventId":"coc-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-calendar","categoryId":"coc-lore-category-edition","title":"Dates and Narrative Order","body":"The timeline follows reading order. Historical dates stated in the text range from the 1907 Louisiana raid through Thurston’s later inquiry; retrospective scenes are marked as such rather than forced into a false continuous calendar.","visibleFromEventId":"coc-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-art","categoryId":"coc-lore-category-edition","title":"Text, Maps, and Illustrations","body":"The cover, portraits, objects, locations, and interpretive maps are original generated artwork in a restrained 1920s ink-and-oil style. Maps are reading aids rather than surveyed historical claims.","visibleFromEventId":"coc-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-rlyeh","categoryId":"coc-lore-category-world","title":"R’lyeh","body":"The name first appears in Wilcox’s dream reports, attached to a city of dripping stone and unfamiliar geometry.","visibleFromEventId":"coc-event-1-2","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-cult","categoryId":"coc-lore-category-world","title":"The Cthulhu Cult","body":"Legrasse’s evidence describes a secret tradition scattered among isolated communities and maritime routes.","visibleFromEventId":"coc-event-2-4","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-lore-coordinates","categoryId":"coc-lore-category-world","title":"The Pacific Coordinates","body":"Johansen’s record fixes the risen island near 47° 9′ south, 126° 43′ west.","visibleFromEventId":"coc-event-3-3","tags":[],"coverImageId":null,"linkedEntityIds":[]}],"knowledgeFacts":[{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-fact-dream","title":"Wilcox formed the relief after a dream","description":"The sculptor says the wet clay took shape after his vision of a vast city.","readerLearnsAtEventId":"coc-event-1-2","originEventId":"coc-event-1-2","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-fact-parallel","title":"The strange dreams occurred worldwide","description":"Angell’s collected reports cluster around Wilcox’s fever in March and April 1925.","readerLearnsAtEventId":"coc-event-1-3","originEventId":"coc-event-1-3","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-fact-match","title":"Webb recognizes the idol’s design","description":"The Louisiana statuette and Webb’s Greenland memory share image and chant.","readerLearnsAtEventId":"coc-event-2-2","originEventId":"coc-event-2-2","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-fact-cult","title":"The prisoners describe an ancient secret cult","description":"Castro’s testimony supplies names and beliefs guarded across generations.","readerLearnsAtEventId":"coc-event-2-4","originEventId":"coc-event-2-4","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-fact-alert","title":"Johansen survived aboard the Alert","description":"The Sydney report names the rescued second mate and the captured yacht.","readerLearnsAtEventId":"coc-event-3-1","originEventId":"coc-event-3-1","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-fact-manuscript","title":"Johansen left a private English account","description":"His widow preserves a document intended to keep its subject from casual readers.","readerLearnsAtEventId":"coc-event-3-2","originEventId":"coc-event-3-2","tags":[]},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-fact-island","title":"The sailors landed on R’lyeh","description":"Johansen identifies the risen city behind the newspaper’s unnamed island.","readerLearnsAtEventId":"coc-event-3-3","originEventId":"coc-event-3-3","tags":[]},{"worldId":"call-of-cthulhu-world","cr