lhu/art/locations/brown.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-wilcox-studio","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/wilcox-studio.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-waterfront","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/waterfront.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-bayou-landing","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/bayou-landing.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-squatter-village","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/squatter-village.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-cult-clearing","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/cult-clearing.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-police-camp","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/police-camp.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-landing","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/landing.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-cyclopean-city","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/cyclopean-city.png"},{"worldId":"call-of-cthulhu-world","createdAt":1790035200000,"updatedAt":1790035200000,"id":"coc-image-locations-great-door","mimeType":"image/png","url":"library/call-of-cthulhu/art/locations/great-door.png"},{"worldId":"call-of-cthulhu-world","createdAt"