  "mapRoutes": [],
  "loreCategories": [
    {
      "worldId": "os-lusiadas-pt-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-pt-lore-reading",
      "name": "Ler o poema",
      "description": "A edição e os seus enquadramentos narrativos.",
      "sortOrder": 0
    }
  ],
  "lorePages": [
    {
      "worldId": "os-lusiadas-pt-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-pt-lore-edition",
      "categoryId": "os-lusiadas-pt-lore-reading",
      "title": "Texto e ortografia",
      "body": "Esta edição reproduz o texto português de 1572 transcrito no eBook n.º 27236 do Project Gutenberg. Conserva a ortografia histórica, o s longo, as abreviaturas, a pontuação e a ordem dos versos. A inicial ornamentada da primeira estrofe de cada canto é reunida aos restantes versos dessa estrofe. Foram excluídos apenas os elementos de apresentação documentados no registo da fonte. O poema encontra-se em domínio público.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-pt-event-01-001"
    },
    {
      "worldId": "os-lusiadas-pt-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-pt-lore-frames",
      "categoryId": "os-lusiadas-pt-lore-reading",
      "title": "Viagem, memória e deuses",
      "body": "Os cantos seguem a ordem em que Camões conta a história. A armada surge já no mar; mais tarde, Gama recorda a história de Portugal e a viagem de ida. Os deuses intervêm num plano épico paralelo. O poeta dirige-se também ao rei. Estas vozes não formam uma única cronologia literal.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-pt-event-01-019"
    },
    {
      "worldId": "os-lusiadas-pt-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-pt-lore-calendar",
      "categoryId": "os-lusiadas-pt-lore-reading",
      "title": "Datas editoriais",
      "body": "As datas do calendário servem para orientar a leitura. Os marcos conhecidos da viagem seguem um diário contemporâneo; as cenas intermédias receberam datas interpoladas. A história anterior usa anos aproximados, o relato dos Doze de Inglaterra não tem dia seguro e a ação divina segue um tempo próprio. O poema não data todas as cenas.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-pt-event-03-001"
    },
    {
      "worldId": "os-lusiadas-pt-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-pt-lore-maps",
      "categoryId": "os-lusiadas-pt-lore-reading",
      "title": "Cartas e lugares",
      "body": "As cartas oceânicas e costeiras usam linhas de costa reais e relevo sombreado. A rota assinalada representa o percurso da armada em traços gerais; as posições exatas no mar aberto são editoriais. As posições dos marcadores são aproximadas.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-pt-event-01-019"
    },
    {
      "worldId": "os-lusiadas-pt-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-pt-lore-allegory-map",
      "categoryId": "os-lusiadas-pt-lore-reading",
      "title": "A ilha e os cenários divinos",
      "body": "As cartas da Ilha dos Amores e dos cenários divinos usam relevo interpretativo para tornar legíveis lugares narrados no poema. Não representam um levantamento topográfico nem atribuem coordenadas terrestres a esses espaços alegóricos.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-pt-event-09-021"
    },
    {
      "worldId": "os-lusiadas-pt-world",
      "createdAt": 1791504000000,
      "updatedAt": 1791504000000,
      "id": "os-lusiadas-pt-lore-artwork",
      "categoryId": "os-lusiadas-pt-lore-reading",
      "title": "Ilustrações e fontes cartográficas",
      "body": "A capa, os retratos, os objetos, os lugares e as fações partilham as ilustrações geradas para a outra entrada de Os Lusíadas com OpenAI imagegen em outubro de 2026. São interpretações visuais, não retratos históricos. As cinco cartas geográficas usam polígonos de terra Natural Earth 1:10m e relevo sombreado Natural Earth, de domínio público. A rota e as três cartas de lugares alegóricos são composições editoriais; as oito cartas desta entrada têm títulos e rótulos em português.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "os-lusiadas-pt-event-01-001"
    }
  ],
