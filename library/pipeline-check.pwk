  "lorePages": [
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-1",
      "categoryId": "pipeline-check-lore-category-duality",
      "title": "Jekyll and Hyde Are One Embodied Person",
      "body": "The example models Jekyll and Hyde as separate character records so snapshots, knowledge, and relationships can show which identity is manifest at an event. The relationship between them records their shared body.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-34"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-2",
      "categoryId": "pipeline-check-lore-category-duality",
      "title": "Hyde’s Changing Strength",
      "body": "Hyde begins smaller because Jekyll has exercised that side of himself less. Repetition strengthens Hyde until he emerges without the draught.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-39"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-3",
      "categoryId": "pipeline-check-lore-category-science",
      "title": "The Transforming Draught",
      "body": "The draught combines a red tincture, measured powders, and a salt containing an unknown impurity. It separates and recombines embodied identity rather than merely disguising Jekyll.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-39"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-4",
      "categoryId": "pipeline-check-lore-category-science",
      "title": "The Impure Salt",
      "body": "The first salt works only because of an accidental impurity. Later supplies are chemically purer and therefore useless, making the experiment irreproducible.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-39"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-5",
      "categoryId": "pipeline-check-lore-category-society",
      "title": "Reputation and Blackmail",
      "body": "Utterson and Enfield initially interpret the connection through familiar Victorian fears: scandal, blackmail, inheritance, and the exploitation of a respectable man.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-1"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-6",
      "categoryId": "pipeline-check-lore-category-society",
      "title": "London’s Moral Geography",
      "body": "The novel contrasts respectable squares and professional interiors with fog, nocturnal streets, and Soho. Jekyll’s divided building makes that geography architectural.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-1"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-7",
      "categoryId": "pipeline-check-lore-category-documents",
      "title": "The Order of Disclosure",
      "body": "Enfield’s oral story, the will, Hyde’s forged letter, Lanyon’s sealed narrative, and Jekyll’s statement progressively replace inference with testimony.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-39"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-8",
      "categoryId": "pipeline-check-lore-category-documents",
      "title": "Handwriting as Evidence",
      "body": "Guest recognizes that Hyde’s hand and Jekyll’s hand share their structure. The clue approaches the truth while still allowing Utterson to imagine forgery.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-18"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-9",
      "categoryId": "pipeline-check-lore-category-duality",
      "title": "Responsibility",
      "body": "Jekyll describes Hyde as a separate self but also admits preparing his freedom, enjoying his acts, and using transformation to evade accountability.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-39"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-10",
      "categoryId": "pipeline-check-lore-category-society",
      "title": "Professional Friendship",
      "body": "Utterson, Jekyll, and Lanyon belong to an old male professional circle. Loyalty delays exposure but also preserves the documents that reveal the case.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-6"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-11",
      "categoryId": "pipeline-check-lore-category-sources",
      "title": "Editorial Calendar",
      "body": "The novel gives relative intervals more often than exact dates. Calendar dates in this example are an editorial reconstruction chosen to preserve stated seasons, elapsed intervals, and event order.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-1"
    },
    {
      "worldId": "pipeline-check-world",
      "createdAt": 1785528000000,
      "updatedAt": 1785528000000,
      "id": "pipeline-check-lore-12",
      "categoryId": "pipeline-check-lore-category-sources",
      "title": "Map and Image Sources",
      "body": "The manuscript contains the complete public-domain narrative text from Project Gutenberg eBook #43, divided across all ten chapters and forty-seven modeled events; Gutenberg packaging and the contents list are excluded. Maps use linked Wikimedia Commons images: Bacon’s 1890 London map, Charles Booth’s West Central poverty map, the 1880 Tower House plan, and an early nineteenth-century laboratory plan. The cover is a public-domain period theatrical poster. Character artwork uses public-domain Charles Raymond Macauley illustrations from the 1904 edition. Item artwork uses Google Noto Color Emoji through Iconify. No image blobs are embedded.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "pipeline-check-event-1"
    }
  ],
