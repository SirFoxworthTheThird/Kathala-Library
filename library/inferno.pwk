"characterId":"inferno-char-francesca","eventId":"inferno-event-5-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-two","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":19.02,"statusNotes":"Leaves Dido’s band with Paolo and answers the living traveller."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-5-3-paolo","characterId":"inferno-char-paolo","eventId":"inferno-event-5-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-two","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":19.03,"statusNotes":"Comes silently beside Francesca, borne with her on the wind."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-5-4-francesca","characterId":"inferno-char-francesca","eventId":"inferno-event-5-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-two","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":20,"statusNotes":"Names her city and speaks of love, death, and the shared fate awaiting their killer."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-5-4-paolo","characterId":"inferno-char-paolo","eventId":"inferno-event-5-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-two","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":20.01,"statusNotes":"Weeps without speaking beside Francesca."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-5-4-dante","characterId":"inferno-char-dante","eventId":"inferno-event-5-4","isAlive":true,"currentLocationMarkerId":"inferno-loc-circle-two","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":20.02,"statusNotes":"Bows his head under the weight of their sorrow."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-5-5-francesca","characterId":"inferno-char-francesca","eventId":"inferno-event-5-5","isAlive":false,"currentLocationMarkerId":"inferno-loc-rimini","currentMapLayerId":"inferno-map-history","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":21,"statusNotes":"Recalls the book, glance, and kiss through which desire overcame restraint."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-5-5-paolo","characterId":"inferno-char-paolo","eventId":"inferno-event-5-5","isAlive":false,"currentLocationMarkerId":"inferno-loc-rimini","currentMapLayerId":"inferno-map-history","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":21.01,"statusNotes":"Reads beside Francesca until the story of Lancelot brings them to their first kiss."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-1-dante","characterId":"inferno-char-dante","eventId":"inferno-event-6-1","isAlive":true,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":22,"statusNotes":"Returns to awareness amid ceaseless foul rain, hail, and snow."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-1-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-6-1","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":22.01,"statusNotes":"Continues through the third circle beside him."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-2-cerberus","characterId":"inferno-char-cerberus","eventId":"inferno-event-6-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":23,"statusNotes":"Barks from three throats and claws the gluttonous shades."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-2-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-6-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":23.01,"statusNotes":"Throws earth into the monster’s gullets to open their passage."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-2-dante","characterId":"inferno-char-dante","eventId":"inferno-event-6-2","isAlive":true,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":23.02,"statusNotes":"Walks across the prostrate forms after Cerberus is quieted."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-3-ciacco","characterId":"inferno-char-ciacco","eventId":"inferno-event-6-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":24,"statusNotes":"Rises from the mire, identifies himself by the nickname Ciacco, and appeals to a fellow Florentine."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-3-dante","characterId":"inferno-char-dante","eventId":"inferno-event-6-3","isAlive":true,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":24.01,"statusNotes":"Struggles to recognize the ruined face and asks about Florence’s divided future."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-3-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-6-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":24.02,"statusNotes":"Waits while the two Florentines speak."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-4-ciacco","characterId":"inferno-char-ciacco","eventId":"inferno-event-6-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":25,"statusNotes":"Predicts the city’s factional bloodshed and answers questions about notable citizens."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-4-dante","characterId":"inferno-char-dante","eventId":"inferno-event-6-4","isAlive":true,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":25.01,"statusNotes":"Learns that admired Florentines lie deeper below and asks to be remembered."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-6-4-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-6-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-circle-three","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":25.02,"statusNotes":"Explains the soul’s condition after the final judgment once Ciacco sinks back."},{"worldId":"inferno-world","c