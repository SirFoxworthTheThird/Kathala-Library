ony floor."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-30-2-myrrha","characterId":"inferno-char-myrrha","eventId":"inferno-event-30-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-bolgia-ten","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":161.01,"statusNotes":"Runs rabid through the ditch in the form of one who falsified herself for incest."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-30-2-dante","characterId":"inferno-char-dante","eventId":"inferno-event-30-2","isAlive":true,"currentLocationMarkerId":"inferno-loc-bolgia-ten","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":161.02,"statusNotes":"Watches Griffolino identify the two impersonators."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-30-2-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-30-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-bolgia-ten","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":161.03,"statusNotes":"Keeps Dante attentive to the next sufferers."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-30-3-masterAdam","characterId":"inferno-char-masterAdam","eventId":"inferno-event-30-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-bolgia-ten","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":162,"statusNotes":"Sits swollen and immobile with dropsy, tormented by thirst and the memory of clear streams."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-30-3-dante","characterId":"inferno-char-dante","eventId":