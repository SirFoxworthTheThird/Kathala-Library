ferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-initial-1","relationshipId":"inferno-relationship-virgil-beatrice","eventId":"inferno-event-2-3","label":"Commissioned guide and intercessor","sentiment":"positive","strength":8,"description":"Beatrice entrusts the endangered traveller to Virgil’s speech and care.","isActive":true,"sortKey":1},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-initial-2","relationshipId":"inferno-relationship-francesca-paolo","eventId":"inferno-event-5-3","label":"Bound lovers","sentiment":"positive","strength":8,"description":"The two move together in the wind and answer Dante’s call as one pair.","isActive":true,"sortKey":2},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-initial-3","relationshipId":"inferno-relationship-dante-brunetto","eventId":"inferno-event-15-2","label":"Former pupil and teacher","sentiment":"positive","strength":7,"description":"Dante recognizes a former teacher and addresses him with enduring respect.","isActive":true,"sortKey":3},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-initial-4","relationshipId":"inferno-relationship-ulysses-companions","eventId":"inferno-event-26-6","label":"Commander and aging crew","sentiment":"positive","strength":7,"description":"The companions share Ulysses’ final voyage beyond the known sea.","isActive":true,"sortKey":4},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-initial-5","relationshipId":"inferno-relationship-ugolino-ruggieri","eventId":"inferno-event-32-7","label":"Victim and enemy","sentiment":"negative","strength":1,"description":"Ugolino’s hatred is first visible through the punishment he inflicts on Ruggieri.","isActive":true,"sortKey":5},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-evening-doubt","relationshipId":"inferno-relationship-dante-virgil","eventId":"inferno-event-2-1","label":"Doubt tests trust","sentiment":"neutral","strength":5,"description":"Dante questions both his worth and the road Virgil proposes.","isActive":true,"sortKey":6},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-three-blessed-women","relationshipId":"inferno-relationship-dante-virgil","eventId":"inferno-event-2-4","label":"Courage restored","sentiment":"positive","strength":9,"description":"Virgil’s account of celestial concern restores Dante’s willingness to follow.","isActive":true,"sortKey":7},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-virgil-repulsed","relationshipId":"inferno-relationship-dante-virgil","eventId":"inferno-event-8-5","label":"Fear of abandonment","sentiment":"neutral","strength":5,"description":"The barred gate makes Dante fear that his guide may have to leave him.","isActive":true,"sortKey":8},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-malacoda’s-lie","relationshipId":"inferno-relationship-dante-virgil","eventId":"inferno-event-23-7","label":"Guidance under deception","sentiment":"neutral","strength":6,"description":"Virgil recognizes that another guide deliberately sent them toward a broken route.","isActive":true,"sortKey":9},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-dante’s-shame","relationshipId":"inferno-relationship-dante-virgil","eventId":"inferno-event-30-7","label":"Correction accepted","sentiment":"positive","strength":9,"description":"Virgil’s rebuke produces honest shame and immediate reconciliation.","isActive":true,"sortKey":10},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-relationship-state-to-rebehold-the-stars","relationshipId":"inferno-relationship-dante-virgil","eventId":"inferno-event-34-8","label":"The guidance fulfilled","sentiment":"positive","strength":10,"description":"Virgil leads Dante out from the hidden passage beneath the stars.","isActive":true,"sortKey":11}],"plotThreads":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-thread-descent","name":"The Descent","description":"Dante and Virgil move from the lost wood through the ordered depths toward the opposite hemisphere.","color":"#7b5548","status":"complete","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-thread-intercession","name":"Mercy Before the Journey","description":"Beatrice’s descent to Limbo explains why Virgil comes to the lost traveller.","color":"#7b5548","status":"complete","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-thread-francesca-memory","name":"Francesca’s Memory","description":"A remembered reading gives personal history to one encounter in the second circle.","color":"#7b5548","status":"complete","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-thread-mantua-history","name":"Mantua’s Legendary Origin","description":"Virgil corrects a foundation story while the travellers cross the diviners’ trench.","color":"#7b5548","status":"complete","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-thread-ulysses-voyage","name":"Beyond the Known World","description":"Ulysses recounts the purpose and last course of his final voyage.","color":"#7b5548","status":"complete","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-thread-guido-memory","name":"Counsel and Absolution","description":"Guido recounts the counsel he gave under a promise he believed could excuse it.","color":"#7b5548","status":"complete","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-thread-ugolino-memory","name":"The Sealed Tower","description":"Ugolino recounts the prison days that explain his hatred on the ice.","color":"#7b5548","status":"complete","tags":[]}],"motifs":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-motif-passage","name":"Gates, Bridges, and Crossings","description":"Thresholds make moral and physical descent visible through gates, ferries, rivers, bridges, cliffs, and the final hidden road.","color":"#806858","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-motif-speech","name":"Testimony and Name","description":"The dead speak through confession, prophecy, defiance, evasion, and requests for remembrance.","color":"#806858","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-motif-body","name":"The Altered Body","description":"Wind, mud, fire, wounds, disease, ice, and metamorphosis give each encounter a distinct bodily form.","color":"#806858","tags":[]}],"loreCategories":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-category-edition","name":"Edition","description":"Reader-facing context grounded in Dante’s poem and the Longfellow edition.","color":"#745c50","sortOrder":0},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-category-journey","name":"Journey","description":"Reader-facing context grounded in Dante’s poem and the Longfellow edition.","color":"#745c50","sortOrder":1},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-category-form","name":"Poetic form","description":"Reader-facing context grounded in Dante’s poem and the Longfellow edition.","color":"#745c50","sortOrder":2}],"lorePages":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-source","categoryId":"inferno-lore-category-edition","title":"Text, translation, and rights","body":"This reading edition preserves all 34 cantos, 4,720 verse lines, and 37,417 words from Project Gutenberg eBook #1001, Henry Wadsworth Longfellow’s English translation of Inferno. Dante died in 1321 and Longfellow in 1882; Project Gutenberg marks the edition public domain in the United States. Downloaded source SHA-256: 10fad2f10aaffec3bfe3fd63266544f7fd5bba576cd5c63afe68e8212849754d.","visibleFromEventId":"inferno-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-structure","categoryId":"inferno-lore-category-form","title":"Thirty-four cantos","body":"Inferno is the first canticle of the Divine Comedy and contains thirty-four cantos. The canto headings here preserve Dante’s numbered structure; scene titles are reading aids that appear only with their passages.","visibleFromEventId":"inferno-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-terza","categoryId":"inferno-lore-category-form","title":"Terza rima in translation","body":"Dante’s Italian poem is built in interlocking tercets. Longfellow preserves the three-line grouping and much of the syntax while using unrhymed English verse. This edition preserves every source verse line.","visibleFromEventId":"inferno-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-geography","categoryId":"inferno-lore-category-journey","title":"The shape of Hell","body":"The maps follow the poem’s immense funnel beneath the inhabited hemisphere: upper circles above Dis, violence below the city, ten trenches of fraud, and frozen Cocytus at Earth’s centre. They are interpretive reading maps rather than claims of measurable scale.","visibleFromEventId":"inferno-event-3-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-chronology","categoryId":"inferno-lore-category-journey","title":"Journey and remembered histories","body":"The descent follows the traditional Good Friday to Easter-morning sequence in 1300. Fractions locate ordered scenes within those days and do not claim measured travel duration. Beatrice’s intercession and the narrated histories of Francesca, Mantua, Ulysses, Guido, and Ugolino use separate timelines so memory is not mistaken for action occurring during the descent. Ancient and medieval offsets are approximate editorial positions documented by each timeline.","visibleFromEventId":"inferno-event-2-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-lore-art","categoryId":"inferno-lore-category-edition","title":"Illustration provenance","body":"The world, portraits, objects, places, and topographic maps are original OpenAI ImageGen illustrations made for this edition. They use a mature late-medieval manuscript and engraved relief-map language without imitating any single historical illustrator.","visibleFromEventId":"inferno-event-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]}],"knowledgeFacts":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-fact-virgil","title":"The shade is Virgil","description":"The shade in the wood identifies himself as the Roman poet Virgil.","readerLearnsAtEventId":"inferno-event-1-3","originEventId":"inferno-event-1-3","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-fact-commission","title":"Virgil was sent to Dante","description":"Virgil explains that mercy moved Beatrice to seek Dante’s rescue.","readerLearnsAtEventId":"inferno-event-2-4","originEventId":"inferno-event-2-4","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-fact-lower-order","title":"Lower Hell follows an articulated order","description":"Virgil distinguishes violence, fraud, and treachery before the deeper descent.","readerLearnsAtEventId":"inferno-event-11-2","originEventId":"inferno-event-11-2","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-fact-futuresight","title":"The dead see distant events differently","description":"Farinata explains that distant events are visible while present events become obscure.","readerLearnsAtEventId":"inferno-event-10-4","originEventId":"inferno-event-10-4","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-fact-geryon","title":"The monster is named Geryon","description":"Virgil names the creature carrying them down to Malebolge.","readerLearnsAtEventId":"inferno-event-17-4","originEventId":"inferno-event-17-4","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-fact-ugolino","title":"Ugolino’s hatred has a prison history","description":"The count identifies himself and begins the tower account behind the frozen violence.","readerLearnsAtEventId":"inferno-event-33-1","originEventId":"inferno-event-33-1","tags":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-fact-centre","title":"The travellers cross Earth’s centre","description":"Virgil explains the reversal of gravity and the changed time after passing the centre.","readerLearnsAtEventId":"inferno-event-34-6","originEventId":"inferno-event-34-6","tags":[]}],"knowledgeReveals":[],"factions":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-faction-travellers","name":"The Travellers","description":"Dante and Virgil moving under a commission Dante does not yet fully understand.","color":"#75594c","tags":[],"coverImageId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-faction-guardians","name":"Infernal Guardians","description":"Figures who police thresholds, circles, rivers, and trenches.","color":"#75594c","tags":[],"coverImageId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-faction-malebranche","name":"The Malebranche","description":"The hooked devils assigned to the boiling pitch of the fifth bolgia.","color":"#75594c","tags":[],"coverImageId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-faction-florentines","name":"Florentine Dead","description":"People of Florence encountered throughout the descent.","color":"#75594c","tags":[],"coverImageId":null}],"factionMemberships":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-membership-1","factionId":"inferno-faction-travellers","characterId":"inferno-char-dante","role":"Traveller","startEventId":"inferno-event-1-1","endEventId":null,"notes":""},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-membership-2","factionId":"inferno-faction-travellers","characterId":"inferno-char-virgil","role":"Traveller","startEventId":"inferno-event-1-3","endEventId":null,"notes":""},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-membership-3","factionId":"inferno-faction-guardians","characterId":"inferno-char-charon","role":"Threshold guardian","startEventId":"inferno-event-3-4","endEventId":null,"notes":""},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-membe