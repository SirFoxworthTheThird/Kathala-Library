e,"currentLocationMarkerId":"inferno-loc-styx","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":32,"statusNotes":"Arrives shouting in anger, then receives the two travellers into his small boat."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-2-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-8-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-styx","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":32.01,"statusNotes":"Tells the ferryman that he possesses them only for the crossing."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-2-dante","characterId":"inferno-char-dante","eventId":"inferno-event-8-2","isAlive":true,"currentLocationMarkerId":"inferno-loc-styx","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":32.02,"statusNotes":"Boards after Virgil and feels the living weight press the vessel lower."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-3-filippo","characterId":"inferno-char-filippo","eventId":"inferno-event-8-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-styx","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":33,"statusNotes":"Rises mud-covered beside the boat and reaches toward the living traveller."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-3-dante","characterId":"inferno-char-dante","eventId":"inferno-event-8-3","isAlive":true,"currentLocationMarkerId":"inferno-loc-styx","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":33.01,"statusNotes":"Recognizes an arrogant Florentine and rejects his attempt to cling to the skiff."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-3-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-8-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-styx","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":33.02,"statusNotes":"Embraces Dante after the rejection while the other wrathful souls tear at Filippo."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-4-dante","characterId":"inferno-char-dante","eventId":"inferno-event-8-4","isAlive":true,"currentLocationMarkerId":"inferno-loc-dis-gate","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":34,"statusNotes":"Sees the red-hot mosques and arrives before the iron walls of lower Hell."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-4-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-8-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-dis-gate","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":34.01,"statusNotes":"Confers with the fallen gatekeepers who shut the entrance against them."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-5-dante","characterId":"inferno-char-dante","eventId":"inferno-event-8-5","isAlive":true,"currentLocationMarkerId":"inferno-loc-dis-gate","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":35,"statusNotes":"Fears abandonment when Virgil returns alone from the barred gate."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-8-5-virgil","characterId":"inferno-char-virgil","