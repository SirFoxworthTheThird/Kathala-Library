"sortKey":181.02,"statusNotes":"Listens after pledging to carry the story to the living world."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-33-1-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-33-1","isAlive":false,"currentLocationMarkerId":"inferno-loc-antenora","currentMapLayerId":"inferno-map-cocytus","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":181.03,"statusNotes":"Waits beside Dante on Antenora’s ice while Ugolino begins his testimony."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-33-2-ugolino","characterId":"inferno-char-ugolino","eventId":"inferno-event-33-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-hunger-tower","currentMapLayerId":"inferno-map-history","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":182,"statusNotes":"Recalls imprisonment with his sons and grandsons, the prophetic dream, and the door being nailed shut."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-33-2-children","characterId":"inferno-char-children","eventId":"inferno-event-33-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-hunger-tower","currentMapLayerId":"inferno-map-history","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":182.01,"statusNotes":"Wake hungry in the tower and look to their father for meaning."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-33-3-ugolino","characterId":"inferno-char-ugolino","eventId":"inferno-event-33-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-hunger-tower","currentMapLayerId":"inferno-map-history","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":183,"statusNotes":"Interprets the dream of wolf and cubs as the approach of enemies and starvation."},{"worldId":"inferno-world","c