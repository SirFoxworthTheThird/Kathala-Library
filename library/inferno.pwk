 reforms immediately before the travellers."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-24-5-dante","characterId":"inferno-char-dante","eventId":"inferno-event-24-5","isAlive":true,"currentLocationMarkerId":"inferno-loc-bolgia-seven","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":122.01,"statusNotes":"Watches a punishment outdoing every tale of phoenix-like renewal."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-24-5-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-24-5","isAlive":false,"currentLocationMarkerId":"inferno-loc-bolgia-seven","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":122.02,"statusNotes":"Asks the restored shade to identify himself."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-24-6-vanni","characterId":"inferno-char-vanni","eventId":"inferno-event-24-6","isAlive":false,"currentLocationMarkerId":"inferno-loc-bolgia-seven","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":123,"statusNotes":"Names himself as a violent Pistoian thief and confesses the theft from the sacristy."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-24-6-dante","characterId":"inferno-char-dante","eventId":"inferno-event-24-6","isAlive":true,"currentLocationMarkerId":"inferno-loc-bolgia-seven","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":123.01,"statusNotes":"Recognizes the man and presses for the crime that placed him here."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-24-6-virgil","characterId":"inferno-