,"eventId":"inferno-event-15-4","isAlive":true,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":67.01,"statusNotes":"Receives the prophecy without surrendering conscience to Fortune."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-15-4-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-15-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":67.02,"statusNotes":"Signals approval when Dante places moral readiness above prediction."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-15-5-brunetto","characterId":"inferno-char-brunetto","eventId":"inferno-event-15-5","isAlive":false,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":68,"statusNotes":"Turns and runs after his company like a victor racing for the green cloth."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-15-5-dante","characterId":"inferno-char-dante","eventId":"inferno-event-15-5","isAlive":true,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":68.01,"statusNotes":"Watches his teacher disappear across the burning plain."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-15-5-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-15-5","isAlive":false,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelMod