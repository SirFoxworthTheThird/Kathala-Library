":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-3-2-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-3-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-vestibule","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":10.01,"statusNotes":"Explains why Heaven and deep Hell both refuse the neutral souls."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-3-3-dante","characterId":"inferno-char-dante","eventId":"inferno-event-3-3","isAlive":true,"currentLocationMarkerId":"inferno-loc-acheron","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":11,"statusNotes":"Sees innumerable spirits hurry naked toward the river and asks what law drives them."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-3-3-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-3-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-acheron","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":11.01,"statusNotes":"Promises the meaning will become clear when they reach the dismal shore."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-3-4-charon","characterId":"inferno-char-charon","eventId":"inferno-event-3-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-acheron","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":12,"statusNotes":"Beats the delaying shades into his boat and resists carrying a living body."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-3-4-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-3-4","isAlive":false,"curr