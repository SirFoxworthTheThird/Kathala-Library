:"","travelModeId":null,"sortKey":37.01,"statusNotes":"Covers Dante’s eyes with his own hands so the Gorgon cannot petrify him."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-9-3-messenger","characterId":"inferno-char-messenger","eventId":"inferno-event-9-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-dis-gate","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":38,"statusNotes":"Crosses Styx dry-shod, scatters the resisting dead, and opens the gate with a wand."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-9-3-dante","characterId":"inferno-char-dante","eventId":"inferno-event-9-3","isAlive":true,"currentLocationMarkerId":"inferno-loc-dis-gate","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":38.01,"statusNotes":"Looks past Virgil’s sheltering hand and watches divine authority pass without greeting."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-9-3-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-9-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-dis-gate","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":38.02,"statusNotes":"Bows in silence as the messenger rebukes the fallen guardians."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-9-4-dante","characterId":"inferno-char-dante","eventId":"inferno-event-9-4","isAlive":true,"currentLocationMarkerId":"inferno-loc-circle-six","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":39,"statusNotes":"Enters Dis and sees innumerable open sepulchres glowing with hotter fire."},{"worldId":"inferno-world","createdAt":179228