,"sortKey":87,"statusNotes":"Sees sinners planted headfirst in round holes while flames dance on their soles."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-19-2-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-19-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-bolgia-three","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":87.01,"statusNotes":"Carries Dante down the bank toward the most violently burning feet."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-19-3-nicholas","characterId":"inferno-char-nicholas","eventId":"inferno-event-19-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-bolgia-three","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":88,"statusNotes":"Mistakes Dante for Boniface and speaks from the hole as though expecting a successor."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-19-3-dante","characterId":"inferno-char-dante","eventId":"inferno-event-19-3","isAlive":true,"currentLocationMarkerId":"inferno-loc-bolgia-three","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":88.01,"statusNotes":"Bends like a confessor and asks the buried pope to identify himself."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-19-3-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-19-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-bolgia-three","currentMapLayerId":"inferno-map-malebolge","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":88.02,"statusNotes":"Positions Dante where the voice can reach him."},{"worldId":"inferno-world","createdAt":1792281600000,"update