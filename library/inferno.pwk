9,"title":"Canto XXIX","synopsis":"The complete Longfellow text of Canto XXIX, divided at reviewed tercet boundaries.","notes":"Dante’s authorial canto division.","wordGoal":1080},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-canto-30","timelineId":"inferno-timeline-descent","number":30,"title":"Canto XXX","synopsis":"The complete Longfellow text of Canto XXX, divided at reviewed tercet boundaries.","notes":"Dante’s authorial canto division.","wordGoal":1194},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-canto-31","timelineId":"inferno-timeline-descent","number":31,"title":"Canto XXXI","synopsis":"The complete Longfellow text of Canto XXXI, divided at reviewed tercet boundaries.","notes":"Dante’s authorial canto division.","wordGoal":1148},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-canto-32","timelineId":"inferno-timeline-descent","number":32,"title":"Canto XXXII","synopsis":"The complete Longfellow text of Canto XXXII, divided at reviewed tercet boundaries.","notes":"Dante’s authorial canto division.","wordGoal":1128},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-canto-33","timelineId":"inferno-timeline-descent","number":33,"title":"Canto XXXIII","synopsis":"The complete Longfellow text of Canto XXXIII, divided at reviewed tercet boundaries.","notes":"Dante’s authorial canto division.","wordGoal":1282},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-canto-34","timelineId":"inferno-timeline-descent","number":34,"title":"Canto XXXIV","synopsis":"The complete Longfellow text of Canto XXXIV, divided at reviewed tercet boundaries.","notes":"Dante’s authorial canto division.","wordGoal":1134}],"events":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-1-1","chapterId":"inferno-canto-1","timelineId":"inferno-timeline-descent","title":"Lost in the Dark Wood","description":"Wakes to himself in a savage wood, unable to explain how the straight way was lost.","locationMarkerId":"inferno-loc-dark-wood","involvedCharacterIds":["inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":0,"travelDays":0,"inWorldTime":0.0001,"tension":3,"tags":["Canto I, source lines 1-30"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-1-2","chapterId":"inferno-canto-1","timelineId":"inferno-timeline-descent","title":"The Three Beasts","description":"Attempts the sunlit slope, then yields ground before the panther, lion, and starving she-wolf.","locationMarkerId":"inferno-loc-sunlit-slope","involvedCharacterIds":["inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":1,"travelDays":0,"inWorldTime":0.0031,"tension":4,"tags":["Canto I, source lines 31-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-1-3","chapterId":"inferno-canto-1","timelineId":"inferno-timeline-descent","title":"A Voice in the Waste","description":"Cries for pity when a silent shade appears below the blocked ascent. Identifies himself as a Mantuan poet of Rome and questions Dante’s retreat.","locationMarkerId":"inferno-loc-dark-wood","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":2,"travelDays":0,"inWorldTime":0.0061,"tension":3,"tags":["Canto I, source lines 61-90"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-1-4","chapterId":"inferno-canto-1","timelineId":"inferno-timeline-descent","title":"The Other Road","description":"Warns that the she-wolf bars this ascent and offers a road through the eternal realms. Entrusts himself to the poet whose work taught him his own style.","locationMarkerId":"inferno-loc-dark-wood","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":3,"travelDays":0,"inWorldTime":0.0091,"tension":3,"tags":["Canto I, source lines 91-136"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-2-1","chapterId":"inferno-canto-2","timelineId":"inferno-timeline-descent","title":"Evening Doubt","description":"Falters at dusk and questions whether he has the worth to undertake the passage. Hears Dante compare himself unfavourably with Aeneas and Paul.","locationMarkerId":"inferno-loc-dark-wood","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":4,"travelDays":0,"inWorldTime":0.0589,"tension":3,"tags":["Canto II, source lines 1-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-2-2","chapterId":"inferno-canto-2","timelineId":"inferno-timeline-descent","title":"Virgil Challenges the Retreat","description":"Names cowardice as the force undoing Dante’s resolve and begins to explain his commission. Listens while shame replaces his first impulse to turn back.","locationMarkerId":"inferno-loc-dark-wood","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":5,"travelDays":0,"inWorldTime":0.0625,"tension":3,"tags":["Canto II, source lines 37-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-2-3","chapterId":"inferno-canto-2","timelineId":"inferno-timeline-intercession","title":"Beatrice Descends to Limbo","description":"Comes from blessedness to ask Virgil to rescue the endangered traveller. Receives Beatrice’s request and asks how she can enter a place cut off from hope.","locationMarkerId":"inferno-loc-limbo","involvedCharacterIds":["inferno-char-beatrice","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-intercession"],"motifIds":["inferno-motif-speech"],"sortOrder":6,"travelDays":0,"inWorldTime":0.061,"tension":3,"tags":["Canto II, source lines 61-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-beatrice","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-2-4","chapterId":"inferno-canto-2","timelineId":"inferno-timeline-descent","title":"Three Blessed Women","description":"Relates how Mary, Lucia, and Beatrice moved in mercy before urging immediate departure. Recovers courage as flowers rise after frost and accepts Virgil as guide and master.","locationMarkerId":"inferno-loc-dark-wood","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":7,"travelDays":0,"inWorldTime":0.0697,"tension":2,"tags":["Canto II, source lines 109-142"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-3-1","chapterId":"inferno-canto-3","timelineId":"inferno-timeline-descent","title":"The Gate of Hell","description":"Reads the black inscription ending in the command to abandon hope. Tells Dante to leave suspicion and cowardice behind as they enter.","locationMarkerId":"inferno-loc-hell-gate","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":8,"travelDays":0,"inWorldTime":0.1177,"tension":4,"tags":["Canto III, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-3-2","chapterId":"inferno-canto-3","timelineId":"inferno-timeline-descent","title":"The Futile Choir","description":"Hears the mixed tongues and weeping of those who lived without praise or blame. Explains why Heaven and deep Hell both refuse the neutral souls.","locationMarkerId":"inferno-loc-vestibule","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":9,"travelDays":0,"inWorldTime":0.1201,"tension":3,"tags":["Canto III, source lines 25-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-3-3","chapterId":"inferno-canto-3","timelineId":"inferno-timeline-descent","title":"The Shores of Acheron","description":"Sees innumerable spirits hurry naked toward the river and asks what law drives them. Promises the meaning will become clear when they reach the dismal shore.","locationMarkerId":"inferno-loc-acheron","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":10,"travelDays":0,"inWorldTime":0.1237,"tension":4,"tags":["Canto III, source lines 61-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-3-4","chapterId":"inferno-canto-3","timelineId":"inferno-timeline-descent","title":"Charon and the Crossing","description":"Beats the delaying shades into his boat and resists carrying a living body. Silences Charon by invoking the will that cannot be opposed. Trembles as the earth shakes, a red light flashes, and consciousness fails.","locationMarkerId":"inferno-loc-acheron","involvedCharacterIds":["inferno-char-charon","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-oar"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":11,"travelDays":0,"inWorldTime":0.1273,"tension":5,"tags":["Canto III, source lines 97-136"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-4-1","chapterId":"inferno-canto-4","timelineId":"inferno-timeline-descent","title":"Awakening Above Limbo","description":"Wakes from the thunderous swoon and looks down into the blind first circle. Descends pale with pity while telling Dante that they must go first.","locationMarkerId":"inferno-loc-limbo-rim","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":12,"travelDays":0,"inWorldTime":0.1766,"tension":3,"tags":["Canto IV, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-4-2","chapterId":"inferno-canto-4","timelineId":"inferno-timeline-descent","title":"The Sighs of Limbo","description":"Explains that blameless souls without baptism live in desire without hope. Feels grief for the worthy people suspended outside salvation.","locationMarkerId":"inferno-loc-limbo","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":13,"travelDays":0,"inWorldTime":0.179,"tension":3,"tags":["Canto IV, source lines 25-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-4-3","chapterId":"inferno-canto-4","timelineId":"inferno-timeline-descent","title":"The Noble Poets","description":"Approaches as lord of the highest song with Horace, Ovid, and Lucan. Is greeted by his fellow ancient poets and brings Dante into their company. Receives honour as the sixth among the poets and walks with them toward light.","locationMarkerId":"inferno-loc-noble-castle","involvedCharacterIds":["inferno-char-homer","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":14,"travelDays":0,"inWorldTime":0.1838,"tension":2,"tags":["Canto IV, source lines 73-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-4-4","chapterId":"inferno-canto-4","timelineId":"inferno-timeline-descent","title":"The Noble Castle","description":"Crosses seven walls and a stream to behold heroes, philosophers, physicians, and sages. Leads Dante out from the luminous company toward the place where nothing shines.","locationMarkerId":"inferno-loc-noble-castle","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":15,"travelDays":0,"inWorldTime":0.1874,"tension":2,"tags":["Canto IV, source lines 109-151"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-5-1","chapterId":"inferno-canto-5","timelineId":"inferno-timeline-descent","title":"Before Minos","description":"Judges each confessing soul and coils his tail to assign its depth. Warns Minos not to obstruct a journey willed above. Passes the snarling judge into a darker region.","locationMarkerId":"inferno-loc-circle-two","involvedCharacterIds":["inferno-char-minos","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":16,"travelDays":0,"inWorldTime":0.2354,"tension":4,"tags":["Canto V, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-5-2","chapterId":"inferno-canto-5","timelineId":"inferno-timeline-descent","title":"The Infernal Hurricane","description":"Sees the lustful carried without rest in a storm that answers their surrendered reason. Names famous shades swept through the black air.","locationMarkerId":"inferno-loc-circle-two","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":17,"travelDays":0,"inWorldTime":0.2378,"tension":4,"tags":["Canto V, source lines 25-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-5-3","chapterId":"inferno-canto-5","timelineId":"inferno-timeline-descent","title":"The Lovers in the Wind","description":"Asks to speak with two shades moving together and calls them gently from the storm. Advises Dante to appeal to the love that still binds the pair. Leaves Dido’s band with Paolo and answers the living traveller. Comes silently beside Francesca, borne with her on the wind.","locationMarkerId":"inferno-loc-circle-two","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil","inferno-char-francesca","inferno-char-paolo"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":18,"travelDays":0,"inWorldTime":0.2414,"tension":3,"tags":["Canto V, source lines 61-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-5-4","chapterId":"inferno-canto-5","timelineId":"inferno-timeline-descent","title":"Francesca Names Her Grief","description":"Names her city and speaks of love, death, and the shared fate awaiting their killer. Weeps without speaking beside Francesca. Bows his head under the weight of their sorrow.","locationMarkerId":"inferno-loc-circle-two","involvedCharacterIds":["inferno-char-francesca","inferno-char-paolo","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":19,"travelDays":0,"inWorldTime":0.2438,"tension":4,"tags":["Canto V, source lines 85-114"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-5-5","chapterId":"inferno-canto-5","timelineId":"inferno-timeline-francesca-memory","title":"The Fatal Reading","description":"Recalls the book, glance, and kiss through which desire overcame restraint. Reads beside Francesca until the story of Lancelot brings them to their first kiss.","locationMarkerId":"inferno-loc-rimini","involvedCharacterIds":["inferno-char-francesca","inferno-char-paolo"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-francesca-memory"],"motifIds":["inferno-motif-passage"],"sortOrder":20,"travelDays":0,"inWorldTime":0.115,"tension":5,"tags":["Canto V, source lines 115-142"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-francesca","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-6-1","chapterId":"inferno-canto-6","timelineId":"inferno-timeline-descent","title":"The Cold Rain","description":"Returns to awareness amid ceaseless foul rain, hail, and snow. Continues through the third circle beside him.","locationMarkerId":"inferno-loc-circle-three","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":21,"travelDays":0,"inWorldTime":0.2942,"tension":3,"tags":["Canto VI, source lines 1-12"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-6-2","chapterId":"inferno-canto-6","timelineId":"inferno-timeline-descent","title":"Cerberus","description":"Barks from three throats and claws the gluttonous shades. Throws earth into the monster’s gullets to open their passage. Walks across the prostrate forms after Cerberus is quieted.","locationMarkerId":"inferno-loc-circle-three","involvedCharacterIds":["inferno-char-cerberus","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":22,"travelDays":0,"inWorldTime":0.2954,"tension":4,"tags":["Canto VI, source lines 13-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-6-3","chapterId":"inferno-canto-6","timelineId":"inferno-timeline-descent","title":"Ciacco Rises","description":"Rises from the mire, identifies himself by the nickname Ciacco, and appeals to a fellow Florentine. Struggles to recognize the ruined face and asks about Florence’s divided future. Waits while the two Florentines speak.","locationMarkerId":"inferno-loc-circle-three","involvedCharacterIds":["inferno-char-ciacco","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":23,"travelDays":0,"inWorldTime":0.2978,"tension":3,"tags":["Canto VI, source lines 37-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-6-4","chapterId":"inferno-canto-6","timelineId":"inferno-timeline-descent","title":"The Prophecy of Florence","description":"Predicts the city’s factional bloodshed and answers questions about notable citizens. Learns that admired Florentines lie deeper below and asks to be remembered. Explains the soul’s condition after the final judgment once Ciacco sinks back.","locationMarkerId":"inferno-loc-circle-three","involvedCharacterIds":["inferno-char-ciacco","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":24,"travelDays":0,"inWorldTime":0.299,"tension":4,"tags":["Canto VI, source lines 49-90"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-6-5","chapterId":"inferno-canto-6","timelineId":"inferno-timeline-descent","title":"Toward Plutus","description":"Asks whether reunited body and soul will sharpen or lessen torment. Answers from Aristotle and leads onward until Plutus appears.","locationMarkerId":"inferno-loc-circle-three","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":25,"travelDays":0,"inWorldTime":0.3032,"tension":2,"tags":["Canto VI, source lines 91-115"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-7-1","chapterId":"inferno-canto-7","timelineId":"inferno-timeline-descent","title":"Plutus Falls Silent","description":"Cries an obscure warning at the entrance to the fourth circle. Rebukes the accursed wolf and causes him to collapse. Descends safely past the guardian.","locationMarkerId":"inferno-loc-circle-four","involvedCharacterIds":["inferno-char-plutus","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":26,"travelDays":0,"inWorldTime":0.353,"tension":3,"tags":["Canto VII, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-7-2","chapterId":"inferno-canto-7","timelineId":"inferno-timeline-descent","title":"The Clashing Weights","description":"Watches two crowds roll burdens, collide, reproach one another, and turn back. Identifies avarice and prodigality beneath faces erased by misuse of wealth.","locationMarkerId":"inferno-loc-circle-four","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":27,"travelDays":0,"inWorldTime":0.3554,"tension":4,"tags":["Canto VII, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-7-3","chapterId":"inferno-canto-7","timelineId":"inferno-timeline-descent","title":"Fortune and Her Wheel","description":"Asks why the clerical shades are unrecognizable and what Fortune truly is. Explains the appointed intelligence that transfers worldly goods beyond human control.","locationMarkerId":"inferno-loc-circle-four","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":28,"travelDays":0,"inWorldTime":0.3566,"tension":3,"tags":["Canto VII, source lines 37-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-7-4","chapterId":"inferno-canto-7","timelineId":"inferno-timeline-descent","title":"The Marsh of Styx","description":"Sees the wrathful strike one another above the mire and the sullen gurgle their hymn below it. Names the two tempers punished in the foul marsh and follows its bank toward a tower.","locationMarkerId":"inferno-loc-styx","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":29,"travelDays":0,"inWorldTime":0.3626,"tension":4,"tags":["Canto VII, source lines 97-130"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-8-1","chapterId":"inferno-canto-8","timelineId":"inferno-timeline-descent","title":"Signals Across Styx","description":"Notices two flames answered by a third far across the marsh. Explains that the ferryman is already crossing toward them.","locationMarkerId":"inferno-loc-styx-tower","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":30,"travelDays":0,"inWorldTime":0.4119,"tension":3,"tags":["Canto VIII, source lines 1-18"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-8-2","chapterId":"inferno-canto-8","timelineId":"inferno-timeline-descent","title":"Phlegyas and the Skiff","description":"Arrives shouting in anger, then receives the two travellers into his small boat. Tells the ferryman that he possesses them only for the crossing. Boards after Virgil and feels the living weight press the vessel lower.","locationMarkerId":"inferno-loc-styx","involvedCharacterIds":["inferno-char-phlegyas","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":31,"travelDays":0,"inWorldTime":0.4137,"tension":4,"tags":["Canto VIII, source lines 19-30"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-8-3","chapterId":"inferno-canto-8","timelineId":"inferno-timeline-descent","title":"Filippo Argenti","description":"Rises mud-covered beside the boat and reaches toward the living traveller. Recognizes an arrogant Florentine and rejects his attempt to cling to the skiff. Embraces Dante after the rejection while the other wrathful souls tear at Filippo.","locationMarkerId":"inferno-loc-styx","involvedCharacterIds":["inferno-char-filippo","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":32,"travelDays":0,"inWorldTime":0.4149,"tension":4,"tags":["Canto VIII, source lines 31-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-8-4","chapterId":"inferno-canto-8","timelineId":"inferno-timeline-descent","title":"The Walls of Dis","description":"Sees the red-hot mosques and arrives before the iron walls of lower Hell. Confers with the fallen gatekeepers who shut the entrance against them.","locationMarkerId":"inferno-loc-dis-gate","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":33,"travelDays":0,"inWorldTime":0.4191,"tension":4,"tags":["Canto VIII, source lines 73-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-8-5","chapterId":"inferno-canto-8","timelineId":"inferno-timeline-descent","title":"Virgil Repulsed","description":"Fears abandonment when Virgil returns alone from the barred gate. Conceals his anxiety, promises that stronger help is coming, and waits.","locationMarkerId":"inferno-loc-dis-gate","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":34,"travelDays":0,"inWorldTime":0.4215,"tension":4,"tags":["Canto VIII, source lines 97-130"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-9-1","chapterId":"inferno-canto-9","timelineId":"inferno-timeline-descent","title":"Waiting Before Dis","description":"Reads fear in Virgil’s altered colour and asks whether anyone has crossed this depth before. Recalls an earlier compelled descent to the lowest circle and watches for aid.","locationMarkerId":"inferno-loc-dis-gate","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":35,"travelDays":0,"inWorldTime":0.4707,"tension":3,"tags":["Canto IX, source lines 1-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-9-2","chapterId":"inferno-canto-9","timelineId":"inferno-timeline-descent","title":"The Furies on the Tower","description":"Sees three blood-stained Furies call for Medusa from the fiery battlements. Covers Dante’s eyes with his own hands so the Gorgon cannot petrify him.","locationMarkerId":"inferno-loc-dis-gate","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":36,"travelDays":0,"inWorldTime":0.4743,"tension":5,"tags":["Canto IX, source lines 37-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-9-3","chapterId":"inferno-canto-9","timelineId":"inferno-timeline-descent","title":"The Heavenly Messenger","description":"Crosses Styx dry-shod, scatters the resisting dead, and opens the gate with a wand. Looks past Virgil’s sheltering hand and watches divine authority pass without greeting. Bows in silence as the messenger rebukes the fallen guardians.","locationMarkerId":"inferno-loc-dis-gate","involvedCharacterIds":["inferno-char-messenger","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":37,"travelDays":0,"inWorldTime":0.4779,"tension":4,"tags":["Canto IX, source lines 73-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-9-4","chapterId":"inferno-canto-9","timelineId":"inferno-timeline-descent","title":"The Burning Tombs","description":"Enters Dis and sees innumerable open sepulchres glowing with hotter fire. Explains that heresiarchs and their followers lie within the uncovered tombs.","locationMarkerId":"inferno-loc-circle-six","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":38,"travelDays":0,"inWorldTime":0.4815,"tension":4,"tags":["Canto IX, source lines 109-133"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-10-1","chapterId":"inferno-canto-10","timelineId":"inferno-timeline-descent","title":"Among the Heretics","description":"Walks a hidden path between fiery tombs and the city wall. Invites questions and explains that every tomb will be sealed after judgment.","locationMarkerId":"inferno-loc-circle-six","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":39,"travelDays":0,"inWorldTime":0.5295,"tension":3,"tags":["Canto X, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-10-2","chapterId":"inferno-canto-10","timelineId":"inferno-timeline-descent","title":"Farinata Rises","description":"Rises waist-high from a tomb, recognizes Dante’s Tuscan speech, and asks his ancestry. Faces the proud Florentine and answers the political challenge directly. Pushes Dante closer and tells him to choose his words well.","locationMarkerId":"inferno-loc-circle-six","involvedCharacterIds":["inferno-char-farinata","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":40,"travelDays":0,"inWorldTime":0.5319,"tension":4,"tags":["Canto X, source lines 25-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-10-3","chapterId":"inferno-canto-10","timelineId":"inferno-timeline-descent","title":"Cavalcante Seeks His Son","description":"Rises on his knees, searches for Guido, and collapses when Dante’s tense suggests death. Explains that intellect rather than kinship guides his passage but answers too slowly. Waits unchanged in bearing while the neighbouring shade interrupts.","locationMarkerId":"inferno-loc-circle-six","involvedCharacterIds":["inferno-char-cavalcante","inferno-char-dante","inferno-char-farinata"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":41,"travelDays":0,"inWorldTime":0.5355,"tension":4,"tags":["Canto X, source lines 61-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-10-4","chapterId":"inferno-canto-10","timelineId":"inferno-timeline-descent","title":"What the Damned Can Know","description":"Explains that the dead see distant events but lose knowledge as the future becomes present. Asks that Cavalcante be told his son still lives and learns of his own coming exile. Calls Dante onward from the tombs.","locationMarkerId":"inferno-loc-circle-six","involvedCharacterIds":["inferno-char-farinata","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":42,"travelDays":0,"inWorldTime":0.5391,"tension":3,"tags":["Canto X, source lines 97-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-10-5","chapterId":"inferno-canto-10","timelineId":"inferno-timeline-descent","title":"Toward the Stinking Vale","description":"Carries the troubling prophecy while following the leftward path. Promises fuller explanation later and leads toward the foul-smelling descent.","locationMarkerId":"inferno-loc-circle-six","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":43,"travelDays":0,"inWorldTime":0.5415,"tension":3,"tags":["Canto X, source lines 121-136"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-11-1","chapterId":"inferno-canto-11","timelineId":"inferno-timeline-descent","title":"The Tomb of Anastasius","description":"Stops behind a broken lid to endure the stench rising from below. Uses the pause to explain the ordered circles still beneath them.","locationMarkerId":"inferno-loc-lower-hell-rim","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":44,"travelDays":0,"inWorldTime":0.5883,"tension":2,"tags":["Canto XI, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-11-2","chapterId":"inferno-canto-11","timelineId":"inferno-timeline-descent","title":"Violence and Fraud","description":"Distinguishes violence from fraud and divides injury against neighbour, self, and God. Listens as the lower circles acquire a moral geography.","locationMarkerId":"inferno-loc-lower-hell-rim","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":45,"travelDays":0,"inWorldTime":0.5907,"tension":3,"tags":["Canto XI, source lines 25-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-11-3","chapterId":"inferno-canto-11","timelineId":"inferno-timeline-descent","title":"The Two Kinds of Fraud","description":"Separates fraud against general human trust from treachery against special bonds. Questions why incontinence lies outside the fiery city.","locationMarkerId":"inferno-loc-lower-hell-rim","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":46,"travelDays":0,"inWorldTime":0.5943,"tension":3,"tags":["Canto XI, source lines 61-90"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-11-4","chapterId":"inferno-canto-11","timelineId":"inferno-timeline-descent","title":"Art, Nature, and Usury","description":"Answers from ethics and Genesis, tracing honest human work through nature and art. Understands why usury violates both natural order and human craft.","locationMarkerId":"inferno-loc-lower-hell-rim","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":47,"travelDays":0,"inWorldTime":0.5973,"tension":2,"tags":["Canto XI, source lines 91-115"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-12-1","chapterId":"inferno-canto-12","timelineId":"inferno-timeline-descent","title":"The Shattered Descent","description":"Approaches a ruin so steep that the sight recoils from it. Explains the broken slope and prepares to pass its guardian.","locationMarkerId":"inferno-loc-circle-seven-rim","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":48,"travelDays":0,"inWorldTime":0.6472,"tension":4,"tags":["Canto XII, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-12-2","chapterId":"inferno-canto-12","timelineId":"inferno-timeline-descent","title":"The Minotaur","description":"Bites himself in rage at the mention of Theseus and charges blindly. Provokes the monster, then urges Dante across while its fury distracts it. Hurries down the loose stones of the landslide.","locationMarkerId":"inferno-loc-circle-seven-rim","involvedCharacterIds":["inferno-char-minotaur","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":49,"travelDays":0,"inWorldTime":0.6496,"tension":4,"tags":["Canto XII, source lines 25-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-12-3","chapterId":"inferno-canto-12","timelineId":"inferno-timeline-descent","title":"The Centaur Patrol","description":"Halts the armed centaurs and notices that Dante moves stones with a living body. Challenges the approaching travellers with a drawn bow. Asks Chiron for an escort and explains that necessity, not pleasure, brings them.","locationMarkerId":"inferno-loc-phlegethon","involvedCharacterIds":["inferno-char-chiron","inferno-char-nessus","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-bow"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":50,"travelDays":0,"inWorldTime":0.6532,"tension":4,"tags":["Canto XII, source lines 61-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-chiron","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-12-4","chapterId":"inferno-canto-12","timelineId":"inferno-timeline-descent","title":"Nessus Guides the Ford","description":"Leads the travellers along the boiling blood, naming tyrants at different depths. Sees souls immersed according to the blood they shed. Lets Nessus instruct Dante while they seek a ford.","locationMarkerId":"inferno-loc-phlegethon","involvedCharacterIds":["inferno-char-nessus","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-bow"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":51,"travelDays":0,"inWorldTime":0.6568,"tension":3,"tags":["Canto XII, source lines 97-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-12-5","chapterId":"inferno-canto-12","timelineId":"inferno-timeline-descent","title":"Across the River of Blood","description":"Carries Dante through the shallow passage, points to deeper tyrants, and returns alone. Crosses to the inner bank under the centaur’s protection. Continues toward the unnatural wood.","locationMarkerId":"inferno-loc-phlegethon","involvedCharacterIds":["inferno-char-nessus","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":52,"travelDays":0,"inWorldTime":0.6592,"tension":3,"tags":["Canto XII, source lines 121-139"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-13-1","chapterId":"inferno-canto-13","timelineId":"inferno-timeline-descent","title":"The Wood of the Suicides","description":"Enters a thorn forest with no path and hears lamentation without seeing speakers. Explains that the next circle will overturn expectation and directs close attention.","locationMarkerId":"inferno-loc-suicide-wood","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":53,"travelDays":0,"inWorldTime":0.706,"tension":4,"tags":["Canto XIII, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-13-2","chapterId":"inferno-canto-13","timelineId":"inferno-timeline-descent","title":"The Bleeding Branch","description":"Breaks a twig at Virgil’s instruction and recoils when blood and speech issue together. Apologizes to the wounded shade and promises remembrance in the living world.","locationMarkerId":"inferno-loc-suicide-wood","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":54,"travelDays":0,"inWorldTime":0.7084,"tension":4,"tags":["Canto XIII, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-13-3","chapterId":"inferno-canto-13","timelineId":"inferno-timeline-descent","title":"Pier delle Vigne","description":"Names his trusted service to Frederick, the envy that ruined him, and the despair that made him unjust to himself. Listens with pity too strong for immediate questioning. Asks how the imprisoned souls grow into trees and whether they ever regain their bodies.","locationMarkerId":"inferno-loc-suicide-wood","involvedCharacterIds":["inferno-char-pier","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":55,"travelDays":0,"inWorldTime":0.7096,"tension":4,"tags":["Canto XIII, source lines 37-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-13-4","chapterId":"inferno-canto-13","timelineId":"inferno-timeline-descent","title":"The Trees and Their Bodies","description":"Explains how Minos casts each suicide seedlike into the wood and how rejected bodies will hang from the branches. Learns that bodily reunion will not restore what each soul cast away. Finishes the inquiry on Dante’s behalf.","locationMarkerId":"inferno-loc-suicide-wood","involvedCharacterIds":["inferno-char-pier","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":56,"travelDays":0,"inWorldTime":0.7144,"tension":4,"tags":["Canto XIII, source lines 85-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-13-5","chapterId":"inferno-canto-13","timelineId":"inferno-timeline-descent","title":"The Hunted Squanderers","description":"Runs naked through the thorns while black hounds close behind. Crashes into a bush in terror and is torn apart with it. Watches wasteful violence turn the wood itself into fresh injury. Leads Dante to the wounded bush after the hunt.","locationMarkerId":"inferno-loc-suicide-wood","involvedCharacterIds":["inferno-char-lano","inferno-char-jacopo","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":57,"travelDays":0,"inWorldTime":0.7168,"tension":5,"tags":["Canto XIII, source lines 109-151"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-14-1","chapterId":"inferno-canto-14","timelineId":"inferno-timeline-descent","title":"The Gathered Leaves","description":"Collects scattered leaves and returns them to the anonymous Florentine bush. Allows the act of compassion before leading onto the burning sand.","locationMarkerId":"inferno-loc-suicide-wood","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":58,"travelDays":0,"inWorldTime":0.7648,"tension":2,"tags":["Canto XIV, source lines 1-12"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-14-2","chapterId":"inferno-canto-14","timelineId":"inferno-timeline-descent","title":"The Burning Sand","description":"Sees naked souls lying, crouching, or wandering under a slow rain of fire. Identifies the three postures while keeping to the forest edge.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":59,"travelDays":0,"inWorldTime":0.766,"tension":4,"tags":["Canto XIV, source lines 13-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-14-3","chapterId":"inferno-canto-14","timelineId":"inferno-timeline-descent","title":"Capaneus Defiant","description":"Lies huge upon the sand and defies Jupiter without softening his pride. Rebukes the blasphemer and says his unquenched arrogance completes the punishment. Hears the ancient war at Thebes recalled through Capaneus’s boast.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-capaneus","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":60,"travelDays":0,"inWorldTime":0.7684,"tension":4,"tags":["Canto XIV, source lines 37-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-14-4","chapterId":"inferno-canto-14","timelineId":"inferno-timeline-descent","title":"The Red Rill","description":"Directs Dante onto the petrified margins of a stream that quenches the falling flame. Follows the narrow safe path and asks about the strange water.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":61,"travelDays":0,"inWorldTime":0.772,"tension":3,"tags":["Canto XIV, source lines 73-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-14-5","chapterId":"inferno-canto-14","timelineId":"inferno-timeline-descent","title":"The Old Man of Crete","description":"Describes the cracked statue whose tears form Acheron, Styx, Phlegethon, and Cocytus. Connects the infernal rivers to one source and questions where Lethe lies.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":62,"travelDays":0,"inWorldTime":0.7744,"tension":3,"tags":["Canto XIV, source lines 97-142"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-15-1","chapterId":"inferno-canto-15","timelineId":"inferno-timeline-descent","title":"Along the Hardened Banks","description":"Walks beside the steaming rill while its vapour shields the travellers from fire. Keeps to the margins that form their protected road.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":63,"travelDays":0,"inWorldTime":0.8236,"tension":3,"tags":["Canto XV, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-15-2","chapterId":"inferno-canto-15","timelineId":"inferno-timeline-descent","title":"Brunetto Latini","description":"Recognizes Dante beneath the baked features and takes him by the hem. Recognizes his former teacher and bends respectfully without leaving the safe bank. Permits the conversation while maintaining the onward route.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-brunetto","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":64,"travelDays":0,"inWorldTime":0.826,"tension":3,"tags":["Canto XV, source lines 25-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-15-3","chapterId":"inferno-canto-15","timelineId":"inferno-timeline-descent","title":"Dante Tells His Course","description":"Explains the lost wood, the morning encounter, and the journey homeward under guidance. Hears how recently Dante strayed and begins to read his future from his character. Remains the guide Dante says he follows.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-dante","inferno-char-brunetto","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":65,"travelDays":0,"inWorldTime":0.8284,"tension":3,"tags":["Canto XV, source lines 49-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-15-4","chapterId":"inferno-canto-15","timelineId":"inferno-timeline-descent","title":"Brunetto’s Prophecy","description":"Predicts Florentine hostility, names companions in the running band, and commends his Treasury. Receives the prophecy without surrendering conscience to Fortune. Signals approval when Dante places moral readiness above prediction.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-brunetto","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":66,"travelDays":0,"inWorldTime":0.832,"tension":4,"tags":["Canto XV, source lines 85-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-15-5","chapterId":"inferno-canto-15","timelineId":"inferno-timeline-descent","title":"The Race Resumes","description":"Turns and runs after his company like a victor racing for the green cloth. Watches his teacher disappear across the burning plain. Leads onward toward the cataract.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-brunetto","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":67,"travelDays":0,"inWorldTime":0.8344,"tension":2,"tags":["Canto XV, source lines 109-124"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-16-1","chapterId":"inferno-canto-16","timelineId":"inferno-timeline-descent","title":"The Roar of the Cataract","description":"Hears the river plunge into the next circle and sees three shades detach from a passing company. Warns that the approaching Florentines deserve courtesy.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":68,"travelDays":0,"inWorldTime":0.8825,"tension":3,"tags":["Canto XVI, source lines 1-12"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-16-2","chapterId":"inferno-canto-16","timelineId":"inferno-timeline-descent","title":"Three Florentines Circle","description":"Runs in a wheel with Tegghiaio and Jacopo so none must stand beneath the fire. Stops at the brink, ready to embrace them if the flames allowed it. Waits while the travellers speak with the circling shades.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-guidoGuerra","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":69,"travelDays":0,"inWorldTime":0.8837,"tension":3,"tags":["Canto XVI, source lines 13-30"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-16-3","chapterId":"inferno-canto-16","timelineId":"inferno-timeline-descent","title":"Names Worth Remembering","description":"Names himself and his two companions, asking whether courtesy and valour remain in Florence. Answers each name with respect and grieves at seeing such men in torment.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-guidoGuerra","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":70,"travelDays":0,"inWorldTime":0.8855,"tension":3,"tags":["Canto XVI, source lines 31-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-16-4","chapterId":"inferno-canto-16","timelineId":"inferno-timeline-descent","title":"Florence’s New Pride","description":"Blames sudden wealth and new citizens for the city’s pride and excess. Asks Dante to speak of the three when he returns among the living.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-dante","inferno-char-guidoGuerra"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":71,"travelDays":0,"inWorldTime":0.8897,"tension":3,"tags":["Canto XVI, source lines 73-90"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-16-5","chapterId":"inferno-canto-16","timelineId":"inferno-timeline-descent","title":"The Cord Cast Down","description":"Removes the cord once meant to catch the leopard and gives it to Virgil. Throws the coiled cord into the abyss as a signal.","locationMarkerId":"inferno-loc-cataract","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-cord"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":72,"travelDays":0,"inWorldTime":0.8915,"tension":3,"tags":["Canto XVI, source lines 91-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-16-6","chapterId":"inferno-canto-16","timelineId":"inferno-timeline-descent","title":"A Shape Swims Upward","description":"Sees a marvellous shape rise through the dense air like a diver returning from depth. Announces the approaching creature that crosses walls, weapons, and worlds.","locationMarkerId":"inferno-loc-cataract","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":73,"travelDays":0,"inWorldTime":0.8945,"tension":4,"tags":["Canto XVI, source lines 121-136"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-17-1","chapterId":"inferno-canto-17","timelineId":"inferno-timeline-descent","title":"The Monster on the Brink","description":"Rests with his honest human face and patterned body on the stone while his scorpion tail hangs free. Directs Dante to inspect the final group on the sand. Studies the embodied image of fraud before walking toward the usurers.","locationMarkerId":"inferno-loc-cataract","involvedCharacterIds":["inferno-char-geryon","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":74,"travelDays":0,"inWorldTime":0.9413,"tension":4,"tags":["Canto XVII, source lines 1-30"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-17-2","chapterId":"inferno-canto-17","timelineId":"inferno-timeline-descent","title":"The Usurers","description":"Sees crouching shades wave away fire and recognizes families only by emblems on their purses. Waits beside the unnamed monster while Dante makes the brief circuit.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-purse"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":75,"travelDays":0,"inWorldTime":0.9443,"tension":3,"tags":["Canto XVII, source lines 31-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-17-3","chapterId":"inferno-canto-17","timelineId":"inferno-timeline-descent","title":"The Last Purse","description":"Hears one usurer predict another’s arrival and retreats from the grimacing faces. Has already mounted the beast and calls Dante to sit before him.","locationMarkerId":"inferno-loc-burning-sand","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":76,"travelDays":0,"inWorldTime":0.9473,"tension":3,"tags":["Canto XVII, source lines 61-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-17-4","chapterId":"inferno-canto-17","timelineId":"inferno-timeline-descent","title":"Mounting Fraud","description":"Sits on Geryon’s back trembling and asks Virgil to hold him close. Encircles Dante and commands the monster to descend in wide, gentle turns. Pushes off backward and begins circling into the abyss.","locationMarkerId":"inferno-loc-cataract","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil","inferno-char-geryon"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":77,"travelDays":0,"inWorldTime":0.9497,"tension":5,"tags":["Canto XVII, source lines 85-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-17-5","chapterId":"inferno-canto-17","timelineId":"inferno-timeline-descent","title":"The Flight into Malebolge","description":"Swims slowly downward through the dark air toward the eighth circle. Hears new lamentations, sees fires below, and clings tighter in terror. Holds Dante steady throughout the aerial descent.","locationMarkerId":"inferno-loc-malebolge-overlook","involvedCharacterIds":["inferno-char-geryon","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":78,"travelDays":0,"inWorldTime":0.9509,"tension":5,"tags":["Canto XVII, source lines 97-132"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-17-6","chapterId":"inferno-canto-17","timelineId":"inferno-timeline-descent","title":"Set Down Among Fraud","description":"Sets the travellers beside the rocky cliff and vanishes like an arrow. Finds footing on the bottom of the vast eighth circle. Turns toward the first bolgia.","locationMarkerId":"inferno-loc-malebolge-overlook","involvedCharacterIds":["inferno-char-geryon","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":79,"travelDays":0,"inWorldTime":0.9545,"tension":3,"tags":["Canto XVII, source lines 133-136"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-18-1","chapterId":"inferno-canto-18","timelineId":"inferno-timeline-descent","title":"The Ten Trenches","description":"Surveys the stone basin of Malebolge, its ten concentric ditches, and spoke-like bridges. Leads rightward from Geryon’s landing place.","locationMarkerId":"inferno-loc-malebolge-overlook","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":80,"travelDays":1,"inWorldTime":1.0001,"tension":3,"tags":["Canto XVIII, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-18-2","chapterId":"inferno-canto-18","timelineId":"inferno-timeline-descent","title":"The Driven Panders","description":"Looks down on naked shades whipped in opposing files by horned demons. Explains the traffic pattern and pauses when Dante recognizes a face.","locationMarkerId":"inferno-loc-bolgia-one","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":81,"travelDays":0,"inWorldTime":1.0025,"tension":4,"tags":["Canto XVIII, source lines 25-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-18-3","chapterId":"inferno-canto-18","timelineId":"inferno-timeline-descent","title":"Venedico Caccianemico","description":"Confesses selling his sister to satisfy another man and tries to hide his face. Forces the Bolognese shade to identify himself and his offence. Calls Dante onward once the confession is made.","locationMarkerId":"inferno-loc-bolgia-one","involvedCharacterIds":["inferno-char-venedico","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":82,"travelDays":0,"inWorldTime":1.0049,"tension":4,"tags":["Canto XVIII, source lines 49-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-18-4","chapterId":"inferno-canto-18","timelineId":"inferno-timeline-descent","title":"Jason Passes","description":"Walks with royal bearing despite the lashes, bearing punishment for two betrayals. Names the Greek hero and recounts the women abandoned by his eloquence. Studies the dignified face within the degrading procession.","locationMarkerId":"inferno-loc-bolgia-one","involvedCharacterIds":["inferno-char-jason","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":83,"travelDays":0,"inWorldTime":1.0073,"tension":3,"tags":["Canto XVIII, source lines 73-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-18-5","chapterId":"inferno-canto-18","timelineId":"inferno-timeline-descent","title":"The Flatterers","description":"Peers into a ditch choked with filth and struggles to distinguish its submerged faces. Identifies Alessio and Thais as examples of corrupting praise.","locationMarkerId":"inferno-loc-bolgia-two","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":84,"travelDays":0,"inWorldTime":1.0109,"tension":4,"tags":["Canto XVIII, source lines 109-136"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-19-1","chapterId":"inferno-canto-19","timelineId":"inferno-timeline-descent","title":"The Simoniacs","description":"Condemns those who trade sacred things for gold before viewing their punishment. Brings him to the third trench.","locationMarkerId":"inferno-loc-bolgia-three","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":85,"travelDays":0,"inWorldTime":1.0589,"tension":4,"tags":["Canto XIX, source lines 1-12"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-19-2","chapterId":"inferno-canto-19","timelineId":"inferno-timeline-descent","title":"The Fiery Fonts","description":"Sees sinners planted headfirst in round holes while flames dance on their soles. Carries Dante down the bank toward the most violently burning feet.","locationMarkerId":"inferno-loc-bolgia-three","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":86,"travelDays":0,"inWorldTime":1.0601,"tension":4,"tags":["Canto XIX, source lines 13-30"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-19-3","chapterId":"inferno-canto-19","timelineId":"inferno-timeline-descent","title":"The Inverted Confession","description":"Mistakes Dante for Boniface and speaks from the hole as though expecting a successor. Bends like a confessor and asks the buried pope to identify himself. Positions Dante where the voice can reach him.","locationMarkerId":"inferno-loc-bolgia-three","involvedCharacterIds":["inferno-char-nicholas","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":87,"travelDays":0,"inWorldTime":1.0619,"tension":4,"tags":["Canto XIX, source lines 31-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-19-4","chapterId":"inferno-canto-19","timelineId":"inferno-timeline-descent","title":"Nicholas Names the Succession","description":"Admits grasping wealth and explains how later simoniac popes will push him deeper. Answers the pope with a fierce denunciation of purchased spiritual office. Listens approvingly to the rebuke.","locationMarkerId":"inferno-loc-bolgia-three","involvedCharacterIds":["inferno-char-nicholas","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":88,"travelDays":0,"inWorldTime":1.0649,"tension":5,"tags":["Canto XIX, source lines 61-90"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-19-5","chapterId":"inferno-canto-19","timelineId":"inferno-timeline-descent","title":"Dante Rebukes Corruption","description":"Invokes Peter’s unbought commission and blames clerical avarice for corrupting the world. Twists his feet more violently beneath the rebuke. Lifts Dante back to the bridge and holds him against his breast.","locationMarkerId":"inferno-loc-bolgia-three","involvedCharacterIds":["inferno-char-dante","inferno-char-nicholas","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":89,"travelDays":0,"inWorldTime":1.0679,"tension":5,"tags":["Canto XIX, source lines 91-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-19-6","chapterId":"inferno-canto-19","timelineId":"inferno-timeline-descent","title":"Toward the Fourth Trench","description":"Is carried up the difficult bank and set down above the next valley. Climbs without tiring and reveals the fourth bolgia.","locationMarkerId":"inferno-loc-malebolge-overlook","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":90,"travelDays":0,"inWorldTime":1.0709,"tension":2,"tags":["Canto XIX, source lines 121-133"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-20-1","chapterId":"inferno-canto-20","timelineId":"inferno-timeline-descent","title":"The Twisted Seers","description":"Sees diviners walking backward with faces turned permanently toward their backs. Brings him to the bridge above their reversed procession.","locationMarkerId":"inferno-loc-bolgia-four","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":91,"travelDays":0,"inWorldTime":1.1177,"tension":4,"tags":["Canto XX, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-20-2","chapterId":"inferno-canto-20","timelineId":"inferno-timeline-descent","title":"Pity Rebuked","description":"Weeps at the distortion of the human form. Rebukes misplaced pity where divine judgment has already spoken.","locationMarkerId":"inferno-loc-bolgia-four","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":92,"travelDays":0,"inWorldTime":1.1201,"tension":4,"tags":["Canto XX, source lines 25-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-20-3","chapterId":"inferno-canto-20","timelineId":"inferno-timeline-mantua-history","title":"Manto’s Wandering","description":"Leaves Thebes, crosses lands, and settles alone in the uninhabited marsh where her life ends.","locationMarkerId":"inferno-loc-mantua-marsh","involvedCharacterIds":["inferno-char-manto"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-mantua-history"],"motifIds":["inferno-motif-body"],"sortOrder":93,"travelDays":0,"inWorldTime":0.049,"tension":3,"tags":["Canto XX, source lines 49-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-manto","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-20-4","chapterId":"inferno-canto-20","timelineId":"inferno-timeline-mantua-history","title":"The Founding of Mantua","description":"Lives alone beside the Mincio marsh; after her death, settlers build the city over her bones and name it Mantua.","locationMarkerId":"inferno-loc-mantua-marsh","involvedCharacterIds":["inferno-char-manto"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-mantua-history"],"motifIds":["inferno-motif-body"],"sortOrder":94,"travelDays":0,"inWorldTime":0.061,"tension":3,"tags":["Canto XX, source lines 61-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-manto","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-20-5","chapterId":"inferno-canto-20","timelineId":"inferno-timeline-descent","title":"The Other Diviners","description":"Names Eurypylus, Michael Scot, Guido Bonatti, Asdente, and women who abandoned ordinary craft for spells. Watches the moon set while the long procession passes.","locationMarkerId":"inferno-loc-bolgia-four","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":95,"travelDays":0,"inWorldTime":1.1273,"tension":3,"tags":["Canto XX, source lines 97-117"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-20-6","chapterId":"inferno-canto-20","timelineId":"inferno-timeline-descent","title":"Moonset Above Hell","description":"Learns that the moon was full when he entered the wood and marks the passing infernal night. Turns from the seers toward the next bridge.","locationMarkerId":"inferno-loc-bolgia-four","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":96,"travelDays":0,"inWorldTime":1.1294,"tension":2,"tags":["Canto XX, source lines 118-130"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-21-1","chapterId":"inferno-canto-21","timelineId":"inferno-timeline-descent","title":"The Boiling Pitch","description":"Looks into a trench so dark that only the boiling pitch can be seen. Compares its surface to the Venetian Arsenal and warns Dante to stay alert.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":97,"travelDays":0,"inWorldTime":1.1766,"tension":4,"tags":["Canto XXI, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-21-2","chapterId":"inferno-canto-21","timelineId":"inferno-timeline-descent","title":"A Devil with a Grafter","description":"Turns at Virgil’s urgent warning and sees a black devil carrying a sinner by the tendon. Draws him behind a rock before stepping out alone.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":98,"travelDays":0,"inWorldTime":1.179,"tension":5,"tags":["Canto XXI, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-21-3","chapterId":"inferno-canto-21","timelineId":"inferno-timeline-descent","title":"The Elder of Santa Zita","description":"Throw the magistrate into the pitch and threaten any sinner who surfaces. Hears Lucca mocked while the victim disappears beneath the boil. Conceals Dante until he can negotiate passage.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-malebranche","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":99,"travelDays":0,"inWorldTime":1.1802,"tension":5,"tags":["Canto XXI, source lines 37-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-21-4","chapterId":"inferno-canto-21","timelineId":"inferno-timeline-descent","title":"Malacoda Confronted","description":"Advances with a hook, then lowers it when Virgil invokes heavenly sanction. Faces the devils alone and demands safe conduct through the trench. Emerges reluctantly from shelter as the demons turn their hooks toward him.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-malacoda","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":100,"travelDays":0,"inWorldTime":1.1838,"tension":5,"tags":["Canto XXI, source lines 73-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-21-5","chapterId":"inferno-canto-21","timelineId":"inferno-timeline-descent","title":"A Dangerous Escort","description":"Claims the next bridge is broken and assigns ten Malebranche as escort. Accepts the offered route despite Dante’s fear. Studies the demons’ threatening signals and asks to travel without them.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-malacoda","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":101,"travelDays":0,"inWorldTime":1.1862,"tension":4,"tags":["Canto XXI, source lines 97-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-21-6","chapterId":"inferno-canto-21","timelineId":"inferno-timeline-descent","title":"The Ten Malebranche","description":"Names the escort and gives Barbariccia command. Form a grotesque patrol along the boiling pitch. Walks beside Virgil under the devils’ obscene marching signal. Assures Dante that their grimaces are ordinary among themselves.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-malacoda","inferno-char-malebranche","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-hook"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":102,"travelDays":0,"inWorldTime":1.1874,"tension":4,"tags":["Canto XXI, source lines 109-139"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-22-1","chapterId":"inferno-canto-22","timelineId":"inferno-timeline-descent","title":"March with the Demons","description":"Recalls earthly military signals but finds none so strange as the devils’ trumpet. Keeps attention on the pitch while the escort advances. Search the boiling surface for exposed sinners.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil","inferno-char-malebranche"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":103,"travelDays":0,"inWorldTime":1.2354,"tension":3,"tags":["Canto XXII, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-22-2","chapterId":"inferno-canto-22","timelineId":"inferno-timeline-descent","title":"The Navarrese Surfaces","description":"Raises his back like a dolphin for relief and is hooked before he can dive. Drag the grafter onto the bank and surround him with claws. Watches the captured sinner face the patrol. Asks the prisoner’s origin through the demons’ captain.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-ciampolo","inferno-char-malebranche","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":104,"travelDays":0,"inWorldTime":1.2378,"tension":5,"tags":["Canto XXII, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-22-3","chapterId":"inferno-canto-22","timelineId":"inferno-timeline-descent","title":"Ciampolo’s Account","description":"Explains his Navarrese birth, court service, and practice of selling favours. Listens as the sinner identifies Sardinian companions beneath the pitch. Keeps the devils from tearing the prisoner apart long enough to question him.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-ciampolo","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":105,"travelDays":0,"inWorldTime":1.239,"tension":4,"tags":["Canto XXII, source lines 37-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-22-4","chapterId":"inferno-canto-22","timelineId":"inferno-timeline-descent","title":"Hooks Around the Prisoner","description":"Threaten Ciampolo from every side and tear at his arm. Promises to summon other Italians if the demons will stand back. Sees fraud attempt to outwit its own wardens. Allows the proposed signal to test the prisoner’s claim.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-malebranche","inferno-char-ciampolo","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-hook"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":106,"travelDays":0,"inWorldTime":1.2414,"tension":5,"tags":["Canto XXII, source lines 61-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-22-5","chapterId":"inferno-canto-22","timelineId":"inferno-timeline-descent","title":"The Proposed Signal","description":"Offers a whistle said to call seven hidden sinners to the surface. Withdraw just enough to tempt him into the trick. Anticipates the contest between captive and guards. Stays beside the wary patrol while Ciampolo prepares his supposed signal.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-ciampolo","inferno-char-malebranche","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":107,"travelDays":0,"inWorldTime":1.245,"tension":4,"tags":["Canto XXII, source lines 97-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-22-6","chapterId":"inferno-canto-22","timelineId":"inferno-timeline-descent","title":"Ciampolo Escapes","description":"Seizes the instant, dives into the pitch, and escapes every hook. Pursue in rage; Alichino and Calcabrina fall grappling into the boiling tar. Watches the trick reverse power between sinner and demons. Moves away while Barbariccia organizes the rescue.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-ciampolo","inferno-char-malebranche","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-hook"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":108,"travelDays":0,"inWorldTime":1.2474,"tension":5,"tags":["Canto XXII, source lines 121-132"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-22-7","chapterId":"inferno-canto-22","timelineId":"inferno-timeline-descent","title":"The Devils Fall Together","description":"Haul their scalded companions from the pitch and abandon the travellers in confusion. Leaves the quarrelling patrol behind. Continues toward the next bolgia without their escort.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-malebranche","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":109,"travelDays":0,"inWorldTime":1.2486,"tension":4,"tags":["Canto XXII, source lines 133-151"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-23-1","chapterId":"inferno-canto-23","timelineId":"inferno-timeline-descent","title":"Fear of Pursuit","description":"Compares the marching pair to wary friars and imagines the cheated demons pursuing them. Reads Dante’s thought before it is spoken and shares the concern.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":110,"travelDays":0,"inWorldTime":1.2942,"tension":4,"tags":["Canto XXIII, source lines 1-12"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-23-2","chapterId":"inferno-canto-23","timelineId":"inferno-timeline-descent","title":"The Malebranche Give Chase","description":"Sees the winged devils approaching and begs for immediate escape. Plans to carry Dante down the sloping outer bank.","locationMarkerId":"inferno-loc-bolgia-five","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":111,"travelDays":0,"inWorldTime":1.2954,"tension":5,"tags":["Canto XXIII, source lines 13-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-23-3","chapterId":"inferno-canto-23","timelineId":"inferno-timeline-descent","title":"The Slide into Safety","description":"Seizes Dante like a mother rescuing a child and slides down the bank. Is carried into the sixth trench just before the pursuing claws reach them. Stop at the ridge whose jurisdiction they cannot cross.","locationMarkerId":"inferno-loc-bolgia-six","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante","inferno-char-malebranche"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":112,"travelDays":0,"inWorldTime":1.2978,"tension":5,"tags":["Canto XXIII, source lines 37-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-23-4","chapterId":"inferno-canto-23","timelineId":"inferno-timeline-descent","title":"The Gilded Cloaks","description":"Finds a silent procession bent under leaden cloaks glittering with gold. Matches their slow pace while seeking a guide to the next crossing.","locationMarkerId":"inferno-loc-bolgia-six","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":113,"travelDays":0,"inWorldTime":1.3002,"tension":4,"tags":["Canto XXIII, source lines 61-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-23-5","chapterId":"inferno-canto-23","timelineId":"inferno-timeline-descent","title":"The Jovial Friars","description":"Identifies himself and Loderingo as Bolognese friars chosen to keep peace. Walks beside Catalano beneath the crushing gilded habit. Begins to condemn their hypocrisy before another sight interrupts him. Hears their explanation of the bolgia.","locationMarkerId":"inferno-loc-bolgia-six","involvedCharacterIds":["inferno-char-catalano","inferno-char-loderingo","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":114,"travelDays":0,"inWorldTime":1.3026,"tension":4,"tags":["Canto XXIII, source lines 85-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-23-6","chapterId":"inferno-canto-23","timelineId":"inferno-timeline-descent","title":"Caiaphas on the Ground","description":"Points out Caiaphas crucified across the path and explains that every hypocrite must tread on him. Looks down at the stretched body beneath the weighted procession. Marvels at the punishment he had not seen on his earlier descent.","locationMarkerId":"inferno-loc-bolgia-six","involvedCharacterIds":["inferno-char-catalano","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":115,"travelDays":0,"inWorldTime":1.305,"tension":4,"tags":["Canto XXIII, source lines 109-132"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-23-7","chapterId":"inferno-canto-23","timelineId":"inferno-timeline-descent","title":"Malacoda’s Lie","description":"Explains that the nearby bridges are broken but a climbable ruin reaches the next ridge. Recognizes that Malacoda lied and strides away in anger. Follows the guide toward the fallen stones.","locationMarkerId":"inferno-loc-bolgia-six","involvedCharacterIds":["inferno-char-catalano","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":116,"travelDays":0,"inWorldTime":1.3074,"tension":3,"tags":["Canto XXIII, source lines 133-148"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-24-1","chapterId":"inferno-canto-24","timelineId":"inferno-timeline-descent","title":"The Difficult Climb","description":"Sees Virgil’s anger soften and compares the change to frost yielding under the sun. Studies the ruins and begins climbing the stones first.","locationMarkerId":"inferno-loc-broken-bridge","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":117,"travelDays":0,"inWorldTime":1.353,"tension":3,"tags":["Canto XXIV, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-24-2","chapterId":"inferno-canto-24","timelineId":"inferno-timeline-descent","title":"Carried Up the Ruin","description":"Pushes and pulls Dante from ledge to ledge until both reach the ridge. Spends his breath on the steep ascent and rests only briefly.","locationMarkerId":"inferno-loc-broken-bridge","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":118,"travelDays":0,"inWorldTime":1.3554,"tension":4,"tags":["Canto XXIV, source lines 25-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-24-3","chapterId":"inferno-canto-24","timelineId":"inferno-timeline-descent","title":"Toward the Seventh Bolgia","description":"Urges Dante to overcome heaviness because fame cannot be won from cushions. Rises, claims more strength than he feels, and follows toward the next opening.","locationMarkerId":"inferno-loc-malebolge-overlook","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":119,"travelDays":0,"inWorldTime":1.359,"tension":3,"tags":["Canto XXIV, source lines 61-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-24-4","chapterId":"inferno-canto-24","timelineId":"inferno-timeline-descent","title":"The Pit of Serpents","description":"Peers down at naked thieves running among a monstrous abundance of serpents. Finds a descent along the shattered bank.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":120,"travelDays":0,"inWorldTime":1.3602,"tension":5,"tags":["Canto XXIV, source lines 73-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-24-5","chapterId":"inferno-canto-24","timelineId":"inferno-timeline-descent","title":"Ashes and Restoration","description":"Is bitten, burns into ash, and reforms immediately before the travellers. Watches a punishment outdoing every tale of phoenix-like renewal. Asks the restored shade to identify himself.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-vanni","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":121,"travelDays":0,"inWorldTime":1.3626,"tension":5,"tags":["Canto XXIV, source lines 97-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-24-6","chapterId":"inferno-canto-24","timelineId":"inferno-timeline-descent","title":"Vanni Fucci","description":"Names himself as a violent Pistoian thief and confesses the theft from the sacristy. Recognizes the man and presses for the crime that placed him here. Listens as the prisoner turns confession into a hostile prophecy.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-vanni","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":122,"travelDays":0,"inWorldTime":1.365,"tension":4,"tags":["Canto XXIV, source lines 121-151"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-25-1","chapterId":"inferno-canto-25","timelineId":"inferno-timeline-descent","title":"Vanni’s Blasphemy","description":"Raises an obscene gesture against God and is instantly bound by serpents. Denounces Pistoia and watches the thief flee unable to speak. Advances along the seventh bolgia as the serpents silence Vanni’s blasphemy.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-vanni","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":123,"travelDays":0,"inWorldTime":1.4119,"tension":5,"tags":["Canto XXV, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-25-2","chapterId":"inferno-canto-25","timelineId":"inferno-timeline-descent","title":"Cacus the Centaur","description":"Gallops past covered in serpents with a fire-breathing dragon on his shoulders. Explains why this violent thief is separated from the other centaurs. Watches the monster vanish beneath the ridge.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-cacus","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":124,"travelDays":0,"inWorldTime":1.4143,"tension":4,"tags":["Canto XXV, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-25-3","chapterId":"inferno-canto-25","timelineId":"inferno-timeline-descent","title":"Three Florentine Thieves","description":"Sees three shades arrive asking after Cianfa and stays silent at Virgil’s signal. Commands silent attention to the transformation beginning before them.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":125,"travelDays":0,"inWorldTime":1.4155,"tension":4,"tags":["Canto XXV, source lines 37-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-25-4","chapterId":"inferno-canto-25","timelineId":"inferno-timeline-descent","title":"Six Limbs Become One","description":"Watches a six-footed serpent fuse with Agnello until neither original form remains. Observes the mingled body move away.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":126,"travelDays":0,"inWorldTime":1.4167,"tension":5,"tags":["Canto XXV, source lines 49-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-25-5","chapterId":"inferno-canto-25","timelineId":"inferno-timeline-descent","title":"The Blended Shape","description":"Loses separate human form as flesh, limbs, colour, and face combine with Cianfa. Enfolds Agnello as a serpent and becomes one shared monstrous shape.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-agnello","inferno-char-cianfa"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":127,"travelDays":0,"inWorldTime":1.4179,"tension":5,"tags":["Canto XXV, source lines 61-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-agnello","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-25-6","chapterId":"inferno-canto-25","timelineId":"inferno-timeline-descent","title":"Man and Serpent Exchange","description":"Trades human form with the attacking serpent in a simultaneous distortion of limbs and speech. Rises from serpent shape into the human body taken from Buoso. Follows each exchanged feature despite the speed of change. Stands beside Dante through the metamorphosis.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-buoso","inferno-char-guercio","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":128,"travelDays":0,"inWorldTime":1.4215,"tension":5,"tags":["Canto XXV, source lines 97-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-25-7","chapterId":"inferno-canto-25","timelineId":"inferno-timeline-descent","title":"Forms Reversed","description":"Crawls away transformed as a serpent and hisses along the valley. Speaks from the newly acquired human mouth and drives the serpent off. Identifies Puccio as the only one of the three who did not change. Leads Dante from the thieves after their exchanged forms become distinguishable.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-buoso","inferno-char-guercio","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":129,"travelDays":0,"inWorldTime":1.4239,"tension":4,"tags":["Canto XXV, source lines 121-144"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-25-8","chapterId":"inferno-canto-25","timelineId":"inferno-timeline-descent","title":"Florence Remembered","description":"Concedes possible confusion in so strange a sight while recognizing Guercio Cavalcanti. Continues toward the eighth bolgia.","locationMarkerId":"inferno-loc-bolgia-seven","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":130,"travelDays":0,"inWorldTime":1.4263,"tension":2,"tags":["Canto XXV, source lines 145-151"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-26-1","chapterId":"inferno-canto-26","timelineId":"inferno-timeline-descent","title":"Florence’s Stolen Fame","description":"Turns bitterly on Florence after finding five of its citizens among the thieves. Climbs the rough stair of the bridge ahead.","locationMarkerId":"inferno-loc-malebolge-overlook","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":131,"travelDays":0,"inWorldTime":1.4707,"tension":3,"tags":["Canto XXVI, source lines 1-12"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-26-2","chapterId":"inferno-canto-26","timelineId":"inferno-timeline-descent","title":"The Bridge of Flames","description":"Hauls himself up the rocks and leans over a bolgia filled with moving points of fire. Warns him to hold fast and explains that each flame hides a sinner.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":132,"travelDays":0,"inWorldTime":1.4719,"tension":4,"tags":["Canto XXVI, source lines 13-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-26-3","chapterId":"inferno-canto-26","timelineId":"inferno-timeline-descent","title":"Counsellors Concealed","description":"Compares the scattered flames to fireflies and Elisha’s vision of Elijah. Confirms that the spirits are wrapped in the fire that burns them.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":133,"travelDays":0,"inWorldTime":1.4731,"tension":4,"tags":["Canto XXVI, source lines 25-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-26-4","chapterId":"inferno-canto-26","timelineId":"inferno-timeline-descent","title":"The Double Flame","description":"Identifies Ulysses and Diomedes together in one divided flame. Begs repeatedly to hear the Greek hero and yields the questioning to Virgil. Moves with Diomedes inside the greater horn of fire. Shares the flame and penalties of stratagem with Ulysses.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante","inferno-char-ulysses","inferno-char-diomedes"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":134,"travelDays":0,"inWorldTime":1.4755,"tension":4,"tags":["Canto XXVI, source lines 49-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-26-5","chapterId":"inferno-canto-26","timelineId":"inferno-timeline-descent","title":"Virgil Calls Ulysses","description":"Addresses the ancient Greeks in elevated speech and asks where Ulysses died. Makes the larger horn murmur like a flame in wind before speaking. Listens from the bridge without addressing the Greek directly.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-virgil","inferno-char-ulysses","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":135,"travelDays":0,"inWorldTime":1.4779,"tension":4,"tags":["Canto XXVI, source lines 73-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-26-6","chapterId":"inferno-canto-26","timelineId":"inferno-timeline-ulysses-voyage","title":"Ulysses Leaves Home","description":"Recalls leaving Circe and refusing the claims of son, father, and wife in pursuit of the world. Sail west with Ulysses through the Mediterranean beyond familiar shores.","locationMarkerId":"inferno-loc-mediterranean","involvedCharacterIds":["inferno-char-ulysses","inferno-char-companions"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-ship"],"threadIds":["inferno-thread-ulysses-voyage"],"motifIds":["inferno-motif-body"],"sortOrder":136,"travelDays":0,"inWorldTime":0.085,"tension":4,"tags":["Canto XXVI, source lines 85-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-ulysses","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-26-7","chapterId":"inferno-canto-26","timelineId":"inferno-timeline-ulysses-voyage","title":"Beyond the Pillars","description":"Urges his aging crew toward knowledge, crosses the forbidden boundary, and sights a vast mountain before the sea closes over the ship. Turn their oars to wings for the mad flight and perish with their commander.","locationMarkerId":"inferno-loc-western-ocean","involvedCharacterIds":["inferno-char-ulysses","inferno-char-companions"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-ship"],"threadIds":["inferno-thread-ulysses-voyage"],"motifIds":["inferno-motif-body"],"sortOrder":137,"travelDays":0,"inWorldTime":0.121,"tension":5,"tags":["Canto XXVI, source lines 121-142"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-ulysses","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-27-1","chapterId":"inferno-canto-27","timelineId":"inferno-timeline-descent","title":"Guido’s Flame Approaches","description":"Begins speaking from a flame after the double horn departs. Waits while a new voice asks about Romagna. Invites Dante, as an Italian, to answer the inquiry.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-guidoMontefeltro","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":138,"travelDays":0,"inWorldTime":1.5295,"tension":3,"tags":["Canto XXVII, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-27-2","chapterId":"inferno-canto-27","timelineId":"inferno-timeline-descent","title":"News of Romagna","description":"Describes the uneasy peace and tyrannies of Ravenna, Forlì, Rimini, Faenza, and Cesena. Listens for news of the land he left behind. Yields the conversation to Dante.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-dante","inferno-char-guidoMontefeltro","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":139,"travelDays":0,"inWorldTime":1.5319,"tension":3,"tags":["Canto XXVII, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-27-3","chapterId":"inferno-canto-27","timelineId":"inferno-timeline-descent","title":"The Cities and Their Lords","description":"Names each city through the heraldic beasts and political powers ruling it. Receives the living report from his homeland.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-dante","inferno-char-guidoMontefeltro"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":140,"travelDays":0,"inWorldTime":1.5331,"tension":3,"tags":["Canto XXVII, source lines 37-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-27-4","chapterId":"inferno-canto-27","timelineId":"inferno-timeline-descent","title":"Guido Names Himself","description":"Believing no one returns alive, identifies himself and begins explaining how cunning defined his life. Hears a confession offered only because the speaker thinks it cannot reach the world. Remains beside Dante on the bridge.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-guidoMontefeltro","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":141,"travelDays":0,"inWorldTime":1.5355,"tension":4,"tags":["Canto XXVII, source lines 61-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-27-5","chapterId":"inferno-canto-27","timelineId":"inferno-timeline-guido-memory","title":"From Soldier to Friar","description":"Abandons arms for a friar’s cord, hoping repentance will repair his past, until Pope Boniface seeks his counsel.","locationMarkerId":"inferno-loc-montefeltro-memory","involvedCharacterIds":["inferno-char-guidoMontefeltro"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-guido-memory"],"motifIds":["inferno-motif-body"],"sortOrder":142,"travelDays":0,"inWorldTime":0.073,"tension":3,"tags":["Canto XXVII, source lines 73-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-guidoMontefeltro","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-27-6","chapterId":"inferno-canto-27","timelineId":"inferno-timeline-guido-memory","title":"The Fraudulent Absolution","description":"Demands advice for breaking Palestrina and promises absolution before the sin is committed. Yields the fraudulent counsel after being threatened with papal power.","locationMarkerId":"inferno-loc-lateran","involvedCharacterIds":["inferno-char-boniface","inferno-char-guidoMontefeltro"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-guido-memory"],"motifIds":["inferno-motif-body"],"sortOrder":143,"travelDays":0,"inWorldTime":0.085,"tension":5,"tags":["Canto XXVII, source lines 85-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-boniface","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-27-7","chapterId":"inferno-canto-27","timelineId":"inferno-timeline-guido-memory","title":"Logic at the Deathbed","description":"Faces the black cherub’s argument that promised absolution cannot cover a sin never repented.","locationMarkerId":"inferno-loc-montefeltro-memory","involvedCharacterIds":["inferno-char-guidoMontefeltro"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-guido-memory"],"motifIds":["inferno-motif-body"],"sortOrder":144,"travelDays":0,"inWorldTime":0.121,"tension":4,"tags":["Canto XXVII, source lines 121-132"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-guidoMontefeltro","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-27-8","chapterId":"inferno-canto-27","timelineId":"inferno-timeline-descent","title":"The Flame Departs","description":"Watches Guido’s flame move away after the confession reaches its judgment. Leads onward to the ninth bolgia.","locationMarkerId":"inferno-loc-bolgia-eight","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":145,"travelDays":0,"inWorldTime":1.5427,"tension":3,"tags":["Canto XXVII, source lines 133-136"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-28-1","chapterId":"inferno-canto-28","timelineId":"inferno-timeline-descent","title":"The Wounds of Schism","description":"Declares ordinary language insufficient for the mutilations of the ninth bolgia. Leads him among those repeatedly divided by a sword-bearing devil.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":146,"travelDays":0,"inWorldTime":1.5883,"tension":5,"tags":["Canto XXVIII, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-28-2","chapterId":"inferno-canto-28","timelineId":"inferno-timeline-descent","title":"Mahomet and Ali","description":"Shows his opened body and points to Ali’s cleft face while explaining the cycle of wounds. Answers that no punishment has brought him here and names his living journey. Confirms Dante’s living state and divine purpose.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-mahomet","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":147,"travelDays":0,"inWorldTime":1.5907,"tension":5,"tags":["Canto XXVIII, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-28-3","chapterId":"inferno-canto-28","timelineId":"inferno-timeline-descent","title":"The Sword Behind Them","description":"Explains that a devil renews every wound after each circuit and sends a warning to Fra Dolcino. Receives the message meant for the living world. Remains beside Dante while the warning for Fra Dolcino is entrusted to him.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-mahomet","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":148,"travelDays":0,"inWorldTime":1.5919,"tension":4,"tags":["Canto XXVIII, source lines 37-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-28-4","chapterId":"inferno-canto-28","timelineId":"inferno-timeline-descent","title":"Pier da Medicina","description":"Shows his pierced throat and sends warnings to two men of Fano. Agrees to carry the message and asks about another threatened victim. Waits while Dante receives Pier da Medicina’s warning for the men of Fano.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-pierMedicina","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":149,"travelDays":0,"inWorldTime":1.5943,"tension":4,"tags":["Canto XXVIII, source lines 61-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-28-5","chapterId":"inferno-canto-28","timelineId":"inferno-timeline-descent","title":"The Fano Warning","description":"Predicts a treacherous drowning and identifies the one-eyed lord behind it. Looks where the speaker directs and questions another shade.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-pierMedicina","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":150,"travelDays":0,"inWorldTime":1.5955,"tension":4,"tags":["Canto XXVIII, source lines 73-90"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-28-6","chapterId":"inferno-canto-28","timelineId":"inferno-timeline-descent","title":"Curio and Mosca","description":"Displays the tongue cut from the throat that urged Caesar across the Rubicon. Raises mutilated arms and recalls the counsel that began Tuscan bloodshed. Answers Mosca with the destruction of his lineage. Draws Dante onward after the exchanges with Curio and Mosca turn bitter.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-curio","inferno-char-mosca","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":151,"travelDays":0,"inWorldTime":1.5973,"tension":4,"tags":["Canto XXVIII, source lines 91-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-28-7","chapterId":"inferno-canto-28","timelineId":"inferno-timeline-descent","title":"Bertran Carries His Head","description":"Walks holding his severed head like a lantern and explains the contrapasso for dividing father and son. Receives the final sight of the bolgia in astonishment. Leads from Bertran’s final explanation toward the bridge above the tenth ditch.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-bertran","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":152,"travelDays":0,"inWorldTime":1.6003,"tension":5,"tags":["Canto XXVIII, source lines 121-142"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-29-1","chapterId":"inferno-canto-29","timelineId":"inferno-timeline-descent","title":"Looking Back at Geri","description":"Lingers over the crowd because he thinks he saw a kinsman threatening him. Explains that Geri del Bello resents a death still unavenged.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":153,"travelDays":0,"inWorldTime":1.6472,"tension":3,"tags":["Canto XXIX, source lines 1-12"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-29-2","chapterId":"inferno-canto-29","timelineId":"inferno-timeline-descent","title":"The Unanswered Blood Feud","description":"Explains that no family vengeance has answered Geri’s violent death. Turns him firmly toward the next trench.","locationMarkerId":"inferno-loc-bolgia-nine","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":154,"travelDays":0,"inWorldTime":1.6484,"tension":3,"tags":["Canto XXIX, source lines 13-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-29-3","chapterId":"inferno-canto-29","timelineId":"inferno-timeline-descent","title":"The Stench of Disease","description":"Reaches the final bolgia and is struck by a reek like every hospital crowded into one ditch. Descends to the bank where the falsifiers can be seen.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":155,"travelDays":0,"inWorldTime":1.6508,"tension":4,"tags":["Canto XXIX, source lines 37-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-29-4","chapterId":"inferno-canto-29","timelineId":"inferno-timeline-descent","title":"The Diseased Falsifiers","description":"Sees heaps of sufferers covered with scabs and unable to rise. Approaches two alchemists leaning against each other.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":156,"travelDays":0,"inWorldTime":1.652,"tension":4,"tags":["Canto XXIX, source lines 49-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-29-5","chapterId":"inferno-canto-29","timelineId":"inferno-timeline-descent","title":"Griffolino and Capocchio","description":"Scrapes his diseased skin and identifies himself as an alchemist burned for deceiving Albero. Names himself as a skilled ape of nature and joins the mockery of Sienese vanity. Promises earthly remembrance in exchange for their identities. Listens while the two Italians answer.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-griffolino","inferno-char-capocchio","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":157,"travelDays":0,"inWorldTime":1.6544,"tension":4,"tags":["Canto XXIX, source lines 73-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-29-6","chapterId":"inferno-canto-29","timelineId":"inferno-timeline-descent","title":"Alchemy and Deception","description":"Distinguishes the false promise of flight from the alchemy that condemned him here. Reminds Dante of his talent for imitating natural things. Recognizes Capocchio’s face and history. Prepares to move as new frenzy enters the ditch.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-griffolino","inferno-char-capocchio","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":158,"travelDays":0,"inWorldTime":1.658,"tension":3,"tags":["Canto XXIX, source lines 109-139"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-30-1","chapterId":"inferno-canto-30","timelineId":"inferno-timeline-descent","title":"The Frenzied Impersonators","description":"Recalls mythical madness before seeing two pale shades race forward biting others. Identifies the frenzy as another species of falsification.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":159,"travelDays":0,"inWorldTime":1.706,"tension":5,"tags":["Canto XXX, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-30-2","chapterId":"inferno-canto-30","timelineId":"inferno-timeline-descent","title":"Gianni Schicchi and Myrrha","description":"Bites Capocchio and drags him along the stony floor. Runs rabid through the ditch in the form of one who falsified herself for incest. Watches Griffolino identify the two impersonators. Keeps Dante attentive to the next sufferers.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-gianni","inferno-char-myrrha","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":160,"travelDays":0,"inWorldTime":1.7084,"tension":5,"tags":["Canto XXX, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-30-3","chapterId":"inferno-canto-30","timelineId":"inferno-timeline-descent","title":"Master Adam","description":"Sits swollen and immobile with dropsy, tormented by thirst and the memory of clear streams. Studies the counterfeiter’s distorted body. Allows Dante to question Master Adam about thirst, memory, and counterfeiting.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-masterAdam","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":161,"travelDays":0,"inWorldTime":1.7096,"tension":4,"tags":["Canto XXX, source lines 37-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-30-4","chapterId":"inferno-canto-30","timelineId":"inferno-timeline-descent","title":"The Counterfeit Florins","description":"Names the coinage fraud at Romena and longs to find the Guidi who employed him. Asks who lies smoking beside the counterfeiter. Listens to the catalogue of falsifiers.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-masterAdam","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-florins"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":162,"travelDays":0,"inWorldTime":1.7108,"tension":4,"tags":["Canto XXX, source lines 49-90"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-30-5","chapterId":"inferno-canto-30","timelineId":"inferno-timeline-descent","title":"Sinon and Potiphar’s Wife","description":"Identifies two liars and trades insults with Sinon. Strikes Adam’s belly and defends his own truthful words amid the lie of Troy. Becomes absorbed in the degrading quarrel. Rebukes Dante sharply for desiring to hear more.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-masterAdam","inferno-char-sinon","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":163,"travelDays":0,"inWorldTime":1.715,"tension":5,"tags":["Canto XXX, source lines 91-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-30-6","chapterId":"inferno-canto-30","timelineId":"inferno-timeline-descent","title":"The Quarrel of Thirst and Fever","description":"Mocks Sinon’s fever and lying tongue while defending his own heavier body. Returns each insult and accusation in kind. Feels shame as the exchange grows more petty. Warns that further fascination would provoke real anger.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-masterAdam","inferno-char-sinon","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":164,"travelDays":0,"inWorldTime":1.7168,"tension":4,"tags":["Canto XXX, source lines 109-132"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-30-7","chapterId":"inferno-canto-30","timelineId":"inferno-timeline-descent","title":"Dante’s Shame","description":"Turns so ashamed that he cannot speak and receives forgiveness without asking. Explains that honest shame already washes away the fault and leads onward.","locationMarkerId":"inferno-loc-bolgia-ten","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":165,"travelDays":0,"inWorldTime":1.7192,"tension":2,"tags":["Canto XXX, source lines 133-148"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-31-1","chapterId":"inferno-canto-31","timelineId":"inferno-timeline-descent","title":"The Horn in the Darkness","description":"Hears a horn louder than thunder as Virgil’s rebuke and reassurance settle. Directs Dante’s sight toward the sound through the dense air.","locationMarkerId":"inferno-loc-giants-well","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-horn"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":166,"travelDays":0,"inWorldTime":1.7648,"tension":3,"tags":["Canto XXXI, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-31-2","chapterId":"inferno-canto-31","timelineId":"inferno-timeline-descent","title":"Towers That Are Giants","description":"Mistakes immense figures for towers until their bodies emerge around the well. Corrects the error and explains that the giants stand from the navel downward in the pit.","locationMarkerId":"inferno-loc-giants-well","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":167,"travelDays":0,"inWorldTime":1.7672,"tension":4,"tags":["Canto XXXI, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-31-3","chapterId":"inferno-canto-31","timelineId":"inferno-timeline-descent","title":"Nimrod","description":"Cries incomprehensible words and wears the horn that announced him. Calls his confused language a fitting answer to Babel and tells Dante not to engage him. Measures the giant’s face and torso against monuments.","locationMarkerId":"inferno-loc-giants-well","involvedCharacterIds":["inferno-char-nimrod","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":["inferno-item-horn"],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":168,"travelDays":0,"inWorldTime":1.7684,"tension":4,"tags":["Canto XXXI, source lines 37-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-31-4","chapterId":"inferno-canto-31","timelineId":"inferno-timeline-descent","title":"Ephialtes Bound","description":"Stands chained so tightly that his violent shaking makes the bank tremble. Asks to see Briareus and recoils when the nearer giant moves. Names Ephialtes and explains the rebellion that earned his bonds.","locationMarkerId":"inferno-loc-giants-well","involvedCharacterIds":["inferno-char-ephialtes","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":169,"travelDays":0,"inWorldTime":1.7708,"tension":4,"tags":["Canto XXXI, source lines 61-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-31-5","chapterId":"inferno-canto-31","timelineId":"inferno-timeline-descent","title":"Seeking Antaeus","description":"Asks to see the unbound giant reputed to have fought in the old war. Promises Antaeus ahead and prepares an appeal to his pride.","locationMarkerId":"inferno-loc-giants-well","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":170,"travelDays":0,"inWorldTime":1.7732,"tension":3,"tags":["Canto XXXI, source lines 85-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-31-6","chapterId":"inferno-canto-31","timelineId":"inferno-timeline-descent","title":"Virgil Persuades Antaeus","description":"Bends his enormous hand after Virgil promises earthly fame. Praises the giant’s strength and asks him to lower both travellers into Cocytus. Clings close as the giant reaches down.","locationMarkerId":"inferno-loc-giants-well","involvedCharacterIds":["inferno-char-antaeus","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":171,"travelDays":0,"inWorldTime":1.7756,"tension":4,"tags":["Canto XXXI, source lines 109-132"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-31-7","chapterId":"inferno-canto-31","timelineId":"inferno-timeline-descent","title":"Lowered into Cocytus","description":"Lifts the pair together and sets them gently at the bottom before rising like a mast. Holds Dante while the giant stoops into the abyss. Feels mortal terror in the vast embrace and reaches the frozen ninth circle.","locationMarkerId":"inferno-loc-cocytus","involvedCharacterIds":["inferno-char-antaeus","inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":172,"travelDays":0,"inWorldTime":1.778,"tension":5,"tags":["Canto XXXI, source lines 133-145"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-32-1","chapterId":"inferno-canto-32","timelineId":"inferno-timeline-descent","title":"Invocation for the Frozen Lake","description":"Calls for rough language adequate to the bottom of the universe and fears his words may fail. Guides him from the giant’s feet onto the ice.","locationMarkerId":"inferno-loc-cocytus","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":173,"travelDays":0,"inWorldTime":1.8236,"tension":3,"tags":["Canto XXXII, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-32-2","chapterId":"inferno-canto-32","timelineId":"inferno-timeline-descent","title":"Caina","description":"Sees traitors’ faces bent downward above the frozen lake, teeth chattering like storks. Leads carefully among heads fixed in the ice.","locationMarkerId":"inferno-loc-caina","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":174,"travelDays":0,"inWorldTime":1.826,"tension":4,"tags":["Canto XXXII, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-32-3","chapterId":"inferno-canto-32","timelineId":"inferno-timeline-descent","title":"The Brothers in the Ice","description":"Questions two shades frozen breast to breast and learns of fraternal murder. Waits as other voices identify Caina’s notorious dead.","locationMarkerId":"inferno-loc-caina","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":175,"travelDays":0,"inWorldTime":1.8272,"tension":4,"tags":["Canto XXXII, source lines 37-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-32-4","chapterId":"inferno-canto-32","timelineId":"inferno-timeline-descent","title":"Antenora","description":"Kicks one head by chance or fate and is cursed by the injured traitor. Moves toward the centre of the lake while Dante demands a name.","locationMarkerId":"inferno-loc-antenora","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":176,"travelDays":0,"inWorldTime":1.8308,"tension":4,"tags":["Canto XXXII, source lines 73-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-32-5","chapterId":"inferno-canto-32","timelineId":"inferno-timeline-descent","title":"Bocca Refuses His Name","description":"Refuses identity and dares Dante to leave until his hair is seized. Threatens to pluck the traitor bare unless he speaks. Allows the interrogation while the frozen shades call out.","locationMarkerId":"inferno-loc-antenora","involvedCharacterIds":["inferno-char-bocca","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":177,"travelDays":0,"inWorldTime":1.832,"tension":5,"tags":["Canto XXXII, source lines 85-96"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-32-6","chapterId":"inferno-canto-32","timelineId":"inferno-timeline-descent","title":"Bocca Exposed","description":"Learns Bocca’s name from another shade and promises to carry his infamy above. Retaliates by naming fellow traitors in Antenora. Calls Dante away from the exchange.","locationMarkerId":"inferno-loc-antenora","involvedCharacterIds":["inferno-char-dante","inferno-char-bocca","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":178,"travelDays":0,"inWorldTime":1.8332,"tension":4,"tags":["Canto XXXII, source lines 97-120"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-32-7","chapterId":"inferno-canto-32","timelineId":"inferno-timeline-descent","title":"One Head Gnaws Another","description":"Gnaws the skull of Archbishop Ruggieri from behind. Remains trapped beneath the teeth of his victim. Asks what hatred can justify so brutal a meal and offers to report the cause. Stands beside Dante at the terrible tableau.","locationMarkerId":"inferno-loc-antenora","involvedCharacterIds":["inferno-char-ugolino","inferno-char-ruggieri","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":179,"travelDays":0,"inWorldTime":1.8356,"tension":5,"tags":["Canto XXXII, source lines 121-139"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-1","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-descent","title":"Ugolino Raises His Mouth","description":"Wipes another’s hair from his bloodied mouth and agrees to renew grief for the promise of infamy. Lies frozen beneath the count’s hands and teeth. Listens after pledging to carry the story to the living world. Waits beside Dante on Antenora’s ice while Ugolino begins his testimony.","locationMarkerId":"inferno-loc-antenora","involvedCharacterIds":["inferno-char-ugolino","inferno-char-ruggieri","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":180,"travelDays":0,"inWorldTime":1.8825,"tension":5,"tags":["Canto XXXIII, source lines 1-12"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-2","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-ugolino-memory","title":"The Tower Is Sealed","description":"Recalls imprisonment with his sons and grandsons, the prophetic dream, and the door being nailed shut. Wake hungry in the tower and look to their father for meaning.","locationMarkerId":"inferno-loc-hunger-tower","involvedCharacterIds":["inferno-char-ugolino","inferno-char-children"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-ugolino-memory"],"motifIds":["inferno-motif-speech"],"sortOrder":181,"travelDays":0,"inWorldTime":0.013,"tension":4,"tags":["Canto XXXIII, source lines 13-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-ugolino","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-3","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-ugolino-memory","title":"The Dream of the Hunt","description":"Interprets the dream of wolf and cubs as the approach of enemies and starvation. Ask for bread while the father reads terror in each face.","locationMarkerId":"inferno-loc-hunger-tower","involvedCharacterIds":["inferno-char-ugolino","inferno-char-children"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-ugolino-memory"],"motifIds":["inferno-motif-body"],"sortOrder":182,"travelDays":0,"inWorldTime":0.025,"tension":4,"tags":["Canto XXXIII, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-ugolino","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-4","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-ugolino-memory","title":"The Children Ask for Bread","description":"Bites his hands in silent anguish when no food comes. Offer their own bodies, believing their father’s gesture means hunger.","locationMarkerId":"inferno-loc-hunger-tower","involvedCharacterIds":["inferno-char-ugolino","inferno-char-children"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-ugolino-memory"],"motifIds":["inferno-motif-body"],"sortOrder":183,"travelDays":0,"inWorldTime":0.037,"tension":5,"tags":["Canto XXXIII, source lines 37-48"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-ugolino","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-5","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-ugolino-memory","title":"The Last Days in the Tower","description":"Watches each child die, goes blind, and calls their names until hunger overcomes grief. Fall one by one across the prison floor during the final days.","locationMarkerId":"inferno-loc-hunger-tower","involvedCharacterIds":["inferno-char-ugolino","inferno-char-children"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-ugolino-memory"],"motifIds":["inferno-motif-speech"],"sortOrder":184,"travelDays":0,"inWorldTime":0.049,"tension":5,"tags":["Canto XXXIII, source lines 49-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-ugolino","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-6","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-ugolino-memory","title":"Hunger Overcomes Grief","description":"Goes blind, gropes over each fallen child, and at last yields to hunger after grief.","locationMarkerId":"inferno-loc-hunger-tower","involvedCharacterIds":["inferno-char-ugolino"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-ugolino-memory"],"motifIds":["inferno-motif-body"],"sortOrder":185,"travelDays":0,"inWorldTime":0.073,"tension":5,"tags":["Canto XXXIII, source lines 73-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-ugolino","isFlashback":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-7","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-descent","title":"Pisa Condemned","description":"Returns to gnawing the archbishop after his account. Condemns Pisa for punishing children who had no part in treason. Leads Dante onward across Antenora after the condemnation of Pisa.","locationMarkerId":"inferno-loc-antenora","involvedCharacterIds":["inferno-char-ugolino","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":186,"travelDays":0,"inWorldTime":1.8909,"tension":5,"tags":["Canto XXXIII, source lines 85-90"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-8","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-descent","title":"Ptolomaea","description":"Finds shades lying face upward while frozen tears seal their eyes. Crosses the hard crust toward the final zone.","locationMarkerId":"inferno-loc-ptolomaea","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":187,"travelDays":0,"inWorldTime":1.8915,"tension":4,"tags":["Canto XXXIII, source lines 91-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-33-9","chapterId":"inferno-canto-33","timelineId":"inferno-timeline-descent","title":"Fra Alberigo’s Bargain","description":"Asks Dante to clear the ice from his eyes and explains that some traitors fall here before bodily death. Promises relief in exchange for the truth, then refuses it after hearing the betrayal. Waits while the living traveller learns the strange law.","locationMarkerId":"inferno-loc-ptolomaea","involvedCharacterIds":["inferno-char-alberigo","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":188,"travelDays":0,"inWorldTime":1.8933,"tension":5,"tags":["Canto XXXIII, source lines 109-157"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-34-1","chapterId":"inferno-canto-34","timelineId":"inferno-timeline-descent","title":"The Banners of the King of Hell","description":"Announces the approach to Lucifer and places Dante where the shape can emerge through the gloom. Sees souls wholly sealed in the transparent ice of Judecca.","locationMarkerId":"inferno-loc-judecca","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":189,"travelDays":0,"inWorldTime":1.9413,"tension":5,"tags":["Canto XXXIV, source lines 1-24"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-34-2","chapterId":"inferno-canto-34","timelineId":"inferno-timeline-descent","title":"Lucifer Revealed","description":"Rises from the ice with three faces, six batlike wings, and three sinners crushed in his mouths. Loses the ordinary sense of life and death before the ruined grandeur. Measures Lucifer against the giants and names the three greatest traitors.","locationMarkerId":"inferno-loc-judecca","involvedCharacterIds":["inferno-char-lucifer","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":190,"travelDays":0,"inWorldTime":1.9437,"tension":5,"tags":["Canto XXXIV, source lines 25-36"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-34-3","chapterId":"inferno-canto-34","timelineId":"inferno-timeline-descent","title":"The Three Faces","description":"Weeps from six eyes while his wings freeze Cocytus and his mouths chew Judas, Brutus, and Cassius. Studies the colours and structure of the emperor of the dolorous realm. Explains each mouth’s prisoner and announces that night is returning.","locationMarkerId":"inferno-loc-judecca","involvedCharacterIds":["inferno-char-lucifer","inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":191,"travelDays":0,"inWorldTime":1.9449,"tension":5,"tags":["Canto XXXIV, source lines 37-60"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-34-4","chapterId":"inferno-canto-34","timelineId":"inferno-timeline-descent","title":"Judas, Brutus, and Cassius","description":"Identifies Judas head-first in the central mouth and the two Roman assassins in the black faces. Understands the last image of betrayal before the escape begins. Continues the mindless motion that makes the frozen wind.","locationMarkerId":"inferno-loc-judecca","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante","inferno-char-lucifer"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":192,"travelDays":0,"inWorldTime":1.9473,"tension":5,"tags":["Canto XXXIV, source lines 61-72"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-34-5","chapterId":"inferno-canto-34","timelineId":"inferno-timeline-descent","title":"Climbing Down Lucifer","description":"Clings to Lucifer’s shaggy side, times the wingbeats, and turns at the centre of gravity. Holds Virgil’s neck and is bewildered when descent becomes ascent. Serves unwittingly as the ladder out of Hell.","locationMarkerId":"inferno-loc-earth-centre","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante","inferno-char-lucifer"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":193,"travelDays":0,"inWorldTime":1.9485,"tension":5,"tags":["Canto XXXIV, source lines 73-84"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-34-6","chapterId":"inferno-canto-34","timelineId":"inferno-timeline-descent","title":"Past the Centre","description":"Looks back and sees Lucifer inverted, then asks how time, orientation, and ice have changed. Sets Dante on the cavern floor and begins explaining the passage across the world’s centre.","locationMarkerId":"inferno-loc-earth-centre","involvedCharacterIds":["inferno-char-dante","inferno-char-virgil"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-speech"],"sortOrder":194,"travelDays":0,"inWorldTime":1.9497,"tension":4,"tags":["Canto XXXIV, source lines 85-108"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-34-7","chapterId":"inferno-canto-34","timelineId":"inferno-timeline-descent","title":"The Fall of Lucifer","description":"Explains how Lucifer’s fall displaced land, formed Hell, and opened the hidden path toward the other hemisphere. Learns that morning has replaced evening after crossing the centre.","locationMarkerId":"inferno-loc-earth-centre","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-body"],"sortOrder":195,"travelDays":0,"inWorldTime":1.9521,"tension":3,"tags":["Canto XXXIV, source lines 109-132"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-event-34-8","chapterId":"inferno-canto-34","timelineId":"inferno-timeline-descent","title":"To Rebehold the Stars","description":"Leads without rest up the winding subterranean stream toward a round opening. Follows second and emerges from Hell beneath the stars.","locationMarkerId":"inferno-loc-hidden-passage","involvedCharacterIds":["inferno-char-virgil","inferno-char-dante"],"mentionedCharacterIds":[],"involvedItemIds":[],"threadIds":["inferno-thread-descent"],"motifIds":["inferno-motif-passage"],"sortOrder":196,"travelDays":0,"inWorldTime":1.9545,"tension":3,"tags":["Canto XXXIV, source lines 133-139"],"structureBeat":null,"status":"final","povCharacterId":"inferno-char-dante","isFlashback":false}],"sceneTexts":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-1-1","eventId":"inferno-event-1-1","text":"Midway upon the journey of our life\n    I found myself within a forest dark,\n    For the straightforward pathway had been lost.\nAh me! how hard a thing it is to say\n    What was this forest savage, rough, and stern,\n    Which in the very thought renews the fear.\nSo bitter is it, death is little more;\n    But of the good to treat, which there I found,\n    Speak will I of the other things I saw there.\nI cannot well repeat how there I entered,\n    So full was I of slumber at the moment\n    In which I had abandoned the true way.\nBut after I had reached a mountain’s foot,\n    At that point where the valley terminated,\n    Which had with consternation pierced my heart,\nUpward I looked, and I beheld its shoulders,\n    Vested already with that planet’s rays\n    Which leadeth others right by every road.\nThen was the fear a little quieted\n    That in my heart’s lake had endured throughout\n    The night, which I had passed so piteously.\nAnd even as he, who, with distressful breath,\n    Forth issued from the sea upon the shore,\n    Turns to the water perilous and gazes;\nSo did my soul, that still was fleeing onward,\n    Turn itself back to re-behold the pass\n    Which never yet a living person left.\nAfter my weary body I had rested,\n    The way resumed I on the desert slope,\n    So that the firm foot ever was the lower.","wordCount":237},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-1-2","eventId":"inferno-event-1-2","text":"And lo! almost where the ascent began,\n    A panther light and swift exceedingly,\n    Which with a spotted skin was covered o’er!\nAnd never moved she from before my face,\n    Nay, rather did impede so much my way,\n    That many times I to return had turned.\nThe time was the beginning of the morning,\n    And up the sun was mounting with those stars\n    That with him were, what time the Love Divine\nAt first in motion set those beauteous things;\n    So were to me occasion of good hope,\n    The variegated skin of that wild beast,\nThe hour of time, and the delicious season;\n    But not so much, that did not give me fear\n    A lion’s aspect which appeared to me.\nHe seemed as if against me he were coming\n    With head uplifted, and with ravenous hunger,\n    So that it seemed the air was afraid of him;\nAnd a she-wolf, that with all hungerings\n    Seemed to be laden in her meagreness,\n    And many folk has caused to live forlorn!\nShe brought upon me so much heaviness,\n    With the affright that from her aspect came,\n    That I the hope relinquished of the height.\nAnd as he is who willingly acquires,\n    And the time comes that causes him to lose,\n    Who weeps in all his thoughts and is despondent,\nE’en such made me that beast withouten peace,\n    Which, coming on against me by degrees\n    Thrust me back thither where the sun is silent.","wordCount":240},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-1-3","eventId":"inferno-event-1-3","text":"While I was rushing downward to the lowland,\n    Before mine eyes did one present himself,\n    Who seemed from long-continued silence hoarse.\nWhen I beheld him in the desert vast,\n    “Have pity on me,” unto him I cried,\n    “Whiche’er thou art, or shade or real man!”\nHe answered me: “Not man; man once I was,\n    And both my parents were of Lombardy,\n    And Mantuans by country both of them.\n‘Sub Julio’ was I born, though it was late,\n    And lived at Rome under the good Augustus,\n    During the time of false and lying gods.\nA poet was I, and I sang that just\n    Son of Anchises, who came forth from Troy,\n    After that Ilion the superb was burned.\nBut thou, why goest thou back to such annoyance?\n    Why climb’st thou not the Mount Delectable,\n    Which is the source and cause of every joy?”\n“Now, art thou that Virgilius and that fountain\n    Which spreads abroad so wide a river of speech?”\n    I made response to him with bashful forehead.\n“O, of the other poets honour and light,\n    Avail me the long study and great love\n    That have impelled me to explore thy volume!\nThou art my master, and my author thou,\n    Thou art alone the one from whom I took\n    The beautiful style that has done honour to me.\nBehold the beast, for which I have turned back;\n    Do thou protect me from her, famous Sage,\n    For she doth make my veins and pulses tremble.”","wordCount":244},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-1-4","eventId":"inferno-event-1-4","text":"“Thee it behoves to take another road,”\n    Responded he, when he beheld me weeping,\n    “If from this savage place thou wouldst escape;\nBecause this beast, at which thou criest out,\n    Suffers not any one to pass her way,\n    But so doth harass him, that she destroys him;\nAnd has a nature so malign and ruthless,\n    That never doth she glut her greedy will,\n    And after food is hungrier than before.\nMany the animals with whom she weds,\n    And more they shall be still, until the Greyhound\n    Comes, who shall make her perish in her pain.\nHe shall not feed on either earth or pelf,\n    But upon wisdom, and on love and virtue;\n    ’Twixt Feltro and Feltro shall his nation be;\nOf that low Italy shall he be the saviour,\n    On whose account the maid Camilla died,\n    Euryalus, Turnus, Nisus, of their wounds;\nThrough every city shall he hunt her down,\n    Until he shall have driven her back to Hell,\n    There from whence envy first did let her loose.\nTherefore I think and judge it for thy best\n    Thou follow me, and I will be thy guide,\n    And lead thee hence through the eternal place,\nWhere thou shalt hear the desperate lamentations,\n    Shalt see the ancient spirits disconsolate,\n    Who cry out each one for the second death;\nAnd thou shalt see those who contented are\n    Within the fire, because they hope to come,\n    Whene’er it may be, to the blessed people;\nTo whom, then, if thou wishest to ascend,\n    A soul shall be for that than I more worthy;\n    With her at my departure I will leave thee;\nBecause that Emperor, who reigns above,\n    In that I was rebellious to his law,\n    Wills that through me none come into his city.\nHe governs everywhere, and there he reigns;\n    There is his city and his lofty throne;\n    O happy he whom thereto he elects!”\nAnd I to him: “Poet, I thee entreat,\n    By that same God whom thou didst never know,\n    So that I may escape this woe and worse,\nThou wouldst conduct me there where thou hast said,\n    That I may see the portal of Saint Peter,\n    And those thou makest so disconsolate.”\nThen he moved on, and I behind him followed.","wordCount":371},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-2-1","eventId":"inferno-event-2-1","text":"Day was departing, and the embrowned air\n    Released the animals that are on earth\n    From their fatigues; and I the only one\nMade myself ready to sustain the war,\n    Both of the way and likewise of the woe,\n    Which memory that errs not shall retrace.\nO Muses, O high genius, now assist me!\n    O memory, that didst write down what I saw,\n    Here thy nobility shall be manifest!\nAnd I began: “Poet, who guidest me,\n    Regard my manhood, if it be sufficient,\n    Ere to the arduous pass thou dost confide me.\nThou sayest, that of Silvius the parent,\n    While yet corruptible, unto the world\n    Immortal went, and was there bodily.\nBut if the adversary of all evil\n    Was courteous, thinking of the high effect\n    That issue would from him, and who, and what,\nTo men of intellect unmeet it seems not;\n    For he was of great Rome, and of her empire\n    In the empyreal heaven as father chosen;\nThe which and what, wishing to speak the truth,\n    Were stablished as the holy place, wherein\n    Sits the successor of the greatest Peter.\nUpon this journey, whence thou givest him vaunt,\n    Things did he hear, which the occasion were\n    Both of his victory and the papal mantle.\nThither went afterwards the Chosen Vessel,\n    To bring back comfort thence unto that Faith,\n    Which of salvation’s way is the beginning.\nBut I, why thither come, or who concedes it?\n    I not Aeneas am, I am not Paul,\n    Nor I, nor others, think me worthy of it.\nTherefore, if I resign myself to come,\n    I fear the coming may be ill-advised;\n    Thou’rt wise, and knowest better than I speak.”","wordCount":275},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-2-2","eventId":"inferno-event-2-2","text":"And as he is, who unwills what he willed,\n    And by new thoughts doth his intention change,\n    So that from his design he quite withdraws,\nSuch I became, upon that dark hillside,\n    Because, in thinking, I consumed the emprise,\n    Which was so very prompt in the beginning.\n“If I have well thy language understood,”\n    Replied that shade of the Magnanimous,\n    “Thy soul attainted is with cowardice,\nWhich many times a man encumbers so,\n    It turns him back from honoured enterprise,\n    As false sight doth a beast, when he is shy.\nThat thou mayst free thee from this apprehension,\n    I’ll tell thee why I came, and what I heard\n    At the first moment when I grieved for thee.\nAmong those was I who are in suspense,\n    And a fair, saintly Lady called to me\n    In such wise, I besought her to command me.\nHer eyes where shining brighter than the Star;\n    And she began to say, gentle and low,\n    With voice angelical, in her own language:\n‘O spirit courteous of Mantua,\n    Of whom the fame still in the world endures,\n    And shall endure, long-lasting as the world;","wordCount":187},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-2-3","eventId":"inferno-event-2-3","text":"A friend of mine, and not the friend of fortune,\n    Upon the desert slope is so impeded\n    Upon his way, that he has turned through terror,\nAnd may, I fear, already be so lost,\n    That I too late have risen to his succour,\n    From that which I have heard of him in Heaven.\nBestir thee now, and with thy speech ornate,\n    And with what needful is for his release,\n    Assist him so, that I may be consoled.\nBeatrice am I, who do bid thee go;\n    I come from there, where I would fain return;\n    Love moved me, which compelleth me to speak.\nWhen I shall be in presence of my Lord,\n    Full often will I praise thee unto him.’\n    Then paused she, and thereafter I began:\n‘O Lady of virtue, thou alone through whom\n    The human race exceedeth all contained\n    Within the heaven that has the lesser circles,\nSo grateful unto me is thy commandment,\n    To obey, if ’twere already done, were late;\n    No farther need’st thou ope to me thy wish.\nBut the cause tell me why thou dost not shun\n    The here descending down into this centre,\n    From the vast place thou burnest to return to.’\n‘Since thou wouldst fain so inwardly discern,\n    Briefly will I relate,’ she answered me,\n    ‘Why I am not afraid to enter here.\nOf those things only should one be afraid\n    Which have the power of doing others harm;\n    Of the rest, no; because they are not fearful.\nGod in his mercy such created me\n    That misery of yours attains me not,\n    Nor any flame assails me of this burning.\nA gentle Lady is in Heaven, who grieves\n    At this impediment, to which I send thee,\n    So that stern judgment there above is broken.\nIn her entreaty she besought Lucia,\n    And said, “Thy faithful one now stands in need\n    Of thee, and unto thee I recommend him.”\nLucia, foe of all that cruel is,\n    Hastened away, and came unto the place\n    Where I was sitting with the ancient Rachel.\n“Beatrice” said she, “the true praise of God,\n    Why succourest thou not him, who loved thee so,\n    For thee he issued from the vulgar herd?\nDost thou not hear the pity of his plaint?\n    Dost thou not see the death that combats him\n    Beside that flood, where ocean has no vaunt?”","wordCount":387},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-2-4","eventId":"inferno-event-2-4","text":"Never were persons in the world so swift\n    To work their weal and to escape their woe,\n    As I, after such words as these were uttered,\nCame hither downward from my blessed seat,\n    Confiding in thy dignified discourse,\n    Which honours thee, and those who’ve listened to it.’\nAfter she thus had spoken unto me,\n    Weeping, her shining eyes she turned away;\n    Whereby she made me swifter in my coming;\nAnd unto thee I came, as she desired;\n    I have delivered thee from that wild beast,\n    Which barred the beautiful mountain’s short ascent.\nWhat is it, then?  Why, why dost thou delay?\n    Why is such baseness bedded in thy heart?\n    Daring and hardihood why hast thou not,\nSeeing that three such Ladies benedight\n    Are caring for thee in the court of Heaven,\n    And so much good my speech doth promise thee?”\nEven as the flowerets, by nocturnal chill,\n    Bowed down and closed, when the sun whitens them,\n    Uplift themselves all open on their stems;\nSuch I became with my exhausted strength,\n    And such good courage to my heart there coursed,\n    That I began, like an intrepid person:\n“O she compassionate, who succoured me,\n    And courteous thou, who hast obeyed so soon\n    The words of truth which she addressed to thee!\nThou hast my heart so with desire disposed\n    To the adventure, with these words of thine,\n    That to my first intent I have returned.\nNow go, for one sole will is in us both,\n    Thou Leader, and thou Lord, and Master thou.”\n    Thus said I to him; and when he had moved,\nI entered on the deep and savage way.","wordCount":269},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-3-1","eventId":"inferno-event-3-1","text":"“Through me the way is to the city dolent;\n    Through me the way is to eternal dole;\n    Through me the way among the people lost.\nJustice incited my sublime Creator;\n    Created me divine Omnipotence,\n    The highest Wisdom and the primal Love.\nBefore me there were no created things,\n    Only eterne, and I eternal last.\n    All hope abandon, ye who enter in!”\nThese words in sombre colour I beheld\n    Written upon the summit of a gate;\n    Whence I: “Their sense is, Master, hard to me!”\nAnd he to me, as one experienced:\n    “Here all suspicion needs must be abandoned,\n    All cowardice must needs be here extinct.\nWe to the place have come, where I have told thee\n    Thou shalt behold the people dolorous\n    Who have foregone the good of intellect.”\nAnd after he had laid his hand on mine\n    With joyful mien, whence I was comforted,\n    He led me in among the secret things.\nThere sighs, complaints, and ululations loud\n    Resounded through the air without a star,\n    Whence I, at the beginning, wept thereat.","wordCount":173},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-3-2","eventId":"inferno-event-3-2","text":"Languages diverse, horrible dialects,\n    Accents of anger, words of agony,\n    And voices high and hoarse, with sound of hands,\nMade up a tumult that goes whirling on\n    For ever in that air for ever black,\n    Even as the sand doth, when the whirlwind breathes.\nAnd I, who had my head with horror bound,\n    Said: “Master, what is this which now I hear?\n    What folk is this, which seems by pain so vanquished?”\nAnd he to me: “This miserable mode\n    Maintain the melancholy souls of those\n    Who lived withouten infamy or praise.\nCommingled are they with that caitiff choir\n    Of Angels, who have not rebellious been,\n    Nor faithful were to God, but were for self.\nThe heavens expelled them, not to be less fair;\n    Nor them the nethermore abyss receives,\n    For glory none the damned would have from them.”\nAnd I: “O Master, what so grievous is\n    To these, that maketh them lament so sore?”\n    He answered: “I will tell thee very briefly.\nThese have no longer any hope of death;\n    And this blind life of theirs is so debased,\n    They envious are of every other fate.\nNo fame of them the world permits to be;\n    Misericord and Justice both disdain them.\n    Let us not speak of them, but look, and pass.”\nAnd I, who looked again, beheld a banner,\n    Which, whirling round, ran on so rapidly,\n    That of all pause it seemed to me indignant;\nAnd after it there came so long a train\n    Of people, that I ne’er would have believed\n    That ever Death so many had undone.\nWhen some among them I had recognised,\n    I looked, and I beheld the shade of him\n    Who made through cowardice the great refusal.","wordCount":282},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-3-3","eventId":"inferno-event-3-3","text":"Forthwith I comprehended, and was certain,\n    That this the sect was of the caitiff wretches\n    Hateful to God and to his enemies.\nThese miscreants, who never were alive,\n    Were naked, and were stung exceedingly\n    By gadflies and by hornets that were there.\nThese did their faces irrigate with blood,\n    Which, with their tears commingled, at their feet\n    By the disgusting worms was gathered up.\nAnd when to gazing farther I betook me.\n    People I saw on a great river’s bank;\n    Whence said I: “Master, now vouchsafe to me,\nThat I may know who these are, and what law\n    Makes them appear so ready to pass over,\n    As I discern athwart the dusky light.”\nAnd he to me: “These things shall all be known\n    To thee, as soon as we our footsteps stay\n    Upon the dismal shore of Acheron.”\nThen with mine eyes ashamed and downward cast,\n    Fearing my words might irksome be to him,\n    From speech refrained I till we reached the river.\nAnd lo! towards us coming in a boat\n    An old man, hoary with the hair of eld,\n    Crying: “Woe unto you, ye souls depraved!\nHope nevermore to look upon the heavens;\n    I come to lead you to the other shore,\n    To the eternal shades in heat and frost.\nAnd thou, that yonder standest, living soul,\n    Withdraw thee from these people, who are dead!”\n    But when he saw that I did not withdraw,\nHe said: “By other ways, by other ports\n    Thou to the shore shalt come, not here, for passage;\n    A lighter vessel needs must carry thee.”\nAnd unto him the Guide: “Vex thee not, Charon;\n    It is so willed there where is power to do\n    That which is willed; and farther question not.”","wordCount":287},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-3-4","eventId":"inferno-event-3-4","text":"Thereat were quieted the fleecy cheeks\n    Of him the ferryman of the livid fen,\n    Who round about his eyes had wheels of flame.\nBut all those souls who weary were and naked\n    Their colour changed and gnashed their teeth together,\n    As soon as they had heard those cruel words.\nGod they blasphemed and their progenitors,\n    The human race, the place, the time, the seed\n    Of their engendering and of their birth!\nThereafter all together they drew back,\n    Bitterly weeping, to the accursed shore,\n    Which waiteth every man who fears not God.\nCharon the demon, with the eyes of glede,\n    Beckoning to them, collects them all together,\n    Beats with his oar whoever lags behind.\nAs in the autumn-time the leaves fall off,\n    First one and then another, till the branch\n    Unto the earth surrenders all its spoils;\nIn similar wise the evil seed of Adam\n    Throw themselves from that margin one by one,\n    At signals, as a bird unto its lure.\nSo they depart across the dusky wave,\n    And ere upon the other side they land,\n    Again on this side a new troop assembles.\n“My son,” the courteous Master said to me,\n    “All those who perish in the wrath of God\n    Here meet together out of every land;\nAnd ready are they to pass o’er the river,\n    Because celestial Justice spurs them on,\n    So that their fear is turned into desire.\nThis way there never passes a good soul;\n    And hence if Charon doth complain of thee,\n    Well mayst thou know now what his speech imports.”\nThis being finished, all the dusk champaign\n    Trembled so violently, that of that terror\n    The recollection bathes me still with sweat.\nThe land of tears gave forth a blast of wind,\n    And fulminated a vermilion light,\n    Which overmastered in me every sense,\nAnd as a man whom sleep hath seized I fell.","wordCount":308},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-4-1","eventId":"inferno-event-4-1","text":"Broke the deep lethargy within my head\n    A heavy thunder, so that I upstarted,\n    Like to a person who by force is wakened;\nAnd round about I moved my rested eyes,\n    Uprisen erect, and steadfastly I gazed,\n    To recognise the place wherein I was.\nTrue is it, that upon the verge I found me\n    Of the abysmal valley dolorous,\n    That gathers thunder of infinite ululations.\nObscure, profound it was, and nebulous,\n    So that by fixing on its depths my sight\n    Nothing whatever I discerned therein.\n“Let us descend now into the blind world,”\n    Began the Poet, pallid utterly;\n    “I will be first, and thou shalt second be.”\nAnd I, who of his colour was aware,\n    Said: “How shall I come, if thou art afraid,\n    Who’rt wont to be a comfort to my fears?”\nAnd he to me: “The anguish of the people\n    Who are below here in my face depicts\n    That pity which for terror thou hast taken.\nLet us go on, for the long way impels us.”\n    Thus he went in, and thus he made me enter\n    The foremost circle that surrounds the abyss.","wordCount":185},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-4-2","eventId":"inferno-event-4-2","text":"There, as it seemed to me from listening,\n    Were lamentations none, but only sighs,\n    That tremble made the everlasting air.\nAnd this arose from sorrow without torment,\n    Which the crowds had, that many were and great,\n    Of infants and of women and of men.\nTo me the Master good: “Thou dost not ask\n    What spirits these, which thou beholdest, are?\n    Now will I have thee know, ere thou go farther,\nThat they sinned not; and if they merit had,\n    ’Tis not enough, because they had not baptism\n    Which is the portal of the Faith thou holdest;\nAnd if they were before Christianity,\n    In the right manner they adored not God;\n    And among such as these am I myself.\nFor such defects, and not for other guilt,\n    Lost are we and are only so far punished,\n    That without hope we live on in desire.”\nGreat grief seized on my heart when this I heard,\n    Because some people of much worthiness\n    I knew, who in that Limbo were suspended.\n“Tell me, my Master, tell me, thou my Lord,”\n    Began I, with desire of being certain\n    Of that Faith which o’ercometh every error,\n“Came any one by his own merit hence,\n    Or by another’s, who was blessed thereafter?”\n    And he, who understood my covert speech,\nReplied: “I was a novice in this state,\n    When I saw hither come a Mighty One,\n    With sign of victory incoronate.\nHence he drew forth the shade of the First Parent,\n    And that of his son Abel, and of Noah,\n    Of Moses the lawgiver, and the obedient\nAbraham, patriarch, and David, king,\n    Israel with his father and his children,\n    And Rachel, for whose sake he did so much,\nAnd others many, and he made them blessed;\n    And thou must know, that earlier than these\n    Never were any human spirits saved.”\nWe ceased not to advance because he spake,\n    But still were passing onward through the forest,\n    The forest, say I, of thick-crowded ghosts.\nNot very far as yet our way had gone\n    This side the summit, when I saw a fire\n    That overcame a hemisphere of darkness.\nWe were a little distant from it still,\n    But not so far that I in part discerned not\n    That honourable people held that place.","wordCount":374},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-4-3","eventId":"inferno-event-4-3","text":"“O thou who honourest every art and science,\n    Who may these be, which such great honour have,\n    That from the fashion of the rest it parts them?”\nAnd he to me: “The honourable name,\n    That sounds of them above there in thy life,\n    Wins grace in Heaven, that so advances them.”\nIn the mean time a voice was heard by me:\n    “All honour be to the pre-eminent Poet;\n    His shade returns again, that was departed.”\nAfter the voice had ceased and quiet was,\n    Four mighty shades I saw approaching us;\n    Semblance had they nor sorrowful nor glad.\nTo say to me began my gracious Master:\n    “Him with that falchion in his hand behold,\n    Who comes before the three, even as their lord.\nThat one is Homer, Poet sovereign;\n    He who comes next is Horace, the satirist;\n    The third is Ovid, and the last is Lucan.\nBecause to each of these with me applies\n    The name that solitary voice proclaimed,\n    They do me honour, and in that do well.”\nThus I beheld assemble the fair school\n    Of that lord of the song pre-eminent,\n    Who o’er the others like an eagle soars.\nWhen they together had discoursed somewhat,\n    They turned to me with signs of salutation,\n    And on beholding this, my Master smiled;\nAnd more of honour still, much more, they did me,\n    In that they made me one of their own band;\n    So that the sixth was I, ’mid so much wit.\nThus we went on as far as to the light,\n    Things saying ’tis becoming to keep silent,\n    As was the saying of them where I was.\nWe came unto a noble castle’s foot,\n    Seven times encompassed with lofty walls,\n    Defended round by a fair rivulet;","wordCount":288},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-4-4","eventId":"inferno-event-4-4","text":"This we passed over even as firm ground;\n    Through portals seven I entered with these Sages;\n    We came into a meadow of fresh verdure.\nPeople were there with solemn eyes and slow,\n    Of great authority in their countenance;\n    They spake but seldom, and with gentle voices.\nThus we withdrew ourselves upon one side\n    Into an opening luminous and lofty,\n    So that they all of them were visible.\nThere opposite, upon the green enamel,\n    Were pointed out to me the mighty spirits,\n    Whom to have seen I feel myself exalted.\nI saw Electra with companions many,\n    ’Mongst whom I knew both Hector and Aeneas,\n    Caesar in armour with gerfalcon eyes;\nI saw Camilla and Penthesilea\n    On the other side, and saw the King Latinus,\n    Who with Lavinia his daughter sat;\nI saw that Brutus who drove Tarquin forth,\n    Lucretia, Julia, Marcia, and Cornelia,\n    And saw alone, apart, the Saladin.\nWhen I had lifted up my brows a little,\n    The Master I beheld of those who know,\n    Sit with his philosophic family.\nAll gaze upon him, and all do him honour.\n    There I beheld both Socrates and Plato,\n    Who nearer him before the others stand;\nDemocritus, who puts the world on chance,\n    Diogenes, Anaxagoras, and Thales,\n    Zeno, Empedocles, and Heraclitus;\nOf qualities I saw the good collector,\n    Hight Dioscorides; and Orpheus saw I,\n    Tully and Livy, and moral Seneca,\nEuclid, geometrician, and Ptolemy,\n    Galen, Hippocrates, and Avicenna,\n    Averroes, who the great Comment made.\nI cannot all of them pourtray in full,\n    Because so drives me onward the long theme,\n    That many times the word comes short of fact.\nThe sixfold company in two divides;\n    Another way my sapient Guide conducts me\n    Forth from the quiet to the air that trembles;\nAnd to a place I come where nothing shines.","wordCount":297},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-5-1","eventId":"inferno-event-5-1","text":"Thus I descended out of the first circle\n    Down to the second, that less space begirds,\n    And so much greater dole, that goads to wailing.\nThere standeth Minos horribly, and snarls;\n    Examines the transgressions at the entrance;\n    Judges, and sends according as he girds him.\nI say, that when the spirit evil-born\n    Cometh before him, wholly it confesses;\n    And this discriminator of transgressions\nSeeth what place in Hell is meet for it;\n    Girds himself with his tail as many times\n    As grades he wishes it should be thrust down.\nAlways before him many of them stand;\n    They go by turns each one unto the judgment;\n    They speak, and hear, and then are downward hurled.\n“O thou, that to this dolorous hostelry\n    Comest,” said Minos to me, when he saw me,\n    Leaving the practice of so great an office,\n“Look how thou enterest, and in whom thou trustest;\n    Let not the portal’s amplitude deceive thee.”\n    And unto him my Guide: “Why criest thou too?\nDo not impede his journey fate-ordained;\n    It is so willed there where is power to do\n    That which is willed; and ask no further question.”","wordCount":190},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-5-2","eventId":"inferno-event-5-2","text":"And now begin the dolesome notes to grow\n    Audible unto me; now am I come\n    There where much lamentation strikes upon me.\nI came into a place mute of all light,\n    Which bellows as the sea does in a tempest,\n    If by opposing winds ’t is combated.\nThe infernal hurricane that never rests\n    Hurtles the spirits onward in its rapine;\n    Whirling them round, and smiting, it molests them.\nWhen they arrive before the precipice,\n    There are the shrieks, the plaints, and the laments,\n    There they blaspheme the puissance divine.\nI understood that unto such a torment\n    The carnal malefactors were condemned,\n    Who reason subjugate to appetite.\nAnd as the wings of starlings bear them on\n    In the cold season in large band and full,\n    So doth that blast the spirits maledict;\nIt hither, thither, downward, upward, drives them;\n    No hope doth comfort them for evermore,\n    Not of repose, but even of lesser pain.\nAnd as the cranes go chanting forth their lays,\n    Making in air a long line of themselves,\n    So saw I coming, uttering lamentations,\nShadows borne onward by the aforesaid stress.\n    Whereupon said I: “Master, who are those\n    People, whom the black air so castigates?”\n“The first of those, of whom intelligence\n    Thou fain wouldst have,” then said he unto me,\n    “The empress was of many languages.\nTo sensual vices she was so abandoned,\n    That lustful she made licit in her law,\n    To remove the blame to which she had been led.\nShe is Semiramis, of whom we read\n    That she succeeded Ninus, and was his spouse;\n    She held the land which now the Sultan rules.","wordCount":268},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-5-3","eventId":"inferno-event-5-3","text":"The next is she who killed herself for love,\n    And broke faith with the ashes of Sichaeus;\n    Then Cleopatra the voluptuous.”\nHelen I saw, for whom so many ruthless\n    Seasons revolved; and saw the great Achilles,\n    Who at the last hour combated with Love.\nParis I saw, Tristan; and more than a thousand\n    Shades did he name and point out with his finger,\n    Whom Love had separated from our life.\nAfter that I had listened to my Teacher,\n    Naming the dames of eld and cavaliers,\n    Pity prevailed, and I was nigh bewildered.\nAnd I began: “O Poet, willingly\n    Speak would I to those two, who go together,\n    And seem upon the wind to be so light.”\nAnd, he to me: “Thou’lt mark, when they shall be\n    Nearer to us; and then do thou implore them\n    By love which leadeth them, and they will come.”\nSoon as the wind in our direction sways them,\n    My voice uplift I: “O ye weary souls!\n    Come speak to us, if no one interdicts it.”\nAs turtle-doves, called onward by desire,\n    With open and steady wings to the sweet nest\n    Fly through the air by their volition borne,","wordCount":194},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-5-4","eventId":"inferno-event-5-4","text":"So came they from the band where Dido is,\n    Approaching us athwart the air malign,\n    So strong was the affectionate appeal.\n“O living creature gracious and benignant,\n    Who visiting goest through the purple air\n    Us, who have stained the world incarnadine,\nIf were the King of the Universe our friend,\n    We would pray unto him to give thee peace,\n    Since thou hast pity on our woe perverse.\nOf what it pleases thee to hear and speak,\n    That will we hear, and we will speak to you,\n    While silent is the wind, as it is now.\nSitteth the city, wherein I was born,\n    Upon the sea-shore where the Po descends\n    To rest in peace with all his retinue.\nLove, that on gentle heart doth swiftly seize,\n    Seized this man for the person beautiful\n    That was ta’en from me, and still the mode offends me.\nLove, that exempts no one beloved from loving,\n    Seized me with pleasure of this man so strongly,\n    That, as thou seest, it doth not yet desert me;\nLove has conducted us unto one death;\n    Caina waiteth him who quenched our life!”\n    These words were borne along from them to us.\nAs soon as I had heard those souls tormented,\n    I bowed my face, and so long held it down\n    Until the Poet said to me: “What thinkest?”\nWhen I made answer, I began: “Alas!\n    How many pleasant thoughts, how much desire,\n    Conducted these unto the dolorous pass!”","wordCount":241},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-5-5","eventId":"inferno-event-5-5","text":"Then unto them I turned me, and I spake,\n    And I began: “Thine agonies, Francesca,\n    Sad and compassionate to weeping make me.\nBut tell me, at the time of those sweet sighs,\n    By what and in what manner Love conceded,\n    That you should know your dubious desires?”\nAnd she to me: “There is no greater sorrow\n    Than to be mindful of the happy time\n    In misery, and that thy Teacher knows.\nBut, if to recognise the earliest root\n    Of love in us thou hast so great desire,\n    I will do even as he who weeps and speaks.\nOne day we reading were for our delight\n    Of Launcelot, how Love did him enthral.\n    Alone we were and without any fear.\nFull many a time our eyes together drew\n    That reading, and drove the colour from our faces;\n    But one point only was it that o’ercame us.\nWhen as we read of the much-longed-for smile\n    Being by such a noble lover kissed,\n    This one, who ne’er from me shall be divided,\nKissed me upon the mouth all palpitating.\n    Galeotto was the book and he who wrote it.\n    That day no farther did we read therein.”\nAnd all the while one spirit uttered this,\n    The other one did weep so, that, for pity,\n    I swooned away as if I had been dying,\nAnd fell, even as a dead body falls.","wordCount":229},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-6-1","eventId":"inferno-event-6-1","text":"At the return of consciousness, that closed\n    Before the pity of those two relations,\n    Which utterly with sadness had confused me,\nNew torments I behold, and new tormented\n    Around me, whichsoever way I move,\n    And whichsoever way I turn, and gaze.\nIn the third circle am I of the rain\n    Eternal, maledict, and cold, and heavy;\n    Its law and quality are never new.\nHuge hail, and water sombre-hued, and snow,\n    Athwart the tenebrous air pour down amain;\n    Noisome the earth is, that receiveth this.","wordCount":85},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-6-2","eventId":"inferno-event-6-2","text":"Cerberus, monster cruel and uncouth,\n    With his three gullets like a dog is barking\n    Over the people that are there submerged.\nRed eyes he has, and unctuous beard and black,\n    And belly large, and armed with claws his hands;\n    He rends the spirits, flays, and quarters them.\nHowl the rain maketh them like unto dogs;\n    One side they make a shelter for the other;\n    Oft turn themselves the wretched reprobates.\nWhen Cerberus perceived us, the great worm!\n     His mouths he opened, and displayed his tusks;\n     Not a limb had he that was motionless.\nAnd my Conductor, with his spans extended,\n    Took of the earth, and with his fists well filled,\n    He threw it into those rapacious gullets.\nSuch as that dog is, who by barking craves,\n    And quiet grows soon as his food he gnaws,\n    For to devour it he but thinks and struggles,\nThe like became those muzzles filth-begrimed\n    Of Cerberus the demon, who so thunders\n    Over the souls that they would fain be deaf.\nWe passed across the shadows, which subdues\n    The heavy rain-storm, and we placed our feet\n    Upon their vanity that person seems.","wordCount":189},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-6-3","eventId":"inferno-event-6-3","text":"They all were lying prone upon the earth,\n    Excepting one, who sat upright as soon\n    As he beheld us passing on before him.\n“O thou that art conducted through this Hell,”\n    He said to me, “recall me, if thou canst;\n    Thyself wast made before I was unmade.”\nAnd I to him: “The anguish which thou hast\n    Perhaps doth draw thee out of my remembrance,\n    So that it seems not I have ever seen thee.\nBut tell me who thou art, that in so doleful\n    A place art put, and in such punishment,\n    If some are greater, none is so displeasing.”","wordCount":100},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-6-4","eventId":"inferno-event-6-4","text":"And he to me: “Thy city, which is full\n    Of envy so that now the sack runs over,\n    Held me within it in the life serene.\nYou citizens were wont to call me Ciacco;\n    For the pernicious sin of gluttony\n    I, as thou seest, am battered by this rain.\nAnd I, sad soul, am not the only one,\n    For all these suffer the like penalty\n    For the like sin;” and word no more spake he.\nI answered him: “Ciacco, thy wretchedness\n    Weighs on me so that it to weep invites me;\n    But tell me, if thou knowest, to what shall come\nThe citizens of the divided city;\n    If any there be just; and the occasion\n    Tell me why so much discord has assailed it.”\nAnd he to me: “They, after long contention,\n    Will come to bloodshed; and the rustic party\n    Will drive the other out with much offence.\nThen afterwards behoves it this one fall\n    Within three suns, and rise again the other\n    By force of him who now is on the coast.\nHigh will it hold its forehead a long while,\n    Keeping the other under heavy burdens,\n    Howe’er it weeps thereat and is indignant.\nThe just are two, and are not understood there;\n    Envy and Arrogance and Avarice\n    Are the three sparks that have all hearts enkindled.”\nHere ended he his tearful utterance;\n    And I to him: “I wish thee still to teach me,\n    And make a gift to me of further speech.\nFarinata and Tegghiaio, once so worthy,\n    Jacopo Rusticucci, Arrigo, and Mosca,\n    And others who on good deeds set their thoughts,\nSay where they are, and cause that I may know them;\n    For great desire constraineth me to learn\n    If Heaven doth sweeten them, or Hell envenom.”\nAnd he: “They are among the blacker souls;\n    A different sin downweighs them to the bottom;\n    If thou so far descendest, thou canst see them.\nBut when thou art again in the sweet world,\n    I pray thee to the mind of others bring me;\n    No more I tell thee and no more I answer.”","wordCount":344},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-6-5","eventId":"inferno-event-6-5","text":"Then his straightforward eyes he turned askance,\n    Eyed me a little, and then bowed his head;\n    He fell therewith prone like the other blind.\nAnd the Guide said to me: “He wakes no more\n    This side the sound of the angelic trumpet;\n    When shall approach the hostile Potentate,\nEach one shall find again his dismal tomb,\n    Shall reassume his flesh and his own figure,\n    Shall hear what through eternity re-echoes.”\nSo we passed onward o’er the filthy mixture\n    Of shadows and of rain with footsteps slow,\n    Touching a little on the future life.\nWherefore I said: “Master, these torments here,\n    Will they increase after the mighty sentence,\n    Or lesser be, or will they be as burning?”\nAnd he to me: “Return unto thy science,\n    Which wills, that as the thing more perfect is,\n    The more it feels of pleasure and of pain.\nAlbeit that this people maledict\n    To true perfection never can attain,\n    Hereafter more than now they look to be.”\nRound in a circle by that road we went,\n    Speaking much more, which I do not repeat;\n    We came unto the point where the descent is;\nThere we found Plutus the great enemy.","wordCount":195},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-7-1","eventId":"inferno-event-7-1","text":"“Pape Satan, Pape Satan, Aleppe!”\n    Thus Plutus with his clucking voice began;\n    And that benignant Sage, who all things knew,\nSaid, to encourage me: “Let not thy fear\n    Harm thee; for any power that he may have\n    Shall not prevent thy going down this crag.”\nThen he turned round unto that bloated lip,\n    And said: “Be silent, thou accursed wolf;\n    Consume within thyself with thine own rage.\nNot causeless is this journey to the abyss;\n    Thus is it willed on high, where Michael wrought\n    Vengeance upon the proud adultery.”\nEven as the sails inflated by the wind\n    Involved together fall when snaps the mast,\n    So fell the cruel monster to the earth.\nThus we descended into the fourth chasm,\n    Gaining still farther on the dolesome shore\n    Which all the woe of the universe insacks.\nJustice of God, ah! who heaps up so many\n    New toils and sufferings as I beheld?\n    And why doth our transgression waste us so?\nAs doth the billow there upon Charybdis,\n    That breaks itself on that which it encounters,\n    So here the folk must dance their roundelay.","wordCount":181},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-7-2","eventId":"inferno-event-7-2","text":"Here saw I people, more than elsewhere, many,\n    On one side and the other, with great howls,\n    Rolling weights forward by main force of chest.\nThey clashed together, and then at that point\n    Each one turned backward, rolling retrograde,\n    Crying, “Why keepest?” and, “Why squanderest thou?”\nThus they returned along the lurid circle\n    On either hand unto the opposite point,\n    Shouting their shameful metre evermore.\nThen each, when he arrived there, wheeled about\n    Through his half-circle to another joust;\n    And I, who had my heart pierced as it were,","wordCount":90},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-7-3","eventId":"inferno-event-7-3","text":"Exclaimed: “My Master, now declare to me\n    What people these are, and if all were clerks,\n    These shaven crowns upon the left of us.”\nAnd he to me: “All of them were asquint\n    In intellect in the first life, so much\n    That there with measure they no spending made.\nClearly enough their voices bark it forth,\n    Whene’er they reach the two points of the circle,\n    Where sunders them the opposite defect.\nClerks those were who no hairy covering\n    Have on the head, and Popes and Cardinals,\n    In whom doth Avarice practise its excess.”\nAnd I: “My Master, among such as these\n    I ought forsooth to recognise some few,\n    Who were infected with these maladies.”\nAnd he to me: “Vain thought thou entertainest;\n    The undiscerning life which made them sordid\n    Now makes them unto all discernment dim.\nForever shall they come to these two buttings;\n    These from the sepulchre shall rise again\n    With the fist closed, and these with tresses shorn.\nIll giving and ill keeping the fair world\n    Have ta’en from them, and placed them in this scuffle;\n    Whate’er it be, no words adorn I for it.\nNow canst thou, Son, behold the transient farce\n    Of goods that are committed unto Fortune,\n    For which the human race each other buffet;\nFor all the gold that is beneath the moon,\n    Or ever has been, of these weary souls\n    Could never make a single one repose.”\n“Master,” I said to him, “now tell me also\n    What is this Fortune which thou speakest of,\n    That has the world’s goods so within its clutches?”\nAnd he to me: “O creatures imbecile,\n    What ignorance is this which doth beset you?\n    Now will I have thee learn my judgment of her.\nHe whose omniscience everything transcends\n    The heavens created, and gave who should guide them,\n    That every part to every part may shine,\nDistributing the light in equal measure;\n    He in like manner to the mundane splendours\n    Ordained a general ministress and guide,\nThat she might change at times the empty treasures\n    From race to race, from one blood to another,\n    Beyond resistance of all human wisdom.\nTherefore one people triumphs, and another\n    Languishes, in pursuance of her judgment,\n    Which hidden is, as in the grass a serpent.\nYour knowledge has no counterstand against her;\n    She makes provision, judges, and pursues\n    Her governance, as theirs the other gods.\nHer permutations have not any truce;\n    Necessity makes her precipitate,\n    So often cometh who his turn obtains.\nAnd this is she who is so crucified\n    Even by those who ought to give her praise,\n    Giving her blame amiss, and bad repute.\nBut she is blissful, and she hears it not;\n    Among the other primal creatures gladsome\n    She turns her sphere, and blissful she rejoices.","wordCount":456},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-7-4","eventId":"inferno-event-7-4","text":"Let us descend now unto greater woe;\n    Already sinks each star that was ascending\n    When I set out, and loitering is forbidden.”\nWe crossed the circle to the other bank,\n    Near to a fount that boils, and pours itself\n    Along a gully that runs out of it.\nThe water was more sombre far than perse;\n    And we, in company with the dusky waves,\n    Made entrance downward by a path uncouth.\nA marsh it makes, which has the name of Styx,\n    This tristful brooklet, when it has descended\n    Down to the foot of the malign gray shores.\nAnd I, who stood intent upon beholding,\n    Saw people mud-besprent in that lagoon,\n    All of them naked and with angry look.\nThey smote each other not alone with hands,\n    But with the head and with the breast and feet,\n    Tearing each other piecemeal with their teeth.\nSaid the good Master: “Son, thou now beholdest\n    The souls of those whom anger overcame;\n    And likewise I would have thee know for certain\nBeneath the water people are who sigh\n    And make this water bubble at the surface,\n    As the eye tells thee wheresoe’er it turns.\nFixed in the mire they say, ‘We sullen were\n    In the sweet air, which by the sun is gladdened,\n    Bearing within ourselves the sluggish reek;\nNow we are sullen in this sable mire.’\n    This hymn do they keep gurgling in their throats,\n    For with unbroken words they cannot say it.”\nThus we went circling round the filthy fen\n    A great arc ’twixt the dry bank and the swamp,\n    With eyes turned unto those who gorge the mire;\nUnto the foot of a tower we came at last.","wordCount":277},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-8-1","eventId":"inferno-event-8-1","text":"I say, continuing, that long before\n    We to the foot of that high tower had come,\n    Our eyes went upward to the summit of it,\nBy reason of two flamelets we saw placed there,\n    And from afar another answer them,\n    So far, that hardly could the eye attain it.\nAnd, to the sea of all discernment turned,\n    I said: “What sayeth this, and what respondeth\n    That other fire? and who are they that made it?”\nAnd he to me: “Across the turbid waves\n    What is expected thou canst now discern,\n    If reek of the morass conceal it not.”\nCord never shot an arrow from itself\n    That sped away athwart the air so swift,\n    As I beheld a very little boat\nCome o’er the water tow’rds us at that moment,\n    Under the guidance of a single pilot,\n    Who shouted, “Now art thou arrived, fell soul?”","wordCount":144},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-8-2","eventId":"inferno-event-8-2","text":"“Phlegyas, Phlegyas, thou criest out in vain\n    For this once,” said my Lord; “thou shalt not have us\n    Longer than in the passing of the slough.”\nAs he who listens to some great deceit\n    That has been done to him, and then resents it,\n    Such became Phlegyas, in his gathered wrath.\nMy Guide descended down into the boat,\n    And then he made me enter after him,\n    And only when I entered seemed it laden.\nSoon as the Guide and I were in the boat,\n    The antique prow goes on its way, dividing\n    More of the water than ’tis wont with others.","wordCount":101},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-8-3","eventId":"inferno-event-8-3","text":"While we were running through the dead canal,\n    Uprose in front of me one full of mire,\n    And said, “Who ’rt thou that comest ere the hour?”\nAnd I to him: “Although I come, I stay not;\n    But who art thou that hast become so squalid?”\n    “Thou seest that I am one who weeps,” he answered.\nAnd I to him: “With weeping and with wailing,\n    Thou spirit maledict, do thou remain;\n    For thee I know, though thou art all defiled.”\nThen stretched he both his hands unto the boat;\n    Whereat my wary Master thrust him back,\n    Saying, “Away there with the other dogs!”\nThereafter with his arms he clasped my neck;\n    He kissed my face, and said: “Disdainful soul,\n    Blessed be she who bore thee in her bosom.\nThat was an arrogant person in the world;\n    Goodness is none, that decks his memory;\n    So likewise here his shade is furious.\nHow many are esteemed great kings up there,\n    Who here shall be like unto swine in mire,\n    Leaving behind them horrible dispraises!”\nAnd I: “My Master, much should I be pleased,\n    If I could see him soused into this broth,\n    Before we issue forth out of the lake.”\nAnd he to me: “Ere unto thee the shore\n    Reveal itself, thou shalt be satisfied;\n    Such a desire ’tis meet thou shouldst enjoy.”\nA little after that, I saw such havoc\n    Made of him by the people of the mire,\n    That still I praise and thank my God for it.\nThey all were shouting, “At Philippo Argenti!”\n    And that exasperate spirit Florentine\n    Turned round upon himself with his own teeth.\nWe left him there, and more of him I tell not;\n    But on mine ears there smote a lamentation,\n    Whence forward I intent unbar mine eyes.\nAnd the good Master said: “Even now, my Son,\n    The city draweth near whose name is Dis,\n    With the grave citizens, with the great throng.”\nAnd I: “Its mosques already, Master, clearly\n    Within there in the valley I discern\n    Vermilion, as if issuing from the fire","wordCount":340},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-8-4","eventId":"inferno-event-8-4","text":"They were.”  And he to me: “The fire eternal\n    That kindles them within makes them look red,\n    As thou beholdest in this nether Hell.”\nThen we arrived within the moats profound,\n    That circumvallate that disconsolate city;\n    The walls appeared to me to be of iron.\nNot without making first a circuit wide,\n    We came unto a place where loud the pilot\n    Cried out to us, “Debark, here is the entrance.”\nMore than a thousand at the gates I saw\n    Out of the Heavens rained down, who angrily\n    Were saying, “Who is this that without death\nGoes through the kingdom of the people dead?”\n    And my sagacious Master made a sign\n    Of wishing secretly to speak with them.\nA little then they quelled their great disdain,\n    And said: “Come thou alone, and he begone\n    Who has so boldly entered these dominions.\nLet him return alone by his mad road;\n    Try, if he can; for thou shalt here remain,\n    Who hast escorted him through such dark regions.”\nThink, Reader, if I was discomforted\n    At utterance of the accursed words;\n    For never to return here I believed.","wordCount":184},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-8-5","eventId":"inferno-event-8-5","text":"“O my dear Guide, who more than seven times\n    Hast rendered me security, and drawn me\n    From imminent peril that before me stood,\nDo not desert me,” said I, “thus undone;\n    And if the going farther be denied us,\n    Let us retrace our steps together swiftly.”\nAnd that Lord, who had led me thitherward,\n    Said unto me: “Fear not; because our passage\n    None can take from us, it by Such is given.\nBut here await me, and thy weary spirit\n    Comfort and nourish with a better hope;\n    For in this nether world I will not leave thee.”\nSo onward goes and there abandons me\n    My Father sweet, and I remain in doubt,\n    For No and Yes within my head contend.\nI could not hear what he proposed to them;\n    But with them there he did not linger long,\n    Ere each within in rivalry ran back.\nThey closed the portals, those our adversaries,\n    On my Lord’s breast, who had remained without\n    And turned to me with footsteps far between.\nHis eyes cast down, his forehead shorn had he\n    Of all its boldness, and he said, with sighs,\n    “Who has denied to me the dolesome houses?”\nAnd unto me: “Thou, because I am angry,\n    Fear not, for I will conquer in the trial,\n    Whatever for defence within be planned.\nThis arrogance of theirs is nothing new;\n    For once they used it at less secret gate,\n    Which finds itself without a fastening still.\nO’er it didst thou behold the dead inscription;\n    And now this side of it descends the steep,\n    Passing across the circles without escort,\nOne by whose means the city shall be opened.”","wordCount":272},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-9-1","eventId":"inferno-event-9-1","text":"That hue which cowardice brought out on me,\n    Beholding my Conductor backward turn,\n    Sooner repressed within him his new colour.\nHe stopped attentive, like a man who listens,\n    Because the eye could not conduct him far\n    Through the black air, and through the heavy fog.\n“Still it behoveth us to win the fight,”\n    Began he; “Else. . .Such offered us herself. . .\n    O how I long that some one here arrive!”\nWell I perceived, as soon as the beginning\n    He covered up with what came afterward,\n    That they were words quite different from the first;\nBut none the less his saying gave me fear,\n    Because I carried out the broken phrase,\n    Perhaps to a worse meaning than he had.\n“Into this bottom of the doleful conch\n    Doth any e’er descend from the first grade,\n    Which for its pain has only hope cut off?”\nThis question put I; and he answered me:\n    “Seldom it comes to pass that one of us\n    Maketh the journey upon which I go.\nTrue is it, once before I here below\n    Was conjured by that pitiless Erictho,\n    Who summoned back the shades unto their bodies.\nNaked of me short while the flesh had been,\n    Before within that wall she made me enter,\n    To bring a spirit from the circle of Judas;\nThat is the lowest region and the darkest,\n    And farthest from the heaven which circles all.\n    Well know I the way; therefore be reassured.\nThis fen, which a prodigious stench exhales,\n    Encompasses about the city dolent,\n    Where now we cannot enter without anger.”\nAnd more he said, but not in mind I have it;\n    Because mine eye had altogether drawn me\n    Tow’rds the high tower with the red-flaming summit,","wordCount":283},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-9-2","eventId":"inferno-event-9-2","text":"Where in a moment saw I swift uprisen\n    The three infernal Furies stained with blood,\n    Who had the limbs of women and their mien,\nAnd with the greenest hydras were begirt;\n    Small serpents and cerastes were their tresses,\n    Wherewith their horrid temples were entwined.\nAnd he who well the handmaids of the Queen\n    Of everlasting lamentation knew,\n    Said unto me: “Behold the fierce Erinnys.\nThis is Megaera, on the left-hand side;\n    She who is weeping on the right, Alecto;\n    Tisiphone is between;” and then was silent.\nEach one her breast was rending with her nails;\n    They beat them with their palms, and cried so loud,\n    That I for dread pressed close unto the Poet.\n“Medusa come, so we to stone will change him!”\n    All shouted looking down; “in evil hour\n    Avenged we not on Theseus his assault!”\n“Turn thyself round, and keep thine eyes close shut,\n    For if the Gorgon appear, and thou shouldst see it,\n    No more returning upward would there be.”\nThus said the Master; and he turned me round\n    Himself, and trusted not unto my hands\n    So far as not to blind me with his own.\nO ye who have undistempered intellects,\n    Observe the doctrine that conceals itself\n    Beneath the veil of the mysterious verses!\nAnd now there came across the turbid waves\n    The clangour of a sound with terror fraught,\n    Because of which both of the margins trembled;\nNot otherwise it was than of a wind\n    Impetuous on account of adverse heats,\n    That smites the forest, and, without restraint,\nThe branches rends, beats down, and bears away;\n    Right onward, laden with dust, it goes superb,\n    And puts to flight the wild beasts and the shepherds.","wordCount":280},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-9-3","eventId":"inferno-event-9-3","text":"Mine eyes he loosed, and said: “Direct the nerve\n    Of vision now along that ancient foam,\n    There yonder where that smoke is most intense.”\nEven as the frogs before the hostile serpent\n    Across the water scatter all abroad,\n    Until each one is huddled in the earth.\nMore than a thousand ruined souls I saw,\n    Thus fleeing from before one who on foot\n    Was passing o’er the Styx with soles unwet.\nFrom off his face he fanned that unctuous air,\n    Waving his left hand oft in front of him,\n    And only with that anguish seemed he weary.\nWell I perceived one sent from Heaven was he,\n    And to the Master turned; and he made sign\n    That I should quiet stand, and bow before him.\nAh! how disdainful he appeared to me!\n    He reached the gate, and with a little rod\n    He opened it, for there was no resistance.\n“O banished out of Heaven, people despised!”\n    Thus he began upon the horrid threshold;\n    “Whence is this arrogance within you couched?\nWherefore recalcitrate against that will,\n    From which the end can never be cut off,\n    And which has many times increased your pain?\nWhat helpeth it to butt against the fates?\n    Your Cerberus, if you remember well,\n    For that still bears his chin and gullet peeled.”\nThen he returned along the miry road,\n    And spake no word to us, but had the look\n    Of one whom other care constrains and goads\nThan that of him who in his presence is;\n    And we our feet directed tow’rds the city,\n    After those holy words all confident.\nWithin we entered without any contest;\n    And I, who inclination had to see\n    What the condition such a fortress holds,","wordCount":281},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-9-4","eventId":"inferno-event-9-4","text":"Soon as I was within, cast round mine eye,\n    And see on every hand an ample plain,\n    Full of distress and torment terrible.\nEven as at Arles, where stagnant grows the Rhone,\n    Even as at Pola near to the Quarnaro,\n    That shuts in Italy and bathes its borders,\nThe sepulchres make all the place uneven;\n    So likewise did they there on every side,\n    Saving that there the manner was more bitter;\nFor flames between the sepulchres were scattered,\n    By which they so intensely heated were,\n    That iron more so asks not any art.\nAll of their coverings uplifted were,\n    And from them issued forth such dire laments,\n    Sooth seemed they of the wretched and tormented.\nAnd I: “My Master, what are all those people\n    Who, having sepulture within those tombs,\n    Make themselves audible by doleful sighs?”\nAnd he to me: “Here are the Heresiarchs,\n    With their disciples of all sects, and much\n    More than thou thinkest laden are the tombs.\nHere like together with its like is buried;\n    And more and less the monuments are heated.”\n    And when he to the right had turned, we passed\nBetween the torments and high parapets.","wordCount":192},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-10-1","eventId":"inferno-event-10-1","text":"Now onward goes, along a narrow path\n    Between the torments and the city wall,\n    My Master, and I follow at his back.\n“O power supreme, that through these impious circles\n    Turnest me,” I began, “as pleases thee,\n    Speak to me, and my longings satisfy;\nThe people who are lying in these tombs,\n    Might they be seen? already are uplifted\n    The covers all, and no one keepeth guard.”\nAnd he to me: “They all will be closed up\n    When from Jehoshaphat they shall return\n    Here with the bodies they have left above.\nTheir cemetery have upon this side\n    With Epicurus all his followers,\n    Who with the body mortal make the soul;\nBut in the question thou dost put to me,\n    Within here shalt thou soon be satisfied,\n    And likewise in the wish thou keepest silent.”\nAnd I: “Good Leader, I but keep concealed\n    From thee my heart, that I may speak the less,\n    Nor only now hast thou thereto disposed me.”\n“O Tuscan, thou who through the city of fire\n    Goest alive, thus speaking modestly,\n    Be pleased to stay thy footsteps in this place.","wordCount":183},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-10-2","eventId":"inferno-event-10-2","text":"Thy mode of speaking makes thee manifest\n    A native of that noble fatherland,\n    To which perhaps I too molestful was.”\nUpon a sudden issued forth this sound\n    From out one of the tombs; wherefore I pressed,\n    Fearing, a little nearer to my Leader.\nAnd unto me he said: “Turn thee; what dost thou?\n    Behold there Farinata who has risen;\n    From the waist upwards wholly shalt thou see him.”\nI had already fixed mine eyes on his,\n    And he uprose erect with breast and front\n    E’en as if Hell he had in great despite.\nAnd with courageous hands and prompt my Leader\n    Thrust me between the sepulchres towards him,\n    Exclaiming, “Let thy words explicit be.”\nAs soon as I was at the foot of his tomb\n    Somewhat he eyed me, and, as if disdainful,\n    Then asked of me, “Who were thine ancestors?”\nI, who desirous of obeying was,\n    Concealed it not, but all revealed to him;\n    Whereat he raised his brows a little upward.\nThen said he: “Fiercely adverse have they been\n    To me, and to my fathers, and my party;\n    So that two several times I scattered them.”\n“If they were banished, they returned on all sides,”\n    I answered him, “the first time and the second;\n    But yours have not acquired that art aright.”\nThen there uprose upon the sight, uncovered\n    Down to the chin, a shadow at his side;\n    I think that he had risen on his knees.\nRound me he gazed, as if solicitude\n    He had to see if some one else were with me,\n    But after his suspicion was all spent,\nWeeping, he said to me: “If through this blind\n    Prison thou goest by loftiness of genius,\n    Where is my son? and why is he not with thee?”","wordCount":291},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-10-3","eventId":"inferno-event-10-3","text":"And I to him: “I come not of myself;\n    He who is waiting yonder leads me here,\n    Whom in disdain perhaps your Guido had.”\nHis language and the mode of punishment\n    Already unto me had read his name;\n    On that account my answer was so full.\nUp starting suddenly, he cried out: “How\n    Saidst thou,—he had?  Is he not still alive?\n    Does not the sweet light strike upon his eyes?”\nWhen he became aware of some delay,\n    Which I before my answer made, supine\n    He fell again, and forth appeared no more.\nBut the other, magnanimous, at whose desire\n    I had remained, did not his aspect change,\n    Neither his neck he moved, nor bent his side.\n“And if,” continuing his first discourse,\n    “They have that art,” he said, “not learned aright,\n    That more tormenteth me, than doth this bed.\nBut fifty times shall not rekindled be\n    The countenance of the Lady who reigns here,\n    Ere thou shalt know how heavy is that art;\nAnd as thou wouldst to the sweet world return,\n    Say why that people is so pitiless\n    Against my race in each one of its laws?”\nWhence I to him: “The slaughter and great carnage\n    Which have with crimson stained the Arbia, cause\n    Such orisons in our temple to be made.”\nAfter his head he with a sigh had shaken,\n    “There I was not alone,” he said, “nor surely\n    Without a cause had with the others moved.\nBut there I was alone, where every one\n    Consented to the laying waste of Florence,\n    He who defended her with open face.”\n“Ah! so hereafter may your seed repose,”\n    I him entreated, “solve for me that knot,\n    Which has entangled my conceptions here.","wordCount":283},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-10-4","eventId":"inferno-event-10-4","text":"It seems that you can see, if I hear rightly,\n    Beforehand whatsoe’er time brings with it,\n    And in the present have another mode.”\n“We see, like those who have imperfect sight,\n    The things,” he said, “that distant are from us;\n    So much still shines on us the Sovereign Ruler.\nWhen they draw near, or are, is wholly vain\n    Our intellect, and if none brings it to us,\n    Not anything know we of your human state.\nHence thou canst understand, that wholly dead\n    Will be our knowledge from the moment when\n    The portal of the future shall be closed.”\nThen I, as if compunctious for my fault,\n    Said: “Now, then, you will tell that fallen one,\n    That still his son is with the living joined.\nAnd if just now, in answering, I was dumb,\n    Tell him I did it because I was thinking\n    Already of the error you have solved me.”\nAnd now my Master was recalling me,\n    Wherefore more eagerly I prayed the spirit\n    That he would tell me who was with him there.\nHe said: “With more than a thousand here I lie;\n    Within here is the second Frederick,\n    And the Cardinal, and of the rest I speak not.”","wordCount":200},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-10-5","eventId":"inferno-event-10-5","text":"Thereon he hid himself; and I towards\n    The ancient poet turned my steps, reflecting\n    Upon that saying, which seemed hostile to me.\nHe moved along; and afterward thus going,\n    He said to me, “Why art thou so bewildered?”\n    And I in his inquiry satisfied him.\n“Let memory preserve what thou hast heard\n    Against thyself,” that Sage commanded me,\n    “And now attend here;” and he raised his finger.\n“When thou shalt be before the radiance sweet\n    Of her whose beauteous eyes all things behold,\n    From her thou’lt know the journey of thy life.”\nUnto the left hand then he turned his feet;\n    We left the wall, and went towards the middle,\n    Along a path that strikes into a valley,\nWhich even up there unpleasant made its stench.","wordCount":126},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-11-1","eventId":"inferno-event-11-1","text":"Upon the margin of a lofty bank\n    Which great rocks broken in a circle made,\n    We came upon a still more cruel throng;\nAnd there, by reason of the horrible\n    Excess of stench the deep abyss throws out,\n    We drew ourselves aside behind the cover\nOf a great tomb, whereon I saw a writing,\n    Which said: “Pope Anastasius I hold,\n    Whom out of the right way Photinus drew.”\n“Slow it behoveth our descent to be,\n    So that the sense be first a little used\n    To the sad blast, and then we shall not heed it.”\nThe Master thus; and unto him I said,\n    “Some compensation find, that the time pass not\n    Idly;” and he: “Thou seest I think of that.\nMy son, upon the inside of these rocks,”\n    Began he then to say, “are three small circles,\n    From grade to grade, like those which thou art leaving.\nThey all are full of spirits maledict;\n    But that hereafter sight alone suffice thee,\n    Hear how and wherefore they are in constraint.\nOf every malice that wins hate in Heaven,\n    Injury is the end; and all such end\n    Either by force or fraud afflicteth others.","wordCount":192},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-11-2","eventId":"inferno-event-11-2","text":"But because fraud is man’s peculiar vice,\n    More it displeases God; and so stand lowest\n    The fraudulent, and greater dole assails them.\nAll the first circle of the Violent is;\n    But since force may be used against three persons,\n    In three rounds ’tis divided and constructed.\nTo God, to ourselves, and to our neighbour can we\n    Use force; I say on them and on their things,\n    As thou shalt hear with reason manifest.\nA death by violence, and painful wounds,\n    Are to our neighbour given; and in his substance\n    Ruin, and arson, and injurious levies;\nWhence homicides, and he who smites unjustly,\n    Marauders, and freebooters, the first round\n    Tormenteth all in companies diverse.\nMan may lay violent hands upon himself\n    And his own goods; and therefore in the second\n    Round must perforce without avail repent\nWhoever of your world deprives himself,\n    Who games, and dissipates his property,\n    And weepeth there, where he should jocund be.\nViolence can be done the Deity,\n    In heart denying and blaspheming Him,\n    And by disdaining Nature and her bounty.\nAnd for this reason doth the smallest round\n    Seal with its signet Sodom and Cahors,\n    And who, disdaining God, speaks from the heart.\nFraud, wherewithal is every conscience stung,\n    A man may practise upon him who trusts,\n    And him who doth no confidence imburse.\nThis latter mode, it would appear, dissevers\n    Only the bond of love which Nature makes;\n    Wherefore within the second circle nestle\nHypocrisy, flattery, and who deals in magic,\n    Falsification, theft, and simony,\n    Panders, and barrators, and the like filth.","wordCount":257},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-11-3","eventId":"inferno-event-11-3","text":"By the other mode, forgotten is that love\n    Which Nature makes, and what is after added,\n    From which there is a special faith engendered.\nHence in the smallest circle, where the point is\n    Of the Universe, upon which Dis is seated,\n    Whoe’er betrays for ever is consumed.”\nAnd I: “My Master, clear enough proceeds\n    Thy reasoning, and full well distinguishes\n    This cavern and the people who possess it.\nBut tell me, those within the fat lagoon,\n    Whom the wind drives, and whom the rain doth beat,\n    And who encounter with such bitter tongues,\nWherefore are they inside of the red city\n    Not punished, if God has them in his wrath,\n    And if he has not, wherefore in such fashion?”\nAnd unto me he said: “Why wanders so\n    Thine intellect from that which it is wont?\n    Or, sooth, thy mind where is it elsewhere looking?\nHast thou no recollection of those words\n    With which thine Ethics thoroughly discusses\n    The dispositions three, that Heaven abides not,—\nIncontinence, and Malice, and insane\n    Bestiality? and how Incontinence\n    Less God offendeth, and less blame attracts?\nIf thou regardest this conclusion well,\n    And to thy mind recallest who they are\n    That up outside are undergoing penance,\nClearly wilt thou perceive why from these felons\n    They separated are, and why less wroth\n    Justice divine doth smite them with its hammer.”","wordCount":223},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-11-4","eventId":"inferno-event-11-4","text":"“O Sun, that healest all distempered vision,\n    Thou dost content me so, when thou resolvest,\n    That doubting pleases me no less than knowing!\nOnce more a little backward turn thee,” said I,\n    “There where thou sayest that usury offends\n    Goodness divine, and disengage the knot.”\n“Philosophy,” he said, “to him who heeds it,\n    Noteth, not only in one place alone,\n    After what manner Nature takes her course\nFrom Intellect Divine, and from its art;\n    And if thy Physics carefully thou notest,\n    After not many pages shalt thou find,\nThat this your art as far as possible\n    Follows, as the disciple doth the master;\n    So that your art is, as it were, God’s grandchild.\nFrom these two, if thou bringest to thy mind\n    Genesis at the beginning, it behoves\n    Mankind to gain their life and to advance;\nAnd since the usurer takes another way,\n    Nature herself and in her follower\n    Disdains he, for elsewhere he puts his hope.\nBut follow, now, as I would fain go on,\n    For quivering are the Fishes on the horizon,\n    And the Wain wholly over Caurus lies,\nAnd far beyond there we descend the crag.”","wordCount":189},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-12-1","eventId":"inferno-event-12-1","text":"The place where to descend the bank we came\n    Was alpine, and from what was there, moreover,\n    Of such a kind that every eye would shun it.\nSuch as that ruin is which in the flank\n    Smote, on this side of Trent, the Adige,\n    Either by earthquake or by failing stay,\nFor from the mountain’s top, from which it moved,\n    Unto the plain the cliff is shattered so,\n    Some path ’twould give to him who was above;\nEven such was the descent of that ravine,\n    And on the border of the broken chasm\n    The infamy of Crete was stretched along,\nWho was conceived in the fictitious cow;\n    And when he us beheld, he bit himself,\n    Even as one whom anger racks within.\nMy Sage towards him shouted: “Peradventure\n    Thou think’st that here may be the Duke of Athens,\n    Who in the world above brought death to thee?\nGet thee gone, beast, for this one cometh not\n    Instructed by thy sister, but he comes\n    In order to behold your punishments.”\nAs is that bull who breaks loose at the moment\n    In which he has received the mortal blow,\n    Who cannot walk, but staggers here and there,","wordCount":195},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-12-2","eventId":"inferno-event-12-2","text":"The Minotaur beheld I do the like;\n    And he, the wary, cried: “Run to the passage;\n    While he wroth, ’tis well thou shouldst descend.”\nThus down we took our way o’er that discharge\n    Of stones, which oftentimes did move themselves\n    Beneath my feet, from the unwonted burden.\nThoughtful I went; and he said: “Thou art thinking\n    Perhaps upon this ruin, which is guarded\n    By that brute anger which just now I quenched.\nNow will I have thee know, the other time\n    I here descended to the nether Hell,\n    This precipice had not yet fallen down.\nBut truly, if I well discern, a little\n    Before His coming who the mighty spoil\n    Bore off from Dis, in the supernal circle,\nUpon all sides the deep and loathsome valley\n    Trembled so, that I thought the Universe\n    Was thrilled with love, by which there are who think\nThe world ofttimes converted into chaos;\n    And at that moment this primeval crag\n    Both here and elsewhere made such overthrow.\nBut fix thine eyes below; for draweth near\n    The river of blood, within which boiling is\n    Whoe’er by violence doth injure others.”\nO blind cupidity, O wrath insane,\n    That spurs us onward so in our short life,\n    And in the eternal then so badly steeps us!\nI saw an ample moat bent like a bow,\n    As one which all the plain encompasses,\n    Conformable to what my Guide had said.\nAnd between this and the embankment’s foot\n    Centaurs in file were running, armed with arrows,\n    As in the world they used the chase to follow.\nBeholding us descend, each one stood still,\n    And from the squadron three detached themselves,\n    With bows and arrows in advance selected;","wordCount":278},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-12-3","eventId":"inferno-event-12-3","text":"And from afar one cried: “Unto what torment\n    Come ye, who down the hillside are descending?\n    Tell us from there; if not, I draw the bow.”\nMy Master said: “Our answer will we make\n    To Chiron, near you there; in evil hour,\n    That will of thine was evermore so hasty.”\nThen touched he me, and said: “This one is Nessus,\n    Who perished for the lovely Dejanira,\n    And for himself, himself did vengeance take.\nAnd he in the midst, who at his breast is gazing,\n    Is the great Chiron, who brought up Achilles;\n    That other Pholus is, who was so wrathful.\nThousands and thousands go about the moat\n    Shooting with shafts whatever soul emerges\n    Out of the blood, more than his crime allots.”\nNear we approached unto those monsters fleet;\n    Chiron an arrow took, and with the notch\n    Backward upon his jaws he put his beard.\nAfter he had uncovered his great mouth,\n    He said to his companions: “Are you ware\n    That he behind moveth whate’er he touches?\nThus are not wont to do the feet of dead men.”\n    And my good Guide, who now was at his breast,\n    Where the two natures are together joined,\nReplied: “Indeed he lives, and thus alone\n    Me it behoves to show him the dark valley;\n    Necessity, and not delight, impels us.\nSome one withdrew from singing Halleluja,\n    Who unto me committed this new office;\n    No thief is he, nor I a thievish spirit.\nBut by that virtue through which I am moving\n    My steps along this savage thoroughfare,\n    Give us some one of thine, to be with us,\nAnd who may show us where to pass the ford,\n    And who may carry this one on his back;\n    For ’tis no spirit that can walk the air.”","wordCount":292},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-12-4","eventId":"inferno-event-12-4","text":"Upon his right breast Chiron wheeled about,\n    And said to Nessus: “Turn and do thou guide them,\n    And warn aside, if other band may meet you.”\nWe with our faithful escort onward moved\n    Along the brink of the vermilion boiling,\n    Wherein the boiled were uttering loud laments.\nPeople I saw within up to the eyebrows,\n    And the great Centaur said: “Tyrants are these,\n    Who dealt in bloodshed and in pillaging.\nHere they lament their pitiless mischiefs; here\n    Is Alexander, and fierce Dionysius\n    Who upon Sicily brought dolorous years.\nThat forehead there which has the hair so black\n    Is Azzolin; and the other who is blond,\n    Obizzo is of Esti, who, in truth,\nUp in the world was by his stepson slain.”\n    Then turned I to the Poet; and he said,\n    “Now he be first to thee, and second I.”\nA little farther on the Centaur stopped\n    Above a folk, who far down as the throat\n    Seemed from that boiling stream to issue forth.\nA shade he showed us on one side alone,\n    Saying: “He cleft asunder in God’s bosom\n    The heart that still upon the Thames is honoured.”","wordCount":188},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-12-5","eventId":"inferno-event-12-5","text":"Then people saw I, who from out the river\n    Lifted their heads and also all the chest;\n    And many among these I recognised.\nThus ever more and more grew shallower\n    That blood, so that the feet alone it covered;\n    And there across the moat our passage was.\n“Even as thou here upon this side beholdest\n    The boiling stream, that aye diminishes,”\n    The Centaur said, “I wish thee to believe\nThat on this other more and more declines\n    Its bed, until it reunites itself\n    Where it behoveth tyranny to groan.\nJustice divine, upon this side, is goading\n    That Attila, who was a scourge on earth,\n    And Pyrrhus, and Sextus; and for ever milks\nThe tears which with the boiling it unseals\n    In Rinier da Corneto and Rinier Pazzo,\n    Who made upon the highways so much war.”\nThen back he turned, and passed again the ford.","wordCount":144},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-13-1","eventId":"inferno-event-13-1","text":"Not yet had Nessus reached the other side,\n    When we had put ourselves within a wood,\n    That was not marked by any path whatever.\nNot foliage green, but of a dusky colour,\n    Not branches smooth, but gnarled and intertangled,\n    Not apple-trees were there, but thorns with poison.\nSuch tangled thickets have not, nor so dense,\n    Those savage wild beasts, that in hatred hold\n    ’Twixt Cecina and Corneto the tilled places.\nThere do the hideous Harpies make their nests,\n    Who chased the Trojans from the Strophades,\n    With sad announcement of impending doom;\nBroad wings have they, and necks and faces human,\n    And feet with claws, and their great bellies fledged;\n    They make laments upon the wondrous trees.\nAnd the good Master: “Ere thou enter farther,\n    Know that thou art within the second round,”\n    Thus he began to say, “and shalt be, till\nThou comest out upon the horrible sand;\n    Therefore look well around, and thou shalt see\n    Things that will credence give unto my speech.”\nI heard on all sides lamentations uttered,\n    And person none beheld I who might make them,\n    Whence, utterly bewildered, I stood still.","wordCount":187},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-13-2","eventId":"inferno-event-13-2","text":"I think he thought that I perhaps might think\n    So many voices issued through those trunks\n    From people who concealed themselves from us;\nTherefore the Master said: “If thou break off\n    Some little spray from any of these trees,\n    The thoughts thou hast will wholly be made vain.”\nThen stretched I forth my hand a little forward,\n    And plucked a branchlet off from a great thorn;\n    And the trunk cried, “Why dost thou mangle me?”\nAfter it had become embrowned with blood,\n    It recommenced its cry: “Why dost thou rend me?\n    Hast thou no spirit of pity whatsoever?","wordCount":98},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-13-3","eventId":"inferno-event-13-3","text":"Men once we were, and now are changed to trees;\n    Indeed, thy hand should be more pitiful,\n    Even if the souls of serpents we had been.”\nAs out of a green brand, that is on fire\n    At one of the ends, and from the other drips\n    And hisses with the wind that is escaping;\nSo from that splinter issued forth together\n    Both words and blood; whereat I let the tip\n    Fall, and stood like a man who is afraid.\n“Had he been able sooner to believe,”\n    My Sage made answer, “O thou wounded soul,\n    What only in my verses he has seen,\nNot upon thee had he stretched forth his hand;\n    Whereas the thing incredible has caused me\n    To put him to an act which grieveth me.\nBut tell him who thou wast, so that by way\n    Of some amends thy fame he may refresh\n    Up in the world, to which he can return.”\nAnd the trunk said: “So thy sweet words allure me,\n    I cannot silent be; and you be vexed not,\n    That I a little to discourse am tempted.\nI am the one who both keys had in keeping\n    Of Frederick’s heart, and turned them to and fro\n    So softly in unlocking and in locking,\nThat from his secrets most men I withheld;\n    Fidelity I bore the glorious office\n    So great, I lost thereby my sleep and pulses.\nThe courtesan who never from the dwelling\n    Of Caesar turned aside her strumpet eyes,\n    Death universal and the vice of courts,\nInflamed against me all the other minds,\n    And they, inflamed, did so inflame Augustus,\n    That my glad honours turned to dismal mournings.\nMy spirit, in disdainful exultation,\n    Thinking by dying to escape disdain,\n    Made me unjust against myself, the just.\nI, by the roots unwonted of this wood,\n    Do swear to you that never broke I faith\n    Unto my lord, who was so worthy of honour;\nAnd to the world if one of you return,\n    Let him my memory comfort, which is lying\n    Still prostrate from the blow that envy dealt it.”\nWaited awhile, and then: “Since he is silent,”\n    The Poet said to me, “lose not the time,\n    But speak, and question him, if more may please thee.”\nWhence I to him: “Do thou again inquire\n    Concerning what thou thinks’t will satisfy me;\n    For I cannot, such pity is in my heart.”","wordCount":394},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-13-4","eventId":"inferno-event-13-4","text":"Therefore he recommenced: “So may the man\n    Do for thee freely what thy speech implores,\n    Spirit incarcerate, again be pleased\nTo tell us in what way the soul is bound\n    Within these knots; and tell us, if thou canst,\n    If any from such members e’er is freed.”\nThen blew the trunk amain, and afterward\n    The wind was into such a voice converted:\n    “With brevity shall be replied to you.\nWhen the exasperated soul abandons\n    The body whence it rent itself away,\n    Minos consigns it to the seventh abyss.\nIt falls into the forest, and no part\n    Is chosen for it; but where Fortune hurls it,\n    There like a grain of spelt it germinates.\nIt springs a sapling, and a forest tree;\n    The Harpies, feeding then upon its leaves,\n    Do pain create, and for the pain an outlet.\nLike others for our spoils shall we return;\n    But not that any one may them revest,\n    For ’tis not just to have what one casts off.\nHere we shall drag them, and along the dismal\n    Forest our bodies shall suspended be,\n    Each to the thorn of his molested shade.”","wordCount":186},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-13-5","eventId":"inferno-event-13-5","text":"We were attentive still unto the trunk,\n    Thinking that more it yet might wish to tell us,\n    When by a tumult we were overtaken,\nIn the same way as he is who perceives\n    The boar and chase approaching to his stand,\n    Who hears the crashing of the beasts and branches;\nAnd two behold! upon our left-hand side,\n    Naked and scratched, fleeing so furiously,\n    That of the forest, every fan they broke.\nHe who was in advance: “Now help, Death, help!”\n    And the other one, who seemed to lag too much,\n    Was shouting: “Lano, were not so alert\nThose legs of thine at joustings of the Toppo!”\n    And then, perchance because his breath was failing,\n    He grouped himself together with a bush.\nBehind them was the forest full of black\n    She-mastiffs, ravenous, and swift of foot\n    As greyhounds, who are issuing from the chain.\nOn him who had crouched down they set their teeth,\n    And him they lacerated piece by piece,\n    Thereafter bore away those aching members.\nThereat my Escort took me by the hand,\n    And led me to the bush, that all in vain\n    Was weeping from its bloody lacerations.\n“O Jacopo,” it said, “of Sant’ Andrea,\n    What helped it thee of me to make a screen?\n    What blame have I in thy nefarious life?”\nWhen near him had the Master stayed his steps,\n    He said: “Who wast thou, that through wounds so many\n    Art blowing out with blood thy dolorous speech?”\nAnd he to us: “O souls, that hither come\n    To look upon the shameful massacre\n    That has so rent away from me my leaves,\nGather them up beneath the dismal bush;\n    I of that city was which to the Baptist\n    Changed its first patron, wherefore he for this\nForever with his art will make it sad.\n    And were it not that on the pass of Arno\n    Some glimpses of him are remaining still,\nThose citizens, who afterwards rebuilt it\n    Upon the ashes left by Attila,\n    In vain had caused their labour to be done.\nOf my own house I made myself a gibbet.”","wordCount":347},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-14-1","eventId":"inferno-event-14-1","text":"Because the charity of my native place\n    Constrained me, gathered I the scattered leaves,\n    And gave them back to him, who now was hoarse.\nThen came we to the confine, where disparted\n    The second round is from the third, and where\n    A horrible form of Justice is beheld.\nClearly to manifest these novel things,\n    I say that we arrived upon a plain,\n    Which from its bed rejecteth every plant;\nThe dolorous forest is a garland to it\n    All round about, as the sad moat to that;\n    There close upon the edge we stayed our feet.","wordCount":95},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-14-2","eventId":"inferno-event-14-2","text":"The soil was of an arid and thick sand,\n    Not of another fashion made than that\n    Which by the feet of Cato once was pressed.\nVengeance of God, O how much oughtest thou\n    By each one to be dreaded, who doth read\n    That which was manifest unto mine eyes!\nOf naked souls beheld I many herds,\n    Who all were weeping very miserably,\n    And over them seemed set a law diverse.\nSupine upon the ground some folk were lying;\n    And some were sitting all drawn up together,\n    And others went about continually.\nThose who were going round were far the more,\n    And those were less who lay down to their torment,\n    But had their tongues more loosed to lamentation.\nO’er all the sand-waste, with a gradual fall,\n    Were raining down dilated flakes of fire,\n    As of the snow on Alp without a wind.\nAs Alexander, in those torrid parts\n    Of India, beheld upon his host\n    Flames fall unbroken till they reached the ground.\nWhence he provided with his phalanxes\n    To trample down the soil, because the vapour\n    Better extinguished was while it was single;","wordCount":184},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-14-3","eventId":"inferno-event-14-3","text":"Thus was descending the eternal heat,\n    Whereby the sand was set on fire, like tinder\n    Beneath the steel, for doubling of the dole.\nWithout repose forever was the dance\n    Of miserable hands, now there, now here,\n    Shaking away from off them the fresh gleeds.\n“Master,” began I, “thou who overcomest\n    All things except the demons dire, that issued\n    Against us at the entrance of the gate,\nWho is that mighty one who seems to heed not\n    The fire, and lieth lowering and disdainful,\n    So that the rain seems not to ripen him?”\nAnd he himself, who had become aware\n    That I was questioning my Guide about him,\n    Cried: “Such as I was living, am I, dead.\nIf Jove should weary out his smith, from whom\n    He seized in anger the sharp thunderbolt,\n    Wherewith upon the last day I was smitten,\nAnd if he wearied out by turns the others\n    In Mongibello at the swarthy forge,\n    Vociferating, ‘Help, good Vulcan, help!’\nEven as he did there at the fight of Phlegra,\n    And shot his bolts at me with all his might,\n    He would not have thereby a joyous vengeance.”\nThen did my Leader speak with such great force,\n    That I had never heard him speak so loud:\n    “O Capaneus, in that is not extinguished\nThine arrogance, thou punished art the more;\n    Not any torment, saving thine own rage,\n    Would be unto thy fury pain complete.”\nThen he turned round to me with better lip,\n    Saying: “One of the Seven Kings was he\n    Who Thebes besieged, and held, and seems to hold\nGod in disdain, and little seems to prize him;\n    But, as I said to him, his own despites\n    Are for his breast the fittest ornaments.","wordCount":285},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-14-4","eventId":"inferno-event-14-4","text":"Now follow me, and mind thou do not place\n    As yet thy feet upon the burning sand,\n    But always keep them close unto the wood.”\nSpeaking no word, we came to where there gushes\n    Forth from the wood a little rivulet,\n    Whose redness makes my hair still stand on end.\nAs from the Bulicame springs the brooklet,\n    The sinful women later share among them,\n    So downward through the sand it went its way.\nThe bottom of it, and both sloping banks,\n    Were made of stone, and the margins at the side;\n    Whence I perceived that there the passage was.\n“In all the rest which I have shown to thee\n    Since we have entered in within the gate\n    Whose threshold unto no one is denied,\nNothing has been discovered by thine eyes\n    So notable as is the present river,\n    Which all the little flames above it quenches.”\nThese words were of my Leader; whence I prayed him\n    That he would give me largess of the food,\n    For which he had given me largess of desire.\n“In the mid-sea there sits a wasted land,”\n    Said he thereafterward, “whose name is Crete,\n    Under whose king the world of old was chaste.","wordCount":199},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-14-5","eventId":"inferno-event-14-5","text":"There is a mountain there, that once was glad\n    With waters and with leaves, which was called Ida;\n    Now ’tis deserted, as a thing worn out.\nRhea once chose it for the faithful cradle\n    Of her own son; and to conceal him better,\n    Whene’er he cried, she there had clamours made.\nA grand old man stands in the mount erect,\n    Who holds his shoulders turned tow’rds Damietta,\n    And looks at Rome as if it were his mirror.\nHis head is fashioned of refined gold,\n    And of pure silver are the arms and breast;\n    Then he is brass as far down as the fork.\nFrom that point downward all is chosen iron,\n    Save that the right foot is of kiln-baked clay,\n    And more he stands on that than on the other.\nEach part, except the gold, is by a fissure\n    Asunder cleft, that dripping is with tears,\n    Which gathered together perforate that cavern.\nFrom rock to rock they fall into this valley;\n    Acheron, Styx, and Phlegethon they form;\n    Then downward go along this narrow sluice\nUnto that point where is no more descending.\n    They form Cocytus; what that pool may be\n    Thou shalt behold, so here ’tis not narrated.”\nAnd I to him: “If so the present runnel\n    Doth take its rise in this way from our world,\n    Why only on this verge appears it to us?”\nAnd he to me: “Thou knowest the place is round,\n    And notwithstanding thou hast journeyed far,\n    Still to the left descending to the bottom,\nThou hast not yet through all the circle turned.\n    Therefore if something new appear to us,\n    It should not bring amazement to thy face.”\nAnd I again: “Master, where shall be found\n    Lethe and Phlegethon, for of one thou’rt silent,\n    And sayest the other of this rain is made?”\n“In all thy questions truly thou dost please me,”\n    Replied he; “but the boiling of the red\n    Water might well solve one of them thou makest.\nThou shalt see Lethe, but outside this moat,\n    There where the souls repair to lave themselves,\n    When sin repented of has been removed.”\nThen said he: “It is time now to abandon\n    The wood; take heed that thou come after me;\n    A way the margins make that are not burning,\nAnd over them all vapours are extinguished.”","wordCount":383},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-15-1","eventId":"inferno-event-15-1","text":"Now bears us onward one of the hard margins,\n    And so the brooklet’s mist o’ershadows it,\n    From fire it saves the water and the dikes.\nEven as the Flemings, ’twixt Cadsand and Bruges,\n    Fearing the flood that tow’rds them hurls itself,\n    Their bulwarks build to put the sea to flight;\nAnd as the Paduans along the Brenta,\n    To guard their villas and their villages,\n    Or ever Chiarentana feel the heat;\nIn such similitude had those been made,\n    Albeit not so lofty nor so thick,\n    Whoever he might be, the master made them.\nNow were we from the forest so remote,\n    I could not have discovered where it was,\n    Even if backward I had turned myself,\nWhen we a company of souls encountered,\n    Who came beside the dike, and every one\n    Gazed at us, as at evening we are wont\nTo eye each other under a new moon,\n    And so towards us sharpened they their brows\n    As an old tailor at the needle’s eye.\nThus scrutinised by such a family,\n    By some one I was recognised, who seized\n    My garment’s hem, and cried out, “What a marvel!”","wordCount":186},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-15-2","eventId":"inferno-event-15-2","text":"And I, when he stretched forth his arm to me,\n    On his baked aspect fastened so mine eyes,\n    That the scorched countenance prevented not\nHis recognition by my intellect;\n    And bowing down my face unto his own,\n    I made reply, “Are you here, Ser Brunetto?”\nAnd he: “May’t not displease thee, O my son,\n    If a brief space with thee Brunetto Latini\n    Backward return and let the trail go on.”\nI said to him: “With all my power I ask it;\n    And if you wish me to sit down with you,\n    I will, if he please, for I go with him.”\n“O son,” he said, “whoever of this herd\n    A moment stops, lies then a hundred years,\n    Nor fans himself when smiteth him the fire.\nTherefore go on; I at thy skirts will come,\n    And afterward will I rejoin my band,\n    Which goes lamenting its eternal doom.”\nI did not dare to go down from the road\n    Level to walk with him; but my head bowed\n    I held as one who goeth reverently.\nAnd he began: “What fortune or what fate\n    Before the last day leadeth thee down here?\n    And who is this that showeth thee the way?”","wordCount":198},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-15-3","eventId":"inferno-event-15-3","text":"“Up there above us in the life serene,”\n    I answered him, “I lost me in a valley,\n    Or ever yet my age had been completed.\nBut yestermorn I turned my back upon it;\n    This one appeared to me, returning thither,\n    And homeward leadeth me along this road.”\nAnd he to me: “If thou thy star do follow,\n    Thou canst not fail thee of a glorious port,\n    If well I judged in the life beautiful.\nAnd if I had not died so prematurely,\n    Seeing Heaven thus benignant unto thee,\n    I would have given thee comfort in the work.\nBut that ungrateful and malignant people,\n    Which of old time from Fesole descended,\n    And smacks still of the mountain and the granite,\nWill make itself, for thy good deeds, thy foe;\n    And it is right; for among crabbed sorbs\n    It ill befits the sweet fig to bear fruit.\nOld rumour in the world proclaims them blind;\n    A people avaricious, envious, proud;\n    Take heed that of their customs thou do cleanse thee.\nThy fortune so much honour doth reserve thee,\n    One party and the other shall be hungry\n    For thee; but far from goat shall be the grass.\nTheir litter let the beasts of Fesole\n    Make of themselves, nor let them touch the plant,\n    If any still upon their dunghill rise,\nIn which may yet revive the consecrated\n    Seed of those Romans, who remained there when\n    The nest of such great malice it became.”\n“If my entreaty wholly were fulfilled,”\n    Replied I to him, “not yet would you be\n    In banishment from human nature placed;\nFor in my mind is fixed, and touches now\n    My heart the dear and good paternal image\n    Of you, when in the world from hour to hour","wordCount":288},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-15-4","eventId":"inferno-event-15-4","text":"You taught me how a man becomes eternal;\n    And how much I am grateful, while I live\n    Behoves that in my language be discerned.\nWhat you narrate of my career I write,\n    And keep it to be glossed with other text\n    By a Lady who can do it, if I reach her.\nThis much will I have manifest to you;\n    Provided that my conscience do not chide me,\n    For whatsoever Fortune I am ready.\nSuch handsel is not new unto mine ears;\n    Therefore let Fortune turn her wheel around\n    As it may please her, and the churl his mattock.”\nMy Master thereupon on his right cheek\n    Did backward turn himself, and looked at me;\n    Then said: “He listeneth well who noteth it.”\nNor speaking less on that account, I go\n    With Ser Brunetto, and I ask who are\n    His most known and most eminent companions.\nAnd he to me: “To know of some is well;\n    Of others it were laudable to be silent,\n    For short would be the time for so much speech.\nKnow them in sum, that all of them were clerks,\n    And men of letters great and of great fame,\n    In the world tainted with the selfsame sin.","wordCount":200},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-15-5","eventId":"inferno-event-15-5","text":"Priscian goes yonder with that wretched crowd,\n    And Francis of Accorso; and thou hadst seen there\n    If thou hadst had a hankering for such scurf,\nThat one, who by the Servant of the Servants\n    From Arno was transferred to Bacchiglione,\n    Where he has left his sin-excited nerves.\nMore would I say, but coming and discoursing\n    Can be no longer; for that I behold\n    New smoke uprising yonder from the sand.\nA people comes with whom I may not be;\n    Commended unto thee be my Tesoro,\n    In which I still live, and no more I ask.”\nThen he turned round, and seemed to be of those\n    Who at Verona run for the Green Mantle\n    Across the plain; and seemed to be among them\nThe one who wins, and not the one who loses.","wordCount":133},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-16-1","eventId":"inferno-event-16-1","text":"Now was I where was heard the reverberation\n    Of water falling into the next round,\n    Like to that humming which the beehives make,\nWhen shadows three together started forth,\n    Running, from out a company that passed\n    Beneath the rain of the sharp martyrdom.\nTowards us came they, and each one cried out:\n    “Stop, thou; for by thy garb to us thou seemest\n    To be some one of our depraved city.”\nAh me! what wounds I saw upon their limbs,\n    Recent and ancient by the flames burnt in!\n    It pains me still but to remember it.","wordCount":95},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-16-2","eventId":"inferno-event-16-2","text":"Unto their cries my Teacher paused attentive;\n    He turned his face towards me, and “Now wait,”\n    He said; “to these we should be courteous.\nAnd if it were not for the fire that darts\n    The nature of this region, I should say\n    That haste were more becoming thee than them.”\nAs soon as we stood still, they recommenced\n    The old refrain, and when they overtook us,\n    Formed of themselves a wheel, all three of them.\nAs champions stripped and oiled are wont to do,\n    Watching for their advantage and their hold,\n    Before they come to blows and thrusts between them,\nThus, wheeling round, did every one his visage\n    Direct to me, so that in opposite wise\n    His neck and feet continual journey made.\nAnd, “If the misery of this soft place\n    Bring in disdain ourselves and our entreaties,”\n    Began one, “and our aspect black and blistered,","wordCount":146},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-16-3","eventId":"inferno-event-16-3","text":"Let the renown of us thy mind incline\n    To tell us who thou art, who thus securely\n    Thy living feet dost move along through Hell.\nHe in whose footprints thou dost see me treading,\n    Naked and skinless though he now may go,\n    Was of a greater rank than thou dost think;\nHe was the grandson of the good Gualdrada;\n    His name was Guidoguerra, and in life\n    Much did he with his wisdom and his sword.\nThe other, who close by me treads the sand,\n    Tegghiaio Aldobrandi is, whose fame\n    Above there in the world should welcome be.\nAnd I, who with them on the cross am placed,\n    Jacopo Rusticucci was; and truly\n    My savage wife, more than aught else, doth harm me.”\nCould I have been protected from the fire,\n    Below I should have thrown myself among them,\n    And think the Teacher would have suffered it;\nBut as I should have burned and baked myself,\n    My terror overmastered my good will,\n    Which made me greedy of embracing them.\nThen I began: “Sorrow and not disdain\n    Did your condition fix within me so,\n    That tardily it wholly is stripped off,\nAs soon as this my Lord said unto me\n    Words, on account of which I thought within me\n    That people such as you are were approaching.\nI of your city am; and evermore\n    Your labours and your honourable names\n    I with affection have retraced and heard.\nI leave the gall, and go for the sweet fruits\n    Promised to me by the veracious Leader;\n    But to the centre first I needs must plunge.”\n“So may the soul for a long while conduct\n    Those limbs of thine,” did he make answer then,\n    “And so may thy renown shine after thee,\nValour and courtesy, say if they dwell\n    Within our city, as they used to do,\n    Or if they wholly have gone out of it;\nFor Guglielmo Borsier, who is in torment\n    With us of late, and goes there with his comrades,\n    Doth greatly mortify us with his words.”","wordCount":335},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-16-4","eventId":"inferno-event-16-4","text":"“The new inhabitants and the sudden gains,\n    Pride and extravagance have in thee engendered,\n    Florence, so that thou weep’st thereat already!”\nIn this wise I exclaimed with face uplifted;\n    And the three, taking that for my reply,\n    Looked at each other, as one looks at truth.\n“If other times so little it doth cost thee,”\n    Replied they all, “to satisfy another,\n    Happy art thou, thus speaking at thy will!\nTherefore, if thou escape from these dark places,\n    And come to rebehold the beauteous stars,\n    When it shall pleasure thee to say, ‘I was,’\nSee that thou speak of us unto the people.”\n    Then they broke up the wheel, and in their flight\n    It seemed as if their agile legs were wings.\nNot an Amen could possibly be said\n    So rapidly as they had disappeared;\n    Wherefore the Master deemed best to depart.","wordCount":141},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-16-5","eventId":"inferno-event-16-5","text":"I followed him, and little had we gone,\n    Before the sound of water was so near us,\n    That speaking we should hardly have been heard.\nEven as that stream which holdeth its own course\n    The first from Monte Veso tow’rds the East,\n    Upon the left-hand slope of Apennine,\nWhich is above called Acquacheta, ere\n    It down descendeth into its low bed,\n    And at Forli is vacant of that name,\nReverberates there above San Benedetto\n    From Alps, by falling at a single leap,\n    Where for a thousand there were room enough;\nThus downward from a bank precipitate,\n    We found resounding that dark-tinted water,\n    So that it soon the ear would have offended.\nI had a cord around about me girt,\n    And therewithal I whilom had designed\n    To take the panther with the painted skin.\nAfter I this had all from me unloosed,\n    As my Conductor had commanded me,\n    I reached it to him, gathered up and coiled,\nWhereat he turned himself to the right side,\n    And at a little distance from the verge,\n    He cast it down into that deep abyss.\n“It must needs be some novelty respond,”\n    I said within myself, “to the new signal\n    The Master with his eye is following so.”\nAh me! how very cautious men should be\n    With those who not alone behold the act,\n    But with their wisdom look into the thoughts!","wordCount":229},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-16-6","eventId":"inferno-event-16-6","text":"He said to me: “Soon there will upward come\n    What I await; and what thy thought is dreaming\n    Must soon reveal itself unto thy sight.”\nAye to that truth which has the face of falsehood,\n    A man should close his lips as far as may be,\n    Because without his fault it causes shame;\nBut here I cannot; and, Reader, by the notes\n    Of this my Comedy to thee I swear,\n    So may they not be void of lasting favour,\nAthwart that dense and darksome atmosphere\n    I saw a figure swimming upward come,\n    Marvellous unto every steadfast heart,\nEven as he returns who goeth down\n    Sometimes to clear an anchor, which has grappled\n    Reef, or aught else that in the sea is hidden,\nWho upward stretches, and draws in his feet.","wordCount":130},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-17-1","eventId":"inferno-event-17-1","text":"“Behold the monster with the pointed tail,\n    Who cleaves the hills, and breaketh walls and weapons,\n    Behold him who infecteth all the world.”\nThus unto me my Guide began to say,\n    And beckoned him that he should come to shore,\n    Near to the confine of the trodden marble;\nAnd that uncleanly image of deceit\n    Came up and thrust ashore its head and bust,\n    But on the border did not drag its tail.\nThe face was as the face of a just man,\n    Its semblance outwardly was so benign,\n    And of a serpent all the trunk beside.\nTwo paws it had, hairy unto the armpits;\n    The back, and breast, and both the sides it had\n    Depicted o’er with nooses and with shields.\nWith colours more, groundwork or broidery\n    Never in cloth did Tartars make nor Turks,\n    Nor were such tissues by Arachne laid.\nAs sometimes wherries lie upon the shore,\n    That part are in the water, part on land;\n    And as among the guzzling Germans there,\nThe beaver plants himself to wage his war;\n    So that vile monster lay upon the border,\n    Which is of stone, and shutteth in the sand.\nHis tail was wholly quivering in the void,\n    Contorting upwards the envenomed fork,\n    That in the guise of scorpion armed its point.\nThe Guide said: “Now perforce must turn aside\n    Our way a little, even to that beast\n    Malevolent, that yonder coucheth him.”","wordCount":233},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-17-2","eventId":"inferno-event-17-2","text":"We therefore on the right side descended,\n    And made ten steps upon the outer verge,\n    Completely to avoid the sand and flame;\nAnd after we are come to him, I see\n    A little farther off upon the sand\n    A people sitting near the hollow place.\nThen said to me the Master: “So that full\n    Experience of this round thou bear away,\n    Now go and see what their condition is.\nThere let thy conversation be concise;\n    Till thou returnest I will speak with him,\n    That he concede to us his stalwart shoulders.”\nThus farther still upon the outermost\n    Head of that seventh circle all alone\n    I went, where sat the melancholy folk.\nOut of their eyes was gushing forth their woe;\n    This way, that way, they helped them with their hands\n    Now from the flames and now from the hot soil.\nNot otherwise in summer do the dogs,\n    Now with the foot, now with the muzzle, when\n    By fleas, or flies, or gadflies, they are bitten.\nWhen I had turned mine eyes upon the faces\n    Of some, on whom the dolorous fire is falling,\n    Not one of them I knew; but I perceived\nThat from the neck of each there hung a pouch,\n    Which certain colour had, and certain blazon;\n    And thereupon it seems their eyes are feeding.\nAnd as I gazing round me come among them,\n    Upon a yellow pouch I azure saw\n    That had the face and posture of a lion.","wordCount":242},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-17-3","eventId":"inferno-event-17-3","text":"Proceeding then the current of my sight,\n    Another of them saw I, red as blood,\n    Display a goose more white than butter is.\nAnd one, who with an azure sow and gravid\n    Emblazoned had his little pouch of white,\n    Said unto me: “What dost thou in this moat?\nNow get thee gone; and since thou’rt still alive,\n    Know that a neighbour of mine, Vitaliano,\n    Will have his seat here on my left-hand side.\nA Paduan am I with these Florentines;\n    Full many a time they thunder in mine ears,\n    Exclaiming, ‘Come the sovereign cavalier,\nHe who shall bring the satchel with three goats;’”\n    Then twisted he his mouth, and forth he thrust\n    His tongue, like to an ox that licks its nose.\nAnd fearing lest my longer stay might vex\n    Him who had warned me not to tarry long,\n    Backward I turned me from those weary souls.\nI found my Guide, who had already mounted\n    Upon the back of that wild animal,\n    And said to me: “Now be both strong and bold.\nNow we descend by stairways such as these;\n    Mount thou in front, for I will be midway,\n    So that the tail may have no power to harm thee.”","wordCount":201},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-17-4","eventId":"inferno-event-17-4","text":"Such as he is who has so near the ague\n    Of quartan that his nails are blue already,\n    And trembles all, but looking at the shade;\nEven such became I at those proffered words;\n    But shame in me his menaces produced,\n    Which maketh servant strong before good master.\nI seated me upon those monstrous shoulders;\n    I wished to say, and yet the voice came not\n    As I believed, “Take heed that thou embrace me.”\nBut he, who other times had rescued me\n    In other peril, soon as I had mounted,\n    Within his arms encircled and sustained me,","wordCount":97},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-17-5","eventId":"inferno-event-17-5","text":"And said: “Now, Geryon, bestir thyself;\n    The circles large, and the descent be little;\n    Think of the novel burden which thou hast.”\nEven as the little vessel shoves from shore,\n    Backward, still backward, so he thence withdrew;\n    And when he wholly felt himself afloat,\nThere where his breast had been he turned his tail,\n    And that extended like an eel he moved,\n    And with his paws drew to himself the air.\nA greater fear I do not think there was\n    What time abandoned Phaeton the reins,\n    Whereby the heavens, as still appears, were scorched;\nNor when the wretched Icarus his flanks\n    Felt stripped of feathers by the melting wax,\n    His father crying, “An ill way thou takest!”\nThan was my own, when I perceived myself\n    On all sides in the air, and saw extinguished\n    The sight of everything but of the monster.\nOnward he goeth, swimming slowly, slowly;\n    Wheels and descends, but I perceive it only\n    By wind upon my face and from below.\nI heard already on the right the whirlpool\n    Making a horrible crashing under us;\n    Whence I thrust out my head with eyes cast downward.\nThen was I still more fearful of the abyss;\n    Because I fires beheld, and heard laments,\n    Whereat I, trembling, all the closer cling.\nI saw then, for before I had not seen it,\n    The turning and descending, by great horrors\n    That were approaching upon divers sides.\nAs falcon who has long been on the wing,\n    Who, without seeing either lure or bird,\n    Maketh the falconer say, “Ah me, thou stoopest,”\nDescendeth weary, whence he started swiftly,\n    Thorough a hundred circles, and alights\n    Far from his master, sullen and disdainful;","wordCount":277},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-17-6","eventId":"inferno-event-17-6","text":"Even thus did Geryon place us on the bottom,\n    Close to the bases of the rough-hewn rock,\n    And being disencumbered of our persons,\nHe sped away as arrow from the string.","wordCount":32},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-18-1","eventId":"inferno-event-18-1","text":"There is a place in Hell called Malebolge,\n    Wholly of stone and of an iron colour,\n    As is the circle that around it turns.\nRight in the middle of the field malign\n    There yawns a well exceeding wide and deep,\n    Of which its place the structure will recount.\nRound, then, is that enclosure which remains\n    Between the well and foot of the high, hard bank,\n    And has distinct in valleys ten its bottom.\nAs where for the protection of the walls\n    Many and many moats surround the castles,\n    The part in which they are a figure forms,\nJust such an image those presented there;\n    And as about such strongholds from their gates\n    Unto the outer bank are little bridges,\nSo from the precipice’s base did crags\n    Project, which intersected dikes and moats,\n    Unto the well that truncates and collects them.\nWithin this place, down shaken from the back\n    Of Geryon, we found us; and the Poet\n    Held to the left, and I moved on behind.\nUpon my right hand I beheld new anguish,\n    New torments, and new wielders of the lash,\n    Wherewith the foremost Bolgia was replete.","wordCount":187},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-18-2","eventId":"inferno-event-18-2","text":"Down at the bottom were the sinners naked;\n    This side the middle came they facing us,\n    Beyond it, with us, but with greater steps;\nEven as the Romans, for the mighty host,\n    The year of Jubilee, upon the bridge,\n    Have chosen a mode to pass the people over;\nFor all upon one side towards the Castle\n    Their faces have, and go unto St. Peter’s;\n    On the other side they go towards the Mountain.\nThis side and that, along the livid stone\n    Beheld I horned demons with great scourges,\n    Who cruelly were beating them behind.\nAh me! how they did make them lift their legs\n    At the first blows! and sooth not any one\n    The second waited for, nor for the third.\nWhile I was going on, mine eyes by one\n    Encountered were; and straight I said: “Already\n    With sight of this one I am not unfed.”\nTherefore I stayed my feet to make him out,\n    And with me the sweet Guide came to a stand,\n    And to my going somewhat back assented;\nAnd he, the scourged one, thought to hide himself,\n    Lowering his face, but little it availed him;\n    For said I: “Thou that castest down thine eyes,","wordCount":198},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-18-3","eventId":"inferno-event-18-3","text":"If false are not the features which thou bearest,\n    Thou art Venedico Caccianimico;\n    But what doth bring thee to such pungent sauces?”\nAnd he to me: “Unwillingly I tell it;\n    But forces me thine utterance distinct,\n    Which makes me recollect the ancient world.\nI was the one who the fair Ghisola\n    Induced to grant the wishes of the Marquis,\n    Howe’er the shameless story may be told.\nNot the sole Bolognese am I who weeps here;\n    Nay, rather is this place so full of them,\n    That not so many tongues to-day are taught\n’Twixt Reno and Savena to say ‘sipa;’\n    And if thereof thou wishest pledge or proof,\n    Bring to thy mind our avaricious heart.”\nWhile speaking in this manner, with his scourge\n    A demon smote him, and said: “Get thee gone\n    Pander, there are no women here for coin.”\nI joined myself again unto mine Escort;\n    Thereafterward with footsteps few we came\n    To where a crag projected from the bank.\nThis very easily did we ascend,\n    And turning to the right along its ridge,\n    From those eternal circles we departed.","wordCount":181},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-18-4","eventId":"inferno-event-18-4","text":"When we were there, where it is hollowed out\n    Beneath, to give a passage to the scourged,\n    The Guide said: “Wait, and see that on thee strike\nThe vision of those others evil-born,\n    Of whom thou hast not yet beheld the faces,\n    Because together with us they have gone.”\nFrom the old bridge we looked upon the train\n    Which tow’rds us came upon the other border,\n    And which the scourges in like manner smite.\nAnd the good Master, without my inquiring,\n    Said to me: “See that tall one who is coming,\n    And for his pain seems not to shed a tear;\nStill what a royal aspect he retains!\n    That Jason is, who by his heart and cunning\n    The Colchians of the Ram made destitute.\nHe by the isle of Lemnos passed along\n    After the daring women pitiless\n    Had unto death devoted all their males.\nThere with his tokens and with ornate words\n    Did he deceive Hypsipyle, the maiden\n    Who first, herself, had all the rest deceived.\nThere did he leave her pregnant and forlorn;\n    Such sin unto such punishment condemns him,\n    And also for Medea is vengeance done.\nWith him go those who in such wise deceive;\n    And this sufficient be of the first valley\n    To know, and those that in its jaws it holds.”\nWe were already where the narrow path\n    Crosses athwart the second dike, and forms\n    Of that a buttress for another arch.\nThence we heard people, who are making moan\n    In the next Bolgia, snorting with their muzzles,\n    And with their palms beating upon themselves\nThe margins were incrusted with a mould\n    By exhalation from below, that sticks there,\n    And with the eyes and nostrils wages war.","wordCount":282},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-18-5","eventId":"inferno-event-18-5","text":"The bottom is so deep, no place suffices\n    To give us sight of it, without ascending\n    The arch’s back, where most the crag impends.\nThither we came, and thence down in the moat\n    I saw a people smothered in a filth\n    That out of human privies seemed to flow;\nAnd whilst below there with mine eye I search,\n    I saw one with his head so foul with ordure,\n    It was not clear if he were clerk or layman.\nHe screamed to me: “Wherefore art thou so eager\n    To look at me more than the other foul ones?”\n    And I to him: “Because, if I remember,\nI have already seen thee with dry hair,\n    And thou’rt Alessio Interminei of Lucca;\n    Therefore I eye thee more than all the others.”\nAnd he thereon, belabouring his pumpkin:\n    “The flatteries have submerged me here below,\n    Wherewith my tongue was never surfeited.”\nThen said to me the Guide: “See that thou thrust\n    Thy visage somewhat farther in advance,\n    That with thine eyes thou well the face attain\nOf that uncleanly and dishevelled drab,\n    Who there doth scratch herself with filthy nails,\n    And crouches now, and now on foot is standing.\nThais the harlot is it, who replied\n    Unto her paramour, when he said, ‘Have I\n    Great gratitude from thee?’—‘Nay, marvellous;’\nAnd herewith let our sight be satisfied.”","wordCount":223},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-19-1","eventId":"inferno-event-19-1","text":"O Simon Magus, O forlorn disciples,\n    Ye who the things of God, which ought to be\n    The brides of holiness, rapaciously\nFor silver and for gold do prostitute,\n    Now it behoves for you the trumpet sound,\n    Because in this third Bolgia ye abide.\nWe had already on the following tomb\n    Ascended to that portion of the crag\n    Which o’er the middle of the moat hangs plumb.\nWisdom supreme, O how great art thou showest\n    In heaven, in earth, and in the evil world,\n    And with what justice doth thy power distribute!","wordCount":91},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-19-2","eventId":"inferno-event-19-2","text":"I saw upon the sides and on the bottom\n    The livid stone with perforations filled,\n    All of one size, and every one was round.\nTo me less ample seemed they not, nor greater\n    Than those that in my beautiful Saint John\n    Are fashioned for the place of the baptisers,\nAnd one of which, not many years ago,\n    I broke for some one, who was drowning in it;\n    Be this a seal all men to undeceive.\nOut of the mouth of each one there protruded\n    The feet of a transgressor, and the legs\n    Up to the calf, the rest within remained.\nIn all of them the soles were both on fire;\n    Wherefore the joints so violently quivered,\n    They would have snapped asunder withes and bands.\nEven as the flame of unctuous things is wont\n    To move upon the outer surface only,\n    So likewise was it there from heel to point.","wordCount":149},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-19-3","eventId":"inferno-event-19-3","text":"“Master, who is that one who writhes himself,\n    More than his other comrades quivering,”\n    I said, “and whom a redder flame is sucking?”\nAnd he to me: “If thou wilt have me bear thee\n    Down there along that bank which lowest lies,\n    From him thou’lt know his errors and himself.”\nAnd I: “What pleases thee, to me is pleasing;\n    Thou art my Lord, and knowest that I depart not\n    From thy desire, and knowest what is not spoken.”\nStraightway upon the fourth dike we arrived;\n    We turned, and on the left-hand side descended\n    Down to the bottom full of holes and narrow.\nAnd the good Master yet from off his haunch\n    Deposed me not, till to the hole he brought me\n    Of him who so lamented with his shanks.\n“Whoe’er thou art, that standest upside down,\n    O doleful soul, implanted like a stake,”\n    To say began I, “if thou canst, speak out.”\nI stood even as the friar who is confessing\n    The false assassin, who, when he is fixed,\n    Recalls him, so that death may be delayed.\nAnd he cried out: “Dost thou stand there already,\n    Dost thou stand there already, Boniface?\n    By many years the record lied to me.\nArt thou so early satiate with that wealth,\n    For which thou didst not fear to take by fraud\n    The beautiful Lady, and then work her woe?”\nSuch I became, as people are who stand,\n    Not comprehending what is answered them,\n    As if bemocked, and know not how to answer.","wordCount":250},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-19-4","eventId":"inferno-event-19-4","text":"Then said Virgilius: “Say to him straightway,\n    ‘I am not he, I am not he thou thinkest.’”\n    And I replied as was imposed on me.\nWhereat the spirit writhed with both his feet,\n    Then, sighing, with a voice of lamentation\n    Said to me: “Then what wantest thou of me?\nIf who I am thou carest so much to know,\n    That thou on that account hast crossed the bank,\n    Know that I vested was with the great mantle;\nAnd truly was I son of the She-bear,\n    So eager to advance the cubs, that wealth\n    Above, and here myself, I pocketed.\nBeneath my head the others are dragged down\n    Who have preceded me in simony,\n    Flattened along the fissure of the rock.\nBelow there I shall likewise fall, whenever\n    That one shall come who I believed thou wast,\n    What time the sudden question I proposed.\nBut longer I my feet already toast,\n    And here have been in this way upside down,\n    Than he will planted stay with reddened feet;\nFor after him shall come of fouler deed\n    From tow’rds the west a Pastor without law,\n    Such as befits to cover him and me.\nNew Jason will he be, of whom we read\n    In Maccabees; and as his king was pliant,\n    So he who governs France shall be to this one.”\nI do not know if I were here too bold,\n    That him I answered only in this metre:\n    “I pray thee tell me now how great a treasure","wordCount":247},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-19-5","eventId":"inferno-event-19-5","text":"Our Lord demanded of Saint Peter first,\n    Before he put the keys into his keeping?\n    Truly he nothing asked but ‘Follow me.’\nNor Peter nor the rest asked of Matthias\n    Silver or gold, when he by lot was chosen\n    Unto the place the guilty soul had lost.\nTherefore stay here, for thou art justly punished,\n    And keep safe guard o’er the ill-gotten money,\n    Which caused thee to be valiant against Charles.\nAnd were it not that still forbids it me\n    The reverence for the keys superlative\n    Thou hadst in keeping in the gladsome life,\nI would make use of words more grievous still;\n    Because your avarice afflicts the world,\n    Trampling the good and lifting the depraved.\nThe Evangelist you Pastors had in mind,\n    When she who sitteth upon many waters\n    To fornicate with kings by him was seen;\nThe same who with the seven heads was born,\n    And power and strength from the ten horns received,\n    So long as virtue to her spouse was pleasing.\nYe have made yourselves a god of gold and silver;\n    And from the idolater how differ ye,\n    Save that he one, and ye a hundred worship?\nAh, Constantine! of how much ill was mother,\n    Not thy conversion, but that marriage dower\n    Which the first wealthy Father took from thee!”\nAnd while I sang to him such notes as these,\n    Either that anger or that conscience stung him,\n    He struggled violently with both his feet.","wordCount":240},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-19-6","eventId":"inferno-event-19-6","text":"I think in sooth that it my Leader pleased,\n    With such contented lip he listened ever\n    Unto the sound of the true words expressed.\nTherefore with both his arms he took me up,\n    And when he had me all upon his breast,\n    Remounted by the way where he descended.\nNor did he tire to have me clasped to him;\n    But bore me to the summit of the arch\n    Which from the fourth dike to the fifth is passage.\nThere tenderly he laid his burden down,\n    Tenderly on the crag uneven and steep,\n    That would have been hard passage for the goats:\nThence was unveiled to me another valley.","wordCount":108},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-20-1","eventId":"inferno-event-20-1","text":"Of a new pain behoves me to make verses\n    And give material to the twentieth canto\n    Of the first song, which is of the submerged.\nI was already thoroughly disposed\n    To peer down into the uncovered depth,\n    Which bathed itself with tears of agony;\nAnd people saw I through the circular valley,\n    Silent and weeping, coming at the pace\n    Which in this world the Litanies assume.\nAs lower down my sight descended on them,\n    Wondrously each one seemed to be distorted\n    From chin to the beginning of the chest;\nFor tow’rds the reins the countenance was turned,\n    And backward it behoved them to advance,\n    As to look forward had been taken from them.\nPerchance indeed by violence of palsy\n    Some one has been thus wholly turned awry;\n    But I ne’er saw it, nor believe it can be.\nAs God may let thee, Reader, gather fruit\n    From this thy reading, think now for thyself\n    How I could ever keep my face unmoistened,\nWhen our own image near me I beheld\n    Distorted so, the weeping of the eyes\n    Along the fissure bathed the hinder parts.","wordCount":183},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-20-2","eventId":"inferno-event-20-2","text":"Truly I wept, leaning upon a peak\n    Of the hard crag, so that my Escort said\n    To me: “Art thou, too, of the other fools?\nHere pity lives when it is wholly dead;\n    Who is a greater reprobate than he\n    Who feels compassion at the doom divine?\nLift up, lift up thy head, and see for whom\n    Opened the earth before the Thebans’ eyes;\n    Wherefore they all cried: ‘Whither rushest thou,\nAmphiaraus?  Why dost leave the war?’\n    And downward ceased he not to fall amain\n    As far as Minos, who lays hold on all.\nSee, he has made a bosom of his shoulders!\n    Because he wished to see too far before him\n    Behind he looks, and backward goes his way:\nBehold Tiresias, who his semblance changed,\n    When from a male a female he became,\n    His members being all of them transformed;\nAnd afterwards was forced to strike once more\n    The two entangled serpents with his rod,\n    Ere he could have again his manly plumes.\nThat Aruns is, who backs the other’s belly,\n    Who in the hills of Luni, there where grubs\n    The Carrarese who houses underneath,","wordCount":186},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-20-3","eventId":"inferno-event-20-3","text":"Among the marbles white a cavern had\n    For his abode; whence to behold the stars\n    And sea, the view was not cut off from him.\nAnd she there, who is covering up her breasts,\n    Which thou beholdest not, with loosened tresses,\n    And on that side has all the hairy skin,\nWas Manto, who made quest through many lands,\n    Afterwards tarried there where I was born;\n    Whereof I would thou list to me a little.\nAfter her father had from life departed,\n    And the city of Bacchus had become enslaved,\n    She a long season wandered through the world.","wordCount":97},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-20-4","eventId":"inferno-event-20-4","text":"Above in beauteous Italy lies a lake\n    At the Alp’s foot that shuts in Germany\n    Over Tyrol, and has the name Benaco.\nBy a thousand springs, I think, and more, is bathed,\n    ’Twixt Garda and Val Camonica, Pennino,\n    With water that grows stagnant in that lake.\nMidway a place is where the Trentine Pastor,\n    And he of Brescia, and the Veronese\n    Might give his blessing, if he passed that way.\nSitteth Peschiera, fortress fair and strong,\n    To front the Brescians and the Bergamasks,\n    Where round about the bank descendeth lowest.\nThere of necessity must fall whatever\n    In bosom of Benaco cannot stay,\n    And grows a river down through verdant pastures.\nSoon as the water doth begin to run,\n    No more Benaco is it called, but Mincio,\n    Far as Governo, where it falls in Po.\nNot far it runs before it finds a plain\n    In which it spreads itself, and makes it marshy,\n    And oft ’tis wont in summer to be sickly.\nPassing that way the virgin pitiless\n    Land in the middle of the fen descried,\n    Untilled and naked of inhabitants;\nThere to escape all human intercourse,\n    She with her servants stayed, her arts to practise\n    And lived, and left her empty body there.\nThe men, thereafter, who were scattered round,\n    Collected in that place, which was made strong\n    By the lagoon it had on every side;\nThey built their city over those dead bones,\n    And, after her who first the place selected,\n    Mantua named it, without other omen.\nIts people once within more crowded were,\n    Ere the stupidity of Casalodi\n    From Pinamonte had received deceit.","wordCount":265},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-20-5","eventId":"inferno-event-20-5","text":"Therefore I caution thee, if e’er thou hearest\n    Originate my city otherwise,\n    No falsehood may the verity defraud.”\nAnd I: “My Master, thy discourses are\n    To me so certain, and so take my faith,\n    That unto me the rest would be spent coals.\nBut tell me of the people who are passing,\n    If any one note-worthy thou beholdest,\n    For only unto that my mind reverts.”\nThen said he to me: “He who from the cheek\n    Thrusts out his beard upon his swarthy shoulders\n    Was, at the time when Greece was void of males,\nSo that there scarce remained one in the cradle,\n    An augur, and with Calchas gave the moment,\n    In Aulis, when to sever the first cable.\nEryphylus his name was, and so sings\n    My lofty Tragedy in some part or other;\n    That knowest thou well, who knowest the whole of it.\nThe next, who is so slender in the flanks,\n    Was Michael Scott, who of a verity\n    Of magical illusions knew the game.","wordCount":166},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-20-6","eventId":"inferno-event-20-6","text":"Behold Guido Bonatti, behold Asdente,\n    Who now unto his leather and his thread\n    Would fain have stuck, but he too late repents.\nBehold the wretched ones, who left the needle,\n    The spool and rock, and made them fortune-tellers;\n    They wrought their magic spells with herb and image.\nBut come now, for already holds the confines\n    Of both the hemispheres, and under Seville\n    Touches the ocean-wave, Cain and the thorns,\nAnd yesternight the moon was round already;\n    Thou shouldst remember well it did not harm thee\n    From time to time within the forest deep.”\nThus spake he to me, and we walked the while.","wordCount":105},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-21-1","eventId":"inferno-event-21-1","text":"From bridge to bridge thus, speaking other things\n    Of which my Comedy cares not to sing,\n    We came along, and held the summit, when\nWe halted to behold another fissure\n    Of Malebolge and other vain laments;\n    And I beheld it marvellously dark.\nAs in the Arsenal of the Venetians\n    Boils in the winter the tenacious pitch\n    To smear their unsound vessels o’er again,\nFor sail they cannot; and instead thereof\n    One makes his vessel new, and one recaulks\n    The ribs of that which many a voyage has made;\nOne hammers at the prow, one at the stern,\n    This one makes oars, and that one cordage twists,\n    Another mends the mainsail and the mizzen;\nThus, not by fire, but by the art divine,\n    Was boiling down below there a dense pitch\n    Which upon every side the bank belimed.\nI saw it, but I did not see within it\n    Aught but the bubbles that the boiling raised,\n    And all swell up and resubside compressed.\nThe while below there fixedly I gazed,\n    My Leader, crying out: “Beware, beware!”\n    Drew me unto himself from where I stood.","wordCount":183},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-21-2","eventId":"inferno-event-21-2","text":"Then I turned round, as one who is impatient\n    To see what it behoves him to escape,\n    And whom a sudden terror doth unman,\nWho, while he looks, delays not his departure;\n    And I beheld behind us a black devil,\n    Running along upon the crag, approach.\nAh, how ferocious was he in his aspect!\n    And how he seemed to me in action ruthless,\n    With open wings and light upon his feet!\nHis shoulders, which sharp-pointed were and high,\n    A sinner did encumber with both haunches,\n    And he held clutched the sinews of the feet.","wordCount":95},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-21-3","eventId":"inferno-event-21-3","text":"From off our bridge, he said: “O Malebranche,\n    Behold one of the elders of Saint Zita;\n    Plunge him beneath, for I return for others\nUnto that town, which is well furnished with them.\n    All there are barrators, except Bonturo;\n    No into Yes for money there is changed.”\nHe hurled him down, and over the hard crag\n    Turned round, and never was a mastiff loosened\n    In so much hurry to pursue a thief.\nThe other sank, and rose again face downward;\n    But the demons, under cover of the bridge,\n    Cried: “Here the Santo Volto has no place!\nHere swims one otherwise than in the Serchio;\n    Therefore, if for our gaffs thou wishest not,\n    Do not uplift thyself above the pitch.”\nThey seized him then with more than a hundred rakes;\n    They said: “It here behoves thee to dance covered,\n    That, if thou canst, thou secretly mayest pilfer.”\nNot otherwise the cooks their scullions make\n    Immerse into the middle of the caldron\n    The meat with hooks, so that it may not float.\nSaid the good Master to me: “That it be not\n    Apparent thou art here, crouch thyself down\n    Behind a jag, that thou mayest have some screen;\nAnd for no outrage that is done to me\n    Be thou afraid, because these things I know,\n    For once before was I in such a scuffle.”\nThen he passed on beyond the bridge’s head,\n    And as upon the sixth bank he arrived,\n    Need was for him to have a steadfast front.\nWith the same fury, and the same uproar,\n    As dogs leap out upon a mendicant,\n    Who on a sudden begs, where’er he stops,\nThey issued from beneath the little bridge,\n    And turned against him all their grappling-irons;\n    But he cried out: “Be none of you malignant!","wordCount":294},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-21-4","eventId":"inferno-event-21-4","text":"Before those hooks of yours lay hold of me,\n    Let one of you step forward, who may hear me,\n    And then take counsel as to grappling me.”\nThey all cried out: “Let Malacoda go;”\n    Whereat one started, and the rest stood still,\n    And he came to him, saying: “What avails it?”\n“Thinkest thou, Malacoda, to behold me\n    Advanced into this place,” my Master said,\n    “Safe hitherto from all your skill of fence,\nWithout the will divine, and fate auspicious?\n    Let me go on, for it in Heaven is willed\n    That I another show this savage road.”\nThen was his arrogance so humbled in him,\n    That he let fall his grapnel at his feet,\n    And to the others said: “Now strike him not.”\nAnd unto me my Guide: “O thou, who sittest\n    Among the splinters of the bridge crouched down,\n    Securely now return to me again.”\nWherefore I started and came swiftly to him;\n    And all the devils forward thrust themselves,\n    So that I feared they would not keep their compact.\nAnd thus beheld I once afraid the soldiers\n    Who issued under safeguard from Caprona,\n    Seeing themselves among so many foes.","wordCount":190},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-21-5","eventId":"inferno-event-21-5","text":"Close did I press myself with all my person\n    Beside my Leader, and turned not mine eyes\n    From off their countenance, which was not good.\nThey lowered their rakes, and “Wilt thou have me hit him,”\n    They said to one another, “on the rump?”\n    And answered: “Yes; see that thou nick him with it.”\nBut the same demon who was holding parley\n    With my Conductor turned him very quickly,\n    And said: “Be quiet, be quiet, Scarmiglione;”\nThen said to us: “You can no farther go\n    Forward upon this crag, because is lying\n    All shattered, at the bottom, the sixth arch.","wordCount":100},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-21-6","eventId":"inferno-event-21-6","text":"And if it still doth please you to go onward,\n    Pursue your way along upon this rock;\n    Near is another crag that yields a path.\nYesterday, five hours later than this hour,\n    One thousand and two hundred sixty-six\n    Years were complete, that here the way was broken.\nI send in that direction some of mine\n    To see if any one doth air himself;\n    Go ye with them; for they will not be vicious.\nStep forward, Alichino and Calcabrina,”\n    Began he to cry out, “and thou, Cagnazzo;\n    And Barbariccia, do thou guide the ten.\nCome forward, Libicocco and Draghignazzo,\n    And tusked Ciriatto and Graffiacane,\n    And Farfarello and mad Rubicante;\nSearch ye all round about the boiling pitch;\n    Let these be safe as far as the next crag,\n    That all unbroken passes o’er the dens.”\n“O me! what is it, Master, that I see?\n    Pray let us go,” I said, “without an escort,\n    If thou knowest how, since for myself I ask none.\nIf thou art as observant as thy wont is,\n    Dost thou not see that they do gnash their teeth,\n    And with their brows are threatening woe to us?”\nAnd he to me: “I will not have thee fear;\n    Let them gnash on, according to their fancy,\n    Because they do it for those boiling wretches.”\nAlong the left-hand dike they wheeled about;\n    But first had each one thrust his tongue between\n    His teeth towards their leader for a signal;\nAnd he had made a trumpet of his rump.","wordCount":250},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-22-1","eventId":"inferno-event-22-1","text":"I have erewhile seen horsemen moving camp,\n    Begin the storming, and their muster make,\n    And sometimes starting off for their escape;\nVaunt-couriers have I seen upon your land,\n    O Aretines, and foragers go forth,\n    Tournaments stricken, and the joustings run,\nSometimes with trumpets and sometimes with bells,\n    With kettle-drums, and signals of the castles,\n    And with our own, and with outlandish things,\nBut never yet with bagpipe so uncouth\n    Did I see horsemen move, nor infantry,\n    Nor ship by any sign of land or star.\nWe went upon our way with the ten demons;\n    Ah, savage company! but in the church\n    With saints, and in the tavern with the gluttons!\nEver upon the pitch was my intent,\n    To see the whole condition of that Bolgia,\n    And of the people who therein were burned.\nEven as the dolphins, when they make a sign\n    To mariners by arching of the back,\n    That they should counsel take to save their vessel,\nThus sometimes, to alleviate his pain,\n    One of the sinners would display his back,\n    And in less time conceal it than it lightens.","wordCount":183},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-22-2","eventId":"inferno-event-22-2","text":"As on the brink of water in a ditch\n    The frogs stand only with their muzzles out,\n    So that they hide their feet and other bulk,\nSo upon every side the sinners stood;\n    But ever as Barbariccia near them came,\n    Thus underneath the boiling they withdrew.\nI saw, and still my heart doth shudder at it,\n    One waiting thus, even as it comes to pass\n    One frog remains, and down another dives;\nAnd Graffiacan, who most confronted him,\n    Grappled him by his tresses smeared with pitch,\n    And drew him up, so that he seemed an otter.","wordCount":96},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-22-3","eventId":"inferno-event-22-3","text":"I knew, before, the names of all of them,\n    So had I noted them when they were chosen,\n    And when they called each other, listened how.\n“O Rubicante, see that thou do lay\n    Thy claws upon him, so that thou mayst flay him,”\n    Cried all together the accursed ones.\nAnd I: “My Master, see to it, if thou canst,\n    That thou mayst know who is the luckless wight,\n    Thus come into his adversaries’ hands.”\nNear to the side of him my Leader drew,\n    Asked of him whence he was; and he replied:\n    “I in the kingdom of Navarre was born;\nMy mother placed me servant to a lord,\n    For she had borne me to a ribald knave,\n    Destroyer of himself and of his things.\nThen I domestic was of good King Thibault;\n    I set me there to practise barratry,\n    For which I pay the reckoning in this heat.”\nAnd Ciriatto, from whose mouth projected,\n    On either side, a tusk, as in a boar,\n    Caused him to feel how one of them could rip.\nAmong malicious cats the mouse had come;\n    But Barbariccia clasped him in his arms,\n    And said: “Stand ye aside, while I enfork him.”","wordCount":196},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-22-4","eventId":"inferno-event-22-4","text":"And to my Master he turned round his head;\n    “Ask him again,” he said, “if more thou wish\n    To know from him, before some one destroy him.”\nThe Guide: “Now tell then of the other culprits;\n    Knowest thou any one who is a Latian,\n    Under the pitch?”  And he: “I separated\nLately from one who was a neighbour to it;\n    Would that I still were covered up with him,\n    For I should fear not either claw nor hook!”\nAnd Libicocco: “We have borne too much;”\n    And with his grapnel seized him by the arm,\n    So that, by rending, he tore off a tendon.\nEke Draghignazzo wished to pounce upon him\n    Down at the legs; whence their Decurion\n    Turned round and round about with evil look.\nWhen they again somewhat were pacified,\n    Of him, who still was looking at his wound,\n    Demanded my Conductor without stay:\n“Who was that one, from whom a luckless parting\n    Thou sayest thou hast made, to come ashore?”\n    And he replied: “It was the Friar Gomita,\nHe of Gallura, vessel of all fraud,\n    Who had the enemies of his Lord in hand,\n    And dealt so with them each exults thereat;\nMoney he took, and let them smoothly off,\n    As he says; and in other offices\n    A barrator was he, not mean but sovereign.\nForegathers with him one Don Michael Zanche\n    Of Logodoro; and of Sardinia\n    To gossip never do their tongues feel tired.\nO me! see that one, how he grinds his teeth;\n    Still farther would I speak, but am afraid\n    Lest he to scratch my itch be making ready.”\nAnd the grand Provost, turned to Farfarello,\n    Who rolled his eyes about as if to strike,\n    Said: “Stand aside there, thou malicious bird.”","wordCount":287},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-22-5","eventId":"inferno-event-22-5","text":"“If you desire either to see or hear,”\n    The terror-stricken recommenced thereon,\n    “Tuscans or Lombards, I will make them come.\nBut let the Malebranche cease a little,\n    So that these may not their revenges fear,\n    And I, down sitting in this very place,\nFor one that I am will make seven come,\n    When I shall whistle, as our custom is\n    To do whenever one of us comes out.”\nCagnazzo at these words his muzzle lifted,\n    Shaking his head, and said: “Just hear the trick\n    Which he has thought of, down to throw himself!”\nWhence he, who snares in great abundance had,\n    Responded: “I by far too cunning am,\n    When I procure for mine a greater sadness.”\nAlichin held not in, but running counter\n    Unto the rest, said to him: “If thou dive,\n    I will not follow thee upon the gallop,\nBut I will beat my wings above the pitch;\n    The height be left, and be the bank a shield\n    To see if thou alone dost countervail us.”\nO thou who readest, thou shalt hear new sport!\n    Each to the other side his eyes averted;\n    He first, who most reluctant was to do it.","wordCount":194},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-22-6","eventId":"inferno-event-22-6","text":"The Navarrese selected well his time;\n    Planted his feet on land, and in a moment\n    Leaped, and released himself from their design.\nWhereat each one was suddenly stung with shame,\n    But he most who was cause of the defeat;\n    Therefore he moved, and cried: “Thou art o’ertakern.”\nBut little it availed, for wings could not\n    Outstrip the fear; the other one went under,\n    And, flying, upward he his breast directed;\nNot otherwise the duck upon a sudden\n    Dives under, when the falcon is approaching,\n    And upward he returneth cross and weary.","wordCount":91},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-22-7","eventId":"inferno-event-22-7","text":"Infuriate at the mockery, Calcabrina\n    Flying behind him followed close, desirous\n    The other should escape, to have a quarrel.\nAnd when the barrator had disappeared,\n    He turned his talons upon his companion,\n    And grappled with him right above the moat.\nBut sooth the other was a doughty sparhawk\n    To clapperclaw him well; and both of them\n    Fell in the middle of the boiling pond.\nA sudden intercessor was the heat;\n    But ne’ertheless of rising there was naught,\n    To such degree they had their wings belimed.\nLamenting with the others, Barbariccia\n    Made four of them fly to the other side\n    With all their gaffs, and very speedily\nThis side and that they to their posts descended;\n    They stretched their hooks towards the pitch-ensnared,\n    Who were already baked within the crust,\nAnd in this manner busied did we leave them.","wordCount":139},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-23-1","eventId":"inferno-event-23-1","text":"Silent, alone, and without company\n    We went, the one in front, the other after,\n    As go the Minor Friars along their way.\nUpon the fable of Aesop was directed\n    My thought, by reason of the present quarrel,\n    Where he has spoken of the frog and mouse;\nFor ‘mo’ and ‘issa’ are not more alike\n    Than this one is to that, if well we couple\n    End and beginning with a steadfast mind.\nAnd even as one thought from another springs,\n    So afterward from that was born another,\n    Which the first fear within me double made.","wordCount":94},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-23-2","eventId":"inferno-event-23-2","text":"Thus did I ponder: “These on our account\n    Are laughed to scorn, with injury and scoff\n    So great, that much I think it must annoy them.\nIf anger be engrafted on ill-will,\n    They will come after us more merciless\n    Than dog upon the leveret which he seizes,”\nI felt my hair stand all on end already\n    With terror, and stood backwardly intent,\n    When said I: “Master, if thou hidest not\nThyself and me forthwith, of Malebranche\n    I am in dread; we have them now behind us;\n    I so imagine them, I already feel them.”\nAnd he: “If I were made of leaded glass,\n    Thine outward image I should not attract\n    Sooner to me than I imprint the inner.\nJust now thy thoughts came in among my own,\n    With similar attitude and similar face,\n    So that of both one counsel sole I made.\nIf peradventure the right bank so slope\n    That we to the next Bolgia can descend,\n    We shall escape from the imagined chase.”\nNot yet he finished rendering such opinion,\n    When I beheld them come with outstretched wings,\n    Not far remote, with will to seize upon us.","wordCount":189},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-23-3","eventId":"inferno-event-23-3","text":"My Leader on a sudden seized me up,\n    Even as a mother who by noise is wakened,\n    And close beside her sees the enkindled flames,\nWho takes her son, and flies, and does not stop,\n    Having more care of him than of herself,\n    So that she clothes her only with a shift;\nAnd downward from the top of the hard bank\n    Supine he gave him to the pendent rock,\n    That one side of the other Bolgia walls.\nNe’er ran so swiftly water through a sluice\n    To turn the wheel of any land-built mill,\n    When nearest to the paddles it approaches,\nAs did my Master down along that border,\n    Bearing me with him on his breast away,\n    As his own son, and not as a companion.\nHardly the bed of the ravine below\n    His feet had reached, ere they had reached the hill\n    Right over us; but he was not afraid;\nFor the high Providence, which had ordained\n    To place them ministers of the fifth moat,\n    The power of thence departing took from all.\nA painted people there below we found,\n    Who went about with footsteps very slow,\n    Weeping and in their semblance tired and vanquished.","wordCount":196},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-23-4","eventId":"inferno-event-23-4","text":"They had on mantles with the hoods low down\n    Before their eyes, and fashioned of the cut\n    That in Cologne they for the monks are made.\nWithout, they gilded are so that it dazzles;\n    But inwardly all leaden and so heavy\n    That Frederick used to put them on of straw.\nO everlastingly fatiguing mantle!\n    Again we turned us, still to the left hand\n    Along with them, intent on their sad plaint;\nBut owing to the weight, that weary folk\n    Came on so tardily, that we were new\n    In company at each motion of the haunch.\nWhence I unto my Leader: “See thou find\n    Some one who may by deed or name be known,\n    And thus in going move thine eye about.”\nAnd one, who understood the Tuscan speech,\n    Cried to us from behind: “Stay ye your feet,\n    Ye, who so run athwart the dusky air!\nPerhaps thou’lt have from me what thou demandest.”\n    Whereat the Leader turned him, and said: “Wait,\n    And then according to his pace proceed.”\nI stopped, and two beheld I show great haste\n    Of spirit, in their faces, to be with me;\n    But the burden and the narrow way delayed them.","wordCount":195},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-23-5","eventId":"inferno-event-23-5","text":"When they came up, long with an eye askance\n    They scanned me without uttering a word.\n    Then to each other turned, and said together:\n“He by the action of his throat seems living;\n    And if they dead are, by what privilege\n    Go they uncovered by the heavy stole?”\nThen said to me: “Tuscan, who to the college\n    Of miserable hypocrites art come,\n    Do not disdain to tell us who thou art.”\nAnd I to them: “Born was I, and grew up\n    In the great town on the fair river of Arno,\n    And with the body am I’ve always had.\nBut who are ye, in whom there trickles down\n    Along your cheeks such grief as I behold?\n    And what pain is upon you, that so sparkles?”\nAnd one replied to me: “These orange cloaks\n    Are made of lead so heavy, that the weights\n    Cause in this way their balances to creak.\nFrati Gaudenti were we, and Bolognese;\n    I Catalano, and he Loderingo\n    Named, and together taken by thy city,\nAs the wont is to take one man alone,\n    For maintenance of its peace; and we were such\n    That still it is apparent round Gardingo.”","wordCount":193},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-23-6","eventId":"inferno-event-23-6","text":"“O Friars,” began I, “your iniquitous. . .”\n    But said no more; for to mine eyes there rushed\n    One crucified with three stakes on the ground.\nWhen me he saw, he writhed himself all over,\n    Blowing into his beard with suspirations;\n    And the Friar Catalan, who noticed this,\nSaid to me: “This transfixed one, whom thou seest,\n    Counselled the Pharisees that it was meet\n    To put one man to torture for the people.\nCrosswise and naked is he on the path,\n    As thou perceivest; and he needs must feel,\n    Whoever passes, first how much he weighs;\nAnd in like mode his father-in-law is punished\n    Within this moat, and the others of the council,\n    Which for the Jews was a malignant seed.”\nAnd thereupon I saw Virgilius marvel\n    O’er him who was extended on the cross\n    So vilely in eternal banishment.\nThen he directed to the Friar this voice:\n    “Be not displeased, if granted thee, to tell us\n    If to the right hand any pass slope down\nBy which we two may issue forth from here,\n    Without constraining some of the black angels\n    To come and extricate us from this deep.”","wordCount":190},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-23-7","eventId":"inferno-event-23-7","text":"Then he made answer: “Nearer than thou hopest\n    There is a rock, that forth from the great circle\n    Proceeds, and crosses all the cruel valleys,\nSave that at this ’tis broken, and does not bridge it;\n    You will be able to mount up the ruin,\n    That sidelong slopes and at the bottom rises.”\nThe Leader stood awhile with head bowed down;\n    Then said: “The business badly he recounted\n    Who grapples with his hook the sinners yonder.”\nAnd the Friar: “Many of the Devil’s vices\n    Once heard I at Bologna, and among them,\n    That he’s a liar and the father of lies.”\nThereat my Leader with great strides went on,\n    Somewhat disturbed with anger in his looks;\n    Whence from the heavy-laden I departed\nAfter the prints of his beloved feet.","wordCount":130},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-24-1","eventId":"inferno-event-24-1","text":"In that part of the youthful year wherein\n    The Sun his locks beneath Aquarius tempers,\n    And now the nights draw near to half the day,\nWhat time the hoar-frost copies on the ground\n    The outward semblance of her sister white,\n    But little lasts the temper of her pen,\nThe husbandman, whose forage faileth him,\n    Rises, and looks, and seeth the champaign\n    All gleaming white, whereat he beats his flank,\nReturns in doors, and up and down laments,\n    Like a poor wretch, who knows not what to do;\n    Then he returns and hope revives again,\nSeeing the world has changed its countenance\n    In little time, and takes his shepherd’s crook,\n    And forth the little lambs to pasture drives.\nThus did the Master fill me with alarm,\n    When I beheld his forehead so disturbed,\n    And to the ailment came as soon the plaster.\nFor as we came unto the ruined bridge,\n    The Leader turned to me with that sweet look\n    Which at the mountain’s foot I first beheld.\nHis arms he opened, after some advisement\n    Within himself elected, looking first\n    Well at the ruin, and laid hold of me.","wordCount":188},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-24-2","eventId":"inferno-event-24-2","text":"And even as he who acts and meditates,\n    For aye it seems that he provides beforehand,\n    So upward lifting me towards the summit\nOf a huge rock, he scanned another crag,\n    Saying: “To that one grapple afterwards,\n    But try first if ’tis such that it will hold thee.”\nThis was no way for one clothed with a cloak;\n    For hardly we, he light, and I pushed upward,\n    Were able to ascend from jag to jag.\nAnd had it not been, that upon that precinct\n    Shorter was the ascent than on the other,\n    He I know not, but I had been dead beat.\nBut because Malebolge tow’rds the mouth\n    Of the profoundest well is all inclining,\n    The structure of each valley doth import\nThat one bank rises and the other sinks.\n    Still we arrived at length upon the point\n    Wherefrom the last stone breaks itself asunder.\nThe breath was from my lungs so milked away,\n    When I was up, that I could go no farther,\n    Nay, I sat down upon my first arrival.\n“Now it behoves thee thus to put off sloth,”\n    My Master said; “for sitting upon down,\n    Or under quilt, one cometh not to fame,\nWithouten which whoso his life consumes\n    Such vestige leaveth of himself on earth,\n    As smoke in air or in the water foam.\nAnd therefore raise thee up, o’ercome the anguish\n    With spirit that o’ercometh every battle,\n    If with its heavy body it sink not.\nA longer stairway it behoves thee mount;\n    ’Tis not enough from these to have departed;\n    Let it avail thee, if thou understand me.”\nThen I uprose, showing myself provided\n    Better with breath than I did feel myself,\n    And said: “Go on, for I am strong and bold.”","wordCount":287},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-24-3","eventId":"inferno-event-24-3","text":"Upward we took our way along the crag,\n    Which jagged was, and narrow, and difficult,\n    And more precipitous far than that before.\nSpeaking I went, not to appear exhausted;\n    Whereat a voice from the next moat came forth,\n    Not well adapted to articulate words.\nI know not what it said, though o’er the back\n    I now was of the arch that passes there;\n    But he seemed moved to anger who was speaking.\nI was bent downward, but my living eyes\n    Could not attain the bottom, for the dark;\n    Wherefore I: “Master, see that thou arrive","wordCount":95},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-24-4","eventId":"inferno-event-24-4","text":"At the next round, and let us descend the wall;\n    For as from hence I hear and understand not,\n    So I look down and nothing I distinguish.”\n“Other response,” he said, “I make thee not,\n    Except the doing; for the modest asking\n    Ought to be followed by the deed in silence.”\nWe from the bridge descended at its head,\n    Where it connects itself with the eighth bank,\n    And then was manifest to me the Bolgia;\nAnd I beheld therein a terrible throng\n    Of serpents, and of such a monstrous kind,\n    That the remembrance still congeals my blood\nLet Libya boast no longer with her sand;\n    For if Chelydri, Jaculi, and Phareae\n    She breeds, with Cenchri and with Amphisbaena,\nNeither so many plagues nor so malignant\n    E’er showed she with all Ethiopia,\n    Nor with whatever on the Red Sea is!\nAmong this cruel and most dismal throng\n    People were running naked and affrighted.\n    Without the hope of hole or heliotrope.\nThey had their hands with serpents bound behind them;\n    These riveted upon their reins the tail\n    And head, and were in front of them entwined.","wordCount":184},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-24-5","eventId":"inferno-event-24-5","text":"And lo! at one who was upon our side\n    There darted forth a serpent, which transfixed him\n    There where the neck is knotted to the shoulders.\nNor ‘O’ so quickly e’er, nor ‘I’ was written,\n    As he took fire, and burned; and ashes wholly\n    Behoved it that in falling he became.\nAnd when he on the ground was thus destroyed,\n    The ashes drew together, and of themselves\n    Into himself they instantly returned.\nEven thus by the great sages ’tis confessed\n    The phoenix dies, and then is born again,\n    When it approaches its five-hundredth year;\nOn herb or grain it feeds not in its life,\n    But only on tears of incense and amomum,\n    And nard and myrrh are its last winding-sheet.\nAnd as he is who falls, and knows not how,\n    By force of demons who to earth down drag him,\n    Or other oppilation that binds man,\nWhen he arises and around him looks,\n    Wholly bewildered by the mighty anguish\n    Which he has suffered, and in looking sighs;\nSuch was that sinner after he had risen.\n    Justice of God! O how severe it is,\n    That blows like these in vengeance poureth down!","wordCount":193},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-24-6","eventId":"inferno-event-24-6","text":"The Guide thereafter asked him who he was;\n    Whence he replied: “I rained from Tuscany\n    A short time since into this cruel gorge.\nA bestial life, and not a human, pleased me,\n    Even as the mule I was; I’m Vanni Fucci,\n    Beast, and Pistoia was my worthy den.”\nAnd I unto the Guide: “Tell him to stir not,\n    And ask what crime has thrust him here below,\n    For once a man of blood and wrath I saw him.”\nAnd the sinner, who had heard, dissembled not,\n    But unto me directed mind and face,\n    And with a melancholy shame was painted.\nThen said: “It pains me more that thou hast caught me\n    Amid this misery where thou seest me,\n    Than when I from the other life was taken.\nWhat thou demandest I cannot deny;\n    So low am I put down because I robbed\n    The sacristy of the fair ornaments,\nAnd falsely once ’twas laid upon another;\n    But that thou mayst not such a sight enjoy,\n    If thou shalt e’er be out of the dark places,\nThine ears to my announcement ope and hear:\n    Pistoia first of Neri groweth meagre;\n    Then Florence doth renew her men and manners;\nMars draws a vapour up from Val di Magra,\n    Which is with turbid clouds enveloped round,\n    And with impetuous and bitter tempest\nOver Campo Picen shall be the battle;\n    When it shall suddenly rend the mist asunder,\n    So that each Bianco shall thereby be smitten.\nAnd this I’ve said that it may give thee pain.”","wordCount":251},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-25-1","eventId":"inferno-event-25-1","text":"At the conclusion of his words, the thief\n    Lifted his hands aloft with both the figs,\n    Crying: “Take that, God, for at thee I aim them.”\nFrom that time forth the serpents were my friends;\n    For one entwined itself about his neck\n    As if it said: “I will not thou speak more;”\nAnd round his arms another, and rebound him,\n    Clinching itself together so in front,\n    That with them he could not a motion make.\nPistoia, ah, Pistoia! why resolve not\n    To burn thyself to ashes and so perish,\n    Since in ill-doing thou thy seed excellest?\nThrough all the sombre circles of this Hell,\n    Spirit I saw not against God so proud,\n    Not he who fell at Thebes down from the walls!\nHe fled away, and spake no further word;\n    And I beheld a Centaur full of rage\n    Come crying out: “Where is, where is the scoffer?”\nI do not think Maremma has so many\n    Serpents as he had all along his back,\n    As far as where our countenance begins.\nUpon the shoulders, just behind the nape,\n    With wings wide open was a dragon lying,\n    And he sets fire to all that he encounters.","wordCount":195},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-25-2","eventId":"inferno-event-25-2","text":"My Master said: “That one is Cacus, who\n    Beneath the rock upon Mount Aventine\n    Created oftentimes a lake of blood.\nHe goes not on the same road with his brothers,\n    By reason of the fraudulent theft he made\n    Of the great herd, which he had near to him;\nWhereat his tortuous actions ceased beneath\n    The mace of Hercules, who peradventure\n    Gave him a hundred, and he felt not ten.”\nWhile he was speaking thus, he had passed by,\n    And spirits three had underneath us come,\n    Of which nor I aware was, nor my Leader,","wordCount":94},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-25-3","eventId":"inferno-event-25-3","text":"Until what time they shouted: “Who are you?”\n    On which account our story made a halt,\n    And then we were intent on them alone.\nI did not know them; but it came to pass,\n    As it is wont to happen by some chance,\n    That one to name the other was compelled,\nExclaiming: “Where can Cianfa have remained?”\n    Whence I, so that the Leader might attend,\n    Upward from chin to nose my finger laid.\nIf thou art, Reader, slow now to believe\n    What I shall say, it will no marvel be,\n    For I who saw it hardly can admit it.","wordCount":99},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-25-4","eventId":"inferno-event-25-4","text":"As I was holding raised on them my brows,\n    Behold! a serpent with six feet darts forth\n    In front of one, and fastens wholly on him.\nWith middle feet it bound him round the paunch,\n    And with the forward ones his arms it seized;\n    Then thrust its teeth through one cheek and the other;\nThe hindermost it stretched upon his thighs,\n    And put its tail through in between the two,\n    And up behind along the reins outspread it.\nIvy was never fastened by its barbs\n    Unto a tree so, as this horrible reptile\n    Upon the other’s limbs entwined its own.","wordCount":100},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-25-5","eventId":"inferno-event-25-5","text":"Then they stuck close, as if of heated wax\n    They had been made, and intermixed their colour;\n    Nor one nor other seemed now what he was;\nE’en as proceedeth on before the flame\n    Upward along the paper a brown colour,\n    Which is not black as yet, and the white dies.\nThe other two looked on, and each of them\n    Cried out: “O me, Agnello, how thou changest!\n    Behold, thou now art neither two nor one.”\nAlready the two heads had one become,\n    When there appeared to us two figures mingled\n    Into one face, wherein the two were lost.\nOf the four lists were fashioned the two arms,\n    The thighs and legs, the belly and the chest\n    Members became that never yet were seen.\nEvery original aspect there was cancelled;\n    Two and yet none did the perverted image\n    Appear, and such departed with slow pace.\nEven as a lizard, under the great scourge\n    Of days canicular, exchanging hedge,\n    Lightning appeareth if the road it cross;\nThus did appear, coming towards the bellies\n    Of the two others, a small fiery serpent,\n    Livid and black as is a peppercorn.\nAnd in that part whereat is first received\n    Our aliment, it one of them transfixed;\n    Then downward fell in front of him extended.\nThe one transfixed looked at it, but said naught;\n    Nay, rather with feet motionless he yawned,\n    Just as if sleep or fever had assailed him.\nHe at the serpent gazed, and it at him;\n    One through the wound, the other through the mouth\n    Smoked violently, and the smoke commingled.\nHenceforth be silent Lucan, where he mentions\n    Wretched Sabellus and Nassidius,\n    And wait to hear what now shall be shot forth.","wordCount":279},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-25-6","eventId":"inferno-event-25-6","text":"Be silent Ovid, of Cadmus and Arethusa;\n    For if him to a snake, her to fountain,\n    Converts he fabling, that I grudge him not;\nBecause two natures never front to front\n    Has he transmuted, so that both the forms\n    To interchange their matter ready were.\nTogether they responded in such wise,\n    That to a fork the serpent cleft his tail,\n    And eke the wounded drew his feet together.\nThe legs together with the thighs themselves\n    Adhered so, that in little time the juncture\n    No sign whatever made that was apparent.\nHe with the cloven tail assumed the figure\n    The other one was losing, and his skin\n    Became elastic, and the other’s hard.\nI saw the arms draw inward at the armpits,\n    And both feet of the reptile, that were short,\n    Lengthen as much as those contracted were.\nThereafter the hind feet, together twisted,\n    Became the member that a man conceals,\n    And of his own the wretch had two created.\nWhile both of them the exhalation veils\n    With a new colour, and engenders hair\n    On one of them and depilates the other,","wordCount":181},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-25-7","eventId":"inferno-event-25-7","text":"The one uprose and down the other fell,\n    Though turning not away their impious lamps,\n    Underneath which each one his muzzle changed.\nHe who was standing drew it tow’rds the temples,\n    And from excess of matter, which came thither,\n    Issued the ears from out the hollow cheeks;\nWhat did not backward run and was retained\n    Of that excess made to the face a nose,\n    And the lips thickened far as was befitting.\nHe who lay prostrate thrusts his muzzle forward,\n    And backward draws the ears into his head,\n    In the same manner as the snail its horns;\nAnd so the tongue, which was entire and apt\n    For speech before, is cleft, and the bi-forked\n    In the other closes up, and the smoke ceases.\nThe soul, which to a reptile had been changed,\n    Along the valley hissing takes to flight,\n    And after him the other speaking sputters.\nThen did he turn upon him his new shoulders,\n    And said to the other: “I’ll have Buoso run,\n    Crawling as I have done, along this road.”\nIn this way I beheld the seventh ballast\n    Shift and reshift, and here be my excuse\n    The novelty, if aught my pen transgress.","wordCount":196},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-25-8","eventId":"inferno-event-25-8","text":"And notwithstanding that mine eyes might be\n    Somewhat bewildered, and my mind dismayed,\n    They could not flee away so secretly\nBut that I plainly saw Puccio Sciancato;\n    And he it was who sole of three companions,\n    Which came in the beginning, was not changed;\nThe other was he whom thou, Gaville, weepest.","wordCount":52},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-26-1","eventId":"inferno-event-26-1","text":"Rejoice, O Florence, since thou art so great,\n    That over sea and land thou beatest thy wings,\n    And throughout Hell thy name is spread abroad!\nAmong the thieves five citizens of thine\n    Like these I found, whence shame comes unto me,\n    And thou thereby to no great honour risest.\nBut if when morn is near our dreams are true,\n    Feel shalt thou in a little time from now\n    What Prato, if none other, craves for thee.\nAnd if it now were, it were not too soon;\n    Would that it were, seeing it needs must be,\n    For ’twill aggrieve me more the more I age.","wordCount":104},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-26-2","eventId":"inferno-event-26-2","text":"We went our way, and up along the stairs\n    The bourns had made us to descend before,\n    Remounted my Conductor and drew me.\nAnd following the solitary path\n    Among the rocks and ridges of the crag,\n    The foot without the hand sped not at all.\nThen sorrowed I, and sorrow now again,\n    When I direct my mind to what I saw,\n    And more my genius curb than I am wont,\nThat it may run not unless virtue guide it;\n    So that if some good star, or better thing,\n    Have given me good, I may myself not grudge it.","wordCount":98},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-26-3","eventId":"inferno-event-26-3","text":"As many as the hind (who on the hill\n    Rests at the time when he who lights the world\n    His countenance keeps least concealed from us,\nWhile as the fly gives place unto the gnat)\n    Seeth the glow-worms down along the valley,\n    Perchance there where he ploughs and makes his vintage;\nWith flames as manifold resplendent all\n    Was the eighth Bolgia, as I grew aware\n    As soon as I was where the depth appeared.\nAnd such as he who with the bears avenged him\n    Beheld Elijah’s chariot at departing,\n    What time the steeds to heaven erect uprose,\nFor with his eye he could not follow it\n    So as to see aught else than flame alone,\n    Even as a little cloud ascending upward,\nThus each along the gorge of the intrenchment\n    Was moving; for not one reveals the theft,\n    And every flame a sinner steals away.\nI stood upon the bridge uprisen to see,\n    So that, if I had seized not on a rock,\n    Down had I fallen without being pushed.\nAnd the Leader, who beheld me so attent,\n    Exclaimed: “Within the fires the spirits are;\n    Each swathes himself with that wherewith he burns.”","wordCount":194},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-26-4","eventId":"inferno-event-26-4","text":"“My Master,” I replied, “by hearing thee\n    I am more sure; but I surmised already\n    It might be so, and already wished to ask thee\nWho is within that fire, which comes so cleft\n    At top, it seems uprising from the pyre\n    Where was Eteocles with his brother placed.”\nHe answered me: “Within there are tormented\n    Ulysses and Diomed, and thus together\n    They unto vengeance run as unto wrath.\nAnd there within their flame do they lament\n    The ambush of the horse, which made the door\n    Whence issued forth the Romans’ gentle seed;\nTherein is wept the craft, for which being dead\n    Deidamia still deplores Achilles,\n    And pain for the Palladium there is borne.”\n“If they within those sparks possess the power\n    To speak,” I said, “thee, Master, much I pray,\n    And re-pray, that the prayer be worth a thousand,\nThat thou make no denial of awaiting\n    Until the horned flame shall hither come;\n    Thou seest that with desire I lean towards it.”\nAnd he to me: “Worthy is thy entreaty\n    Of much applause, and therefore I accept it;\n    But take heed that thy tongue restrain itself.","wordCount":188},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-26-5","eventId":"inferno-event-26-5","text":"Leave me to speak, because I have conceived\n    That which thou wishest; for they might disdain\n    Perchance, since they were Greeks, discourse of thine.”\nWhen now the flame had come unto that point,\n    Where to my Leader it seemed time and place,\n    After this fashion did I hear him speak:\n“O ye, who are twofold within one fire,\n    If I deserved of you, while I was living,\n    If I deserved of you or much or little\nWhen in the world I wrote the lofty verses,\n    Do not move on, but one of you declare\n    Whither, being lost, he went away to die.”","wordCount":102},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-26-6","eventId":"inferno-event-26-6","text":"Then of the antique flame the greater horn,\n    Murmuring, began to wave itself about\n    Even as a flame doth which the wind fatigues.\nThereafterward, the summit to and fro\n    Moving as if it were the tongue that spake,\n    It uttered forth a voice, and said: “When I\nFrom Circe had departed, who concealed me\n    More than a year there near unto Gaeta,\n    Or ever yet Aeneas named it so,\nNor fondness for my son, nor reverence\n    For my old father, nor the due affection\n    Which joyous should have made Penelope,\nCould overcome within me the desire\n    I had to be experienced of the world,\n    And of the vice and virtue of mankind;\nBut I put forth on the high open sea\n    With one sole ship, and that small company\n    By which I never had deserted been.\nBoth of the shores I saw as far as Spain,\n    Far as Morocco, and the isle of Sardes,\n    And the others which that sea bathes round about.\nI and my company were old and slow\n    When at that narrow passage we arrived\n    Where Hercules his landmarks set as signals,\nThat man no farther onward should adventure.\n    On the right hand behind me left I Seville,\n    And on the other already had left Ceuta.\n‘O brothers, who amid a hundred thousand\n    Perils,’ I said, ‘have come unto the West,\n    To this so inconsiderable vigil\nWhich is remaining of your senses still\n    Be ye unwilling to deny the knowledge,\n    Following the sun, of the unpeopled world.\nConsider ye the seed from which ye sprang;\n    Ye were not made to live like unto brutes,\n    But for pursuit of virtue and of knowledge.’","wordCount":275},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-26-7","eventId":"inferno-event-26-7","text":"So eager did I render my companions,\n    With this brief exhortation, for the voyage,\n    That then I hardly could have held them back.\nAnd having turned our stern unto the morning,\n    We of the oars made wings for our mad flight,\n    Evermore gaining on the larboard side.\nAlready all the stars of the other pole\n    The night beheld, and ours so very low\n    It did not rise above the ocean floor.\nFive times rekindled and as many quenched\n    Had been the splendour underneath the moon,\n    Since we had entered into the deep pass,\nWhen there appeared to us a mountain, dim\n    From distance, and it seemed to me so high\n    As I had never any one beheld.\nJoyful were we, and soon it turned to weeping;\n    For out of the new land a whirlwind rose,\n    And smote upon the fore part of the ship.\nThree times it made her whirl with all the waters,\n    At the fourth time it made the stern uplift,\n    And the prow downward go, as pleased Another,\nUntil the sea above us closed again.”","wordCount":178},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-27-1","eventId":"inferno-event-27-1","text":"Already was the flame erect and quiet,\n    To speak no more, and now departed from us\n    With the permission of the gentle Poet;\nWhen yet another, which behind it came,\n    Caused us to turn our eyes upon its top\n    By a confused sound that issued from it.\nAs the Sicilian bull (that bellowed first\n    With the lament of him, and that was right,\n    Who with his file had modulated it)\nBellowed so with the voice of the afflicted,\n    That, notwithstanding it was made of brass,\n    Still it appeared with agony transfixed;\nThus, by not having any way or issue\n    At first from out the fire, to its own language\n    Converted were the melancholy words.\nBut afterwards, when they had gathered way\n    Up through the point, giving it that vibration\n    The tongue had given them in their passage out,\nWe heard it said: “O thou, at whom I aim\n    My voice, and who but now wast speaking Lombard,\n    Saying, ‘Now go thy way, no more I urge thee,’\nBecause I come perchance a little late,\n    To stay and speak with me let it not irk thee;\n    Thou seest it irks not me, and I am burning.","wordCount":195},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-27-2","eventId":"inferno-event-27-2","text":"If thou but lately into this blind world\n    Hast fallen down from that sweet Latian land,\n    Wherefrom I bring the whole of my transgression,\nSay, if the Romagnuols have peace or war,\n    For I was from the mountains there between\n    Urbino and the yoke whence Tiber bursts.”\nI still was downward bent and listening,\n    When my Conductor touched me on the side,\n    Saying: “Speak thou: this one a Latian is.”\nAnd I, who had beforehand my reply\n    In readiness, forthwith began to speak:\n    “O soul, that down below there art concealed,","wordCount":91},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-27-3","eventId":"inferno-event-27-3","text":"Romagna thine is not and never has been\n    Without war in the bosom of its tyrants;\n    But open war I none have left there now.\nRavenna stands as it long years has stood;\n    The Eagle of Polenta there is brooding,\n    So that she covers Cervia with her vans.\nThe city which once made the long resistance,\n    And of the French a sanguinary heap,\n    Beneath the Green Paws finds itself again;\nVerrucchio’s ancient Mastiff and the new,\n    Who made such bad disposal of Montagna,\n    Where they are wont make wimbles of their teeth.\nThe cities of Lamone and Santerno\n    Governs the Lioncel of the white lair,\n    Who changes sides ’twixt summer-time and winter;\nAnd that of which the Savio bathes the flank,\n    Even as it lies between the plain and mountain,\n    Lives between tyranny and a free state.\nNow I entreat thee tell us who thou art;\n    Be not more stubborn than the rest have been,\n    So may thy name hold front there in the world.”\nAfter the fire a little more had roared\n    In its own fashion, the sharp point it moved\n    This way and that, and then gave forth such breath:","wordCount":193},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-27-4","eventId":"inferno-event-27-4","text":"“If I believed that my reply were made\n    To one who to the world would e’er return,\n    This flame without more flickering would stand still;\nBut inasmuch as never from this depth\n    Did any one return, if I hear true,\n    Without the fear of infamy I answer,\nI was a man of arms, then Cordelier,\n    Believing thus begirt to make amends;\n    And truly my belief had been fulfilled\nBut for the High Priest, whom may ill betide,\n    Who put me back into my former sins;\n    And how and wherefore I will have thee hear.","wordCount":94},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-27-5","eventId":"inferno-event-27-5","text":"While I was still the form of bone and pulp\n    My mother gave to me, the deeds I did\n    Were not those of a lion, but a fox.\nThe machinations and the covert ways\n    I knew them all, and practised so their craft,\n    That to the ends of earth the sound went forth.\nWhen now unto that portion of mine age\n    I saw myself arrived, when each one ought\n    To lower the sails, and coil away the ropes,\nThat which before had pleased me then displeased me;\n    And penitent and confessing I surrendered,\n    Ah woe is me! and it would have bestead me;","wordCount":103},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-27-6","eventId":"inferno-event-27-6","text":"The Leader of the modern Pharisees\n    Having a war near unto Lateran,\n    And not with Saracens nor with the Jews,\nFor each one of his enemies was Christian,\n    And none of them had been to conquer Acre,\n    Nor merchandising in the Sultan’s land,\nNor the high office, nor the sacred orders,\n    In him regarded, nor in me that cord\n    Which used to make those girt with it more meagre;\nBut even as Constantine sought out Sylvester\n    To cure his leprosy, within Soracte,\n    So this one sought me out as an adept\nTo cure him of the fever of his pride.\n    Counsel he asked of me, and I was silent,\n    Because his words appeared inebriate.\nAnd then he said: ‘Be not thy heart afraid;\n    Henceforth I thee absolve; and thou instruct me\n    How to raze Palestrina to the ground.\nHeaven have I power to lock and to unlock,\n    As thou dost know; therefore the keys are two,\n    The which my predecessor held not dear.’\nThen urged me on his weighty arguments\n    There, where my silence was the worst advice;\n    And said I: ‘Father, since thou washest me\nOf that sin into which I now must fall,\n    The promise long with the fulfilment short\n    Will make thee triumph in thy lofty seat.’\nFrancis came afterward, when I was dead,\n    For me; but one of the black Cherubim\n    Said to him: ‘Take him not; do me no wrong;\nHe must come down among my servitors,\n    Because he gave the fraudulent advice\n    From which time forth I have been at his hair;\nFor who repents not cannot be absolved,\n    Nor can one both repent and will at once,\n    Because of the contradiction which consents not.’","wordCount":281},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-27-7","eventId":"inferno-event-27-7","text":"O miserable me! how I did shudder\n    When he seized on me, saying: ‘Peradventure\n    Thou didst not think that I was a logician!’\nHe bore me unto Minos, who entwined\n    Eight times his tail about his stubborn back,\n    And after he had bitten it in great rage,\nSaid: ‘Of the thievish fire a culprit this;’\n    Wherefore, here where thou seest, am I lost,\n    And vested thus in going I bemoan me.”\nWhen it had thus completed its recital,\n    The flame departed uttering lamentations,\n    Writhing and flapping its sharp-pointed horn.","wordCount":90},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-27-8","eventId":"inferno-event-27-8","text":"Onward we passed, both I and my Conductor,\n    Up o’er the crag above another arch,\n    Which the moat covers, where is paid the fee\nBy those who, sowing discord, win their burden.","wordCount":32},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-28-1","eventId":"inferno-event-28-1","text":"Who ever could, e’en with untrammelled words,\n    Tell of the blood and of the wounds in full\n    Which now I saw, by many times narrating?\nEach tongue would for a certainty fall short\n    By reason of our speech and memory,\n    That have small room to comprehend so much.\nIf were again assembled all the people\n    Which formerly upon the fateful land\n    Of Puglia were lamenting for their blood\nShed by the Romans and the lingering war\n    That of the rings made such illustrious spoils,\n    As Livy has recorded, who errs not,\nWith those who felt the agony of blows\n    By making counterstand to Robert Guiscard,\n    And all the rest, whose bones are gathered still\nAt Ceperano, where a renegade\n    Was each Apulian, and at Tagliacozzo,\n    Where without arms the old Alardo conquered,\nAnd one his limb transpierced, and one lopped off,\n    Should show, it would be nothing to compare\n    With the disgusting mode of the ninth Bolgia.\nA cask by losing centre-piece or cant\n    Was never shattered so, as I saw one\n    Rent from the chin to where one breaketh wind.","wordCount":182},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-28-2","eventId":"inferno-event-28-2","text":"Between his legs were hanging down his entrails;\n    His heart was visible, and the dismal sack\n    That maketh excrement of what is eaten.\nWhile I was all absorbed in seeing him,\n    He looked at me, and opened with his hands\n    His bosom, saying: “See now how I rend me;\nHow mutilated, see, is Mahomet;\n    In front of me doth Ali weeping go,\n    Cleft in the face from forelock unto chin;\nAnd all the others whom thou here beholdest,\n    Disseminators of scandal and of schism\n    While living were, and therefore are cleft thus.","wordCount":92},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-28-3","eventId":"inferno-event-28-3","text":"A devil is behind here, who doth cleave us\n    Thus cruelly, unto the falchion’s edge\n    Putting again each one of all this ream,\nWhen we have gone around the doleful road;\n    By reason that our wounds are closed again\n    Ere any one in front of him repass.\nBut who art thou, that musest on the crag,\n    Perchance to postpone going to the pain\n    That is adjudged upon thine accusations?”\n“Nor death hath reached him yet, nor guilt doth bring him,”\n    My Master made reply, “to be tormented;\n    But to procure him full experience,\nMe, who am dead, behoves it to conduct him\n    Down here through Hell, from circle unto circle;\n    And this is true as that I speak to thee.”\nMore than a hundred were there when they heard him,\n    Who in the moat stood still to look at me,\n    Through wonderment oblivious of their torture.\n“Now say to Fra Dolcino, then, to arm him,\n    Thou, who perhaps wilt shortly see the sun,\n    If soon he wish not here to follow me,\nSo with provisions, that no stress of snow\n    May give the victory to the Novarese,\n    Which otherwise to gain would not be easy.”","wordCount":195},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-28-4","eventId":"inferno-event-28-4","text":"After one foot to go away he lifted,\n    This word did Mahomet say unto me,\n    Then to depart upon the ground he stretched it.\nAnother one, who had his throat pierced through,\n    And nose cut off close underneath the brows,\n    And had no longer but a single ear,\nStaying to look in wonder with the others,\n    Before the others did his gullet open,\n    Which outwardly was red in every part,\nAnd said: “O thou, whom guilt doth not condemn,\n    And whom I once saw up in Latian land,\n    Unless too great similitude deceive me,","wordCount":94},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-28-5","eventId":"inferno-event-28-5","text":"Call to remembrance Pier da Medicina,\n    If e’er thou see again the lovely plain\n    That from Vercelli slopes to Marcabo,\nAnd make it known to the best two of Fano,\n    To Messer Guido and Angiolello likewise,\n    That if foreseeing here be not in vain,\nCast over from their vessel shall they be,\n    And drowned near unto the Cattolica,\n    By the betrayal of a tyrant fell.\nBetween the isles of Cyprus and Majorca\n    Neptune ne’er yet beheld so great a crime,\n    Neither of pirates nor Argolic people.\nThat traitor, who sees only with one eye,\n    And holds the land, which some one here with me\n    Would fain be fasting from the vision of,\nWill make them come unto a parley with him;\n    Then will do so, that to Focara’s wind\n    They will not stand in need of vow or prayer.”","wordCount":139},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-28-6","eventId":"inferno-event-28-6","text":"And I to him: “Show to me and declare,\n    If thou wouldst have me bear up news of thee,\n    Who is this person of the bitter vision.”\nThen did he lay his hand upon the jaw\n    Of one of his companions, and his mouth\n    Oped, crying: “This is he, and he speaks not.\nThis one, being banished, every doubt submerged\n    In Caesar by affirming the forearmed\n    Always with detriment allowed delay.”\nO how bewildered unto me appeared,\n    With tongue asunder in his windpipe slit,\n    Curio, who in speaking was so bold!\nAnd one, who both his hands dissevered had,\n    The stumps uplifting through the murky air,\n    So that the blood made horrible his face,\nCried out: “Thou shalt remember Mosca also,\n    Who said, alas! ‘A thing done has an end!’\n    Which was an ill seed for the Tuscan people.”\n“And death unto thy race,” thereto I added;\n    Whence he, accumulating woe on woe,\n    Departed, like a person sad and crazed.\nBut I remained to look upon the crowd;\n    And saw a thing which I should be afraid,\n    Without some further proof, even to recount,\nIf it were not that conscience reassures me,\n    That good companion which emboldens man\n    Beneath the hauberk of its feeling pure.\nI truly saw, and still I seem to see it,\n    A trunk without a head walk in like manner\n    As walked the others of the mournful herd.","wordCount":232},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-28-7","eventId":"inferno-event-28-7","text":"And by the hair it held the head dissevered,\n    Hung from the hand in fashion of a lantern,\n    And that upon us gazed and said: “O me!”\nIt of itself made to itself a lamp,\n    And they were two in one, and one in two;\n    How that can be, He knows who so ordains it.\nWhen it was come close to the bridge’s foot,\n    It lifted high its arm with all the head,\n    To bring more closely unto us its words,\nWhich were: “Behold now the sore penalty,\n    Thou, who dost breathing go the dead beholding;\n    Behold if any be as great as this.\nAnd so that thou may carry news of me,\n    Know that Bertram de Born am I, the same\n    Who gave to the Young King the evil comfort.\nI made the father and the son rebellious;\n    Achitophel not more with Absalom\n    And David did with his accursed goadings.\nBecause I parted persons so united,\n    Parted do I now bear my brain, alas!\n    From its beginning, which is in this trunk.\nThus is observed in me the counterpoise.”","wordCount":180},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-29-1","eventId":"inferno-event-29-1","text":"The many people and the divers wounds\n    These eyes of mine had so inebriated,\n    That they were wishful to stand still and weep;\nBut said Virgilius: “What dost thou still gaze at?\n    Why is thy sight still riveted down there\n    Among the mournful, mutilated shades?\nThou hast not done so at the other Bolge;\n    Consider, if to count them thou believest,\n    That two-and-twenty miles the valley winds,\nAnd now the moon is underneath our feet;\n    Henceforth the time allotted us is brief,\n    And more is to be seen than what thou seest.”","wordCount":94},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-29-2","eventId":"inferno-event-29-2","text":"“If thou hadst,” I made answer thereupon,\n    “Attended to the cause for which I looked,\n    Perhaps a longer stay thou wouldst have pardoned.”\nMeanwhile my Guide departed, and behind him\n    I went, already making my reply,\n    And superadding: “In that cavern where\nI held mine eyes with such attention fixed,\n    I think a spirit of my blood laments\n    The sin which down below there costs so much.”\nThen said the Master: “Be no longer broken\n    Thy thought from this time forward upon him;\n    Attend elsewhere, and there let him remain;\nFor him I saw below the little bridge,\n    Pointing at thee, and threatening with his finger\n    Fiercely, and heard him called Geri del Bello.\nSo wholly at that time wast thou impeded\n    By him who formerly held Altaforte,\n    Thou didst not look that way; so he departed.”\n“O my Conductor, his own violent death,\n    Which is not yet avenged for him,” I said,\n    “By any who is sharer in the shame,\nMade him disdainful; whence he went away,\n    As I imagine, without speaking to me,\n    And thereby made me pity him the more.”","wordCount":183},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-29-3","eventId":"inferno-event-29-3","text":"Thus did we speak as far as the first place\n    Upon the crag, which the next valley shows\n    Down to the bottom, if there were more light.\nWhen we were now right over the last cloister\n    Of Malebolge, so that its lay-brothers\n    Could manifest themselves unto our sight,\nDivers lamentings pierced me through and through,\n    Which with compassion had their arrows barbed,\n    Whereat mine ears I covered with my hands.\nWhat pain would be, if from the hospitals\n    Of Valdichiana, ’twixt July and September,\n    And of Maremma and Sardinia","wordCount":90},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-29-4","eventId":"inferno-event-29-4","text":"All the diseases in one moat were gathered,\n    Such was it here, and such a stench came from it\n    As from putrescent limbs is wont to issue.\nWe had descended on the furthest bank\n    From the long crag, upon the left hand still,\n    And then more vivid was my power of sight\nDown tow’rds the bottom, where the ministress\n    Of the high Lord, Justice infallible,\n    Punishes forgers, which she here records.\nI do not think a sadder sight to see\n    Was in Aegina the whole people sick,\n    (When was the air so full of pestilence,\nThe animals, down to the little worm,\n    All fell, and afterwards the ancient people,\n    According as the poets have affirmed,\nWere from the seed of ants restored again,)\n    Than was it to behold through that dark valley\n    The spirits languishing in divers heaps.\nThis on the belly, that upon the back\n    One of the other lay, and others crawling\n    Shifted themselves along the dismal road.\nWe step by step went onward without speech,\n    Gazing upon and listening to the sick\n    Who had not strength enough to lift their bodies.","wordCount":184},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-29-5","eventId":"inferno-event-29-5","text":"I saw two sitting leaned against each other,\n    As leans in heating platter against platter,\n    From head to foot bespotted o’er with scabs;\nAnd never saw I plied a currycomb\n    By stable-boy for whom his master waits,\n    Or him who keeps awake unwillingly,\nAs every one was plying fast the bite\n    Of nails upon himself, for the great rage\n    Of itching which no other succour had.\nAnd the nails downward with them dragged the scab,\n    In fashion as a knife the scales of bream,\n    Or any other fish that has them largest.\n“O thou, that with thy fingers dost dismail thee,”\n    Began my Leader unto one of them,\n    “And makest of them pincers now and then,\nTell me if any Latian is with those\n    Who are herein; so may thy nails suffice thee\n    To all eternity unto this work.”\n“Latians are we, whom thou so wasted seest,\n    Both of us here,” one weeping made reply;\n    “But who art thou, that questionest about us?”\nAnd said the Guide: “One am I who descends\n    Down with this living man from cliff to cliff,\n    And I intend to show Hell unto him.”\nThen broken was their mutual support,\n    And trembling each one turned himself to me,\n    With others who had heard him by rebound.\nWholly to me did the good Master gather,\n    Saying: “Say unto them whate’er thou wishest.”\n    And I began, since he would have it so:\n“So may your memory not steal away\n    In the first world from out the minds of men,\n    But so may it survive ’neath many suns,\nSay to me who ye are, and of what people;\n    Let not your foul and loathsome punishment\n    Make you afraid to show yourselves to me.”","wordCount":286},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-29-6","eventId":"inferno-event-29-6","text":"“I of Arezzo was,” one made reply,\n    “And Albert of Siena had me burned;\n    But what I died for does not bring me here.\n’Tis true I said to him, speaking in jest,\n    That I could rise by flight into the air,\n    And he who had conceit, but little wit,\nWould have me show to him the art; and only\n    Because no Daedalus I made him, made me\n    Be burned by one who held him as his son.\nBut unto the last Bolgia of the ten,\n    For alchemy, which in the world I practised,\n    Minos, who cannot err, has me condemned.”\nAnd to the Poet said I: “Now was ever\n    So vain a people as the Sienese?\n    Not for a certainty the French by far.”\nWhereat the other leper, who had heard me,\n    Replied unto my speech: “Taking out Stricca,\n    Who knew the art of moderate expenses,\nAnd Niccolo, who the luxurious use\n    Of cloves discovered earliest of all\n    Within that garden where such seed takes root;\nAnd taking out the band, among whom squandered\n    Caccia d’Ascian his vineyards and vast woods,\n    And where his wit the Abbagliato proffered!\nBut, that thou know who thus doth second thee\n    Against the Sienese, make sharp thine eye\n    Tow’rds me, so that my face well answer thee,\nAnd thou shalt see I am Capocchio’s shade,\n    Who metals falsified by alchemy;\n    Thou must remember, if I well descry thee,\nHow I a skilful ape of nature was.”","wordCount":243},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-30-1","eventId":"inferno-event-30-1","text":"’Twas at the time when Juno was enraged,\n    For Semele, against the Theban blood,\n    As she already more than once had shown,\nSo reft of reason Athamas became,\n    That, seeing his own wife with children twain\n    Walking encumbered upon either hand,\nHe cried: “Spread out the nets, that I may take\n    The lioness and her whelps upon the passage;”\n    And then extended his unpitying claws,\nSeizing the first, who had the name Learchus,\n    And whirled him round, and dashed him on a rock;\n    And she, with the other burthen, drowned herself;—\nAnd at the time when fortune downward hurled\n    The Trojan’s arrogance, that all things dared,\n    So that the king was with his kingdom crushed,\nHecuba sad, disconsolate, and captive,\n    When lifeless she beheld Polyxena,\n    And of her Polydorus on the shore\nOf ocean was the dolorous one aware,\n    Out of her senses like a dog she barked,\n    So much the anguish had her mind distorted;\nBut not of Thebes the furies nor the Trojan\n    Were ever seen in any one so cruel\n    In goading beasts, and much more human members,","wordCount":181},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-30-2","eventId":"inferno-event-30-2","text":"As I beheld two shadows pale and naked,\n    Who, biting, in the manner ran along\n    That a boar does, when from the sty turned loose.\nOne to Capocchio came, and by the nape\n    Seized with its teeth his neck, so that in dragging\n    It made his belly grate the solid bottom.\nAnd the Aretine, who trembling had remained,\n    Said to me: “That mad sprite is Gianni Schicchi,\n    And raving goes thus harrying other people.”\n“O,” said I to him, “so may not the other\n    Set teeth on thee, let it not weary thee\n    To tell us who it is, ere it dart hence.”","wordCount":103},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-30-3","eventId":"inferno-event-30-3","text":"And he to me: “That is the ancient ghost\n    Of the nefarious Myrrha, who became\n    Beyond all rightful love her father’s lover.\nShe came to sin with him after this manner,\n    By counterfeiting of another’s form;\n    As he who goeth yonder undertook,\nThat he might gain the lady of the herd,\n    To counterfeit in himself Buoso Donati,\n    Making a will and giving it due form.”\nAnd after the two maniacs had passed\n    On whom I held mine eye, I turned it back\n    To look upon the other evil-born.","wordCount":89},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-30-4","eventId":"inferno-event-30-4","text":"I saw one made in fashion of a lute,\n    If he had only had the groin cut off\n    Just at the point at which a man is forked.\nThe heavy dropsy, that so disproportions\n    The limbs with humours, which it ill concocts,\n    That the face corresponds not to the belly,\nCompelled him so to hold his lips apart\n    As does the hectic, who because of thirst\n    One tow’rds the chin, the other upward turns.\n“O ye, who without any torment are,\n    And why I know not, in the world of woe,”\n    He said to us, “behold, and be attentive\nUnto the misery of Master Adam;\n    I had while living much of what I wished,\n    And now, alas! a drop of water crave.\nThe rivulets, that from the verdant hills\n    Of Cassentin descend down into Arno,\n    Making their channels to be cold and moist,\nEver before me stand, and not in vain;\n    For far more doth their image dry me up\n    Than the disease which strips my face of flesh.\nThe rigid justice that chastises me\n    Draweth occasion from the place in which\n    I sinned, to put the more my sighs in flight.\nThere is Romena, where I counterfeited\n    The currency imprinted with the Baptist,\n    For which I left my body burned above.\nBut if I here could see the tristful soul\n    Of Guido, or Alessandro, or their brother,\n    For Branda’s fount I would not give the sight.\nOne is within already, if the raving\n    Shades that are going round about speak truth;\n    But what avails it me, whose limbs are tied?\nIf I were only still so light, that in\n    A hundred years I could advance one inch,\n    I had already started on the way,\nSeeking him out among this squalid folk,\n    Although the circuit be eleven miles,\n    And be not less than half a mile across.\nFor them am I in such a family;\n    They did induce me into coining florins,\n    Which had three carats of impurity.”","wordCount":328},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-30-5","eventId":"inferno-event-30-5","text":"And I to him: “Who are the two poor wretches\n    That smoke like unto a wet hand in winter,\n    Lying there close upon thy right-hand confines?”\n“I found them here,” replied he, “when I rained\n    Into this chasm, and since they have not turned,\n    Nor do I think they will for evermore.\nOne the false woman is who accused Joseph,\n    The other the false Sinon, Greek of Troy;\n    From acute fever they send forth such reek.”\nAnd one of them, who felt himself annoyed\n    At being, peradventure, named so darkly,\n    Smote with the fist upon his hardened paunch.\nIt gave a sound, as if it were a drum;\n    And Master Adam smote him in the face,\n    With arm that did not seem to be less hard,\nSaying to him: “Although be taken from me\n    All motion, for my limbs that heavy are,\n    I have an arm unfettered for such need.”","wordCount":151},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-30-6","eventId":"inferno-event-30-6","text":"Whereat he answer made: “When thou didst go\n    Unto the fire, thou hadst it not so ready:\n    But hadst it so and more when thou wast coining.”\nThe dropsical: “Thou sayest true in that;\n    But thou wast not so true a witness there,\n    Where thou wast questioned of the truth at Troy.”\n“If I spake false, thou falsifiedst the coin,”\n    Said Sinon; “and for one fault I am here,\n    And thou for more than any other demon.”\n“Remember, perjurer, about the horse,”\n    He made reply who had the swollen belly,\n    “And rueful be it thee the whole world knows it.”\n“Rueful to thee the thirst be wherewith cracks\n    Thy tongue,” the Greek said, “and the putrid water\n    That hedges so thy paunch before thine eyes.”\nThen the false-coiner: “So is gaping wide\n    Thy mouth for speaking evil, as ’tis wont;\n    Because if I have thirst, and humour stuff me\nThou hast the burning and the head that aches,\n    And to lick up the mirror of Narcissus\n    Thou wouldst not want words many to invite thee.”\nIn listening to them was I wholly fixed,\n    When said the Master to me: “Now just look,\n    For little wants it that I quarrel with thee.”","wordCount":202},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-30-7","eventId":"inferno-event-30-7","text":"When him I heard in anger speak to me,\n    I turned me round towards him with such shame\n    That still it eddies through my memory.\nAnd as he is who dreams of his own harm,\n    Who dreaming wishes it may be a dream,\n    So that he craves what is, as if it were not;\nSuch I became, not having power to speak,\n    For to excuse myself I wished, and still\n    Excused myself, and did not think I did it.\n“Less shame doth wash away a greater fault,”\n    The Master said, “than this of thine has been;\n    Therefore thyself disburden of all sadness,\nAnd make account that I am aye beside thee,\n    If e’er it come to pass that fortune bring thee\n    Where there are people in a like dispute;\nFor a base wish it is to wish to hear it.”","wordCount":140},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-31-1","eventId":"inferno-event-31-1","text":"One and the selfsame tongue first wounded me,\n    So that it tinged the one cheek and the other,\n    And then held out to me the medicine;\nThus do I hear that once Achilles’ spear,\n    His and his father’s, used to be the cause\n    First of a sad and then a gracious boon.\nWe turned our backs upon the wretched valley,\n    Upon the bank that girds it round about,\n    Going across it without any speech.\nThere it was less than night, and less than day,\n    So that my sight went little in advance;\n    But I could hear the blare of a loud horn,\nSo loud it would have made each thunder faint,\n    Which, counter to it following its way,\n    Mine eyes directed wholly to one place.\nAfter the dolorous discomfiture\n    When Charlemagne the holy emprise lost,\n    So terribly Orlando sounded not.\nShort while my head turned thitherward I held\n    When many lofty towers I seemed to see,\n    Whereat I: “Master, say, what town is this?”\nAnd he to me: “Because thou peerest forth\n    Athwart the darkness at too great a distance,\n    It happens that thou errest in thy fancy.","wordCount":188},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-31-2","eventId":"inferno-event-31-2","text":"Well shalt thou see, if thou arrivest there,\n    How much the sense deceives itself by distance;\n    Therefore a little faster spur thee on.”\nThen tenderly he took me by the hand,\n    And said: “Before we farther have advanced,\n    That the reality may seem to thee\nLess strange, know that these are not towers, but giants,\n    And they are in the well, around the bank,\n    From navel downward, one and all of them.”\nAs, when the fog is vanishing away,\n    Little by little doth the sight refigure\n    Whate’er the mist that crowds the air conceals,","wordCount":94},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-31-3","eventId":"inferno-event-31-3","text":"So, piercing through the dense and darksome air,\n    More and more near approaching tow’rd the verge,\n    My error fled, and fear came over me;\nBecause as on its circular parapets\n    Montereggione crowns itself with towers,\n    E’en thus the margin which surrounds the well\nWith one half of their bodies turreted\n    The horrible giants, whom Jove menaces\n    E’en now from out the heavens when he thunders.\nAnd I of one already saw the face,\n    Shoulders, and breast, and great part of the belly,\n    And down along his sides both of the arms.\nCertainly Nature, when she left the making\n    Of animals like these, did well indeed,\n    By taking such executors from Mars;\nAnd if of elephants and whales she doth not\n    Repent her, whosoever looketh subtly\n    More just and more discreet will hold her for it;\nFor where the argument of intellect\n    Is added unto evil will and power,\n    No rampart can the people make against it.\nHis face appeared to me as long and large\n    As is at Rome the pine-cone of Saint Peter’s,\n    And in proportion were the other bones;","wordCount":182},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-31-4","eventId":"inferno-event-31-4","text":"So that the margin, which an apron was\n    Down from the middle, showed so much of him\n    Above it, that to reach up to his hair\nThree Frieslanders in vain had vaunted them;\n    For I beheld thirty great palms of him\n    Down from the place where man his mantle buckles.\n“Raphael mai amech izabi almi,”\n    Began to clamour the ferocious mouth,\n    To which were not befitting sweeter psalms.\nAnd unto him my Guide: “Soul idiotic,\n    Keep to thy horn, and vent thyself with that,\n    When wrath or other passion touches thee.\nSearch round thy neck, and thou wilt find the belt\n    Which keeps it fastened, O bewildered soul,\n    And see it, where it bars thy mighty breast.”\nThen said to me: “He doth himself accuse;\n    This one is Nimrod, by whose evil thought\n    One language in the world is not still used.\nHere let us leave him and not speak in vain;\n    For even such to him is every language\n    As his to others, which to none is known.”\nTherefore a longer journey did we make,\n    Turned to the left, and a crossbow-shot oft\n    We found another far more fierce and large.","wordCount":193},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-31-5","eventId":"inferno-event-31-5","text":"In binding him, who might the master be\n    I cannot say; but he had pinioned close\n    Behind the right arm, and in front the other,\nWith chains, that held him so begirt about\n    From the neck down, that on the part uncovered\n    It wound itself as far as the fifth gyre.\n“This proud one wished to make experiment\n    Of his own power against the Supreme Jove,”\n    My Leader said, “whence he has such a guerdon.\nEphialtes is his name; he showed great prowess.\n    What time the giants terrified the gods;\n    The arms he wielded never more he moves.”\nAnd I to him: “If possible, I should wish\n    That of the measureless Briareus\n    These eyes of mine might have experience.”\nWhence he replied: “Thou shalt behold Antaeus\n    Close by here, who can speak and is unbound,\n    Who at the bottom of all crime shall place us.\nMuch farther yon is he whom thou wouldst see,\n    And he is bound, and fashioned like to this one,\n    Save that he seems in aspect more ferocious.”\nThere never was an earthquake of such might\n    That it could shake a tower so violently,\n    As Ephialtes suddenly shook himself.","wordCount":193},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-31-6","eventId":"inferno-event-31-6","text":"Then was I more afraid of death than ever,\n    For nothing more was needful than the fear,\n    If I had not beheld the manacles.\nThen we proceeded farther in advance,\n    And to Antaeus came, who, full five ells\n    Without the head, forth issued from the cavern.\n“O thou, who in the valley fortunate,\n    Which Scipio the heir of glory made,\n    When Hannibal turned back with all his hosts,\nOnce brought’st a thousand lions for thy prey,\n    And who, hadst thou been at the mighty war\n    Among thy brothers, some it seems still think\nThe sons of Earth the victory would have gained:\n    Place us below, nor be disdainful of it,\n    There where the cold doth lock Cocytus up.\nMake us not go to Tityus nor Typhoeus;\n    This one can give of that which here is longed for;\n    Therefore stoop down, and do not curl thy lip.\nStill in the world can he restore thy fame;\n    Because he lives, and still expects long life,\n    If to itself Grace call him not untimely.”\nSo said the Master; and in haste the other\n    His hands extended and took up my Guide,—\n    Hands whose great pressure Hercules once felt.","wordCount":195},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-31-7","eventId":"inferno-event-31-7","text":"Virgilius, when he felt himself embraced,\n    Said unto me: “Draw nigh, that I may take thee;”\n    Then of himself and me one bundle made.\nAs seems the Carisenda, to behold\n    Beneath the leaning side, when goes a cloud\n    Above it so that opposite it hangs;\nSuch did Antaeus seem to me, who stood\n    Watching to see him stoop, and then it was\n    I could have wished to go some other way.\nBut lightly in the abyss, which swallows up\n    Judas with Lucifer, he put us down;\n    Nor thus bowed downward made he there delay,\nBut, as a mast does in a ship, uprose.","wordCount":103},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-32-1","eventId":"inferno-event-32-1","text":"If I had rhymes both rough and stridulous,\n    As were appropriate to the dismal hole\n    Down upon which thrust all the other rocks,\nI would press out the juice of my conception\n    More fully; but because I have them not,\n    Not without fear I bring myself to speak;\nFor ’tis no enterprise to take in jest,\n    To sketch the bottom of all the universe,\n    Nor for a tongue that cries Mamma and Babbo.\nBut may those Ladies help this verse of mine,\n    Who helped Amphion in enclosing Thebes,\n    That from the fact the word be not diverse.\nO rabble ill-begotten above all,\n    Who’re in the place to speak of which is hard,\n    ’Twere better ye had here been sheep or goats!\nWhen we were down within the darksome well,\n    Beneath the giant’s feet, but lower far,\n    And I was scanning still the lofty wall,\nI heard it said to me: “Look how thou steppest!\n    Take heed thou do not trample with thy feet\n    The heads of the tired, miserable brothers!”\nWhereat I turned me round, and saw before me\n    And underfoot a lake, that from the frost\n    The semblance had of glass, and not of water.","wordCount":197},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-32-2","eventId":"inferno-event-32-2","text":"So thick a veil ne’er made upon its current\n    In winter-time Danube in Austria,\n    Nor there beneath the frigid sky the Don,\nAs there was here; so that if Tambernich\n    Had fallen upon it, or Pietrapana,\n    E’en at the edge ’twould not have given a creak.\nAnd as to croak the frog doth place himself\n    With muzzle out of water,—when is dreaming\n    Of gleaning oftentimes the peasant-girl,—\nLivid, as far down as where shame appears,\n    Were the disconsolate shades within the ice,\n    Setting their teeth unto the note of storks.","wordCount":93},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-32-3","eventId":"inferno-event-32-3","text":"Each one his countenance held downward bent;\n    From mouth the cold, from eyes the doleful heart\n    Among them witness of itself procures.\nWhen round about me somewhat I had looked,\n    I downward turned me, and saw two so close,\n    The hair upon their heads together mingled.\n“Ye who so strain your breasts together, tell me,”\n    I said, “who are you;” and they bent their necks,\n    And when to me their faces they had lifted,\nTheir eyes, which first were only moist within,\n    Gushed o’er the eyelids, and the frost congealed\n    The tears between, and locked them up again.\nClamp never bound together wood with wood\n    So strongly; whereat they, like two he-goats,\n    Butted together, so much wrath o’ercame them.\nAnd one, who had by reason of the cold\n    Lost both his ears, still with his visage downward,\n    Said: “Why dost thou so mirror thyself in us?\nIf thou desire to know who these two are,\n    The valley whence Bisenzio descends\n    Belonged to them and to their father Albert.\nThey from one body came, and all Caina\n    Thou shalt search through, and shalt not find a shade\n    More worthy to be fixed in gelatine;\nNot he in whom were broken breast and shadow\n    At one and the same blow by Arthur’s hand;\n    Focaccia not; not he who me encumbers\nSo with his head I see no farther forward,\n    And bore the name of Sassol Mascheroni;\n    Well knowest thou who he was, if thou art Tuscan.\nAnd that thou put me not to further speech,\n    Know that I Camicion de’ Pazzi was,\n    And wait Carlino to exonerate me.”\nThen I beheld a thousand faces, made\n    Purple with cold; whence o’er me comes a shudder,\n    And evermore will come, at frozen ponds.","wordCount":290},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-32-4","eventId":"inferno-event-32-4","text":"And while we were advancing tow’rds the middle,\n    Where everything of weight unites together,\n    And I was shivering in the eternal shade,\nWhether ’twere will, or destiny, or chance,\n    I know not; but in walking ’mong the heads\n    I struck my foot hard in the face of one.\nWeeping he growled: “Why dost thou trample me?\n    Unless thou comest to increase the vengeance\n    of Montaperti, why dost thou molest me?”\nAnd I: “My Master, now wait here for me,\n    That I through him may issue from a doubt;\n    Then thou mayst hurry me, as thou shalt wish.”","wordCount":97},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-32-5","eventId":"inferno-event-32-5","text":"The Leader stopped; and to that one I said\n    Who was blaspheming vehemently still:\n    “Who art thou, that thus reprehendest others?”\n“Now who art thou, that goest through Antenora\n    Smiting,” replied he, “other people’s cheeks,\n    So that, if thou wert living, ’twere too much?”\n“Living I am, and dear to thee it may be,”\n    Was my response, “if thou demandest fame,\n    That ’mid the other notes thy name I place.”\nAnd he to me: “For the reverse I long;\n    Take thyself hence, and give me no more trouble;\n    For ill thou knowest to flatter in this hollow.”","wordCount":97},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-32-6","eventId":"inferno-event-32-6","text":"Then by the scalp behind I seized upon him,\n    And said: “It must needs be thou name thyself,\n    Or not a hair remain upon thee here.”\nWhence he to me: “Though thou strip off my hair,\n    I will not tell thee who I am, nor show thee,\n    If on my head a thousand times thou fall.”\nI had his hair in hand already twisted,\n    And more than one shock of it had pulled out,\n    He barking, with his eyes held firmly down,\nWhen cried another: “What doth ail thee, Bocca?\n    Is’t not enough to clatter with thy jaws,\n    But thou must bark? what devil touches thee?”\n“Now,” said I, “I care not to have thee speak,\n    Accursed traitor; for unto thy shame\n    I will report of thee veracious news.”\n“Begone,” replied he, “and tell what thou wilt,\n    But be not silent, if thou issue hence,\n    Of him who had just now his tongue so prompt;\nHe weepeth here the silver of the French;\n    ‘I saw,’ thus canst thou phrase it, ‘him of Duera\n    There where the sinners stand out in the cold.’\nIf thou shouldst questioned be who else was there,\n    Thou hast beside thee him of Beccaria,\n    Of whom the gorget Florence slit asunder;","wordCount":205},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-32-7","eventId":"inferno-event-32-7","text":"Gianni del Soldanier, I think, may be\n    Yonder with Ganellon, and Tebaldello\n    Who oped Faenza when the people slep.”\nAlready we had gone away from him,\n    When I beheld two frozen in one hole,\n    So that one head a hood was to the other;\nAnd even as bread through hunger is devoured,\n    The uppermost on the other set his teeth,\n    There where the brain is to the nape united.\nNot in another fashion Tydeus gnawed\n    The temples of Menalippus in disdain,\n    Than that one did the skull and the other things.\n“O thou, who showest by such bestial sign\n    Thy hatred against him whom thou art eating,\n    Tell me the wherefore,” said I, “with this compact,\nThat if thou rightfully of him complain,\n    In knowing who ye are, and his transgression,\n    I in the world above repay thee for it,\nIf that wherewith I speak be not dried up.”","wordCount":149},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-1","eventId":"inferno-event-33-1","text":"His mouth uplifted from his grim repast,\n    That sinner, wiping it upon the hair\n    Of the same head that he behind had wasted.\nThen he began: “Thou wilt that I renew\n    The desperate grief, which wrings my heart already\n    To think of only, ere I speak of it;\nBut if my words be seed that may bear fruit\n    Of infamy to the traitor whom I gnaw,\n    Speaking and weeping shalt thou see together.\nI know not who thou art, nor by what mode\n    Thou hast come down here; but a Florentine\n    Thou seemest to me truly, when I hear thee.","wordCount":100},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-2","eventId":"inferno-event-33-2","text":"Thou hast to know I was Count Ugolino,\n    And this one was Ruggieri the Archbishop;\n    Now I will tell thee why I am such a neighbour.\nThat, by effect of his malicious thoughts,\n    Trusting in him I was made prisoner,\n    And after put to death, I need not say;\n But ne’ertheless what thou canst not have heard,\n    That is to say, how cruel was my death,\n    Hear shalt thou, and shalt know if he has wronged me.\nA narrow perforation in the mew,\n    Which bears because of me the title of Famine,\n    And in which others still must be locked up,","wordCount":101},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-3","eventId":"inferno-event-33-3","text":"Had shown me through its opening many moons\n    Already, when I dreamed the evil dream\n    Which of the future rent for me the veil.\nThis one appeared to me as lord and master,\n    Hunting the wolf and whelps upon the mountain\n    For which the Pisans cannot Lucca see.\nWith sleuth-hounds gaunt, and eager, and well trained,\n    Gualandi with Sismondi and Lanfianchi\n    He had sent out before him to the front.\nAfter brief course seemed unto me forespent\n    The father and the sons, and with sharp tushes\n    It seemed to me I saw their flanks ripped open.","wordCount":97},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-4","eventId":"inferno-event-33-4","text":"When I before the morrow was awake,\n    Moaning amid their sleep I heard my sons\n    Who with me were, and asking after bread.\nCruel indeed art thou, if yet thou grieve not,\n    Thinking of what my heart foreboded me,\n    And weep’st thou not, what art thou wont to weep at?\nThey were awake now, and the hour drew nigh\n    At which our food used to be brought to us,\n    And through his dream was each one apprehensive;\nAnd I heard locking up the under door\n    Of the horrible tower; whereat without a word\n    I gazed into the faces of my sons.","wordCount":101},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-5","eventId":"inferno-event-33-5","text":"I wept not, I within so turned to stone;\n    They wept; and darling little Anselm mine\n    Said: ‘Thou dost gaze so, father, what doth ail thee?’\nStill not a tear I shed, nor answer made\n    All of that day, nor yet the night thereafter,\n    Until another sun rose on the world.\nAs now a little glimmer made its way\n    Into the dolorous prison, and I saw\n    Upon four faces my own very aspect,\nBoth of my hands in agony I bit;\n    And, thinking that I did it from desire\n    Of eating, on a sudden they uprose,\nAnd said they: ‘Father, much less pain ’twill give us\n    If thou do eat of us; thyself didst clothe us\n    With this poor flesh, and do thou strip it off.’\nI calmed me then, not to make them more sad.\n    That day we all were silent, and the next.\n    Ah! obdurate earth, wherefore didst thou not open?\nWhen we had come unto the fourth day, Gaddo\n    Threw himself down outstretched before my feet,\n    Saying, ‘My father, why dost thou not help me?’\nAnd there he died; and, as thou seest me,\n    I saw the three fall, one by one, between\n    The fifth day and the sixth; whence I betook me,","wordCount":206},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-6","eventId":"inferno-event-33-6","text":"Already blind, to groping over each,\n    And three days called them after they were dead;\n    Then hunger did what sorrow could not do.”\nWhen he had said this, with his eyes distorted,\n    The wretched skull resumed he with his teeth,\n    Which, as a dog’s, upon the bone were strong.\nAh! Pisa, thou opprobrium of the people\n    Of the fair land there where the ‘Si’ doth sound,\n    Since slow to punish thee thy neighbours are,\nLet the Capraia and Gorgona move,\n    And make a hedge across the mouth of Arno\n    That every person in thee it may drown!","wordCount":97},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-7","eventId":"inferno-event-33-7","text":"For if Count Ugolino had the fame\n    Of having in thy castles thee betrayed,\n    Thou shouldst not on such cross have put his sons.\nGuiltless of any crime, thou modern Thebes!\n    Their youth made Uguccione and Brigata,\n    And the other two my song doth name above!","wordCount":46},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-8","eventId":"inferno-event-33-8","text":"We passed still farther onward, where the ice\n    Another people ruggedly enswathes,\n    Not downward turned, but all of them reversed.\nWeeping itself there does not let them weep,\n    And grief that finds a barrier in the eyes\n    Turns itself inward to increase the anguish;\nBecause the earliest tears a cluster form,\n    And, in the manner of a crystal visor,\n    Fill all the cup beneath the eyebrow full.\nAnd notwithstanding that, as in a callus,\n    Because of cold all sensibility\n    Its station had abandoned in my face,\nStill it appeared to me I felt some wind;\n    Whence I: “My Master, who sets this in motion?\n    Is not below here every vapour quenched?”\nWhence he to me: “Full soon shalt thou be where\n    Thine eye shall answer make to thee of this,\n    Seeing the cause which raineth down the blast.”","wordCount":138},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-33-9","eventId":"inferno-event-33-9","text":"And one of the wretches of the frozen crust\n    Cried out to us: “O souls so merciless\n    That the last post is given unto you,\nLift from mine eyes the rigid veils, that I\n    May vent the sorrow which impregns my heart\n    A little, e’er the weeping recongeal.”\nWhence I to him: “If thou wouldst have me help thee\n    Say who thou wast; and if I free thee not,\n    May I go to the bottom of the ice.”\nThen he replied: “I am Friar Alberigo;\n    He am I of the fruit of the bad garden,\n    Who here a date am getting for my fig.”\n“O,” said I to him, “now art thou, too, dead?”\n    And he to me: “How may my body fare\n    Up in the world, no knowledge I possess.\nSuch an advantage has this Ptolomaea,\n    That oftentimes the soul descendeth here\n    Sooner than Atropos in motion sets it.\nAnd, that thou mayest more willingly remove\n    From off my countenance these glassy tears,\n    Know that as soon as any soul betrays\nAs I have done, his body by a demon\n    Is taken from him, who thereafter rules it,\n    Until his time has wholly been revolved.\nItself down rushes into such a cistern;\n    And still perchance above appears the body\n    Of yonder shade, that winters here behind me.\nThis thou shouldst know, if thou hast just come down;\n    It is Ser Branca d’ Oria, and many years\n    Have passed away since he was thus locked up.”\n“I think,” said I to him, “thou dost deceive me;\n    For Branca d’ Oria is not dead as yet,\n    And eats, and drinks, and sleeps, and puts on clothes.”\n“In moat above,” said he, “of Malebranche,\n    There where is boiling the tenacious pitch,\n    As yet had Michel Zanche not arrived,\nWhen this one left a devil in his stead\n    In his own body and one near of kin,\n    Who made together with him the betrayal.\nBut hitherward stretch out thy hand forthwith,\n    Open mine eyes;”—and open them I did not,\n    And to be rude to him was courtesy.\nAh, Genoese! ye men at variance\n    With every virtue, full of every vice\n    Wherefore are ye not scattered from the world?\nFor with the vilest spirit of Romagna\n    I found of you one such, who for his deeds\n    In soul already in Cocytus bathes,\nAnd still above in body seems alive!","wordCount":396},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-34-1","eventId":"inferno-event-34-1","text":"“‘Vexilla Regis prodeunt Inferni’\n    Towards us; therefore look in front of thee,”\n    My Master said, “if thou discernest him.”\nAs, when there breathes a heavy fog, or when\n    Our hemisphere is darkening into night,\n    Appears far off a mill the wind is turning,\nMethought that such a building then I saw;\n    And, for the wind, I drew myself behind\n    My Guide, because there was no other shelter.\nNow was I, and with fear in verse I put it,\n    There where the shades were wholly covered up,\n    And glimmered through like unto straws in glass.\nSome prone are lying, others stand erect,\n    This with the head, and that one with the soles;\n    Another, bow-like, face to feet inverts.\nWhen in advance so far we had proceeded,\n    That it my Master pleased to show to me\n    The creature who once had the beauteous semblance,\nHe from before me moved and made me stop,\n    Saying: “Behold Dis, and behold the place\n    Where thou with fortitude must arm thyself.”\nHow frozen I became and powerless then,\n    Ask it not, Reader, for I write it not,\n    Because all language would be insufficient.","wordCount":188},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-34-2","eventId":"inferno-event-34-2","text":"I did not die, and I alive remained not;\n    Think for thyself now, hast thou aught of wit,\n    What I became, being of both deprived.\nThe Emperor of the kingdom dolorous\n    From his mid-breast forth issued from the ice;\n    And better with a giant I compare\nThan do the giants with those arms of his;\n    Consider now how great must be that whole,\n    Which unto such a part conforms itself.\nWere he as fair once, as he now is foul,\n    And lifted up his brow against his Maker,\n    Well may proceed from him all tribulation.","wordCount":96},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-34-3","eventId":"inferno-event-34-3","text":"O, what a marvel it appeared to me,\n    When I beheld three faces on his head!\n    The one in front, and that vermilion was;\nTwo were the others, that were joined with this\n    Above the middle part of either shoulder,\n    And they were joined together at the crest;\nAnd the right-hand one seemed ’twixt white and yellow;\n    The left was such to look upon as those\n    Who come from where the Nile falls valley-ward.\nUnderneath each came forth two mighty wings,\n    Such as befitting were so great a bird;\n    Sails of the sea I never saw so large.\n No feathers had they, but as of a bat\n    Their fashion was; and he was waving them,\n    So that three winds proceeded forth therefrom.\nThereby Cocytus wholly was congealed.\n    With six eyes did he weep, and down three chins\n    Trickled the tear-drops and the bloody drivel.\nAt every mouth he with his teeth was crunching\n    A sinner, in the manner of a brake,\n    So that he three of them tormented thus.\nTo him in front the biting was as naught\n    Unto the clawing, for sometimes the spine\n    Utterly stripped of all the skin remained.","wordCount":195},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-34-4","eventId":"inferno-event-34-4","text":"“That soul up there which has the greatest pain,”\n    The Master said, “is Judas Iscariot;\n    With head inside, he plies his legs without.\nOf the two others, who head downward are,\n    The one who hangs from the black jowl is Brutus;\n    See how he writhes himself, and speaks no word.\nAnd the other, who so stalwart seems, is Cassius.\n    But night is reascending, and ’tis time\n    That we depart, for we have seen the whole.”\nAs seemed him good, I clasped him round the neck,\n    And he the vantage seized of time and place,\n    And when the wings were opened wide apart,","wordCount":102},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-34-5","eventId":"inferno-event-34-5","text":"He laid fast hold upon the shaggy sides;\n    From fell to fell descended downward then\n    Between the thick hair and the frozen crust.\nWhen we were come to where the thigh revolves\n    Exactly on the thickness of the haunch,\n    The Guide, with labour and with hard-drawn breath,\nTurned round his head where he had had his legs,\n    And grappled to the hair, as one who mounts,\n    So that to Hell I thought we were returning.\n“Keep fast thy hold, for by such stairs as these,”\n    The Master said, panting as one fatigued,\n    “Must we perforce depart from so much evil.”","wordCount":101},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-34-6","eventId":"inferno-event-34-6","text":"Then through the opening of a rock he issued,\n    And down upon the margin seated me;\n    Then tow’rds me he outstretched his wary step.\nI lifted up mine eyes and thought to see\n    Lucifer in the same way I had left him;\n    And I beheld him upward hold his legs.\nAnd if I then became disquieted,\n    Let stolid people think who do not see\n    What the point is beyond which I had passed.\n“Rise up,” the Master said, “upon thy feet;\n    The way is long, and difficult the road,\n    And now the sun to middle-tierce returns.”\nIt was not any palace corridor\n    There where we were, but dungeon natural,\n    With floor uneven and unease of light.\n“Ere from the abyss I tear myself away,\n    My Master,” said I when I had arisen,\n    “To draw me from an error speak a little;\nWhere is the ice? and how is this one fixed\n    Thus upside down? and how in such short time\n    From eve to morn has the sun made his transit?”\nAnd he to me: “Thou still imaginest\n    Thou art beyond the centre, where I grasped\n    The hair of the fell worm, who mines the world.","wordCount":196},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-34-7","eventId":"inferno-event-34-7","text":"That side thou wast, so long as I descended;\n    When round I turned me, thou didst pass the point\n    To which things heavy draw from every side,\nAnd now beneath the hemisphere art come\n    Opposite that which overhangs the vast\n    Dry-land, and ’neath whose cope was put to death\nThe Man who without sin was born and lived.\n    Thou hast thy feet upon the little sphere\n    Which makes the other face of the Judecca.\nHere it is morn when it is evening there;\n    And he who with his hair a stairway made us\n    Still fixed remaineth as he was before.\nUpon this side he fell down out of heaven;\n    And all the land, that whilom here emerged,\n    For fear of him made of the sea a veil,\nAnd came to our hemisphere; and peradventure\n    To flee from him, what on this side appears\n    Left the place vacant here, and back recoiled.”\nA place there is below, from Beelzebub\n    As far receding as the tomb extends,\n    Which not by sight is known, but by the sound\nOf a small rivulet, that there descendeth\n    Through chasm within the stone, which it has gnawed\n    With course that winds about and slightly falls.","wordCount":200},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-text-34-8","eventId":"inferno-event-34-8","text":"The Guide and I into that hidden road\n    Now entered, to return to the bright world;\n    And without care of having any rest\nWe mounted up, he first and I the second,\n    Till I beheld through a round aperture\n    Some of the beauteous things that Heaven doth bear;\nThence we came forth to rebehold the stars.","wordCount":56}],"timelines":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-timeline-descent","name":"The Descent","description":"The primary journey from the dark wood through Hell to the stars. Fractions place scenes within the traditional Good Friday to Easter-morning sequence.","color":"#7d473d","dayOffset":0},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-timeline-intercession","name":"The Celestial Intercession","description":"Virgil’s account of Beatrice descending to Limbo shortly before the journey begins.","color":"#76688b","dayOffset":-0.25},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-timeline-francesca-memory","name":"Francesca’s Memory","description":"The fatal reading in Rimini, placed approximately in the conventional year of Francesca’s death, 1285.","color":"#8c5f68","dayOffset":-5475},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-timeline-mantua-history","name":"The Founding of Mantua","description":"Virgil’s legendary account of Manto and Mantua, assigned an explicitly approximate ancient editorial position.","color":"#67785e","dayOffset":-912500},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-timeline-ulysses-voyage","name":"Ulysses’ Last Voyage","description":"Ulysses’ narrated voyage beyond the Pillars, assigned to a broad legendary post-Trojan era rather than the descent.","color":"#526a7b","dayOffset":-912500},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-timeline-guido-memory","name":"Guido’s Last Counsel","description":"Guido’s account of Pope Boniface’s demand and the logic at his death, placed approximately in 1298.","color":"#7a6254","dayOffset":-730},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-timeline-ugolino-memory","name":"Ugolino in the Tower","description":"Ugolino’s imprisonment and death with the children, placed approximately in 1289.","color":"#70605b","dayOffset":-4015}],"mapLayers":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-map-overview","name":"The Descent Through Hell","description":"A topographic cutaway of the dark wood, the funnel of Hell, the centre of Earth, and the hidden ascent.","parentMapId":null,"imageId":"inferno-image-map-overview","imageWidth":1536,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":null,"levelLabel":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-map-upper","name":"Upper Hell","description":"A topographic plan from the gate and Acheron through Limbo, the circles of appetite, Styx, and the walls of Dis.","parentMapId":"inferno-map-overview","imageId":"inferno-image-map-upper","imageWidth":1536,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":null,"levelLabel":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-map-lower","name":"Dis and the Circle of Violence","description":"A topographic plan of the burning tombs, the three rings of violence, Phlegethon, the thorn wood, burning sand, and cataract.","parentMapId":"inferno-map-overview","imageId":"inferno-image-map-lower","imageWidth":1536,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":null,"levelLabel":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-map-malebolge","name":"Malebolge","description":"A mature topographic plan of the ten stone bolgias, their bridges, broken crossings, and the giants’ well.","parentMapId":"inferno-map-overview","imageId":"inferno-image-map-malebolge","imageWidth":1536,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":null,"levelLabel":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-map-cocytus","name":"Cocytus and the Earth’s Centre","description":"A topographic plan of the four frozen zones, Lucifer at the centre, and the upward passage.","parentMapId":"inferno-map-overview","imageId":"inferno-image-map-cocytus","imageWidth":1536,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":null,"levelLabel":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-map-history","name":"Italy and the Western Sea","description":"A historical topographic map for the poem’s embedded memories in Rimini, Mantua, Montefeltro, Rome, Pisa, and Ulysses’ western voyage.","parentMapId":null,"imageId":"inferno-image-map-history","imageWidth":1536,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":null,"levelLabel":null}],"locationMarkers":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-dark-wood","name":"The Dark Wood","description":"A tangled woodland below the sunlit slope where the straight path is lost.","mapLayerId":"inferno-map-overview","linkedMapLayerId":null,"x":430,"y":860,"iconType":"landmark","imageId":"inferno-image-location-dark-wood","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-sunlit-slope","name":"The Sunlit Slope","description":"The first rising ground above the wood, blocked by three beasts.","mapLayerId":"inferno-map-overview","linkedMapLayerId":null,"x":1080,"y":870,"iconType":"landmark","imageId":"inferno-image-location-sunlit-slope","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-hell-mouth","name":"The Mouth of Hell","description":"The upper opening of the immense cone beneath the inhabited world.","mapLayerId":"inferno-map-overview","linkedMapLayerId":"inferno-map-upper","x":768,"y":805,"iconType":"landmark","imageId":"inferno-image-location-hell-mouth","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-dis-region","name":"The City of Dis","description":"The red-walled division between upper Hell and the deeper circles.","mapLayerId":"inferno-map-overview","linkedMapLayerId":"inferno-map-lower","x":768,"y":555,"iconType":"landmark","imageId":"inferno-image-location-dis-region","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-malebolge-region","name":"Malebolge","description":"The eighth circle forms ten descending stone trenches around a central well.","mapLayerId":"inferno-map-overview","linkedMapLayerId":"inferno-map-malebolge","x":768,"y":335,"iconType":"landmark","imageId":"inferno-image-location-malebolge-region","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-cocytus-region","name":"Cocytus","description":"The frozen ninth circle and the centre of gravity at the cone’s point.","mapLayerId":"inferno-map-overview","linkedMapLayerId":"inferno-map-cocytus","x":768,"y":120,"iconType":"landmark","imageId":"inferno-image-location-cocytus-region","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-hell-gate","name":"The Gate of Hell","description":"The inscribed threshold from the mortal approach into the infernal vestibule.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":160,"y":850,"iconType":"landmark","imageId":"inferno-image-location-hell-gate","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-vestibule","name":"The Vestibule","description":"The waste where neutral souls run behind an empty banner.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":310,"y":780,"iconType":"landmark","imageId":"inferno-image-location-vestibule","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-acheron","name":"Acheron","description":"The first infernal river and Charon’s crowded crossing.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":470,"y":720,"iconType":"landmark","imageId":"inferno-image-location-acheron","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-limbo-rim","name":"The Rim of Limbo","description":"The brink from which the travellers first hear the sighs of the first circle.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":610,"y":690,"iconType":"landmark","imageId":"inferno-image-location-limbo-rim","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-limbo","name":"Limbo","description":"A dim meadow holding virtuous souls outside hope of Heaven.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":730,"y":650,"iconType":"landmark","imageId":"inferno-image-location-limbo","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-noble-castle","name":"The Noble Castle","description":"A luminous enclosure with seven walls and a green meadow for the ancient wise.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":850,"y":650,"iconType":"landmark","imageId":"inferno-image-location-noble-castle","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-circle-two","name":"The Second Circle","description":"Minos judges at the entrance to a lightless region swept by perpetual wind.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":930,"y":560,"iconType":"landmark","imageId":"inferno-image-location-circle-two","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-circle-three","name":"The Third Circle","description":"Cold foul rain falls upon a muddy field guarded by Cerberus.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":1060,"y":500,"iconType":"landmark","imageId":"inferno-image-location-circle-three","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-circle-four","name":"The Fourth Circle","description":"Two burdened crowds collide and reverse along the divided circle.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":1140,"y":400,"iconType":"landmark","imageId":"inferno-image-location-circle-four","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-styx","name":"The Marsh of Styx","description":"Wrathful souls strike above the black marsh while the sullen lie beneath.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":1020,"y":300,"iconType":"landmark","imageId":"inferno-image-location-styx","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-styx-tower","name":"The Signal Tower","description":"A tower above Styx answers distant flames before Phlegyas arrives.","mapLayerId":"inferno-map-upper","linkedMapLayerId":null,"x":880,"y":340,"iconType":"landmark","imageId":"inferno-image-location-styx-tower","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-dis-gate","name":"The Gate of Dis","description":"Iron walls and fiery towers bar the route into lower Hell.","mapLayerId":"inferno-map-upper","linkedMapLayerId":"inferno-map-lower","x":760,"y":220,"iconType":"landmark","imageId":"inferno-image-location-dis-gate","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-circle-six","name":"The Sixth Circle","description":"Open fiery tombs fill the cemetery immediately inside Dis.","mapLayerId":"inferno-map-lower","linkedMapLayerId":null,"x":190,"y":800,"iconType":"landmark","imageId":"inferno-image-location-circle-six","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-lower-hell-rim","name":"The Rim of Lower Hell","description":"A broken bank above the deeper circles where the travellers pause against the stench.","mapLayerId":"inferno-map-lower","linkedMapLayerId":null,"x":360,"y":730,"iconType":"landmark","imageId":"inferno-image-location-lower-hell-rim","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-circle-seven-rim","name":"The Landslide","description":"A shattered descent guarded by the Minotaur leads to the circle of violence.","mapLayerId":"inferno-map-lower","linkedMapLayerId":null,"x":500,"y":650,"iconType":"landmark","imageId":"inferno-image-location-circle-seven-rim","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-phlegethon","name":"Phlegethon","description":"A boiling river of blood patrolled by armed centaurs.","mapLayerId":"inferno-map-lower","linkedMapLayerId":null,"x":650,"y":610,"iconType":"landmark","imageId":"inferno-image-location-phlegethon","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-suicide-wood","name":"The Wood of the Suicides","description":"A pathless thorn forest inhabited by Harpies and imprisoned voices.","mapLayerId":"inferno-map-lower","linkedMapLayerId":null,"x":790,"y":510,"iconType":"landmark","imageId":"inferno-image-location-suicide-wood","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-burning-sand","name":"The Burning Sand","description":"An arid plain receives an unending rain of fire.","mapLayerId":"inferno-map-lower","linkedMapLayerId":null,"x":930,"y":420,"iconType":"landmark","imageId":"inferno-image-location-burning-sand","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-cataract","name":"The Cataract","description":"Phlegethon plunges from the burning plain into Malebolge.","mapLayerId":"inferno-map-lower","linkedMapLayerId":"inferno-map-malebolge","x":1080,"y":270,"iconType":"landmark","imageId":"inferno-image-location-cataract","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-malebolge-overlook","name":"The Rim of Malebolge","description":"The eighth circle opens as a vast stone basin crossed by spoke-like bridges.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":210,"y":820,"iconType":"landmark","imageId":"inferno-image-location-malebolge-overlook","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-one","name":"First Bolgia","description":"Panders and seducers move in opposed files under the lashes of demons.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":330,"y":730,"iconType":"landmark","imageId":"inferno-image-location-bolgia-one","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-two","name":"Second Bolgia","description":"Flatterers lie in a ditch of corrupt filth.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":430,"y":670,"iconType":"landmark","imageId":"inferno-image-location-bolgia-two","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-three","name":"Third Bolgia","description":"Simoniacs are planted headfirst in fiery stone apertures.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":520,"y":620,"iconType":"landmark","imageId":"inferno-image-location-bolgia-three","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-four","name":"Fourth Bolgia","description":"Diviners walk with their faces twisted backward.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":595,"y":580,"iconType":"landmark","imageId":"inferno-image-location-bolgia-four","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-five","name":"Fifth Bolgia","description":"Boiling pitch conceals grafters under the hooks of the Malebranche.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":655,"y":545,"iconType":"landmark","imageId":"inferno-image-location-bolgia-five","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-six","name":"Sixth Bolgia","description":"Hypocrites circle under gilded cloaks of lead.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":705,"y":515,"iconType":"landmark","imageId":"inferno-image-location-bolgia-six","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-broken-bridge","name":"The Broken Bridges","description":"Collapsed arches force a dangerous climb between the sixth and seventh trenches.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":825,"y":540,"iconType":"landmark","imageId":"inferno-image-location-broken-bridge","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-seven","name":"Seventh Bolgia","description":"Thieves and serpents exchange shapes in a stone-filled pit.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":740,"y":480,"iconType":"landmark","imageId":"inferno-image-location-bolgia-seven","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-eight","name":"Eighth Bolgia","description":"Fraudulent counsellors move concealed inside individual flames.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":760,"y":440,"iconType":"landmark","imageId":"inferno-image-location-bolgia-eight","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-nine","name":"Ninth Bolgia","description":"Sowers of division circle through repeated wounds.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":null,"x":770,"y":395,"iconType":"landmark","imageId":"inferno-image-location-bolgia-nine","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-bolgia-ten","name":"Tenth Bolgia","description":"Falsifiers suffer disease, thirst, fever, and madness.","mapLayerId":"inferno-map-malebolge","linkedMapLayerId":"inferno-map-cocytus","x":770,"y":345,"iconType":"landmark","imageId":"inferno-image-location-bolgia-ten","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-giants-well","name":"The Giants’ Well","description":"Ancient giants stand around the shaft between Malebolge and the frozen lake.","mapLayerId":"inferno-map-cocytus","linkedMapLayerId":null,"x":260,"y":820,"iconType":"landmark","imageId":"inferno-image-location-giants-well","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-cocytus","name":"Cocytus","description":"The frozen lake of the ninth circle spreads below the giants’ well.","mapLayerId":"inferno-map-cocytus","linkedMapLayerId":null,"x":410,"y":720,"iconType":"landmark","imageId":"inferno-image-location-cocytus","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-caina","name":"Caina","description":"Traitors to kindred bow their faces above the ice.","mapLayerId":"inferno-map-cocytus","linkedMapLayerId":null,"x":535,"y":640,"iconType":"landmark","imageId":"inferno-image-location-caina","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-antenora","name":"Antenora","description":"Traitors to country stand deeper in Cocytus.","mapLayerId":"inferno-map-cocytus","linkedMapLayerId":null,"x":630,"y":575,"iconType":"landmark","imageId":"inferno-image-location-antenora","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-ptolomaea","name":"Ptolomaea","description":"Traitors to guests lie face upward while their tears freeze.","mapLayerId":"inferno-map-cocytus","linkedMapLayerId":null,"x":700,"y":530,"iconType":"landmark","imageId":"inferno-image-location-ptolomaea","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-judecca","name":"Judecca","description":"Traitors to benefactors are sealed wholly inside transparent ice.","mapLayerId":"inferno-map-cocytus","linkedMapLayerId":null,"x":745,"y":500,"iconType":"landmark","imageId":"inferno-image-location-judecca","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-earth-centre","name":"The Centre of Earth","description":"Gravity reverses beside Lucifer’s body at the lowest point of the descent.","mapLayerId":"inferno-map-cocytus","linkedMapLayerId":null,"x":768,"y":475,"iconType":"landmark","imageId":"inferno-image-location-earth-centre","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-hidden-passage","name":"The Hidden Passage","description":"A narrow stream and winding tunnel climb toward the stars of the other hemisphere.","mapLayerId":"inferno-map-cocytus","linkedMapLayerId":null,"x":1230,"y":250,"iconType":"landmark","imageId":"inferno-image-location-hidden-passage","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-rimini","name":"Rimini","description":"The Adriatic city associated with Francesca’s memory of Paolo and the fatal reading.","mapLayerId":"inferno-map-history","linkedMapLayerId":null,"x":960,"y":570,"iconType":"landmark","imageId":"inferno-image-location-rimini","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-mantua-marsh","name":"The Mincio Marsh","description":"The wetland below Lake Garda where Virgil places Manto’s settlement and Mantua’s origin.","mapLayerId":"inferno-map-history","linkedMapLayerId":null,"x":720,"y":700,"iconType":"landmark","imageId":"inferno-image-location-mantua-marsh","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-mediterranean","name":"The Mediterranean","description":"The sea crossed by Ulysses after leaving Circe.","mapLayerId":"inferno-map-history","linkedMapLayerId":null,"x":520,"y":430,"iconType":"landmark","imageId":"inferno-image-location-mediterranean","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-western-ocean","name":"Beyond the Pillars","description":"The Atlantic west of Gibraltar where Ulysses pursues the unknown sea.","mapLayerId":"inferno-map-history","linkedMapLayerId":null,"x":160,"y":380,"iconType":"landmark","imageId":"inferno-image-location-western-ocean","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-montefeltro-memory","name":"Montefeltro","description":"The rugged Romagnol territory associated with Guido’s military life.","mapLayerId":"inferno-map-history","linkedMapLayerId":null,"x":820,"y":620,"iconType":"landmark","imageId":"inferno-image-location-montefeltro-memory","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-lateran","name":"The Lateran","description":"The papal court in Rome where Boniface demands fraudulent counsel.","mapLayerId":"inferno-map-history","linkedMapLayerId":null,"x":760,"y":400,"iconType":"landmark","imageId":"inferno-image-location-lateran","tags":[],"factionId":null},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-loc-hunger-tower","name":"The Hunger Tower","description":"The Pisan prison in which Ugolino remembers the sealed door and his children’s deaths.","mapLayerId":"inferno-map-history","linkedMapLayerId":null,"x":650,"y":520,"iconType":"landmark","imageId":"inferno-image-location-hunger-tower","tags":[],"factionId":null}],"characters":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-dante","name":"Dante","aliases":[],"description":"At first appearance, wakes to himself in a savage wood, unable to explain how the straight way was lost.","color":"#6f473f","portraitImageId":"inferno-image-character-dante","isAlive":true,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-virgil","name":"Virgil","aliases":[],"description":"At first appearance, identifies himself as a Mantuan poet of Rome and questions Dante’s retreat.","color":"#87705a","portraitImageId":"inferno-image-character-virgil","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-beatrice","name":"Beatrice","aliases":[],"description":"At first appearance, comes from blessedness to ask Virgil to rescue the endangered traveller.","color":"#6a6478","portraitImageId":"inferno-image-character-beatrice","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-charon","name":"Charon","aliases":[],"description":"At first appearance, beats the delaying shades into his boat and resists carrying a living body.","color":"#5a5662","portraitImageId":"inferno-image-character-charon","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-homer","name":"Homer","aliases":[],"description":"At first appearance, approaches as lord of the highest song with Horace, Ovid, and Lucan.","color":"#82574c","portraitImageId":"inferno-image-character-homer","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-minos","name":"Minos","aliases":[],"description":"At first appearance, judges each confessing soul and coils his tail to assign its depth.","color":"#79664b","portraitImageId":"inferno-image-character-minos","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-francesca","name":"Francesca da Rimini","aliases":[],"description":"At first appearance, leaves Dido’s band with Paolo and answers the living traveller.","color":"#65494d","portraitImageId":"inferno-image-character-francesca","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-paolo","name":"Paolo Malatesta","aliases":[],"description":"At first appearance, comes silently beside Francesca, borne with her on the wind.","color":"#8b7458","portraitImageId":"inferno-image-character-paolo","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-cerberus","name":"Cerberus","aliases":[],"description":"At first appearance, barks from three throats and claws the gluttonous shades.","color":"#4d5961","portraitImageId":"inferno-image-character-cerberus","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-ciacco","name":"Ciacco","aliases":[],"description":"At first appearance, rises from the mire, identifies himself by the nickname Ciacco, and appeals to a fellow Florentine.","color":"#745552","portraitImageId":"inferno-image-character-ciacco","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-plutus","name":"Plutus","aliases":[],"description":"At first appearance, cries an obscure warning at the entrance to the fourth circle.","color":"#8b6a42","portraitImageId":"inferno-image-character-plutus","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-phlegyas","name":"Phlegyas","aliases":[],"description":"At first appearance, arrives shouting in anger, then receives the two travellers into his small boat.","color":"#5c4750","portraitImageId":"inferno-image-character-phlegyas","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-filippo","name":"Filippo Argenti","aliases":[],"description":"At first appearance, rises mud-covered beside the boat and reaches toward the living traveller.","color":"#6f473f","portraitImageId":"inferno-image-character-filippo","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-messenger","name":"The Heavenly Messenger","aliases":[],"description":"At first appearance, crosses Styx dry-shod, scatters the resisting dead, and opens the gate with a wand.","color":"#87705a","portraitImageId":"inferno-image-character-messenger","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-farinata","name":"Farinata degli Uberti","aliases":[],"description":"At first appearance, rises waist-high from a tomb, recognizes Dante’s Tuscan speech, and asks his ancestry.","color":"#6a6478","portraitImageId":"inferno-image-character-farinata","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-cavalcante","name":"Cavalcante de’ Cavalcanti","aliases":[],"description":"At first appearance, rises on his knees, searches for Guido, and collapses when Dante’s tense suggests death.","color":"#5a5662","portraitImageId":"inferno-image-character-cavalcante","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-minotaur","name":"The Minotaur","aliases":[],"description":"At first appearance, bites himself in rage at the mention of Theseus and charges blindly.","color":"#82574c","portraitImageId":"inferno-image-character-minotaur","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-chiron","name":"Chiron","aliases":[],"description":"At first appearance, halts the armed centaurs and notices that Dante moves stones with a living body.","color":"#79664b","portraitImageId":"inferno-image-character-chiron","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-nessus","name":"Nessus","aliases":[],"description":"At first appearance, challenges the approaching travellers with a drawn bow.","color":"#65494d","portraitImageId":"inferno-image-character-nessus","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-pier","name":"Pier delle Vigne","aliases":[],"description":"At first appearance, names his trusted service to Frederick, the envy that ruined him, and the despair that made him unjust to himself.","color":"#8b7458","portraitImageId":"inferno-image-character-pier","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-lano","name":"Lano da Siena","aliases":[],"description":"At first appearance, runs naked through the thorns while black hounds close behind.","color":"#4d5961","portraitImageId":"inferno-image-character-lano","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-jacopo","name":"Jacopo da Sant’ Andrea","aliases":[],"description":"At first appearance, crashes into a bush in terror and is torn apart with it.","color":"#745552","portraitImageId":"inferno-image-character-jacopo","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-capaneus","name":"Capaneus","aliases":[],"description":"At first appearance, lies huge upon the sand and defies Jupiter without softening his pride.","color":"#8b6a42","portraitImageId":"inferno-image-character-capaneus","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-brunetto","name":"Brunetto Latini","aliases":[],"description":"At first appearance, recognizes Dante beneath the baked features and takes him by the hem.","color":"#5c4750","portraitImageId":"inferno-image-character-brunetto","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-guidoGuerra","name":"Guido Guerra","aliases":[],"description":"At first appearance, runs in a wheel with Tegghiaio and Jacopo so none must stand beneath the fire.","color":"#6f473f","portraitImageId":"inferno-image-character-guidoGuerra","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-geryon","name":"The Monster of Fraud","aliases":[],"description":"At first appearance, rests with his honest human face and patterned body on the stone while his scorpion tail hangs free.","color":"#87705a","portraitImageId":"inferno-image-character-geryon","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[{"eventId":"inferno-event-17-4","name":"Geryon"}]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-venedico","name":"Venedico Caccianemico","aliases":[],"description":"At first appearance, confesses selling his sister to satisfy another man and tries to hide his face.","color":"#6a6478","portraitImageId":"inferno-image-character-venedico","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-jason","name":"Jason","aliases":[],"description":"At first appearance, walks with royal bearing despite the lashes, bearing punishment for two betrayals.","color":"#5a5662","portraitImageId":"inferno-image-character-jason","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-nicholas","name":"The Buried Pope","aliases":[],"description":"At first appearance, mistakes Dante for Boniface and speaks from the hole as though expecting a successor.","color":"#82574c","portraitImageId":"inferno-image-character-nicholas","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[{"eventId":"inferno-event-19-4","name":"Pope Nicholas III"}]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-manto","name":"Manto","aliases":[],"description":"At first appearance, leaves Thebes, crosses lands, and settles alone in the uninhabited marsh where her life ends.","color":"#79664b","portraitImageId":"inferno-image-character-manto","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-malacoda","name":"Malacoda","aliases":[],"description":"At first appearance, advances with a hook, then lowers it when Virgil invokes heavenly sanction.","color":"#65494d","portraitImageId":"inferno-image-character-malacoda","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-malebranche","name":"The Malebranche","aliases":[],"description":"At first appearance, throw the magistrate into the pitch and threaten any sinner who surfaces.","color":"#8b7458","portraitImageId":"inferno-image-character-malebranche","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-ciampolo","name":"Ciampolo of Navarre","aliases":[],"description":"At first appearance, raises his back like a dolphin for relief and is hooked before he can dive.","color":"#4d5961","portraitImageId":"inferno-image-character-ciampolo","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-catalano","name":"Catalano dei Malavolti","aliases":[],"description":"At first appearance, identifies himself and Loderingo as Bolognese friars chosen to keep peace.","color":"#745552","portraitImageId":"inferno-image-character-catalano","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-loderingo","name":"Loderingo degli Andalò","aliases":[],"description":"At first appearance, walks beside Catalano beneath the crushing gilded habit.","color":"#8b6a42","portraitImageId":"inferno-image-character-loderingo","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-vanni","name":"Vanni Fucci","aliases":[],"description":"At first appearance, is bitten, burns into ash, and reforms immediately before the travellers.","color":"#5c4750","portraitImageId":"inferno-image-character-vanni","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-cacus","name":"Cacus","aliases":[],"description":"At first appearance, gallops past covered in serpents with a fire-breathing dragon on his shoulders.","color":"#6f473f","portraitImageId":"inferno-image-character-cacus","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-agnello","name":"Agnello Brunelleschi","aliases":[],"description":"At first appearance, loses separate human form as flesh, limbs, colour, and face combine with Cianfa.","color":"#87705a","portraitImageId":"inferno-image-character-agnello","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-cianfa","name":"Cianfa Donati","aliases":[],"description":"At first appearance, enfolds Agnello as a serpent and becomes one shared monstrous shape.","color":"#6a6478","portraitImageId":"inferno-image-character-cianfa","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-buoso","name":"Buoso Donati","aliases":[],"description":"At first appearance, trades human form with the attacking serpent in a simultaneous distortion of limbs and speech.","color":"#5a5662","portraitImageId":"inferno-image-character-buoso","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-guercio","name":"Guercio Cavalcanti","aliases":[],"description":"At first appearance, rises from serpent shape into the human body taken from Buoso.","color":"#82574c","portraitImageId":"inferno-image-character-guercio","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-ulysses","name":"Ulysses","aliases":[],"description":"At first appearance, moves with Diomedes inside the greater horn of fire.","color":"#79664b","portraitImageId":"inferno-image-character-ulysses","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-diomedes","name":"Diomedes","aliases":[],"description":"At first appearance, shares the flame and penalties of stratagem with Ulysses.","color":"#65494d","portraitImageId":"inferno-image-character-diomedes","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-companions","name":"Ulysses’ Companions","aliases":[],"description":"At first appearance, sail west with Ulysses through the Mediterranean beyond familiar shores.","color":"#8b7458","portraitImageId":"inferno-image-character-companions","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-guidoMontefeltro","name":"Guido da Montefeltro","aliases":[],"description":"At first appearance, begins speaking from a flame after the double horn departs.","color":"#4d5961","portraitImageId":"inferno-image-character-guidoMontefeltro","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-boniface","name":"Pope Boniface VIII","aliases":[],"description":"At first appearance, demands advice for breaking Palestrina and promises absolution before the sin is committed.","color":"#745552","portraitImageId":"inferno-image-character-boniface","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-mahomet","name":"Mahomet","aliases":[],"description":"At first appearance, shows his opened body and points to Ali’s cleft face while explaining the cycle of wounds.","color":"#8b6a42","portraitImageId":"inferno-image-character-mahomet","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-pierMedicina","name":"Pier da Medicina","aliases":[],"description":"At first appearance, shows his pierced throat and sends warnings to two men of Fano.","color":"#5c4750","portraitImageId":"inferno-image-character-pierMedicina","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-curio","name":"Curio","aliases":[],"description":"At first appearance, displays the tongue cut from the throat that urged Caesar across the Rubicon.","color":"#6f473f","portraitImageId":"inferno-image-character-curio","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-mosca","name":"Mosca dei Lamberti","aliases":[],"description":"At first appearance, raises mutilated arms and recalls the counsel that began Tuscan bloodshed.","color":"#87705a","portraitImageId":"inferno-image-character-mosca","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-bertran","name":"Bertran de Born","aliases":[],"description":"At first appearance, walks holding his severed head like a lantern and explains the contrapasso for dividing father and son.","color":"#6a6478","portraitImageId":"inferno-image-character-bertran","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-griffolino","name":"Griffolino d’Arezzo","aliases":[],"description":"At first appearance, scrapes his diseased skin and identifies himself as an alchemist burned for deceiving Albero.","color":"#5a5662","portraitImageId":"inferno-image-character-griffolino","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-capocchio","name":"Capocchio","aliases":[],"description":"At first appearance, names himself as a skilled ape of nature and joins the mockery of Sienese vanity.","color":"#82574c","portraitImageId":"inferno-image-character-capocchio","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-gianni","name":"Gianni Schicchi","aliases":[],"description":"At first appearance, bites Capocchio and drags him along the stony floor.","color":"#79664b","portraitImageId":"inferno-image-character-gianni","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-myrrha","name":"Myrrha","aliases":[],"description":"At first appearance, runs rabid through the ditch in the form of one who falsified herself for incest.","color":"#65494d","portraitImageId":"inferno-image-character-myrrha","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-masterAdam","name":"Master Adam","aliases":[],"description":"At first appearance, sits swollen and immobile with dropsy, tormented by thirst and the memory of clear streams.","color":"#8b7458","portraitImageId":"inferno-image-character-masterAdam","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-sinon","name":"Sinon","aliases":[],"description":"At first appearance, strikes Adam’s belly and defends his own truthful words amid the lie of Troy.","color":"#4d5961","portraitImageId":"inferno-image-character-sinon","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-nimrod","name":"Nimrod","aliases":[],"description":"At first appearance, cries incomprehensible words and wears the horn that announced him.","color":"#745552","portraitImageId":"inferno-image-character-nimrod","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-ephialtes","name":"Ephialtes","aliases":[],"description":"At first appearance, stands chained so tightly that his violent shaking makes the bank tremble.","color":"#8b6a42","portraitImageId":"inferno-image-character-ephialtes","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-antaeus","name":"Antaeus","aliases":[],"description":"At first appearance, bends his enormous hand after Virgil promises earthly fame.","color":"#5c4750","portraitImageId":"inferno-image-character-antaeus","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-bocca","name":"Bocca degli Abati","aliases":[],"description":"At first appearance, refuses identity and dares Dante to leave until his hair is seized.","color":"#6f473f","portraitImageId":"inferno-image-character-bocca","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-ugolino","name":"Count Ugolino","aliases":[],"description":"At first appearance, gnaws the skull of Archbishop Ruggieri from behind.","color":"#87705a","portraitImageId":"inferno-image-character-ugolino","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-ruggieri","name":"Archbishop Ruggieri","aliases":[],"description":"At first appearance, remains trapped beneath the teeth of his victim.","color":"#6a6478","portraitImageId":"inferno-image-character-ruggieri","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-children","name":"Ugolino’s Children","aliases":[],"description":"At first appearance, wake hungry in the tower and look to their father for meaning.","color":"#5a5662","portraitImageId":"inferno-image-character-children","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-alberigo","name":"Fra Alberigo","aliases":[],"description":"At first appearance, asks Dante to clear the ice from his eyes and explains that some traitors fall here before bodily death.","color":"#82574c","portraitImageId":"inferno-image-character-alberigo","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-char-lucifer","name":"Lucifer","aliases":[],"description":"At first appearance, rises from the ice with three faces, six batlike wings, and three sinners crushed in his mouths.","color":"#79664b","portraitImageId":"inferno-image-character-lucifer","isAlive":false,"birthDate":null,"tags":[],"nameChanges":[]}],"items":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-item-cord","name":"Dante’s cord","description":"A cord Dante once intended as a snare and gives Virgil to signal into the abyss.","iconType":"rope","imageId":"inferno-image-item-cord","tags":[],"isCollective":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-item-oar","name":"Charon’s oar","description":"The ferryman’s implement for steering and striking the delaying dead.","iconType":"tool","imageId":"inferno-image-item-oar","tags":[],"isCollective":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-item-bow","name":"The centaurs’ bows","description":"Collective bows and arrows carried by the patrol along Phlegethon.","iconType":"weapon","imageId":"inferno-image-item-bow","tags":[],"isCollective":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-item-purse","name":"The heraldic purses","description":"Collective purses whose emblems identify families among the usurers.","iconType":"container","imageId":"inferno-image-item-purse","tags":[],"isCollective":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-item-hook","name":"The Malebranche hooks","description":"Collective grappling hooks used to drag grafters from boiling pitch.","iconType":"tool","imageId":"inferno-image-item-hook","tags":[],"isCollective":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-item-ship","name":"Ulysses’ ship","description":"The vessel that carries Ulysses and his companions beyond the Pillars of Hercules.","iconType":"vehicle","imageId":"inferno-image-item-ship","tags":[],"isCollective":false},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-item-florins","name":"Counterfeit florins","description":"The false gold coins Master Adam made at Romena.","iconType":"artifact","imageId":"inferno-image-item-florins","tags":[],"isCollective":true},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-item-horn","name":"Nimrod’s horn","description":"The immense horn whose blast crosses the darkness above Cocytus.","iconType":"instrument","imageId":"inferno-image-item-horn","tags":[],"isCollective":false}],"characterSnapshots":[{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-1-1-dante","characterId":"inferno-char-dante","eventId":"inferno-event-1-1","isAlive":true,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":1,"statusNotes":"Wakes to himself in a savage wood, unable to explain how the straight way was lost."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-1-2-dante","characterId":"inferno-char-dante","eventId":"inferno-event-1-2","isAlive":true,"currentLocationMarkerId":"inferno-loc-sunlit-slope","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":2,"statusNotes":"Attempts the sunlit slope, then yields ground before the panther, lion, and starving she-wolf."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-1-3-dante","characterId":"inferno-char-dante","eventId":"inferno-event-1-3","isAlive":true,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3,"statusNotes":"Cries for pity when a silent shade appears below the blocked ascent."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-1-3-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-1-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3.01,"statusNotes":"Identifies himself as a Mantuan poet of Rome and questions Dante’s retreat."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-1-4-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-1-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":4,"statusNotes":"Warns that the she-wolf bars this ascent and offers a road through the eternal realms."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-1-4-dante","characterId":"inferno-char-dante","eventId":"inferno-event-1-4","isAlive":true,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":4.01,"statusNotes":"Entrusts himself to the poet whose work taught him his own style."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-2-1-dante","characterId":"inferno-char-dante","eventId":"inferno-event-2-1","isAlive":true,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":5,"statusNotes":"Falters at dusk and questions whether he has the worth to undertake the passage."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-2-1-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-2-1","isAlive":false,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":5.01,"statusNotes":"Hears Dante compare himself unfavourably with Aeneas and Paul."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-2-2-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-2-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6,"statusNotes":"Names cowardice as the force undoing Dante’s resolve and begins to explain his commission."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-2-2-dante","characterId":"inferno-char-dante","eventId":"inferno-event-2-2","isAlive":true,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overview","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6.01,"statusNotes":"Listens while shame replaces his first impulse to turn back."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-2-3-beatrice","characterId":"inferno-char-beatrice","eventId":"inferno-event-2-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-limbo","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":7,"statusNotes":"Comes from blessedness to ask Virgil to rescue the endangered traveller."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-2-3-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-2-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-limbo","currentMapLayerId":"inferno-map-upper","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":7.01,"statusNotes":"Receives Beatrice’s request and asks how she can enter a place cut off from hope."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-2-4-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-2-4","isAlive":false,"currentLocationMarkerId":"inferno-loc-dark-wood","currentMapLayerId":"inferno-map-overvi