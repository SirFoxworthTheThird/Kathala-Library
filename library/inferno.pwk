":175,"statusNotes":"Sees traitors’ faces bent downward above the frozen lake, teeth chattering like storks."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-32-2-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-32-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-caina","currentMapLayerId":"inferno-map-cocytus","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":175.01,"statusNotes":"Leads carefully among heads fixed in the ice."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-32-3-dante","characterId":"inferno-char-dante","eventId":"inferno-event-32-3","isAlive":true,"currentLocationMarkerId":"inferno-loc-caina","currentMapLayerId":"inferno-map-cocytus","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":176,"statusNotes":"Questions two shades frozen breast to breast and learns of fraternal murder."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-32-3-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-32-3","isAlive":false,"currentLocationMarkerId":"inferno-loc-caina","currentMapLayerId":"inferno-map-cocytus","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":176.01,"statusNotes":"Waits as other voices identify Caina’s notorious dead."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-32-4-dante","characterId":"inferno-char-dante","eventId":"inferno-event-32-4","isAlive":true,"currentLocationMarkerId":"inferno-loc-antenora","currentMapLayerId":"inferno-map-cocytus","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":177,"statusNotes":"Kicks one head by chance or fate and is cursed by the injured traitor."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-32-4-virgil","chara