ferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":64,"statusNotes":"Walks beside the steaming rill while its vapour shields the travellers from fire."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-15-1-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-15-1","isAlive":false,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":64.01,"statusNotes":"Keeps to the margins that form their protected road."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-15-2-brunetto","characterId":"inferno-char-brunetto","eventId":"inferno-event-15-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":65,"statusNotes":"Recognizes Dante beneath the baked features and takes him by the hem."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-15-2-dante","characterId":"inferno-char-dante","eventId":"inferno-event-15-2","isAlive":true,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":65.01,"statusNotes":"Recognizes his former teacher and bends respectfully without leaving the safe bank."},{"worldId":"inferno-world","createdAt":1792281600000,"updatedAt":1792281600000,"id":"inferno-snapshot-15-2-virgil","characterId":"inferno-char-virgil","eventId":"inferno-event-15-2","isAlive":false,"currentLocationMarkerId":"inferno-loc-burning-sand","currentMapLayerId":"inferno-map-lower","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":65.02,"statusNotes":"Permits the conversation while maintaining the onward route."}