cold-choir-loc-medbay","currentMapLayerId":"cold-choir-map-mercy","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":2.02,"statusNotes":"Witnesses the captain’s final bedside exchange while preparing to assume command."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-1-2-2-ilse","characterId":"cold-choir-char-ilse","eventId":"cold-choir-event-1-2-2","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-medbay","currentMapLayerId":"cold-choir-map-mercy","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3,"statusNotes":"Comforts Tamsin outside medbay and agrees to represent the cold rows."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-1-2-2-tamsin","characterId":"cold-choir-char-tamsin","eventId":"cold-choir-event-1-2-2","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-medbay","currentMapLayerId":"cold-choir-map-mercy","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3.01,"statusNotes":"Grieves for her mother in the corridor as the command bell sounds."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-1-2-2-kesh","characterId":"cold-choir-char-kesh","eventId":"cold-choir-event-1-2-2","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-medbay","currentMapLayerId":"cold-choir-map-mercy","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3.02,"statusNotes":"Inherits command and asks Ilse to speak for the sleepers at council."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-1-2-2-lund","characterId":"cold-choir-char-lund","eventId":"cold-choir-event-1-2-2","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-medbay","currentMapLayerId":"cold-choir-map-mercy","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3.03,"statusNotes":"Joins the group outside medbay after attending the captain."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-2-1-1-neve","characterId":"cold-choir-char-neve","eventId":"cold-choir-event-2-1-1","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-hall","currentMapLayerId":"cold-choir-map-compact","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":4,"statusNotes":"Handles the fragile register and accepts responsibility for its conservation survey."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-2-1-1-hal","characterId":"cold-choir-char-hal","eventId":"cold-choir-event-2-1-1","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-hall","currentMapLayerId":"cold-choir-map-compact","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":4.01,"statusNotes":"Shows Neve the old checks and sets her the deadline for the public display."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-2-2-1-neve","characterId":"cold-choir-char-neve","eventId":"cold-choir-event-2-2-1","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-spine","currentMapLayerId":"cold-choir-map-compact","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":5,"statusNotes":"Listens to the strike announcement and questions Jory about the unfinished Roll."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-2-2-1-jory","characterId":"cold-choir-char-jory","eventId":"cold-choir-event-2-2-1","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-spine","currentMapLayerId":"cold-choir-map-compact","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":5.01,"statusNotes":"Explains the miners’ grievance and challenges the station’s finished count."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-3-1-1-osh","characterId":"cold-choir-char-osh","eventId":"cold-choir-event-3-1-1","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-wreck","currentMapLayerId":"cold-choir-map-reach","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6,"statusNotes":"Strips salvage from the wreck while limiting how far Kit explores."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-3-1-1-kit","characterId":"cold-choir-char-kit","eventId":"cold-choir-event-3-1-1","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-wreck","currentMapLayerId":"cold-choir-map-reach","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6.01,"statusNotes":"Works beside Osh and wants to investigate the wreck’s sealed forward bay."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-3-1-2-osh","characterId":"cold-choir-char-osh","eventId":"cold-choir-event-3-1-2","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-pelican-galley","currentMapLayerId":"cold-choir-map-reach","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":7,"statusNotes":"Measures the salvage return against the ship’s debt and receives Fane’s summons."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-3-1-2-kit","characterId":"cold-choir-char-kit","eventId":"cold-choir-event-3-1-2","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-pelican-galley","currentMapLayerId":"cold-choir-map-reach","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":7.01,"statusNotes":"Shares the cramped galley and considers the small return from their work."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snap