000,"id":"cold-choir-image-location-wreck","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/wreck.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-chapel","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/chapel.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-gallows","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/gallows.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-interdict-field","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/interdict-field.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-crawler","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/crawler.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-shaft","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/shaft.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-recovery-hatch","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/recovery-hatch.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-sleeper-hold","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/sleeper-hold.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-row-thirty-one","mimeType":"image/webp","url":"library/the-cold-choir/art/locations/row-thirty-one.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-location-cold-cell","mimeType":"image/w