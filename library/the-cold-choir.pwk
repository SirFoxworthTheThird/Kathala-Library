-sleeper-hold","currentMapLayerId":"cold-choir-map-hold","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":65.02,"statusNotes":"Attempts to cut out a cold unit and is killed by the directed coolant discharge."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-21-1-3-osh","characterId":"cold-choir-char-osh","eventId":"cold-choir-event-21-1-3","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-sleeper-hold","currentMapLayerId":"cold-choir-map-hold","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":66,"statusNotes":"Checks Johanna Aalto’s plate and confirms the damaged junction has not killed its sleeper."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-21-1-3-kit","characterId":"cold-choir-char-kit","eventId":"cold-choir-event-21-1-3","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-sleeper-hold","currentMapLayerId":"cold-choir-map-hold","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":66.01,"statusNotes":"Stands beside Osh after the confrontation and asks where the pilot lies."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-21-1-4-osh","characterId":"cold-choir-char-osh","eventId":"cold-choir-event-21-1-4","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-sleeper-hold","currentMapLayerId":"cold-choir-map-hold","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":67,"statusNotes":"Crosses to Row Forty and descends the rim maintenance well by lamp light."},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-snapshot-21-1-4-kit","characterId":"cold-choir-char-kit","eventId":"cold-choir-event-21-1-4","isAlive":true,"currentLocationMarkerId":"cold-choir-loc-sleeper-hold","currentMapLayerId":"cold-choir-map-hold","inventoryItem