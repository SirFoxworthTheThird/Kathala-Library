},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-character-ansel","mimeType":"image/webp","url":"library/the-cold-choir/art/characters/ansel.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-character-ama","mimeType":"image/webp","url":"library/the-cold-choir/art/characters/ama.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-key","mimeType":"image/webp","url":"library/the-cold-choir/art/items/key.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-roll","mimeType":"image/webp","url":"library/the-cold-choir/art/items/roll.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-ledger","mimeType":"image/webp","url":"library/the-cold-choir/art/items/ledger.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-notebook","mimeType":"image/webp","url":"library/the-cold-choir/art/items/notebook.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-names","mimeType":"image/webp","url":"library/the-cold-choir/art/items/names.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-recorder","mimeType":"image/webp","url":"library/the-cold-choir/art/items/recorder.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-drawings","mimeType":"image/webp","url":"library/the-cold-choir/art/items/drawings.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-card","mimeType":"image/webp","url":"library/the-cold-choir/art/items/card.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-item-letter","mimeType":"image/webp","url":"library/the-cold-choir/art/items/letter.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-faction-mercy","mimeType":"image/webp","url":"library/the-cold-choir/art/factions/mercy.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-faction-compact","mimeType":"image/webp","url":"library/the-cold-choir/art/factions/compact.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-faction-kin","mimeType":"image/webp","url":"library/the-cold-choir/art/factions/kin.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-faction-union","mimeType":"image/webp","url":"library/the-cold-choir/art/factions/union.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-faction-counting","mimeType":"image/webp","url":"library/the-cold-choir/art/factions/counting.webp"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-image-faction-navy","mimeType":"image/webp","url":"library/the-cold-choir/art/factions/navy.webp"}],"relationships":[{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-relationship-ilse-tamsin","characterAId":"cold-choir-char-ilse","characterBId":"cold-choir-char-tamsin","label":"Warden and apprentice","sentiment":"positive","description":"Ilse teaches Tamsin the physical knowledge of the ship while trusting her navigation at landfall.","strength":8,"isBidirectional":true,"startEventId":"cold-choir-event-1-1-1"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-relationship-ilse-bram","characterAId":"cold-choir-char-ilse","characterBId":"cold-choir-char-bram","label":"Department keepers","sentiment":"positive","description":"The warden and quartermaster share responsibility for the sleepers while disagreeing with command’s arithmetic.","strength":7,"isBidirectional":true,"startEventId":"cold-choir-event-4-1-1"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-relationship-bram-ama","characterAId":"cold-choir-char-bram","characterBId":"cold-choir-char-ama","label":"Father and sleeping daughter","sentiment":"positive","description":"Bram’s duty to all four thousand sleepers is inseparable from Ama’s name in Row Thirty-One.","strength":10,"isBidirectional":true,"startEventId":"cold-choir-event-4-2-1"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-relationship-neve-hal","characterAId":"cold-choir-char-neve","characterBId":"cold-choir-char-hal","label":"Archivist and mentor","sentiment":"positive","description":"Hal trained Neve to handle the Roll and leaves her to decide what their institution must finally disclose.","strength":8,"isBidirectional":true,"startEventId":"cold-choir-event-2-1-1"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-relationship-neve-jory","characterAId":"cold-choir-char-neve","characterBId":"cold-choir-char-jory","label":"Archivist and Union delegate","sentiment":"positive","description":"Jory’s claim that the count is unfinished gives Neve a living measure for the archive’s omissions.","strength":6,"isBidirectional":true,"startEventId":"cold-choir-event-2-2-1"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-relationship-osh-kit","characterAId":"cold-choir-char-osh","characterBId":"cold-choir-char-kit","label":"Captain and crewmate","sentiment":"positive","description":"Osh’s hard-earned caution protects Kit while Kit’s moral questions keep the captain from treating people as salvage.","strength":9,"isBidirectional":true,"startEventId":"cold-choir-event-3-1-1"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-relationship-osh-saba","characterAId":"cold-choir-char-osh","characterBId":"cold-choir-char-saba","label":"Old associates","sentiment":"positive","description":"Osh recruits Saba because she trusts her competence when debt and danger converge.","strength":7,"isBidirectional":true,"startEventId":"cold-choir-event-6-2-1"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-relationship-osh-fane","characterAId":"cold-choir-char-osh","characterBId":"cold-choir-char-fane","label":"Debtor and creditor","sentiment":"negative","description":"Fane treats Osh’s ship, labor and choices as claims in his ledger; Osh looks for the edge of every term.","strength":8,"isBidirectional":true,"startEventId":"cold-choir-event-3-2-1"}],"relationshipSnapshots":[],"plotThreads":[{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-thread-mercy","name":"The Air Budget","description":"The final crew measures dwindling life support against its duty to the sleepers.","color":"#71808b","status":"complete","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-thread-compact","name":"The Unfinished Roll","description":"Neve tests public ritual against the evidence preserved in the archive and Kin memory.","color":"#71808b","status":"complete","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-thread-quiet","name":"The Interdict","description":"A salvage debt leads from old wreckage to a prohibited field beneath Ninefold’s ice.","color":"#71808b","status":"complete","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-thread-count","name":"Keep the Count","description":"Rolls, ledgers, songs, cards and names preserve people whom institutions have stopped counting.","color":"#71808b","status":"complete","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-thread-key","name":"The Key of Office","description":"A manual tool passes between wardens, commanders, creditors and salvagers as both mechanism and claim.","color":"#71808b","status":"complete","tags":[]}],"motifs":[{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-motif-breath","name":"Breath and Air","description":"Compressors, life support, pressure and exhausted bodies make survival audible.","color":"#77838a","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-motif-names","name":"Names in Rows","description":"Names written, sung, hidden and read aloud keep the sleepers human across centuries.","color":"#77838a","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-motif-cold","name":"Cold That Preserves","description":"Frost holds bodies and evidence while societies change around them.","color":"#77838a","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-motif-debt","name":"Ledgers and Debt","description":"Material accounts repeatedly become claims over lives.","color":"#77838a","tags":[]}],"loreCategories":[{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-category-edition","name":"Edition","description":"Text, rights, chronology, maps and illustrations.","color":"#6f7f8d","sortOrder":0},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-category-history","name":"Eras and institutions","description":"Reader-facing context grounded in the novel.","color":"#6f7f8d","sortOrder":1},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-category-science","name":"Ship and world","description":"Reader-facing context grounded in the novel.","color":"#6f7f8d","sortOrder":2}],"lorePages":[{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-source","categoryId":"cold-choir-lore-category-edition","title":"Text and rights","body":"This reading edition preserves the complete creator-supplied manuscript of The Cold Choir by Solomon Darko: twenty-one chapters, forty-four authorial sections, and 48,573 narrative words. Copyright © 2026 Solomon Darko. All rights reserved.","visibleFromEventId":"cold-choir-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-eras","categoryId":"cold-choir-lore-category-history","title":"Three separated eras","body":"The novel alternates among the Mercy in 1 Before Landfall, the Compact in 310–311 After Landfall, and the Quiet in 742 After Landfall. The timelines remain separate; objects, records and testimony connect them.","visibleFromEventId":"cold-choir-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-maps","categoryId":"cold-choir-lore-category-edition","title":"Maps and illustrations","body":"Original OpenAI ImageGen navigational plates interpret the novel’s ship, station, and planetary geography. Nested views clarify the smaller spaces encountered during the story.","visibleFromEventId":"cold-choir-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-chronology","categoryId":"cold-choir-lore-category-edition","title":"Chronology method","body":"Each strand uses source-relative days rather than pretending to a single universal calendar. Explicit anchors fix the Mercy council nine days after the captain’s death, the eighteen-hour store-fire interval, the forty-day landfall approach, Investiture eighteen days before the Tricentennial, the arrest conversation four days before it, and the first day of 311 AL. Unstated intervals are editorial day placements; immediate cuts share a day and sortOrder preserves narrative order. The Mercy text conflicts: twenty days to the navigator meeting plus eleven to burn is shorter than the repeated forty-day custody interval. This edition prioritizes the forty-day interval, keeps the twenty-day meeting cue, and treats the eleven-day recollection as unresolved. The final twenty-minute search and four-hour waking are represented explicitly. Other dates between these anchors are editorial placements preserving source order rather than additional claims of elapsed time.","visibleFromEventId":"cold-choir-event-21-2-5","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-landfall","categoryId":"cold-choir-lore-category-history","title":"Before and After Landfall","body":"Dates use the settlement’s own era. Before Landfall belongs to the approaching generation ship; After Landfall measures the societies that inherit it.","visibleFromEventId":"cold-choir-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-lore-mercy","categoryId":"cold-choir-lore-category-science","title":"The Mercy of Tolland","body":"The generation ship carries four thousand specialists and children in cold berths while a living crew maintains the vessel across the voyage.","visibleFromEventId":"cold-choir-event-1-1-1","tags":[],"coverImageId":null,"linkedEntityIds":[]}],"knowledgeFacts":[{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-fact-roll-checks","title":"The Roll contains generations of checks","description":"Quartermasters continued marking the sleeper register throughout the voyage.","readerLearnsAtEventId":"cold-choir-event-2-1-1","originEventId":"cold-choir-event-2-1-1","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-fact-count-short","title":"The official count ended too early","description":"Kin memory preserves names outside the Compact’s finished public Roll.","readerLearnsAtEventId":"cold-choir-event-2-2-1","originEventId":"cold-choir-event-2-2-1","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-fact-interdict","title":"The old ban concealed a physical site","description":"The prohibition points toward a field on Ninefold rather than only a legal tradition.","readerLearnsAtEventId":"cold-choir-event-11-2-1","originEventId":"cold-choir-event-11-2-1","tags":[]},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-fact-ama","title":"Ama Okafor remains in the cold rows","description":"Bram’s daughter is the child assigned to Row Thirty-One, berth twelve.","readerLearnsAtEventId":"cold-choir-event-21-2-3","originEventId":"cold-choir-event-21-2-3","tags":[]}],"knowledgeReveals":[],"factions":[{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-faction-mercy","name":"Mercy crew","description":"The working crew responsible for the ship and its sleeping passengers.","color":"#6e7880","tags":[],"coverImageId":"cold-choir-image-faction-mercy"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-faction-compact","name":"The Compact","description":"The station polity that organizes authority around charter, Watch and Warden.","color":"#6e7880","tags":[],"coverImageId":"cold-choir-image-faction-compact"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-faction-kin","name":"The Kin","description":"A community whose songs preserve the unfinished count.","color":"#6e7880","tags":[],"coverImageId":"cold-choir-image-faction-kin"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-faction-union","name":"Ninefold Ice Union","description":"Miners and delegates seeking safety, compensation and control of their work.","color":"#6e7880","tags":[],"coverImageId":"cold-choir-image-faction-union"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-faction-counting","name":"Counting House","description":"Fane’s network of debt, salvage claims and hired force.","color":"#6e7880","tags":[],"coverImageId":"cold-choir-image-faction-counting"},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-faction-navy","name":"Compact Navy","description":"The service in which Captain Rhee commands the Obedient.","color":"#6e7880","tags":[],"coverImageId":"cold-choir-image-faction-navy"}],"factionMemberships":[{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-membership-1","factionId":"cold-choir-faction-mercy","characterId":"cold-choir-char-ilse","role":"Deck Nine warden","startEventId":"cold-choir-event-1-1-1","endEventId":null,"notes":""},{"worldId":"the-cold-choir-world","createdAt":1792195200000,"updatedAt":1792195200000,"id":"cold-choir-membership-2","factionId":"cold-choir-faction-mercy","characterId":"cold-choir-char-tamsin","role":"Navigator","startEventId":"cold-choir-event-1-1-1","endEventId":null,"not