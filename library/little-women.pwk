  "loreCategories": [
    {
      "worldId": "little-women-world",
      "createdAt": 1792454400000,
      "updatedAt": 1792454400000,
      "id": "little-women-lore-category-edition",
      "name": "Reading Little Women",
      "description": "Text, structure, chronology, geography, and illustration provenance.",
      "sortOrder": 0
    }
  ],
  "lorePages": [
    {
      "worldId": "little-women-world",
      "createdAt": 1792454400000,
      "updatedAt": 1792454400000,
      "id": "little-women-lore-source",
      "categoryId": "little-women-lore-category-edition",
      "title": "Text and public-domain source",
      "body": "This reading text preserves the complete narrative of Project Gutenberg eBook 514, Louisa May Alcott’s Little Women. The source file has SHA-256 36831477b339dbcd7e7206119d77e9e58b9727ef3c299d1a1dc4446e1db97850. Gutenberg packaging is excluded; both parts, all forty-seven authorial chapter headings, and every retained narrative paragraph remain in order.",
      "sortOrder": 0,
      "visibleFromEventId": "little-women-event-1-1",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": []
    },
    {
      "worldId": "little-women-world",
      "createdAt": 1792454400000,
      "updatedAt": 1792454400000,
      "id": "little-women-lore-structure",
      "categoryId": "little-women-lore-category-edition",
      "title": "Two parts and forty-seven chapters",
      "body": "The novel was published in two parts. This world preserves that division and every authorial chapter title; scene divisions occur only at reviewed paragraph boundaries when place, cast, knowledge, possession, tension, or character state changes.",
      "sortOrder": 1,
      "visibleFromEventId": "little-women-event-1-1",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": []
    },
    {
      "worldId": "little-women-world",
      "createdAt": 1792454400000,
      "updatedAt": 1792454400000,
      "id": "little-women-lore-calendar",
      "categoryId": "little-women-lore-category-edition",
      "title": "Editorial chronology",
      "body": "Relative editorial days preserve the source sequence through sort order while allowing parallel accounts and recollections to return to earlier time. The will dated November 20 precedes the December 1 crisis. Part II begins three relative years after Part I; Jo’s engagement lasts a year before its second year opens, and the harvest is five years after her wedding. Other durations are approximate reading aids. The source’s ages, seasons and quoted year do not establish a consistent Gregorian calendar; no absolute date is asserted.",
      "sortOrder": 2,
      "visibleFromEventId": "little-women-event-1-1",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": []
    },
    {
      "worldId": "little-women-world",
      "createdAt": 1792454400000,
      "updatedAt": 1792454400000,
      "id": "little-women-lore-maps",
      "categoryId": "little-women-lore-category-edition",
      "title": "Places and map method",
      "body": "The March neighborhood and its fictional homes use interpretive local and building plans. The Atlantic and European layers connect real travel centers without claiming surveyed routes.",
      "sortOrder": 3,
      "visibleFromEventId": "little-women-event-1-1",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": []
    },
    {
      "worldId": "little-women-world",
      "createdAt": 1792454400000,
      "updatedAt": 1792454400000,
      "id": "little-women-lore-art",
      "categoryId": "little-women-lore-category-edition",
      "title": "Maps and illustrations",
      "body": "The original maps, portraits, object studies, and cover were generated for this edition with OpenAI’s image generation tool, then individually inspected and retained as fixed edition assets. They use a mature nineteenth-century American visual direction to distinguish people, objects, homes, and travel settings while preserving the novel’s domestic scale.",
      "sortOrder": 4,
      "visibleFromEventId": "little-women-event-1-1",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": []
    }
  ],
